 "itens": {
  "proteja-se.guia-calor.item_2": {
   "texto_do_guia": "Centros comunitários e shoppings podem servir de refúgio nos horários mais quentes do dia",
   "url": "https://www.gov.br/saude/pt-br/assuntos/saude-de-a-a-z/o/ondas-de-calor",
   "trecho": "Ambientes como centros comunitários e shoppings podem servir como refúgio durante os horários mais quentes do dia.",
   "hash": "ec955c5866089180418a226f7c62ac7bb81f3b812287ea06f89bb214124aa74e",
   "consultado_em": "19/10/2026"
  },
  "proteja-se.guia-calor.item_4": {
   "texto_do_guia": "Beba água regularmente, mesmo sem sede, e evite bebidas alcoólicas ou com cafeína",
   "url": "https://www.gov.br/saude/pt-br/assuntos/saude-de-a-a-z/o/ondas-de-calor",
   "trecho": "Hidratação constante: Beber água regularmente, mesmo quando não se sente sede, e evitar bebidas alcoólicas ou com cafeína, que podem aumentar a desidratação.",
   "hash": "ec955c5866089180418a226f7c62ac7bb81f3b812287ea06f89bb214124aa74e",
   "consultado_em": "19/10/2026"
  },
  "proteja-se.guia-calor.item_5": {
   "texto_do_guia": "Use roupas leves, de cores claras e de tecidos que permitam a transpiração",
   "url": "https://www.gov.br/saude/pt-br/assuntos/saude-de-a-a-z/o/ondas-de-calor",
   "trecho": "Vestimenta adequada: Usar roupas leves, de cores claras e de tecidos que permitem a transpiração.",
   "hash": "ec955c5866089180418a226f7c62ac7bb81f3b812287ea06f89bb214124aa74e",
   "consultado_em": "19/10/2026"
  },
  "proteja-se.guia-calor.item_6": {
   "texto_do_guia": "Planeje atividades ao ar livre para a manhã cedo ou o fim da tarde",
   "url": "https://www.gov.br/saude/pt-br/assuntos/saude-de-a-a-z/o/ondas-de-calor",
   "trecho": "Rotina ajustada: Planejar atividades ao ar livre para os horários mais frescos do dia, como a manhã cedo ou o final da tarde.",
   "hash": "ec955c5866089180418a226f7c62ac7bb81f3b812287ea06f89bb214124aa74e",
   "consultado_em": "19/10/2026"
  },
  "proteja-se.guia-calor.item_7": {
   "texto_do_guia": "Prefira alimentos leves e de fácil digestão, como frutas e saladas",
   "url": "https://www.gov.br/saude/pt-br/assuntos/saude-de-a-a-z/o/ondas-de-calor",
   "trecho": "Alimentação leve: Preferir alimentos leves e de fácil digestão, como frutas e saladas, evitando refeições pesadas que exigem mais energia para",
   "hash": "ec955c5866089180418a226f7c62ac7bb81f3b812287ea06f89bb214124aa74e",
   "consultado_em": "19/10/2026"
  },
  "proteja-se.guia-calor.item_9": {
   "texto_do_guia": "Confusão, convulsão ou perda de consciência são emergência médica: ligue 192",
   "url": "https://www.gov.br/saude/pt-br/assuntos/saude-de-a-a-z/o/ondas-de-calor",
   "trecho": "Insolação e Golpe de Calor: O golpe de calor é uma emergência médica que ocorre quando o corpo é incapaz de regular sua temperatura interna, levando a sintomas como confusão, convulsões e perda de consciência.",
   "hash": "ec955c5866089180418a226f7c62ac7bb81f3b812287ea06f89bb214124aa74e",
   "consultado_em": "19/10/2026"
  }
 },
