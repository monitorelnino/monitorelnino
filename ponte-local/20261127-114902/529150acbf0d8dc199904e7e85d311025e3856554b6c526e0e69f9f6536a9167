    <script>
        const API_KEY = '[SEGREDO REDIGIDO]';
        const LAT = '-15.6597';
        const LON = '-40.0656';
        const BASE_URL = `https://api.openweathermap.org/data/2.5/weather?lat=${LAT}&lon=${LON}&appid=${API_KEY}&units=metric&lang=pt_br`;

        async function fetchWeatherData() {
            try {
                const response = await fetch(BASE_URL);
                const data = await response.json();

                document.getElementById('city-name').innerText = "Itarantim, BR";
                const date = new Date();
                document.getElementById('date-time').innerText = date.toLocaleString('pt-BR', { dateStyle: 'full', timeStyle: 'short' });

                document.getElementById('temp').innerText = `${data.main.temp.toFixed(0)}°C`;
                document.getElementById('wind-gust').innerText = data.wind.gust ? `${data.wind.gust.toFixed(1)} Km/h` : "0 Km/h";
                document.getElementById('clouds').innerText = `${data.clouds.all}%`;
                document.getElementById('visibility').innerText = `${(data.visibility / 1000).toFixed(1)} km`;
                
                const sunrise = new Date(data.sys.sunrise * 1000);
                const sunset = new Date(data.sys.sunset * 1000);
                document.getElementById('sunrise').innerText = sunrise.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
                document.getElementById('sunset').innerText = sunset.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });

                document.getElementById('humidity').innerText = `${data.main.humidity}%`;
                document.getElementById('pressure').innerText = `${data.main.pressure} mb`;
                document.getElementById('wind-speed').innerText = `${data.wind.speed.toFixed(1)} Km/h`;

                const iconCode = data.weather[0].icon;
                const iconUrl = `https://openweathermap.org/img/wn/${iconCode}@2x.png`;
                document.getElementById('weather-icon').src = iconUrl;
                document.getElementById('weather-icon').alt = data.weather[0].description;

            } catch (error) {
                alert("Erro ao obter dados da previsão do tempo. Verifique sua chave de API e conexão.");
                console.error(error);
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            fetchWeatherData();
        });
    </script>
