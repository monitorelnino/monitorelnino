<script id="yotu-script-js-after">
yotuwp.data.videos['2cc6uSLhVCI'] = ["Hist\u00f3ria de vida","Estamos orgulhosos do belo trabalho que nosso munic\u00edpio est\u00e1 desempenhando na \u00e1rea da sa\u00fade. Queremos compartilhar algumas hist\u00f3rias inspiradoras de pessoas que foram alcan\u00e7adas por nossos servi\u00e7os e tiveram suas vidas transformadas."];yotuwp.data.videos['F2xnzKANy8E'] = ["Hist\u00f3ria de Vida","Uma linda hist\u00f3ria de vida para compartilhar. Essas hist\u00f3rias inspiradoras fortalecem o compromisso da administra\u00e7\u00e3o em proporcionar cuidados de qualidade que impactam positivamente a comunidade. A prefeitura de Itarantim est\u00e1 construindo um futuro mais saud\u00e1vel e promissor para todos. \ud83c\udf1f\ud83c\udfe5 #Sa\u00fadeTransformadora #ItarantimCuida"];yotuwp.data.videos['aj9LkTWPEZE'] = ["Prefeitura inaugura nova sede do CRAS","Em um marco significativo para a comunidade, a Prefeitura de Itarantim celebrou a inaugura\u00e7\u00e3o da nova sede do CRAS. Essa iniciativa visa atender um n\u00famero ainda maior de usu\u00e1rios dos servi\u00e7os sociais, proporcionando um espa\u00e7o mais amplo e adequado. Com esse passo, a administra\u00e7\u00e3o municipal reafirma o compromisso de servir e fortalecer a comunidade, buscando oferecer suporte social de qualidade a todos os cidad\u00e3os."];yotuwp.data.videos['N6Sqq76YghU'] = ["Posse dos novos Conselheiros Tutelares de Itarantim","A Prefeitura e a Secretaria de Assist\u00eancia Social congratulam calorosamente os novos conselheiros tutelares empossados nesta quarta-feira. Sua dedica\u00e7\u00e3o fortalece nosso compromisso com o bem-estar das crian\u00e7as e adolescentes, e juntos, continuaremos a promover um ambiente seguro e acolhedor para todos. Boas-vindas e sucesso em sua nobre miss\u00e3o!"];yotuwp.data.videos['kBBApBCS7yI'] = ["Prefeitura entrega mais uma frota de carros e equipamentos para o munic\u00edpio.","A Prefeitura Municipal de Itarantim fortaleceu seu compromisso com o desenvolvimento local ao entregar uma nova frota de carros utilit\u00e1rios e maquin\u00e1rios destinados a obras no munic\u00edpio. Essa iniciativa visa potencializar a capacidade de realiza\u00e7\u00e3o de melhorias e interven\u00e7\u00f5es necess\u00e1rias, beneficiando diretamente a comunidade. Com essa entrega, a prefeitura refor\u00e7a seu empenho em proporcionar infraestrutura adequada e servi\u00e7os de qualidade, promovendo o progresso e a qualidade de vida para todos os mun\u00edcipes de Itarantim.\u003Cbr \/\u003E\n\u003Cbr \/\u003E\nAscom."];yotuwp.data.videos['yOePir5DbXo'] = ["Mais de 3k de redes de esgoto reconstru\u00eddas","Aqui, o trabalho continua! A Prefeitura de Itarantim avan\u00e7a no aprimoramento da infraestrutura da cidade com a reconstru\u00e7\u00e3o do sistema de esgotamento. Mais de 3km de redes de esgoto foram totalmente revitalizadas, trazendo melhorias significativas para a comunidade. Essa a\u00e7\u00e3o demonstra o compromisso da administra\u00e7\u00e3o em proporcionar um ambiente mais saud\u00e1vel e sustent\u00e1vel para os cidad\u00e3os, garantindo um sistema de esgoto eficiente e confi\u00e1vel."];
//# sourceURL=yotu-script-js-after
</script>
