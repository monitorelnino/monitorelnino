<script>
(function () {
  var c = document.getElementById("carrossel-prefeitura");
  if (!c) return;
  var slides = Array.prototype.slice.call(c.querySelectorAll(".slide"));
  var pontosBox = c.querySelector(".pontos");
  var btnAnt = c.querySelector(".anterior");
  var btnProx = c.querySelector(".proxima");
  var btnPausar = c.querySelector(".pausar");
  var reduz = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var atual = 0, timer = null, pausado = reduz, pontos = [];
  slides.forEach(function (s, i) {
    var b = document.createElement("button");
    b.type = "button";
    b.className = "ponto";
    b.setAttribute("aria-label", "Mostrar imagem " + (i + 1));
    b.addEventListener("click", function () { mostrar(i); iniciar(); });
    pontosBox.appendChild(b);
    pontos.push(b);
  });
  function mostrar(n) {
    atual = (n + slides.length) % slides.length;
    slides.forEach(function (s, i) {
      var ativo = i === atual;
      s.classList.toggle("ativo", ativo);
      s.setAttribute("aria-hidden", ativo ? "false" : "true");
      s.setAttribute("tabindex", ativo ? "0" : "-1");
      pontos[i].classList.toggle("ativo", ativo);
      if (ativo) { pontos[i].setAttribute("aria-current", "true"); } else { pontos[i].removeAttribute("aria-current"); }
    });
  }
  function parar() { clearInterval(timer); timer = null; }
  function iniciar() {
    parar();
    if (pausado) return;
    timer = setInterval(function () { mostrar(atual + 1); }, 6000);
  }
  function rotuloPausar() {
    btnPausar.innerHTML = pausado ? "&#9654;" : "&#10074;&#10074;";
    btnPausar.setAttribute("aria-label", pausado ? "Retomar rotação automática" : "Pausar rotação automática");
  }
  btnAnt.addEventListener("click", function () { mostrar(atual - 1); iniciar(); });
  btnProx.addEventListener("click", function () { mostrar(atual + 1); iniciar(); });
  btnPausar.addEventListener("click", function () { pausado = !pausado; rotuloPausar(); iniciar(); });
  c.addEventListener("pointerenter", function (e) { if (e.pointerType === "mouse") parar(); });
  c.addEventListener("pointerleave", function (e) { if (e.pointerType === "mouse") iniciar(); });
  c.addEventListener("focusin", parar);
  c.addEventListener("focusout", iniciar);
  var x0 = null;
  c.addEventListener("touchstart", function (e) { x0 = e.touches[0].clientX; }, { passive: true });
  c.addEventListener("touchend", function (e) {
    if (x0 === null) return;
    var dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) { mostrar(atual + (dx < 0 ? 1 : -1)); iniciar(); }
    x0 = null;
  }, { passive: true });
  rotuloPausar();
  mostrar(0);
  iniciar();
})();
</script>
