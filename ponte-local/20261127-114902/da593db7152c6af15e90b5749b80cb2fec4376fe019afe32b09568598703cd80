<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script defer>
    const areas = document.querySelectorAll('.box-img-zoom .img-position')
    const lugaresMapa = document.querySelectorAll('.lugares-mapa-interativo .lugares-mapa-interativo__grid-item')
    const btnCompartilhar = document.querySelectorAll('.box-acessar .btn-whatsapp')

    const fecharModalDetalhes = () => {
        lugaresMapa.forEach(item => {
            item.classList.remove('ativo')
        }
        )

        areas.forEach(item => {
            item.classList.remove('ativo')
            item.setAttribute('aria-expanded', 'false')
        })
    }

    const mostrarDetalhesLugar = (area, index) => {
        lugaresMapa.forEach(item => item.classList.remove('ativo'))
        areas.forEach(item => {
            item.classList.remove('ativo')
            item.setAttribute('aria-expanded', 'false')
        })

        lugaresMapa[index].classList.add('ativo')
        area.classList.add('ativo')
        area.setAttribute('aria-expanded', 'true')

        const titulo = lugaresMapa[index].querySelector('h3')
        if (titulo) titulo.focus()
    }

    areas.forEach((item, index) => {
        item.addEventListener('click', (event) => {
            event.preventDefault()
            mostrarDetalhesLugar(item, index)
            btnCompartilhar[index].href = `https://wa.me/?text=${item.title}\n+${item.href}`
        })

        item.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault()
                mostrarDetalhesLugar(item, index)
            }
        })
    })

    document.addEventListener('click', (event) => {
        const isClickInsideMapa = [...areas].some(el => el.contains(event.target))
        const isClickInsideLugar = [...lugaresMapa].some(el => el.contains(event.target))

        if (!isClickInsideMapa && !isClickInsideLugar) {
            fecharModalDetalhes()
        }
    })

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
            fecharModalDetalhes()
        }
    })

    function abrirRotaGoogleMaps(destino) {
        if (!destino) return;

