<style>.service-duotone-v1 {
    background: linear-gradient(135deg, var(--dynamic-main), color-mix(in srgb, var(--dynamic-main), black 15%));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    border-radius: 12px;
    padding: 25px;
    text-decoration: none !important;
    height: 100%;
    color: #fff;
    transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
    position: relative;
    overflow: hidden;
}

.service-duotone-v1::after {
    content: '';
    position: absolute;
    top: -30px; right: -30px;
    width: 100px; height: 100px;
    background: color-mix(in srgb, white 15%, transparent);
    border-radius: 50%;
    transition: transform 0.6s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.service-duotone-v1:hover {
    transform: translateY(-6px);
    /* A sombra cresce e brilha com a cor secundária no hover */
}

.service-duotone-v1:hover::after {
    transform: scale(2.5); 
}

.service-duotone-v1-icon {
    font-size: 32px;
    margin-bottom: 15px;
    /* Ícone usa a cor de destaque sólida para chamar atenção */
    background: var(--dynamic-highlight);
    color: #ffffff;
    width: 55px; height: 55px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    z-index: 2;
}

.service-duotone-v1-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: #fff;
    line-height: 1.3;
    z-index: 2;
}</style>
<style>.card-glass-wrapper {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    height: 100%;
    min-height: 400px;
    box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.15);
    background: #000;
}
.card-glass-img {
    width: 100%;
    height: 100%;
}
.card-glass-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
}
.card-glass-body {
    position: absolute;
    bottom: 15px;
    left: 15px;
    right: 15px;
    border-radius: 15px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.18);
}
.card-glass-blur {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 1;
}
.card-glass-content {
    position: relative;
    z-index: 2;
    padding: 20px;
    color: #fff;
}
.card-glass-title {
    color: var(--color-text-light, #fff);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.1rem;
    display: block;
    margin: 0;
    line-height: 1.4;
    transition: color 0.3s ease;
}

.card-glass-wrapper:hover .card-glass-title {
    color: var(--dynamic-accent);
}

.card-glass-date {
    font-size: 0.75rem;
    opacity: 0.9;
    color: var(--dynamic-accent);   
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
    display: block;
    font-weight: 600;
}

/* Hover */
.card-glass-wrapper:hover .card-glass-img img { transform: scale(1.1); }
.card-glass-wrapper:hover .card-glass-blur { background: rgba(0, 0, 0, 0.7); }</style>
<style>.card-lic-status-wrapper {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    text-decoration: none !important;
    position: relative;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    transition: all 0.3s ease;
    height: 100%;
    border: 1px solid #eef0f2;
    color: inherit;
    padding-right: 10px;
}

.card-lic-status-wrapper:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    border-color: var(--dynamic-accent);
}

/* BADGE DE STATUS */
.lic-status-badge {
    position: absolute;
    top: 15px;
    right: 15px;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 5px 12px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
/* Paleta de Cores de Status */
.lic-status-green { background: #d1fae5; color: #065f46; border: 1px solid #a7f3d0; }
.lic-status-blue { background: #dbeafe; color: #1e40af; border: 1px solid #bfdbfe; }
.lic-status-gray { background: #f3f4f6; color: #374151; border: 1px solid #e5e7eb; }
.lic-status-red { background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca; }
.lic-status-orange { background: #ffedd5; color: #c2410c; border: 1px solid #fed7aa; }

/* Coluna Esquerda: Calendário */
.card-lic-date-box {
    background-color: color-mix(in srgb, var(--dynamic-accent) 8%, white);
    width: 100px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-right: 1px solid #eef0f2;
    padding: 15px 10px;
    text-align: center;
    color: var(--dynamic-accent);
}

.card-lic-day { font-size: 2.2rem; font-weight: 900; line-height: 1; }
.card-lic-month { font-size: 0.9rem; text-transform: uppercase; font-weight: 800; margin-top: 4px; }
.card-lic-time { 
    margin-top: 12px; font-size: 0.8rem; font-weight: 700; 
    display: flex; align-items: center; gap: 5px;
    background: #fff; padding: 4px 8px; border-radius: 6px;
    border: 1px solid #eef0f2;
}

/* Coluna Direita */
.card-lic-body {
    padding: 20px 20px 20px 25px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.card-lic-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: #333;
    margin: 0 0 8px 0;
    line-height: 1.4;
    padding-right: 80px; /* Impede que o título entre embaixo do badge */
}

.card-lic-meta {
    font-size: 0.85rem;
    color: #666;
    margin-bottom: 10px;
    display: flex; align-items: center; gap: 6px;
    font-weight: 600;
}
.card-lic-meta i { color: var(--dynamic-accent); }

.card-lic-desc { font-size: 0.9rem; color: #666; line-height: 1.6; }

@media (max-width: 768px) {
    .card-lic-status-wrapper { flex-direction: column; padding: 0; }
    .card-lic-date-box { width: 100%; flex-direction: row; gap: 15px; border-right: none; border-bottom: 1px solid #eef0f2; }
    .card-lic-time { margin-top: 0; }
    .card-lic-title { padding-right: 0; margin-top: 30px; } /* Abaixa o título para não brigar com o badge absolute no mobile */
}</style>
<style>.card-sec-inst {
    background: #ffffff;
    border-radius: 12px;
    border: 1px solid #eef0f2;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none !important;
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    transition: all 0.3s ease;
    height: 100%;
}

.card-sec-inst:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    border-color: var(--dynamic-accent);
}

.card-sec-inst-body {
    padding: 25px;
    flex-grow: 1;
}

.card-sec-inst-icon {
    font-size: 2rem;
    color: var(--dynamic-accent);
    margin-bottom: 15px;
    opacity: 0.9;
}

.card-sec-inst-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #333;
    margin: 0 0 15px 0;
    line-height: 1.3;
}

.card-sec-inst-info {
    font-size: 0.85rem;
    color: #666;
    margin-bottom: 6px;
    display: flex;
    align-items: flex-start;
    gap: 10px;
}

.card-sec-inst-info i {
    margin-top: 3px;
    color: #adb5bd;
}

/* Rodapé do Perfil (Secretário) */
.card-sec-inst-footer {
    background-color: #f8f9fa;
    padding: 15px 25px;
    border-top: 1px solid #eef0f2;
    display: flex;
    align-items: center;
    gap: 12px;
}

.card-sec-inst-avatar {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid #ffffff;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    flex-shrink: 0;
}

.card-sec-inst-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.card-sec-inst-person {
    display: flex;
    flex-direction: column;
}

.card-sec-inst-name {
    font-size: 0.9rem;
    font-weight: 700;
    color: #333;
    margin-bottom: 2px;
}

.card-sec-inst-role {
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--dynamic-accent);
    font-weight: 700;
}</style>
<style>.tour-over-wrapper {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none !important;
    box-shadow: 0 6px 20px rgba(0,0,0,0.1);
    transition: all 0.4s ease;
    height: 350px; /* Altura fixa para manter o grid perfeito */
    width: 100%;
    background: #222;
}

.tour-over-wrapper:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 35px rgba(0,0,0,0.2);
}

.tour-over-bg {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
    z-index: 1;
}

.tour-over-wrapper:hover .tour-over-bg {
    transform: scale(1.1);
}

/* O gradiente faz o texto branco ficar legível independente da foto */
.tour-over-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.4) 50%, transparent 100%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    padding: 25px;
}

.tour-over-cat {
    align-self: flex-start;
    background: var(--dynamic-accent);
    color: #ffffff;
    padding: 6px 14px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
}

.tour-over-content {
    margin-top: auto;
    color: #ffffff;
    transition: transform 0.3s ease;
}

.tour-over-wrapper:hover .tour-over-content {
    transform: translateY(-5px);
}

.tour-over-title {
    font-size: 1.4rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 8px 0;
    line-height: 1.2;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
}

.tour-over-desc {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.85);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}</style>
