<script>
  // ===== CONTROLE DE FONTE =====
  let fontSizeMultiplier = 1;
  const defaultFontSize = 16; // Tamanho base em pixels
  
  function aumentarFonte() {
    fontSizeMultiplier += 0.1;
    aplicarTamanhoFonte();
    localStorage.setItem('fontSizeMultiplier', fontSizeMultiplier);
  }
  
  function diminuirFonte() {
    if (fontSizeMultiplier > 0.1) {
      fontSizeMultiplier -= 0.1;
      aplicarTamanhoFonte();
      localStorage.setItem('fontSizeMultiplier', fontSizeMultiplier);
    }
  }
  
  function resetarFonte() {
    fontSizeMultiplier = 1;
    document.documentElement.style.fontSize = '';
    document.body.style.fontSize = '';
    localStorage.removeItem('fontSizeMultiplier');
  }
  
  function aplicarTamanhoFonte() {
    const tamanhoCalculado = defaultFontSize * fontSizeMultiplier;
    document.documentElement.style.fontSize = tamanhoCalculado + 'px';
    document.body.style.fontSize = tamanhoCalculado + 'px';
  }

  // ===== CONTROLE DE CONTRASTE =====
  function altoContraste() {
    document.documentElement.classList.toggle('alto-contraste-mode');
    document.body.classList.toggle('alto-contraste-mode');
    
    if (document.body.classList.contains('escala-cinza-mode')) {
      document.body.classList.remove('escala-cinza-mode');
      localStorage.removeItem('escalaCinza');
    }
    
    localStorage.setItem('altoContraste', document.body.classList.contains('alto-contraste-mode'));
  }
  
  function escalaCinza() {
    document.documentElement.classList.toggle('escala-cinza-mode');
    document.body.classList.toggle('escala-cinza-mode');
    
    if (document.body.classList.contains('alto-contraste-mode')) {
      document.body.classList.remove('alto-contraste-mode');
      localStorage.removeItem('altoContraste');
    }
    
    localStorage.setItem('escalaCinza', document.body.classList.contains('escala-cinza-mode'));
  }

  // ===== PERSISTÊNCIA =====
  document.addEventListener('DOMContentLoaded', function() {
    // Fonte
    const savedSize = parseFloat(localStorage.getItem('fontSizeMultiplier'));
    if (savedSize) {
      fontSizeMultiplier = savedSize;
      aplicarTamanhoFonte();
    }
    
    // Contraste - REMOVIDO O INÍCIO AUTOMÁTICO
    // Verifica se já estava ativo pelo usuário
    if (localStorage.getItem('altoContraste') === 'true') {
      document.documentElement.classList.add('alto-contraste-mode');
      document.body.classList.add('alto-contraste-mode');
    }
    
    // Escala de Cinza
    if (localStorage.getItem('escalaCinza') === 'true') {
      document.documentElement.classList.add('escala-cinza-mode');
      document.body.classList.add('escala-cinza-mode');
    }
  });
</script>				</div>
