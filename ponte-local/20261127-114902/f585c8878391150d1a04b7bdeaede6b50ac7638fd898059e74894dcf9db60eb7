        config: {
            zoom: 1.0,
            step: 0.1,
            max: 1.5,
            min: 0.8,
            // Lista negra para não estragar ícones
            ignoreSelectors: '.fa, .fas, .fab, .far, .material-icons, .dashicons, i, svg, .weather-icon-wrapper',
        },
        processed: false,

        // Inicializa e prepara todos os elementos do site
        init: function() {
            if (this.processed) return;

            // Seleciona TODOS os elementos dentro do body
            const allElements = document.querySelectorAll('body *:not(script):not(style):not(noscript)');
            
            allElements.forEach(el => {
                // Pula elementos que são ícones ou parte da barra de acessibilidade
                if (el.matches(this.config.ignoreSelectors)) return;
                if (el.closest('.top-bar-wrapper')) return; // Não altera o próprio header

                // Obtém o tamanho computado atual (mesmo que venha do CSS do tema)
                const style = window.getComputedStyle(el);
                const currentFontSize = parseFloat(style.fontSize);

                // Se tiver um tamanho de fonte válido (> 0) e não for um ícone
                if (currentFontSize > 0) {
                    // INJEÇÃO DA FÓRMULA:
                    // Define o tamanho como: Tamanho Original * Variável de Zoom
                    // O "important" garante que sobrescreva o CSS do Elementor/Tema
                    el.style.setProperty(
                        'font-size', 
                        `calc(${currentFontSize}px * var(--a11y-zoom))`, 
                        'important'
                    );
                }
            });

            this.processed = true;
            console.log("Acessibilidade Reativa: Elementos preparados.");
        },

        updateZoomVar: function() {
            // Apenas atualiza a variável na raiz. O navegador faz o resto instantaneamente.
            document.documentElement.style.setProperty('--a11y-zoom', this.config.zoom);
        },

        aumentar: function() {
            if (!this.processed) this.init();
            if (this.config.zoom < this.config.max) {
                this.config.zoom = parseFloat((this.config.zoom + this.config.step).toFixed(1));
                this.updateZoomVar();
            }
        },

        diminuir: function() {
            if (!this.processed) this.init();
            if (this.config.zoom > this.config.min) {
                this.config.zoom = parseFloat((this.config.zoom - this.config.step).toFixed(1));
                this.updateZoomVar();
            }
        },

        resetar: function() {
            this.config.zoom = 1.0;
            this.updateZoomVar();
            
            // Remove classes de contraste
            document.documentElement.classList.remove('acc-contraste', 'acc-cinza');
        },

        contraste: function() {
            const root = document.documentElement;
            if (root.classList.contains('acc-contraste')) {
                root.classList.remove('acc-contraste');
            } else {
                root.classList.remove('acc-cinza');
                root.classList.add('acc-contraste');
            }
        },

        escalaCinza: function() {
            const root = document.documentElement;
            if (root.classList.contains('acc-cinza')) {
                root.classList.remove('acc-cinza');
            } else {
                root.classList.remove('acc-contraste');
                root.classList.add('acc-cinza');
            }
        }
    };

    // -----------------------------------------------------------
    // WIDGET DE CLIMA
    // -----------------------------------------------------------
    document.addEventListener("DOMContentLoaded", function() {
        const lat = -23.7314;
        const lon = -52.8733;
        const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true&timezone=America%2FSao_Paulo`;

        const icons = {
            sun: `<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="32" cy="32" r="14" fill="#F4B400"/><path d="M32 4V12M32 52V60M60 32H52M12 32H4M51.8 12.2L46.1 17.9M17.9 46.1L12.2 51.8M51.8 51.8L46.1 46.1M17.9 17.9L12.2 12.2" stroke="#F4B400" stroke-width="4" stroke-linecap="round"/></svg>`,
            cloud: `<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M18 46H48C54.6274 46 60 40.6274 60 34C60 27.3726 54.6274 22 48 22H46.7C45.3 12.6 37.3 5.5 27.5 6.2C19.1 6.9 12.3 13.5 11.1 21.9C5.4 23.4 1.5 28.5 1.5 34.5C1.5 40.85 6.65 46 13 46H18Z" fill="#90CAF9"/></svg>`,
            partly: `<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="24" cy="24" r="10" fill="#F4B400"/><path d="M24 4V8M24 40V44M44 24H40M8 24H4M38.1 9.9L35.3 12.7M12.7 35.3L9.9 38.1M38.1 38.1L35.3 35.3M12.7 12.7L9.9 9.9" stroke="#F4B400" stroke-width="3" stroke-linecap="round"/><path d="M24 54H48C53.5 54 58 49.5 58 44C58 38.5 53.5 34 48 34H46.9C45.7 26.2 39.1 20.2 31 20.8C24 21.4 18.3 26.9 17.3 33.9C12.6 35.1 9.3 39.4 9.3 44.4C9.3 49.7 13.6 54 18.9 54H24Z" fill="#90CAF9"/></svg>`,
            rain: `<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M18 40H48C54.6274 40 60 34.6274 60 28C60 21.3726 54.6274 16 48 16H46.7C45.3 6.6 37.3 -0.5 27.5 0.2C19.1 0.9 12.3 7.5 11.1 15.9C5.4 17.4 1.5 22.5 1.5 28.5C1.5 34.85 6.65 40 13 40H18Z" fill="#78909C"/><path d="M22 46L18 58M32 46L28 58M42 46L38 58" stroke="#4FC3F7" stroke-width="3" stroke-linecap="round"/></svg>`
        };

        function getWeatherDesc(code) {
            if (code === 0) return { text: "Céu Limpo", icon: icons.sun };
            if (code >= 1 && code <= 3) return { text: "Parc. Nublado", icon: icons.partly };
            if (code >= 45 && code <= 48) return { text: "Neblina", icon: icons.cloud };
            if (code >= 51 && code <= 67) return { text: "Chuva Fraca", icon: icons.rain };
            if (code >= 80 && code <= 99) return { text: "Tempestade", icon: icons.rain };
            return { text: "Nublado", icon: icons.cloud };
        }

        function updateWeather(elementId, tempId, textId, iconId) {
            const tempEl = document.getElementById(tempId);
            const textEl = document.getElementById(textId);
            const iconEl = document.getElementById(iconId);
            if (!tempEl) return;

            fetch(url)
                .then(r => {
                    if (!r.ok) throw new Error("Erro HTTP");
                    return r.json();
                })
                .then(data => {
                    if (!data.current_weather) throw new Error("Sem dados");
                    const temp = Math.round(data.current_weather.temperature);
                    const info = getWeatherDesc(data.current_weather.weathercode);
                    tempEl.innerText = temp + "°C";
                    textEl.innerText = info.text;
                    iconEl.innerHTML = info.icon;
                })
                .catch(e => {
                    // Fail silent para não poluir console
                });
        }
        
        // Inicializa Clima
        updateWeather('tapejara-weather', 'w-temp', 'w-text', 'w-icon');
        updateWeather('tapejara-weather-mobile', 'w-temp-mobile', 'w-text-mobile', 'w-icon-mobile');
        
        // Inicializa Acessibilidade após um delay seguro para garantir que o Elementor carregou
        setTimeout(function() {
            window.A11yReactive.init();
        }, 2000); 
    });

})();
</script>				</div>
