<script>
  // -----------------------------------------------------------------
  // JAVASCRIPT (AJUSTADO): PLAYLIST DE UPLOADS + CACHE (ANTI-QUOTA)
  // -----------------------------------------------------------------

  const API_KEY = "[SEGREDO REDIGIDO]";
  const CHANNEL_ID = "UCXDptUOwJpA1srk-glFawTA";
  const MAX_RESULTS = 10;

  // CACHE (para não consumir cota a cada visita)
  const CACHE_TTL_MS = 6 * 60 * 60 * 1000; // 6 horas
  const CACHE_KEY = `yt_videos_cache_${CHANNEL_ID}_${MAX_RESULTS}`;

  // A playlist de uploads do canal é: "UU" + CHANNEL_ID sem os 2 primeiros chars ("UC")
  const UPLOADS_PLAYLIST_ID = "UU" + CHANNEL_ID.slice(2);

  function ensureFontAwesome() {
    if (!document.querySelector('link[href*="font-awesome"]')) {
      document.head.insertAdjacentHTML(
        "beforeend",
        '<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />'
      );
    }
  }

  function setLoading(html) {
    const el = document.querySelector(".loading-state-videos");
    if (el) el.innerHTML = html;
  }

  function removeLoading() {
    document.querySelector(".loading-state-videos")?.remove();
  }

  function getCachedVideos() {
    try {
      const raw = localStorage.getItem(CACHE_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw);
      if (!parsed || !parsed.ts || !Array.isArray(parsed.videos)) return null;
      if (Date.now() - parsed.ts > CACHE_TTL_MS) return null;
      return parsed.videos;
    } catch (e) {
      return null;
    }
  }

  function setCachedVideos(videos) {
    try {
      localStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), videos }));
    } catch (e) {}
  }

  async function fetchUploadsPlaylistVideos() {
    const url =
      `https://www.googleapis.com/youtube/v3/playlistItems` +
      `?part=snippet,contentDetails` +
      `&playlistId=${encodeURIComponent(UPLOADS_PLAYLIST_ID)}` +
      `&maxResults=${encodeURIComponent(MAX_RESULTS)}` +
      `&key=${encodeURIComponent(API_KEY)}`;

    const resp = await fetch(url);
    const data = await resp.json().catch(() => ({}));

    if (!resp.ok || data?.error) {
      const msg =
        data?.error?.message ||
        `YouTube API Error: Status ${resp.status} ${resp.statusText || ""}`.trim();
      const reason = data?.error?.errors?.[0]?.reason || "";
      const code = data?.error?.code || resp.status;
      throw new Error(`${code}${reason ? " (" + reason + ")" : ""}: ${msg}`);
    }

    const items = Array.isArray(data.items) ? data.items : [];
    const videos = items
      .map((item) => {
        const videoId = item?.contentDetails?.videoId;
        const title = item?.snippet?.title || "";
        const thumbs = item?.snippet?.thumbnails || {};
        const thumbnail =
          thumbs?.medium?.url ||
          thumbs?.high?.url ||
          thumbs?.default?.url ||
          "";

        if (!videoId) return null;
        return { id: videoId, title, thumbnail };
      })
      .filter(Boolean);

    return videos;
  }

  function loadMainPlayer(videoId) {
    const container = document.querySelector(".video-player-container");
    if (!container) return;

    // Remove player anterior
    container.querySelector("iframe")?.remove();

    const iframe = document.createElement("iframe");
    iframe.setAttribute("src", `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`);
    iframe.setAttribute("frameborder", "0");
    iframe.setAttribute("allowfullscreen", "");

    removeLoading();
    container.appendChild(iframe);

    // Atualiza estado ativo
    document.querySelectorAll(".thumbnail-card").forEach((card) => {
      card.classList.toggle("active", card.dataset.videoId === videoId);
    });
  }

  function renderThumbnails(videos) {
    const listContainer = document.getElementById("video-thumbnails-list");
    if (!listContainer) return;

    listContainer.innerHTML = "";

    videos.forEach((video) => {
      const card = document.createElement("div");
      card.classList.add("thumbnail-card");
      card.dataset.videoId = video.id;

      card.innerHTML = `
        <div class="thumbnail-image-container">
          <img decoding="async" src="${video.thumbnail}" alt="${video.title}">
        </div>
        <div class="thumbnail-title">${video.title}</div>
      `;

      card.addEventListener("click", () => loadMainPlayer(video.id));
      listContainer.appendChild(card);
    });
  }

  async function initVideosSection() {
    if (!API_KEY || !CHANNEL_ID) {
      setLoading('<i class="fa-solid fa-triangle-exclamation"></i> Erro: API Key ou Channel ID não configurados.');
      return;
    }

    // 1) Tenta cache primeiro
    const cached = getCachedVideos();
    if (cached && cached.length) {
      loadMainPlayer(cached[0].id);
      renderThumbnails(cached);
      return;
    }

    // 2) Busca via API (playlist de uploads) - MUITO mais barato que search
    try {
      const videos = await fetchUploadsPlaylistVideos();

      if (videos.length > 0) {
        setCachedVideos(videos);
        loadMainPlayer(videos[0].id);
        renderThumbnails(videos);
      } else {
        setLoading("Nenhum vídeo público disponível no canal no momento.");
      }
    } catch (err) {
      console.error("Erro ao carregar vídeos:", err);

      const msg = String(err?.message || err);

      if (msg.includes("quotaExceeded")) {
        setLoading(
          `<i class="fa-solid fa-triangle-exclamation"></i> Cota da API do YouTube excedida no momento.<small>Tente novamente mais tarde.</small>`
        );
        return;
      }

      if (msg.includes("API_KEY_HTTP_REFERRER_BLOCKED") || msg.includes("referer")) {
        setLoading(
          `<i class="fa-solid fa-triangle-exclamation"></i> Chave bloqueada por Referer.<small>Verifique se o domínio do site está liberado nas restrições da API Key.</small>`
        );
        return;
      }

      setLoading(
        `<i class="fa-solid fa-triangle-exclamation"></i> Erro ao carregar vídeos.<small>${msg}</small>`
      );
    }
  }

  // Inicia somente quando o DOM estiver pronto (evita falhas no WP/Elementor)
  ensureFontAwesome();
  document.addEventListener("DOMContentLoaded", initVideosSection);
</script>
