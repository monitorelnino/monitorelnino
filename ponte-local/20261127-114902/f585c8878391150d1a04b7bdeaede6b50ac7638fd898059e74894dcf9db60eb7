<style>
    /* ---------------------------------- */
    /* CSS GLOBAL - VISUAL PROTEGIDO */
    /* ---------------------------------- */
    @import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css');

    :root {
        --topbar-icon-size: 13px;
        --topbar-btn-size: 26px;
        --topbar-radius: 6px;
        --white-color: #FFFFFF;
        --accent-color: #6CC24A; 
        --dark-bg-color: #1A3B35;
        
        /* Variável Reativa de Zoom */
        --a11y-zoom: 1; 
    }

    /* FILTROS GLOBAIS COM ALTA PRIORIDADE */
    html.acc-contraste {
        filter: contrast(130%) brightness(90%) grayscale(100%) !important;
        background-color: #121212 !important;
    }
    
    html.acc-contraste body, 
    html.acc-contraste .elementor-section, 
    html.acc-contraste .elementor-column,
    html.acc-contraste footer,
    html.acc-contraste header {
        background-color: #121212 !important;
        color: #fff !important;
        background-image: none !important; /* Remove fundos de imagem que atrapalham leitura */
    }

    /* Força cor branca nos textos em alto contraste */
    html.acc-contraste * {
        color: #fff !important;
        border-color: #fff !important;
        text-shadow: none !important;
    }
    
    /* Exceção para botões do próprio header de acessibilidade para não sumirem */
    html.acc-contraste .acessibilidade-btn, 
    html.acc-contraste .social-btn {
        background-color: #333 !important;
        border: 1px solid #fff !important;
    }
    
    html.acc-cinza {
        filter: grayscale(100%) !important;
    }

    /* ESTILOS PADRÃO DO LAYOUT */
    .top-bar-wrapper {
        width: 100%;
        height: 100%;
        min-height: var(--topbar-btn-size);
        box-sizing: border-box;
        font-family: "Roboto", sans-serif;
    }

    .social-btn, .acessibilidade-btn {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        width: var(--topbar-btn-size) !important;
        height: var(--topbar-btn-size) !important;
        font-size: var(--topbar-icon-size) !important;
        border-radius: var(--topbar-radius) !important;
        background-color: var(--dark-bg-color) !important; 
        color: var(--white-color) !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important; 
        transition: all 0.2s !important;
        text-decoration: none !important;
        cursor: pointer !important;
        flex-shrink: 0 !important;
        position: relative !important;
        box-sizing: border-box !important;
        padding: 0 !important;
        margin: 0 !important;
        appearance: none;
    }
    
    .social-btn:hover, .acessibilidade-btn:hover {
        background-color: var(--accent-color) !important; 
        border-color: var(--accent-color) !important;
    }
    
    .social-btn i, .acessibilidade-btn i {
        color: var(--white-color) !important;
        pointer-events: none;
    }

    /* DESKTOP */
    .desktop-version {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 1280px !important;
        max-width: 100%;
        height: 100%;
        min-height: var(--topbar-btn-size);
        gap: 8px;
        margin: 0 auto;
    }

    .top-bar-section { display: flex; align-items: center; height: var(--topbar-btn-size); }
    .social-icons-wrapper { gap: 6px; justify-content: flex-start; }
    .weather-center-wrapper { justify-content: center; }
    .acessibilidade-wrapper { justify-content: flex-end; }
    .acessibilidade { display: flex !important; gap: 4px !important; align-items: center !important; }

    /* TOOLTIP */
    .tooltip {
        visibility: hidden;
        position: absolute;
        top: calc(100% + 8px);
        left: 50%;
        transform: translateX(-50%);
        background-color: #333 !important;
        color: #fff !important;
        border-radius: 4px;
        padding: 5px 8px !important;
        font-size: 10px !important;
        white-space: nowrap;
        z-index: 9999;
        opacity: 0;
        transition: opacity 0.2s;
        pointer-events: none;
    }
    .tooltip::after {
        content: ''; position: absolute; bottom: 100%; left: 50%;
        transform: translateX(-50%); border: 5px solid transparent; border-bottom-color: #333;
    }
    .acessibilidade-btn:hover .tooltip { visibility: visible; opacity: 1; }

    /* CLIMA */
    .weather-container { display: flex; align-items: center; gap: 8px; color: var(--white-color); line-height: 1; }
    .weather-icon-wrapper svg { width: 32px; height: 32px; }
    .weather-temp { font-size: 18px; font-weight: 700; }
    .weather-desc { font-size: 10px; font-weight: 400; opacity: 0.95; }

    /* MOBILE */
    .mobile-version {
        display: none; width: 100%; height: 34px; align-items: center; justify-content: space-between; padding: 0 5px;
    }
    .mobile-section { display: flex; align-items: center; z-index: 10; gap: 4px; }
    .mobile-weather { position: absolute; left: 50%; transform: translateX(-50%); z-index: 5; white-space: nowrap; }
    .mobile-weather .weather-icon-wrapper svg { width: 22px; height: 22px; }
    .mobile-weather .weather-temp { font-size: 13px; }
    .mobile-weather .weather-desc { font-size: 8px; }
    .mobile-version .social-btn, .mobile-version .acessibilidade-btn {
        width: 28px !important; height: 28px !important; font-size: 12px !important;
    }

    @media (min-width: 769px) {
        .desktop-version { display: flex !important; }
        .mobile-version { display: none !important; }
    }
    @media (max-width: 768px) {
        .desktop-version { display: none !important; }
        .mobile-version { display: flex !important; }
        .tooltip { display: none !important; }
    }
</style>

