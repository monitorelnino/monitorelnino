<script>
    // -----------------------------------------------------------------
    // JAVASCRIPT: LÓGICA DE API, CACHE E RENDERIZAÇÃO
    // AJUSTADO: Mapeamento de ícones sincronizado com o Header
    // -----------------------------------------------------------------

    const WEATHER_CONFIG = {
        lat: -23.7314, // Tapejara-PR
        lon: -52.8733, // Tapejara-PR
        timezone: 'America/Sao_Paulo',
        city: 'Tapejara-PR',
        // Busca a temperatura atual e a previsão de 5 dias
        url: `https://api.open-meteo.com/v1/forecast?latitude=-23.7314&longitude=-52.8733&current_weather=true&daily=weather_code,temperature_2m_max,temperature_2m_min&timezone=America%2FSao_Paulo`
    };

    /**
     * Mapeia o Weather Code (WMO) do Open-Meteo para uma classe de ícone Font Awesome.
     * Esta função está SINCRONIZADA com a lógica de descrição/ícone do header.
     * @param {number} code - O código do tempo da API.
     * @returns {string} - A classe do ícone Font Awesome.
     */
    function getWeatherIcon(code) {
        if (code === 0) return 'fa-solid fa-sun'; // Céu Limpo
        if (code >= 1 && code <= 3) return 'fa-solid fa-cloud-sun'; // Parc. Nublado
        if (code >= 45 && code <= 48) return 'fa-solid fa-smog'; // Neblina
        if (code >= 51 && code <= 67) return 'fa-solid fa-cloud-rain'; // Chuva Fraca/Moderada
        if (code >= 80 && code <= 99) return 'fa-solid fa-cloud-showers-heavy'; // Pancadas/Tempestade
        
        return 'fa-solid fa-cloud'; // Padrão / Nublado
    }

    /**
     * Retorna o nome abreviado do dia da semana (Seg, Ter, Qua...)
     * @param {string} dateString - Data no formato YYYY-MM-DD
     * @returns {string} - Nome abreviado do dia
     */
    function getDayName(dateString) {
        const date = new Date(dateString);
        // Ajuste para evitar fuso horário na meia-noite (muda para o dia seguinte para obter o nome correto)
        date.setDate(date.getDate() + 1); 

        const days = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];
        return days[date.getDay()];
    }

    /**
     * Renderiza o conteúdo da previsão do tempo.
     * @param {object} data - Dados da API.
     */
    function renderWeather(data) {
        const contentDiv = document.getElementById('weather-content');
        if (!data || !data.daily || !data.current_weather) {
            contentDiv.innerHTML = '<div class="error-state">Não foi possível carregar a previsão.</div>';
            return;
        }

        // --- 1. Seção de Hoje (Temperatura Atual) ---
        let todayHtml = `
            <div class="today-section">
                <span class="today-location">${WEATHER_CONFIG.city}</span>
                <i class="today-icon ${getWeatherIcon(data.current_weather.weather_code)}"></i>
                <span class="today-temp">+${Math.round(data.current_weather.temperature)}°C</span>
            </div>
        `;

        // --- 2. Seção de Previsão de 5 Dias (a partir de amanhã) ---
        let forecastHtml = '<div class="forecast-section">';

        // Itera sobre os próximos 5 dias (índices 1 a 5, sendo o 0 o dia atual)
        for (let i = 1; i <= 5; i++) {
            if (data.daily.time[i]) {
                const date = data.daily.time[i];
                const dayName = getDayName(date);
                const maxTemp = Math.round(data.daily.temperature_2m_max[i]);
                const minTemp = Math.round(data.daily.temperature_2m_min[i]);
                const iconClass = getWeatherIcon(data.daily.weather_code[i]); 

                forecastHtml += `
                    <div class="day-card">
                        <span class="day-name">${dayName}</span>
                        <i class="day-icon ${iconClass}"></i>
                        <span class="day-temp-max">+${maxTemp}°C</span>
                        <span class="day-temp-min">+${minTemp}°C</span>
                    </div>
                `;
            }
        }
        forecastHtml += '</div>';

        contentDiv.innerHTML = todayHtml + forecastHtml;
    }

    /**
     * Lógica principal de busca de dados com cache (simulado usando localStorage)
     */
    async function fetchWeather() {
        const contentDiv = document.getElementById('weather-content');
        const CACHE_KEY = 'weather_data_tapejara';
        const CACHE_EXPIRY = 3600000; // 1 hora em milissegundos

        try {
            // 1. Tenta carregar do cache
            const cachedData = localStorage.getItem(CACHE_KEY);
            if (cachedData) {
                const cache = JSON.parse(cachedData);
                const now = new Date().getTime();

                if (now < cache.expiry) {
                    renderWeather(cache.data);
                    return;
                }
            }
            
            // 2. Cache inválido/expirado, busca da API
            contentDiv.innerHTML = '<div class="loading-state"><i class="fa-solid fa-cloud-sun fa-spin"></i> Carregando previsão...</div>';
            
            const response = await fetch(WEATHER_CONFIG.url);
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            const data = await response.json();

            // 3. Renderiza o conteúdo
            renderWeather(data);

            // 4. Salva no cache
            const cache = {
                data: data,
                expiry: new Date().getTime() + CACHE_EXPIRY
            };
            localStorage.setItem(CACHE_KEY, JSON.stringify(cache));

        } catch (error) {
            console.error("Erro ao buscar a previsão do tempo:", error);
            contentDiv.innerHTML = '<div class="error-state"><i class="fa-solid fa-triangle-exclamation"></i> Erro ao carregar. Tente novamente mais tarde.</div>';
        }
    }

    fetchWeather();
</script>				</div>
