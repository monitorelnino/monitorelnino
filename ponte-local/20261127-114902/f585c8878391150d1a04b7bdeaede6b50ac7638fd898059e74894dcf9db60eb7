            const toggleBtn = document.getElementById('tpj-toggle-menu');
            const menuContent = document.getElementById('tpj-menu-content');
            const searchBtn = document.getElementById('tpj-toggle-search');
            const searchBox = document.getElementById('tpj-search-box');

            // Menu Toggle
            toggleBtn.addEventListener('click', function() {
                this.classList.toggle('active');
                menuContent.classList.toggle('active');
                searchBox.classList.remove('active');
                searchBtn.classList.remove('active');
            });

            // Search Toggle
            searchBtn.addEventListener('click', function() {
                this.classList.toggle('active');
                searchBox.classList.toggle('active');
                menuContent.classList.remove('active');
                toggleBtn.classList.remove('active');
            });

            // Submenus
            document.querySelectorAll('.menu-item-has-children > a').forEach(item => {
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    this.parentElement.classList.toggle('open');
                });
            });

            // Clima Forçado
            async function fetchWeather() {
                try {
                    const res = await fetch('https://api.open-meteo.com/v1/forecast?latitude=-23.73&longitude=-52.87&current_weather=true');
                    const data = await res.json();
                    if(data.current_weather) {
                        document.getElementById('weather-temp-tpj').innerText = Math.round(data.current_weather.temperature) + '°C';
                    }
                } catch (e) { document.getElementById('weather-temp-tpj').innerText = '24°C'; }
            }
            fetchWeather();
        });

        // ACESSIBILIDADE GLOBAL (Ajustado para afetar a tag HTML/Raiz)
        let zoom = 100;
        const root = document.documentElement;

        window.changeFontSizeTPJ = function(step) {
            zoom += (step * 5);
            if(zoom < 80) zoom = 80;
            if(zoom > 150) zoom = 150;
            root.style.fontSize = zoom + '%';
        };

        window.resetFontSizeTPJ = function() {
            zoom = 100;
            root.style.fontSize = '100%';
            root.classList.remove('tpj-contrast-active', 'tpj-grayscale-active');
            document.body.classList.remove('tpj-contrast-active', 'tpj-grayscale-active');
        };

        window.toggleContrastTPJ = function() { 
            root.classList.toggle('tpj-contrast-active'); 
        };

        window.toggleGrayscaleTPJ = function() { 
            root.classList.toggle('tpj-grayscale-active'); 
        };
    })();
    </script>

