    /**
     * SCRIPT DE NAVEGAÇÃO ENTRE AS ABAS
     * Este script apenas controla a troca de abas (clique nos botões).
     * Todo o conteúdo agora é HTML estático, portanto os ícones sempre aparecerão.
     */
    function showTab(tabId, clickedButton) {
        // 1. Remove a classe 'active' de todos os conteúdos
        document.querySelectorAll('.tab-content').forEach(content => {
            content.classList.remove('active');
        });

        // 2. Adiciona a classe 'active' ao conteúdo da aba clicada
        const targetContent = document.getElementById(tabId + '-content');
        if (targetContent) {
            targetContent.classList.add('active');
        }

        // 3. Remove a classe 'active' de todos os botões
        document.querySelectorAll('.tab-button').forEach(button => {
            button.classList.remove('active');
        });

        // 4. Adiciona a classe 'active' ao botão clicado
        if (clickedButton) {
            clickedButton.classList.add('active');
        }
    }

    // Garante que a primeira aba esteja visível ao carregar
    document.addEventListener('DOMContentLoaded', () => {
        const activeContent = document.querySelector('.tab-content.active');
        if (!activeContent) {
            const firstBtn = document.getElementById('tab-cidadao-btn');
            if (firstBtn) showTab('cidadao', firstBtn);
        }
    });
