<script>
function toggleContraste() {
  document.body.classList.toggle('alto-contraste');
}

let tamanhoFonte = 100; // Representa 100% do tamanho base
const incremento = 10; // Incremento de 10%

function alterarFonte(acao) {
  tamanhoFonte += acao * incremento;
  if (tamanhoFonte < 80) tamanhoFonte = 80; // Tamanho mínimo de 80%
  if (tamanhoFonte > 150) tamanhoFonte = 150; // Tamanho máximo de 150%
  document.body.style.fontSize = tamanhoFonte + '%';
}
</script>
<script>
$(document).ready(function () {
  $("#menu-container").load("logomenu.html", function () {
    // Espera o conteúdo ser carregado, depois atribui o click
    $("#btnBusca").on("click", function () {
      const termo = $("#campoBusca").val(); // pega o valor digitado no input
      if (termo.trim() !== "") {
        // Redireciona para a página de busca com o termo na URL
        window.location.href = "busca.php?q=" + encodeURIComponent(termo);
      }
    });
  });
  $("#menu-rodape").load("rodape.html");
});


function closeModal() {
  document.getElementById("modal-mensagem").style.display = "none";
};

new Vue({
  el: '#app',
  data() {
    return {
      dtDestaques: '',
      imagemDestaque: '',
      codmidia: '',
      titulo: '',
      dtMidia: '',
      dtNoticia: '',
      dataFormatada: '',
      dtArtigo: '',
      dtArtigoTeste: '',
      dtManual: '',
      dtBanner: '',
      imgCarousel: ''
    };
  },

  methods: {
    destaques() {
      axios.post("pagina002.php", {
        request_for: 'destaques'
      }).then((response) => {
        this.imagemDestaque = response.data[0].caminhoimagem;
        this.codmidia = response.data[0].codmidia;
      }).catch(error => {
        console.error("Erro ao carregar imagem de destaque: ", error);
      });
    },

    outrosDestaques() {
      axios.post("pagina002.php", {
        request_for: 'outrosDestaques'
      }).then((response) => {
        this.dtMidia = response.data;
      }).catch(error => {
        console.error("Erro ao carregar imagem de destaque: ", error);
      });
    },


    noticias() {
      axios.post("pagina002.php", {
        request_for: 'noticias'
      }).then((response) => {
        this.dtNoticia = response.data;
      }).catch(error => {
        console.error("Erro ao carregar imagem de destaque: ", error);
      });
    },

    // Frontend (Axios)
    artigos:function(){
      axios.get("https://www.saogotardo.mg.gov.br/artigos_ac.php?request_for=artigos")
      .then(response => {
        this.dtArtigo = response.data;
      });
    },

    artigos03() {
      axios.post(
        "https://www.saogotardo.mg.gov.br/pagina002.php", // URL completa
        { request_for: 'artigos' },
        {
          headers: {
            'Content-Type': 'application/json' // Força o envio como JSON
          }
        }
      )
      .then((response) => {
        console.log("Resposta:", response.data); // Debug
        this.dtArtigoTeste = response.data;
      })
      .catch(error => {
        console.error("Erro:", error.response); // Mostra detalhes do erro
      });
    },

    artigos02:function(){
      axios.post("pagina002.php", {
        request_for:'artigos'
      }).then(function(response){
        app.dtArtigo = response.data;
      });
    },

    bannerPrincipal(){
      axios.post('pagina002.php', {
        request_for: 'banner'
      }).then((response)=>{
        this.dtBanner = response.data;
        if(this.dtBanner != false){
          document.getElementById("modal-mensagem").style.display = "flex";
        }
      });
    },

    listaCarousel(){
      axios.post("pagina002.php", {
        request_for: 'carousel'
      }).then((response)=>{
        this.imgCarousel = response.data;
      });
    },

    formataData(novaData){
      const dataFormatada = moment(novaData).format('dddd, DD [de] MMMM [de] YYYY');
      return dataFormatada.charAt(0).toUpperCase() + dataFormatada.slice(1);
    }
  },

  created:function(){
    this.artigos();
  },

  mounted() {
    // this.buscaManuais();
    this.destaques();
    this.outrosDestaques();
    this.noticias();
    this.bannerPrincipal();
    this.listaCarousel();
  }
});
</script>

