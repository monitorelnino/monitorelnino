    var elements = $('p, h1, h2, h3, h4, h5, h6, a, button, input, i, svg');

    elements.each((index, item) => {
      let element = $(item);
      let font = $(element).css('font-size');

      let newFont = e == 'a' ? parseInt(font) + 1 : parseInt(font) - 1;

      element.css('font-size', newFont);
    })
