/* Estilo da sombra na parte superior da seção footer */
.footer {
    position: relative; /* Para permitir o posicionamento do pseudo-elemento */
    background-color: white; /* Cor de fundo da seção, ajuste conforme necessário */
}

/* Criar o efeito de sombra na parte superior */
.footer::before {
    content: '';
    position: absolute; /* Posiciona o pseudo-elemento em relação à seção */
    top: 0; /* Fica na parte superior da seção */
    left: 0;
    right: 0;
    height: 5px; /* Altura da sombra */
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.1), transparent); /* Gradiente para simular sombra */
    z-index: 1; /* Garante que a sombra fique acima do conteúdo */
}

