/* Start custom CSS for shortcode, class: .elementor-element-b2795e9 */.noticias-container {
  background-color: #f4f4f4;
  border-radius: 15px;
  padding: 20px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  margin-bottom: 20px;
  transform: translateZ(0);
  will-change: transform;
}

.noticias-header {
  display: flex;
  align-items: center;
  font-size: 20px;
  color: #333;
  margin-bottom: 15px;
  width: 100%;
}

.noticias-icon {
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: white;
  border-radius: 50%;
  border: 2px solid #2a6cc6;
  width: 40px;
  height: 40px;
  margin-right: 10px;
}

.noticias-icon i {
  color: #2a6cc6;
  font-size: 20px;
}

.noticias-title {
  font-weight: bold;
  color: #333;
  font-size: 20px;
}


.noticias-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  grid-template-rows: repeat(2, 1fr);
  gap: 10px;
  height: 400px;
}

.noticia-item {
  position: relative;
  overflow: hidden;
  border-radius: 10px;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
  transition: transform 0.3s ease, background-color 0.3s ease;
  text-decoration: none;
  color: inherit;
  margin-bottom: 0;
  will-change: transform;
  height: 100%;
}

.noticia-item:hover {
  transform: translateY(-5px);
  background-color: rgba(0, 0, 0, 0.1);
}

.noticia-destaque {
  grid-row: span 2;
}

.noticia-item:not(.noticia-destaque) {
  height: calc(100% + 1px);
}

.noticia-imagem {
  height: 100%;
}

.noticia-imagem img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 10px;
  image-rendering: auto;
  transform: translateZ(0);
}

.noticia-infos {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.5);
  color: white;
  padding: 10px;
  border-radius: 0 0 10px 10px;
}

.categoria-badge {
  display: inline-flex;
  align-items: center;
  font-size: 10px;
  color: #fff;
  background-color: #275A95;
  padding: 2px 6px;
  border-radius: 10px;
  margin-right: 5px;
  margin-bottom: 5px;
}

.categoria-badge i {
  margin-right: 3px;
}

.noticia-data {
  font-size: 12px;
  color: #ddd;
}

.noticia-titulo {
  font-size: 18px;
  font-weight: bold;
  color: #fff;
}

.titulo-curto {
  font-size: 16px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: normal;
}

@media (max-width: 768px) {
  .noticias-grid {
    grid-template-columns: 1fr;
    grid-template-rows: auto;
    gap: 10px;
    height: auto;
  }

  .noticia-item {
    height: auto;
  }

  .noticia-destaque {
    grid-row: auto;
  }

  .noticia-imagem img {
    height: 180px;
  }

  .noticia-infos {
    position: absolute;
    background: rgba(0, 0, 0, 0.7);
    padding: 8px;
  }

  .noticia-categoria,
  .noticia-data,
  .noticia-titulo {
    font-size: 11px;
    margin-bottom: 2px;
  }

  .noticia-categoria i {
    font-size: 9px;
  }

  .noticia-titulo {
    font-size: 14px;
  }
}/* End custom CSS */
