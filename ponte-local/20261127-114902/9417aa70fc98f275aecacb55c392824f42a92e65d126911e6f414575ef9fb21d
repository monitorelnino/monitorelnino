					<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Acessibilidade Mobile</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" integrity="sha384-eLdS1Fv3pr5yo7C63rDkNcM+/I5xjLGF8rritW0vhznS9fMAlQlH5aVrUv+/IpS" crossorigin="anonymous">
    <style>
        /* Estilo para os tooltips na versão mobile */
        .acessibilidade-mobile {
            font-size: 20px;
        }

        .acessibilidade-btn-mobile {
            position: relative;
            display: inline-block;
            cursor: pointer;
            margin-right: 5px; /* Espaçamento reduzido entre os ícones */
        }

        .acessibilidade-btn-mobile:hover .tooltip-mobile {
            visibility: visible;
            opacity: 1;
        }

        .tooltip-mobile {
            visibility: hidden;
            width: auto;
            max-width: 200px;
            background-color: black;
            color: #fff;
            text-align: center;
            border-radius: 5px;
            padding: 5px;
            position: absolute;
            z-index: 1;
            top: 125%;
            left: 50%;
            transform: translateX(-50%);
            opacity: 0;
            transition: opacity 0.3s;
            font-size: 14px; /* Tamanho do texto do tooltip */
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .tooltip-mobile::after {
            content: '';
            position: absolute;
            bottom: 100%;
            left: 50%;
            margin-left: -5px;
            border-width: 5px;
            border-style: solid;
            border-color: black transparent transparent transparent;
        }

        /* Cor e tamanho dos ícones na versão mobile */
        .acessibilidade-btn-mobile i {
            color: #006088;
            font-size: 16px; /* Tamanho menor para ícones */
        }

        /* Contraste para mobile */
        .contraste-mobile {
            filter: invert(100%);
        }

        /* Escala de cinza para mobile */
        .escala-de-cinza-mobile {
            filter: grayscale(100%);
        }
    </style>
</head>
<body>
    <div class="acessibilidade-mobile">
        <a href="/ajuda" class="acessibilidade-btn-mobile" title="Acessibilidade">
            <i class="fas fa-wheelchair"></i>
            <span class="tooltip-mobile">Acessibilidade</span>
        </a>
        <a class="acessibilidade-btn-mobile" title="Aumentar Texto" onclick="aumentarTextoMobile()">
            <i class="fas fa-plus"></i>
            <span class="tooltip-mobile">Aumentar Texto</span>
        </a>
        <a class="acessibilidade-btn-mobile" title="Redefinir Texto" href="#" onclick="redefinirTextoMobile()">
            <i class="fas fa-undo"></i>
            <span class="tooltip-mobile">Redefinir Texto</span>
        </a>
        <a class="acessibilidade-btn-mobile" title="Diminuir Fonte" onclick="diminuirTextoMobile()">
            <i class="fas fa-minus"></i>
            <span class="tooltip-mobile">Diminuir Texto</span>
        </a>
        <a class="acessibilidade-btn-mobile" title="Contraste" onclick="alterarContrasteMobile()">
            <i class="fas fa-adjust"></i>
            <span class="tooltip-mobile">Alterar Contraste</span>
        </a>
        <a class="acessibilidade-btn-mobile" title="Escala de Cinza" onclick="alterarEscalaDeCinzaMobile()">
            <i class="fas fa-eye-slash"></i>
            <span class="tooltip-mobile">Escala de Cinza</span>
        </a>
    </div>

    <script>
        function aumentarTextoMobile() {
            var elementos = document.querySelectorAll('body, body *');
            elementos.forEach(function(elemento) {
                var estilo = window.getComputedStyle(elemento, null).getPropertyValue('font-size');
                var tamanhoFonte = parseFloat(estilo);
                elemento.style.fontSize = (tamanhoFonte + 2) + 'px';
            });
        }

        function diminuirTextoMobile() {
            var elementos = document.querySelectorAll('body, body *');
            elementos.forEach(function(elemento) {
                var estilo = window.getComputedStyle(elemento, null).getPropertyValue('font-size');
                var tamanhoFonte = parseFloat(estilo);
                elemento.style.fontSize = (tamanhoFonte - 2) + 'px';
            });
        }

        function redefinirTextoMobile() {
            var elementos = document.querySelectorAll('body, body *');
            elementos.forEach(function(elemento) {
                elemento.style.fontSize = '';
            });
        }

        function alterarContrasteMobile() {
            var corpo = document.querySelector('body');
            corpo.classList.toggle('contraste-mobile');
        }

        function alterarEscalaDeCinzaMobile() {
            var corpo = document.querySelector('body');
            corpo.classList.toggle('escala-de-cinza-mobile');
        }
    </script>
</body>
</html>
