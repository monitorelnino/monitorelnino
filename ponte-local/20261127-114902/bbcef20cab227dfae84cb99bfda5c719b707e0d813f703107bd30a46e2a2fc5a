<script>
    const listaMenu = document.querySelectorAll('.lista-menu')
    const buttonsMenu = document.querySelectorAll('[data-servicos="menus"] li button')

    buttonsMenu[0].classList.add('ativo')
    listaMenu[0].classList.add('ativo')

    const ativarMenu = (btn, index) => {
        buttonsMenu.forEach(item => item.classList.remove('ativo'))
        listaMenu.forEach(item => item.classList.remove('ativo'))
        listaMenu[index].classList.add('ativo')
        btn.classList.add('ativo')
    }

    buttonsMenu.forEach((item, index) => {
        item.addEventListener('click', () => {
            ativarMenu(item, index)
        })
    })

</script>

    





    

