    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 42px;
    padding: 10px 24px;
    background: #0c7b93;
    color: #fff !important;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    text-decoration: none !important;
    box-shadow: 0 3px 8px rgba(12, 123, 147, 0.18);
    transition:
        background-color 0.25s ease,
        transform 0.25s ease,
        box-shadow 0.25s ease;
}

.noticias-mais::after {
    content: "\f105";
    font-family: FontAwesome;
    font-size: 17px;
    transition: transform 0.25s ease;
}

.noticias-mais:hover {
    background: #095d70;
