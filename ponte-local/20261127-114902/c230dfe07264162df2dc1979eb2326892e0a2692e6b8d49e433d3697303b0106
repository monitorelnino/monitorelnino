.noticias-container {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: "Roboto", Arial, sans-serif;
}

.noticias-container * {
    box-sizing: border-box;
}

#noticias-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    width: 100%;
}

.noticias-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.04);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
    transition:
        transform 0.25s ease,
        box-shadow 0.25s ease;
}

.noticias-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.13);
}

.noticias-link {
    display: flex;
    flex-direction: column;
    flex: 1;
    color: inherit !important;
    text-decoration: none !important;
}

.noticias-link:hover,
.noticias-link:focus {
    color: inherit !important;
    text-decoration: none !important;
}

.noticias-imagem {
    position: relative;
    width: 100%;
    height: 205px;
    background-size: cover;
    background-position: center;
    background-color: #f2f2f2;
    overflow: hidden;
}

.noticias-imagem::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to bottom,
        transparent 60%,
        rgba(0, 0, 0, 0.12) 100%
    );
    pointer-events: none;
}

.noticias-data {
    position: absolute;
    left: 12px;
    bottom: 12px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.96);
    color: #333;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    padding: 7px 10px;
    border-radius: 6px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.14);
}

.noticias-conteudo {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 18px 18px 16px;
}

.noticias-titulo {
    margin: 0;
    color: #222;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.45;
    flex-grow: 1;
}

.noticias-leia-mais {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 6px;
    margin-top: 16px;
    color: #0c7b93;
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
    transition:
        color 0.2s ease,
        gap 0.2s ease;
}

.noticias-leia-mais::after {
    content: "\f105";
    font-family: FontAwesome;
    font-size: 16px;
}

.noticias-card:hover .noticias-leia-mais {
    color: #095d70;
