<script>
function noticiasPadTo2Digits(num) {
    return num.toString().padStart(2, "0");
}

function noticiasFormatDate(date) {
    return [
        noticiasPadTo2Digits(date.getDate()),
        noticiasPadTo2Digits(date.getMonth() + 1),
        date.getFullYear()
    ].join("/");
}

function carregarNoticias() {
    jQuery.get(
        "https://tresrios.rj.gov.br/?rest_route=/wp/v2/posts&_embed&tags=27&per_page=4",
        function(data) {
            var htmlDoc = "";

            for (let i = 0; i < data.length; i++) {
                try {
                    var titulo = data[i].title.rendered;

                    if (titulo.length > 110) {
                        titulo = titulo.substring(0, 110) + "...";
                    }

                    var imagem = "";

                    try {
                        const media = data[i]._embedded?.["wp:featuredmedia"]?.[0];

                        if (media && media.source_url) {
                            imagem = media.source_url;
                        }
                    } catch (e) {
                        console.log("Erro ao carregar imagem:", e);
                    }

                    var dataNews = new Date(data[i].date);
                    var link = data[i].link;

                    var estiloImagem = imagem
                        ? "background-image:url('" + imagem + "')"
                        : "";

                    htmlDoc +=
                        '<article class="noticias-card">' +
                            '<a class="noticias-link" href="' + link + '">' +

                                '<div class="noticias-imagem" style="' + estiloImagem + '">' +
                                    '<div class="noticias-data">' +
                                        noticiasFormatDate(dataNews) +
                                    '</div>' +
                                '</div>' +

                                '<div class="noticias-conteudo">' +
                                    '<h3 class="noticias-titulo">' +
                                        titulo +
                                    '</h3>' +

                                    '<span class="noticias-leia-mais">' +
                                        'Leia mais' +
                                    '</span>' +
                                '</div>' +

                            '</a>' +
                        '</article>';

                } catch (e) {
                    console.error("Erro ao montar notícia:", e);
                }
            }

            jQuery("#noticias-grid").html(htmlDoc);
        }
    ).fail(function(error) {
        console.error("Erro ao carregar notícias:", error);
    });
}

jQuery(document).ready(function() {
    carregarNoticias();
});
