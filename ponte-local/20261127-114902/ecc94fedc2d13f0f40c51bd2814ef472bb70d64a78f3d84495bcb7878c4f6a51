<script>

let escalaAtual = 1;

/* AUMENTAR */
function aumentarFonte(){

    escalaAtual += 0.1;

    aplicarEscala();
}

/* DIMINUIR */
function diminuirFonte(){

    escalaAtual -= 0.1;

    if(escalaAtual < 0.7){

        escalaAtual = 0.7;
    }

    aplicarEscala();
}

/* ESCALA */
function aplicarEscala(){

    document.querySelectorAll("body *").forEach(function(el){

        if(el.closest('.acessibilidade-bar')) return;

        if(!el.dataset.tamanhoOriginal){

            el.dataset.tamanhoOriginal =
            window.getComputedStyle(el).fontSize;
        }

        let original =
        parseFloat(el.dataset.tamanhoOriginal);

        el.style.fontSize =
        (original * escalaAtual) + "px";
    });
}

/* CONTRASTE */
function contraste(){

    document.body.classList.toggle(
        "alto-contraste"
    );
}

/* CINZA */
function cinza(){

    document.body.classList.toggle(
        "escala-cinza"
    );
}

/* RESET */
function resetarTudo(){

    escalaAtual = 1;

    document.querySelectorAll("body *").forEach(function(el){

        if(el.closest('.acessibilidade-bar')) return;

        if(el.dataset.tamanhoOriginal){

            el.style.fontSize =
            el.dataset.tamanhoOriginal;
        }
    });

    document.body.classList.remove(
        "alto-contraste",
        "escala-cinza"
    );
}

/* RELÓGIO */
function atualizarRelogio(){

    const agora = new Date();

    document.getElementById(
        "relogio"
    ).innerHTML =
    agora.toLocaleTimeString(
        'pt-BR'
    );

    document.getElementById(
        "calendario"
    ).innerHTML =
    agora.toLocaleDateString(
        'pt-BR'
    );
}

setInterval(
    atualizarRelogio,
    1000
);

atualizarRelogio();

</script>				</div>
