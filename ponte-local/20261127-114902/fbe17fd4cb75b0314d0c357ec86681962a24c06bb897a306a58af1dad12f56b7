            })
            .catch(error => {
                console.error('Error fetching YouTube URL:', error);
                return null;
            });
        if (!youtubeUrl) {
            document.getElementById('camera-livestream-section').style.display = 'none';
            return;
        }

        // Extract video ID from various YouTube URL formats
        var videoId = '';
        
        if (youtubeUrl.includes('youtube.com/embed/')) {
            videoId = youtubeUrl.split('youtube.com/embed/')[1].split('?')[0];
        } else if (youtubeUrl.includes('youtube.com/live/')) {
            videoId = youtubeUrl.split('youtube.com/live/')[1].split('?')[0];
        } else if (youtubeUrl.includes('youtube.com/watch?v=')) {
            videoId = youtubeUrl.split('v=')[1].split('&')[0];
        } else if (youtubeUrl.includes('youtu.be/')) {
            videoId = youtubeUrl.split('youtu.be/')[1].split('?')[0];
        }

        console.log('Fetched YouTube URL:', youtubeUrl);
        console.log('Extracted video ID:', videoId);

        if (videoId) {
            var iframeUrl = 'https://www.youtube.com/embed/' + videoId + '?autoplay=0&rel=0';
            document.getElementById('youtube-livestream-iframe').src = iframeUrl;
            document.getElementById('camera-livestream-section').style.display = 'block';
        } else {
            document.getElementById('camera-livestream-section').style.display = 'none';
        }
    // } else {
