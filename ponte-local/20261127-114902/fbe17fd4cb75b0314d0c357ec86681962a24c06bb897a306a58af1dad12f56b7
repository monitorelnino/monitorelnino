        const scrapUrl = 'https://balneariopinhal.rs.gov.br/video/id/10/?live-da-camera-1.html';
        var youtubeUrl = await fetch(scrapUrl)
            .then(response => response.text())
            .then(html => {
                var parser = new DOMParser();
                var doc = parser.parseFromString(html, 'text/html');
                var iframe = doc.querySelector('#conteudo .embed-responsive > iframe');
