    <script>
        let searchDebounceTimer = null;
        let activeDirectMatchUrl = null;

        function onSearchInput(query) {
            clearTimeout(searchDebounceTimer);
            const q = query.trim();
            if (q.length < 2) {
                fecharSearchDropdown();
                activeDirectMatchUrl = null;
                return;
            }

            searchDebounceTimer = setTimeout(() => {
                buscarSugestoesApi(q);
            }, 180);
        }

        async function buscarSugestoesApi(query) {
            try {
                const res = await fetch('/api/busca/sugestoes?q=' + encodeURIComponent(query));
                const data = await res.json();
                if (data.sucesso && data.itens && data.itens.length > 0) {
                    renderizarSearchDropdown(query, data);
                } else {
                    renderizarSearchDropdownVazio(query);
                }
            } catch (err) {
                console.error('Erro na busca:', err);
            }
        }

        function renderizarSearchDropdown(query, data) {
            const dropdown = document.getElementById('portalSearchDropdown');
            activeDirectMatchUrl = data.matchDireto ? data.matchDireto.url : (data.itens.length > 0 && data.itens[0].isDirectMatch ? data.itens[0].url : null);

            let html = '';

            // Se houver Match Direto de Serviço / Link
            if (data.matchDireto) {
                const m = data.matchDireto;
                html += `
                    <div class="ap-search-group-header" style="background: #f0fdf4; color: #166534;">
                        <i class="bi bi-lightning-charge-fill" style="color: #16a34a;"></i> ACESSO DIRETO RECOMENDADO
                    </div>
                    <a href="${m.url}" ${m.abrirNovaAba ? 'target="_blank" rel="noopener noreferrer"' : ''} class="ap-search-item direct-match">
                        <div class="ap-search-item-icon" style="background: ${m.corFundoIcone || '#dcfce7'}; color: ${m.corIcone || '#16a34a'};">
                            <i class="bi ${m.icone || 'bi-link-45deg'}"></i>
                        </div>
                        <div class="ap-search-item-body">
                            <div class="ap-search-item-title">
                                <span>${m.titulo}</span>
                                <span class="ap-search-item-badge">Link Direto</span>
                            </div>
                            <div class="ap-search-item-desc">${m.descricao || 'Acesse o sistema diretamente'}</div>
                        </div>
                        <i class="bi bi-arrow-right-circle-fill" style="color: #16a34a; font-size: 18px;"></i>
                    </a>
                `;
            }

            // Agrupamento por Categoria
            const servicos = data.itens.filter(i => (i.tipo === 'servico' || i.tipo === 'link') && (!data.matchDireto || i.url !== data.matchDireto.url));
            const paginas = data.itens.filter(i => i.tipo === 'pagina');
            const noticias = data.itens.filter(i => i.tipo === 'noticia' || i.tipo === 'evento');

            if (servicos.length > 0) {
                html += `<div class="ap-search-group-header"><i class="bi bi-grid-fill"></i> SERVIÇOS & LINKS ÚTEIS</div>`;
                servicos.forEach(item => {
                    html += `
                        <a href="${item.url}" ${item.abrirNovaAba ? 'target="_blank" rel="noopener noreferrer"' : ''} class="ap-search-item">
                            <div class="ap-search-item-icon" style="background: ${item.corFundoIcone || '#e0f2fe'}; color: ${item.corIcone || '#0284c7'};">
                                <i class="bi ${item.icone || 'bi-file-text'}"></i>
                            </div>
                            <div class="ap-search-item-body">
                                <div class="ap-search-item-title">${item.titulo}</div>
                                <div class="ap-search-item-desc">${item.descricao}</div>
                            </div>
                            <i class="bi bi-chevron-right" style="color: #94a3b8; font-size: 12px;"></i>
                        </a>
                    `;
                });
            }

            if (paginas.length > 0) {
                html += `<div class="ap-search-group-header"><i class="bi bi-building"></i> PÁGINAS & SECRETARIAS</div>`;
                paginas.forEach(item => {
                    html += `
                        <a href="${item.url}" class="ap-search-item">
                            <div class="ap-search-item-icon" style="background: #ede9fe; color: #7c3aed;">
                                <i class="bi ${item.icone || 'bi-file-earmark-text'}"></i>
                            </div>
                            <div class="ap-search-item-body">
                                <div class="ap-search-item-title">${item.titulo}</div>
                                <div class="ap-search-item-desc">${item.categoria || item.descricao}</div>
                            </div>
                            <i class="bi bi-chevron-right" style="color: #94a3b8; font-size: 12px;"></i>
                        </a>
                    `;
                });
            }

            if (noticias.length > 0) {
                html += `<div class="ap-search-group-header"><i class="bi bi-newspaper"></i> NOTÍCIAS & EVENTOS</div>`;
                noticias.forEach(item => {
                    html += `
                        <a href="${item.url}" class="ap-search-item">
                            <div class="ap-search-item-icon" style="background: #fef3c7; color: #d97706;">
                                <i class="bi ${item.icone || 'bi-newspaper'}"></i>
                            </div>
                            <div class="ap-search-item-body">
                                <div class="ap-search-item-title">${item.titulo}</div>
                                <div class="ap-search-item-desc">${item.descricao}</div>
                            </div>
                            <i class="bi bi-chevron-right" style="color: #94a3b8; font-size: 12px;"></i>
                        </a>
                    `;
                });
            }

            html += `
                <a href="/busca?q=${encodeURIComponent(query)}" class="ap-search-dropdown-footer">
                    Ver todos os resultados para "<strong>${query}</strong>" <i class="bi bi-arrow-right"></i>
                </a>
            `;

            dropdown.innerHTML = html;
            dropdown.style.display = 'block';
        }

        function renderizarSearchDropdownVazio(query) {
            const dropdown = document.getElementById('portalSearchDropdown');
            activeDirectMatchUrl = null;
            dropdown.innerHTML = `
                <div style="padding: 20px; text-align: center; color: #64748b; font-size: 13px;">
                    <i class="bi bi-search" style="font-size: 24px; display: block; margin-bottom: 6px; color: #94a3b8;"></i>
                    Nenhum serviço direto encontrado para "<strong>${query}</strong>".
                </div>
                <a href="/busca?q=${encodeURIComponent(query)}" class="ap-search-dropdown-footer">
                    Pesquisar no portal completo <i class="bi bi-arrow-right"></i>
                </a>
            `;
            dropdown.style.display = 'block';
        }

        function fecharSearchDropdown() {
            const dropdown = document.getElementById('portalSearchDropdown');
            if (dropdown) dropdown.style.display = 'none';
        }

        function onSearchFocus() {
            const val = document.getElementById('portalSearchInput').value.trim();
            if (val.length >= 2) {
                onSearchInput(val);
            }
        }

        function onSearchKeyDown(event) {
            if (event.key === 'Enter') {
                event.preventDefault();
                executarBuscaPrincipal();
            } else if (event.key === 'Escape') {
                fecharSearchDropdown();
            }
        }

        function handleTopSearchSubmit(e) {
            const query = document.getElementById('portalSearchInput').value.trim();
            if (!query) {
                if (e) e.preventDefault();
                return false;
            }

            // Se houver um Match Direto de alta prioridade (ex: "nfs", "iptu", "cnd")
            if (activeDirectMatchUrl) {
                if (e) e.preventDefault();
                if (activeDirectMatchUrl.startsWith('http')) {
                    window.open(activeDirectMatchUrl, '_blank', 'noopener,noreferrer');
                } else {
                    window.location.href = activeDirectMatchUrl;
                }
                fecharSearchDropdown();
                return false;
            }

            // Submete normalmente via GET para /Busca?q={query}
            return true;
        }

        function executarBuscaPrincipal() {
            handleTopSearchSubmit(null);
            const query = document.getElementById('portalSearchInput').value.trim();
            if (query && !activeDirectMatchUrl) {
                window.location.href = '/Busca?q=' + encodeURIComponent(query);
            }
        }

        // Fechar dropdown ao clicar fora
        document.addEventListener('click', function(e) {
            const wrapper = document.getElementById('portalSearchWrapper');
            if (wrapper && !wrapper.contains(e.target)) {
                fecharSearchDropdown();
            }
        });

        function toggleMenuMobile() {
            const collapse = document.getElementById('apNavCollapse');
            const btn = document.getElementById('apMobileToggleBtn');
            const icon = document.getElementById('apMobileToggleIcon');
            if (!collapse || !btn) return;
            const isOpen = collapse.classList.toggle('show');
            btn.setAttribute('aria-expanded', isOpen);
            if (isOpen) {
                icon.className = 'bi bi-x-lg';
                btn.classList.add('active');
            } else {
                icon.className = 'bi bi-list';
                btn.classList.remove('active');
                document.querySelectorAll('.ap-menu-item.open').forEach(el => el.classList.remove('open'));
            }
        }

        function toggleSubmenuMobile(el) {
            if (window.innerWidth <= 900) {
                const parent = el.closest('.ap-menu-item');
                if (parent) {
                    const wasOpen = parent.classList.contains('open');
                    document.querySelectorAll('.ap-menu-item.open').forEach(item => {
                        if (item !== parent) item.classList.remove('open');
                    });
                    parent.classList.toggle('open', !wasOpen);
                }
            }
        }

        // 🚀 Navegação Acessível de Teclado no Menu Principal (Espaço, Enter, Setas, Esc)
        function handleMenuKeyDown(e, el) {
            const parent = el.closest('.ap-menu-item');
            if (!parent) return;
            const dropdown = parent.querySelector('.ap-dropdown-menu');
            if (!dropdown) return;

            if (e.key === ' ' || e.key === 'Spacebar' || e.key === 'Enter' || e.key === 'ArrowDown') {
                e.preventDefault();
                // Fechar outros menus abertos por teclado
                document.querySelectorAll('.ap-menu-item.ap-keyboard-open').forEach(item => {
                    if (item !== parent) {
                        item.classList.remove('ap-keyboard-open');
                        const link = item.querySelector('.ap-menu-link');
                        if (link) link.setAttribute('aria-expanded', 'false');
                    }
                });
                parent.classList.add('ap-keyboard-open');
                el.setAttribute('aria-expanded', 'true');
                const firstSubItem = dropdown.querySelector('a');
                if (firstSubItem) {
                    setTimeout(() => firstSubItem.focus(), 50);
                }
            } else if (e.key === 'Escape') {
                e.preventDefault();
                parent.classList.remove('ap-keyboard-open');
                el.setAttribute('aria-expanded', 'false');
            }
        }

        function handleSubmenuItemKeyDown(e, el) {
            const dropdown = el.closest('.ap-dropdown-menu');
            const parent = el.closest('.ap-menu-item');
            if (!dropdown || !parent) return;

            const items = Array.from(dropdown.querySelectorAll('a'));
            const index = items.indexOf(el);

            if (e.key === 'Escape') {
                e.preventDefault();
                parent.classList.remove('ap-keyboard-open');
                const parentLink = parent.querySelector('.ap-menu-link');
                if (parentLink) {
                    parentLink.setAttribute('aria-expanded', 'false');
                    parentLink.focus();
                }
            } else if (e.key === 'ArrowDown') {
                e.preventDefault();
                const next = items[index + 1] || items[0];
                if (next) next.focus();
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                if (index > 0) {
                    items[index - 1].focus();
                } else {
                    const parentLink = parent.querySelector('.ap-menu-link');
                    if (parentLink) parentLink.focus();
                }
            }
        }

        // Fechar menus abertos por teclado ao clicar fora
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.ap-menu-item')) {
                document.querySelectorAll('.ap-menu-item.ap-keyboard-open').forEach(item => {
                    item.classList.remove('ap-keyboard-open');
                    const link = item.querySelector('.ap-menu-link');
                    if (link) link.setAttribute('aria-expanded', 'false');
                });
            }
        });

        // 🚀 Atalho de Teclado Global: Ctrl + K, Cmd + K ou '/' para focar na busca
        document.addEventListener('keydown', function (e) {
            const isCtrlK = (e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K');
            const isSlash = e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA';

            if (isCtrlK || isSlash) {
                e.preventDefault();
                const input = document.getElementById('portalSearchInput');
                if (input) {
                    input.focus();
                    input.select();
                    if (typeof onSearchFocus === 'function') {
                        onSearchFocus();
                    }
                    input.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }
        });

        // 🚀 Scroll Listener para Botão Voltar ao Topo
        window.addEventListener('scroll', function () {
            const btn = document.getElementById('apBackToTopBtn');
            if (btn) {
                if (window.pageYOffset > 280) {
                    btn.classList.add('show');
                } else {
                    btn.classList.remove('show');
                }
            }
        }, { passive: true });

        // 🚜 Toast de Celebração do Jerico / Orgulho Municipal
        let delightTimeout;
        function showJericoDelight(msg) {
            const toast = document.getElementById('apDelightToast');
            const textEl = document.getElementById('apDelightToastText');
            if (!toast || !textEl) return;
            textEl.textContent = msg || '🚜 Orgulho de Alto Paraíso - RO!';
            toast.classList.add('show');
            clearTimeout(delightTimeout);
            delightTimeout = setTimeout(() => {
                toast.classList.remove('show');
            }, 3500);
        }
    </script>

