        let isPaused = false;
        let pausedElapsed = 0;
        let sliderAnimFrame = null;

        function updateProgressBar(progressPercent) {
            const bar = document.getElementById('valSliderProgressBar');
            if (bar) {
                bar.style.width = Math.min(100, Math.max(0, progressPercent)) + '%';
            }
        }

        function showValSlide(index, resetTimer = true) {
            if (totalValSlides <= 0) return;
            
            // Garante índice circular
            currentValSlide = (index % totalValSlides + totalValSlides) % totalValSlides;

            for (let i = 0; i < totalValSlides; i++) {
                const s = document.getElementById('valSlide' + i);
                if (s) s.classList.remove('active');
            }
            const dots = document.querySelectorAll('.val-slider-dot');
            dots.forEach(d => d.classList.remove('active'));

            const targetSlide = document.getElementById('valSlide' + currentValSlide);
            if (targetSlide) targetSlide.classList.add('active');
            if (dots[currentValSlide]) dots[currentValSlide].classList.add('active');

            if (resetTimer) {
                slideStartTime = Date.now();
                pausedElapsed = 0;
                updateProgressBar(0);
            }
        }

        function nextValSlide(isManual = false) {
            showValSlide(currentValSlide + 1, true);
        }

        function prevValSlide(isManual = false) {
            showValSlide(currentValSlide - 1, true);
        }

        function goToValSlide(index) {
            showValSlide(index, true);
        }

        function pauseValSlider() {
            if (isPaused) return;
            isPaused = true;
            pausedElapsed = Date.now() - slideStartTime;
        }

        function resumeValSlider() {
            if (!isPaused) return;
            isPaused = false;
            slideStartTime = Date.now() - pausedElapsed;
        }

        function sliderTimerLoop() {
            if (totalValSlides > 1) {
                if (!isPaused) {
                    const elapsed = Date.now() - slideStartTime;
                    const progress = (elapsed / SLIDE_DURATION) * 100;
                    updateProgressBar(progress);

                    if (elapsed >= SLIDE_DURATION) {
                        nextValSlide(false);
                    }
                }
                sliderAnimFrame = requestAnimationFrame(sliderTimerLoop);
            }
        }

        // Inicialização dos Eventos do Slider (Hover Freeze, Gestos de Touch e Teclado)
        document.addEventListener('DOMContentLoaded', function() {
            const sliderEl = document.getElementById('valHeroSlider');
            if (sliderEl && totalValSlides > 1) {
                // Congela no mouse hover e retoma ao sair
                sliderEl.addEventListener('mouseenter', pauseValSlider);
                sliderEl.addEventListener('mouseleave', resumeValSlider);

                // Suporte a toque no Mobile (Pausa no toque e permite gestos swipe)
                let touchStartX = 0;
                let touchEndX = 0;

                sliderEl.addEventListener('touchstart', function(e) {
                    pauseValSlider();
                    touchStartX = e.changedTouches[0].screenX;
                }, { passive: true });

                sliderEl.addEventListener('touchend', function(e) {
                    touchEndX = e.changedTouches[0].screenX;
                    const diff = touchEndX - touchStartX;
                    if (Math.abs(diff) > 45) {
                        if (diff < 0) {
                            nextValSlide(true); // Swipe para a esquerda -> Próximo
                        } else {
                            prevValSlide(true); // Swipe para a direita -> Anterior
                        }
                    }
                    resumeValSlider();
                }, { passive: true });

                // Inicia loop da barra de progresso
                slideStartTime = Date.now();
                sliderAnimFrame = requestAnimationFrame(sliderTimerLoop);
            }
        });

        // Controle das Abas por Público-Alvo
        function switchValTab(tabId) {
            const container = (window.event && window.event.currentTarget) ? window.event.currentTarget.closest('.val-tabs-container') : document.querySelector('.val-tabs-container');
            if (!container) return;
            const btns = container.querySelectorAll('.val-tab-btn');
            btns.forEach(b => b.classList.remove('active'));

            const contents = container.querySelectorAll('.val-tab-content');
            contents.forEach(c => c.classList.remove('active'));

            if (window.event && window.event.currentTarget) {
                window.event.currentTarget.classList.add('active');
                if (typeof window.event.currentTarget.blur === 'function') {
                    window.event.currentTarget.blur();
                }
            }
            const targetContent = container.querySelector('#valTab-' + tabId);
            if (targetContent) targetContent.classList.add('active');
        }
    </script>

