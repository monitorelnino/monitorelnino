        $(document).ready(function() {
            let hideTimeout;

            function showDropdown(element) {
                clearTimeout(hideTimeout);
                const elementoPai = element.parent();
                const divMenu = $(elementoPai.children()[1]);

                $('.nav-link').each(function() {
                    const ep = $(this).parent();
                    const dm = $(ep.children()[1]);
                    ep.removeClass('show');
                    dm.removeClass('show');
                });

                elementoPai.addClass('show');
                divMenu.addClass('show');
            }

            function hideDropdown() {
                hideTimeout = setTimeout(function() {
                    $('.nav-link').each(function() {
                        const ep = $(this).parent();
                        const dm = $(ep.children()[1]);
                        ep.removeClass('show');
                        dm.removeClass('show');
                    });
                }, 300);
            }

            // Aqui usamos pointerenter e pointerleave
            $('.nav-link').on('mouseenter', function() {
                showDropdown($(this));
            });

            $('.nav-link, .dropdown-menu').on('mouseleave', function() {
                hideDropdown();
            });

            $('.dropdown-menu').on('mouseenter', function() {
                clearTimeout(hideTimeout);
            });

            $(document).on('click', function(event) {
                const target = $(event.target);
                if (!target.closest('.nav-link').length && !target.closest('.dropdown-menu').length) {
                    hideDropdown();
                }
            });
        });
    </script>
