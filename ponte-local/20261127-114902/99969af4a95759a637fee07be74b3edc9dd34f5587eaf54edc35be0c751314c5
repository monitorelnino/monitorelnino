    grid-template-columns: minmax(0, 1fr) 44px minmax(0, max-content) 44px minmax(0, 1fr);
    reading-flow: source-order;
}

body.home .lmb-carrossel .hero-track-wrap > .lm-hero-track {
    grid-area: 1 / 1 / 2 / -1;
    min-width: 0;
}

body.home .lmb-carrossel .hero-track-wrap > .hero-prev { grid-area: 1 / 2; reading-order: 1; }
body.home .lmb-carrossel .hero-track-wrap > .hero-dots { grid-area: 1 / 3; reading-order: 2; }
body.home .lmb-carrossel .hero-track-wrap > .hero-next { grid-area: 1 / 4; reading-order: 3; }

body.home .lmb-carrossel .hero-track-wrap > :is(.hero-arrow, .hero-dots) {
    position: relative;
    inset: auto !important;
    align-self: end;
    z-index: 6;
}

body.home .lmb-carrossel .hero-track-wrap > .hero-dots {
    min-width: 0;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0;
    pointer-events: none;
    reading-flow: flex-visual;
}

body.home .lmb-carrossel .hero-track-wrap :is(.hero-arrow, .hero-dot) {
    flex: 0 0 44px;
    width: 44px !important;
    height: 44px !important;
    padding: 0;
    border: 0;
    border-radius: var(--lm-raio-pequeno, 8px);
    background: transparent;
    box-shadow: none;
    cursor: pointer;
    pointer-events: auto;
}

body.home .lmb-carrossel .hero-track-wrap > .hero-arrow {
    display: flex !important;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: var(--wp--preset--spacing--esp-1);
    transform: none;
    color: var(--lm-ouro);
    font-size: 20px;
    line-height: 1;
    text-shadow: 0 0 2px var(--lm-tinta);
}

@supports (clip-path: polygon(0 0, 100% 0, 100% 100%)) {
    body.home .lmb-carrossel .hero-track-wrap > .hero-arrow { font-size: 0; }

    body.home .lmb-carrossel .hero-track-wrap .hero-arrow::before,
    body.home .lmb-carrossel .hero-track-wrap .hero-arrow::after {
        content: "";
        position: absolute;
        right: 12px;
        bottom: var(--wp--preset--spacing--esp-1);
        width: 20px;
        height: 20px;
    }

    body.home .lmb-carrossel .hero-track-wrap .hero-arrow::before {
        background: var(--lm-tinta);
        clip-path: polygon(3px 3px, 6px 0, 16px 9px, 16px 11px, 6px 20px, 3px 17px, 10px 10px);
    }

    body.home .lmb-carrossel .hero-track-wrap .hero-arrow::after {
        background: var(--lm-ouro);
        clip-path: polygon(5px 3px, 6px 2px, 14px 9px, 14px 11px, 6px 18px, 5px 17px, 12px 10px);
    }

    body.home .lmb-carrossel .hero-track-wrap .hero-prev::before,
    body.home .lmb-carrossel .hero-track-wrap .hero-prev::after {
        transform: scaleX(-1);
    }
}

body.home .lmb-carrossel .hero-track-wrap .hero-dot::after {
    box-sizing: border-box;
    left: 50%;
    bottom: 11px;
    width: 6px;
    height: 6px;
    transform: translateX(-50%);
    border: 1px solid var(--lm-tinta);
    border-radius: var(--lm-raio-pilula, 999px);
    background: var(--lm-branco);
    outline: none;
}

body.home .lmb-carrossel .hero-track-wrap .hero-dot.is-current::after {
    width: 14px;
    background: var(--lm-ouro);
}

@media (hover: hover) {
    body.home .lmb-carrossel .hero-track-wrap :is(.hero-arrow, .hero-dot):hover::after { filter: brightness(.88); }
}

body.home .lmb-carrossel .hero-track-wrap :is(.hero-arrow, .hero-dot):active::after { filter: brightness(.76); }

body.home .lmb-carrossel .hero-track-wrap :is(.hero-arrow, .hero-dot):focus-visible {
    outline: 2px solid var(--lm-branco);
    outline-offset: -4px;
    box-shadow: inset 0 0 0 4px var(--lm-tinta);
}

@media (forced-colors: active) {
    body.home .lmb-carrossel .hero-track-wrap .hero-arrow::before,
    body.home .lmb-carrossel .hero-track-wrap .hero-dot::after {
        forced-color-adjust: none;
        background: ButtonText;
    }
    body.home .lmb-carrossel .hero-track-wrap .hero-arrow::after { display: none; }
    body.home .lmb-carrossel .hero-track-wrap .hero-dot.is-current::after { background: Highlight; border-color: ButtonText; }
    body.home .lmb-carrossel .hero-track-wrap :is(.hero-arrow, .hero-dot):focus-visible { outline-color: Highlight; }
}

@media print {
    body.home .lmb-carrossel .hero-track-wrap > :is(.hero-arrow, .hero-dots) { display: none !important; }
}
