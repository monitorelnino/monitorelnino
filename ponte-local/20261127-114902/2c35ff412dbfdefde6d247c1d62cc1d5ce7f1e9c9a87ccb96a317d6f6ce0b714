        var key="0x4AAAAAADWMzS845WiDMNJR", wid=null, form=null, tries=0;

        var c=document.createElement("div");
        c.style.cssText="position:fixed;left:-9999px;top:0;width:1px;height:1px;opacity:0;overflow:hidden";
        document.body.appendChild(c);

        function hid(f){
            var i=f.querySelector("[name='g-recaptcha-response']");
            if(!i){ i=document.createElement("input"); i.type="hidden"; i.name="g-recaptcha-response"; f.appendChild(i); }
            return i;
        }

        function ensure(){
            if(wid!==null) return true;
            if(!window.turnstile) return false;
            wid = turnstile.render(c, {
            sitekey: key,
            size: "invisible",
            callback: function(t){
                if(!form) return;
                hid(form).value = t;
                var f=form; form=null;
                HTMLFormElement.prototype.submit.call(f);
            }
            });
            return true;
        }

        function exec(){
            if(ensure()) { try{ turnstile.execute(wid); }catch(e){} return; }
            if(++tries < 20) return setTimeout(exec, 50); // espera api.js carregar (até ~1s)
            var f=form; form=null; if(f) HTMLFormElement.prototype.submit.call(f); // fallback
        }

        // pré-carrega (não depende disso)
        window.addEventListener("load", function(){ ensure(); });

        document.addEventListener("submit", function(e){
            var f=e.target; if(!(f instanceof HTMLFormElement)) return;
            var i=f.querySelector("[name='g-recaptcha-response']");
            if(i && i.value.trim()) return;

            e.preventDefault();
            form=f; tries=0; hid(f);
            exec();
        }, true);
        });
    </script>

    

