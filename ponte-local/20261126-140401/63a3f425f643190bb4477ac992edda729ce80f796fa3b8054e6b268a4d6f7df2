<script>
    const boxStatus = document.querySelector('#formulario-estatico .status')
    const campos = document.querySelectorAll(".fale-conosco .campos");
    const btnEnviar = document.querySelector(".fale-conosco button");
    const arrayCampos = Array.from(campos);
    const formulario = document.querySelector('#formulario-estatico form');
    const loader = document.querySelector(".fale-conosco .loader")

    let error = null

    if (boxStatus) {
        setTimeout(() => {
            boxStatus.style.display = 'none'
        }, 6000)
    }

    const regexEmail = /^(([^<>()[\]\\.,;:\s@\"]+(\.[^<>()[\]\\.,;:\s@\"]+)*)|(\".+\"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/

    const campos2 = arrayCampos.map((campo) => {
        campo.addEventListener("keypress", handlkeypress);

        function validaCampo(value) {
            if (value.length === 0) {
                return false;
            } else if (campo.name === "email" && !regexEmail.test(value)) {
                return false;
            } else {
                if (campo.name === "telefone") {
                    if (value.length < 14) {
                        return false
                    }
                }
                error = null;
                return true;
            }
        }

        function handlkeypress({ target }) {
            validaCampo(target.value);
            if (!error) {
                target.style.background = "#fff";
                target.style.borderColor = "#cceeff";
            }
        }

        function handleEnviar(event) {
            event.preventDefault();

            if (validaCampo(campo.value)) {
                campo.style.background = '#fff'
                campo.style.borderColor = "#cceeff";
            } else {
                campo.style.background = '#fcdcdf'
                campo.style.borderColor = "#f00";
            }

            validarTodos();
        }

        btnEnviar.addEventListener("click", handleEnviar);
    });

    function validarTodos() {
        var contador = 0;

        campos.forEach(campo => {
            if (campo.value.length === 0) {
                contador = 0;
            } else if (campo.name === "email" && !regexEmail.test(campo.value)) {
                contador = 0;
            } else {
                if (campo.name === "telefone") {
                    if (campo.value.length < 14) {
                        contador = 0;
                    }
                }
                contador++;
            }
        })

        if (contador == 4) {
            formulario.submit();
            loader.removeAttribute("hidden")
            btnEnviar.setAttribute("hidden", true)
        }
    }
