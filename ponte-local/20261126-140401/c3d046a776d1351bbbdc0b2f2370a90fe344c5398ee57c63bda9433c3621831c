<script defer>
        const linkDiario = document.querySelector('[data-link-diario]');
        const linkBaixar = document.querySelectorAll('[data-link-baixar]');
        const paginadiario = document.querySelector('#pagina');
        const tamanhodiario = document.querySelector('#tamanho');

        const formatarTamanho = (bytes) => {
            if (bytes < 1024 * 1024) {
                let kb = bytes / 1024;
                return (kb < 1 ? kb.toFixed(3) : kb.toFixed(2)) + " KB";
            }

            let mb = bytes / (1024 * 1024);
            return mb.toFixed(2) + " MB";
        };

        // Obtém informações do diário
        const getDadosDiario = async () => {
            try {
                const response = await fetch(linkDiario.dataset.linkDiario);

                if (!response.ok) {
                    throw new Error(`Erro HTTP: ${response.status}`);
                }

                const pdfBlob = await response.blob();
                const arrayBuffer = await pdfBlob.arrayBuffer();

                const pdf = await pdfjsLib.getDocument({
                    data: arrayBuffer
                }).promise;

                paginadiario.innerText = pdf.numPages;
                tamanhodiario.innerText = formatarTamanho(pdfBlob.size);

            } catch (error) {
                console.error("Erro ao carregar PDF:", error);
            }
        };

        // Baixa os editais
        const baixarEditais = async (btn, linkUrl) => {
            try {
                btn.classList.add('carregando');

                const response = await fetch(linkUrl.trim());

                if (!response.ok) {
                    throw new Error(`Erro HTTP: ${response.status}`);
                }

                const file = await response.blob();

                // Obtém o nome do arquivo pela URL
                const url = new URL(linkUrl);
                let nomeArquivo = url.pathname.split('/').pop();

                if (!nomeArquivo || !nomeArquivo.toLowerCase().endsWith('.pdf')) {
                    nomeArquivo = `edital-${Date.now()}.pdf`;
                }

                // Cria o link temporário
                const downloadUrl = URL.createObjectURL(file);

                const link = document.createElement('a');
                link.href = downloadUrl;
                link.download = nomeArquivo;

                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);

                // Libera a memória
                setTimeout(() => {
                    URL.revokeObjectURL(downloadUrl);
                }, 1000);

            } catch (error) {
                console.error("Erro ao baixar o arquivo:", error);
                alert("Não foi possível baixar o arquivo. Tente novamente.");
            } finally {
                btn.classList.remove('carregando');
            }
        };

        // Eventos de download
        linkBaixar.forEach((btn) => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();

                baixarEditais(btn, btn.dataset.linkBaixar);
            });
        });

        getDadosDiario();
</script>

    

