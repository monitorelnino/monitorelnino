<script>
document.addEventListener('DOMContentLoaded', function () {

    /* Dropdowns do menu principal */
    const mainDropdowns = document.querySelectorAll('.main-dropdown');

    mainDropdowns.forEach(function (dropdown) {
        const button = dropdown.querySelector('.main-dropdown-toggle');
        if (!button) return;

        button.addEventListener('click', function (event) {
            event.preventDefault();
            event.stopPropagation();

            mainDropdowns.forEach(function (other) {
                if (other !== dropdown) {
                    other.classList.remove('open');
                    const b = other.querySelector('.main-dropdown-toggle');
                    if (b) b.setAttribute('aria-expanded', 'false');
                }
            });

            const open = dropdown.classList.toggle('open');
            button.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
    });

    /* Dropdowns da barra secundária: hover no desktop + clique */
    const quickDropdowns = document.querySelectorAll('.quick-dropdown');

    quickDropdowns.forEach(function (dropdown) {
        const button = dropdown.querySelector(':scope > button');
        if (!button) return;

        button.setAttribute('aria-haspopup', 'true');
        button.setAttribute('aria-expanded', 'false');

        button.addEventListener('click', function (event) {
            event.preventDefault();
            event.stopPropagation();

            quickDropdowns.forEach(function (other) {
                if (other !== dropdown) {
                    other.classList.remove('open');
                    const b = other.querySelector(':scope > button');
                    if (b) b.setAttribute('aria-expanded', 'false');
                }
            });

            const open = dropdown.classList.toggle('open');
            button.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
    });

    /* Menu mobile */
    const mobileButton = document.querySelector('.mobile-menu-button');
    const mobilePanel = document.getElementById('menuMobile');
    const mobileClose = document.querySelector('.mobile-menu-close');

    function closeMobileMenu() {
        if (!mobilePanel) return;
        mobilePanel.classList.remove('is-open');
        mobilePanel.setAttribute('aria-hidden', 'true');
        if (mobileButton) mobileButton.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('mobile-menu-open');
    }

    if (mobileButton && mobilePanel) {
        mobileButton.addEventListener('click', function (event) {
            event.preventDefault();
            event.stopPropagation();
            const open = mobilePanel.classList.toggle('is-open');
            mobilePanel.setAttribute('aria-hidden', open ? 'false' : 'true');
            mobileButton.setAttribute('aria-expanded', open ? 'true' : 'false');
            document.body.classList.toggle('mobile-menu-open', open);
        });
    }

    if (mobileClose) {
        mobileClose.addEventListener('click', closeMobileMenu);
    }

    mobilePanel && mobilePanel.querySelectorAll('a').forEach(function (link) {
        link.addEventListener('click', function () {
            if (link.getAttribute('target') !== '_blank') closeMobileMenu();
        });
    });

    window.addEventListener('resize', function () {
        if (window.innerWidth > 991) closeMobileMenu();
    });

    /* Clique fora fecha qualquer dropdown */
    document.addEventListener('click', function (event) {
        if (!event.target.closest('.main-dropdown') && !event.target.closest('.quick-dropdown')) {
            mainDropdowns.forEach(function (dropdown) {
                dropdown.classList.remove('open');
                const button = dropdown.querySelector('.main-dropdown-toggle');
                if (button) button.setAttribute('aria-expanded', 'false');
            });

            quickDropdowns.forEach(function (dropdown) {
                dropdown.classList.remove('open');
                const button = dropdown.querySelector(':scope > button');
                if (button) button.setAttribute('aria-expanded', 'false');
            });
        }
    });

});
</script>





<script>
/* =========================================================
   ACESSIBILIDADE - CONTROLES FUNCIONAIS
   ========================================================= */
(function () {
    const STORAGE_KEY = 'setebarras_acessibilidade';
    const minScale = 0.80;
    const maxScale = 1.40;
    const step = 0.10;

    function getSettings() {
        try {
            return JSON.parse(localStorage.getItem(STORAGE_KEY)) || { scale: 1, links: false, grayscale: false, invert: false };
        } catch (e) {
            return { scale: 1, links: false, grayscale: false, invert: false };
        }
    }

    function saveSettings(settings) {
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(settings)); } catch (e) {}
    }

    function getTextElements() {
        const selector = 'h1,h2,h3,h4,h5,h6,p,a,button,li,label,summary,span,strong,small,td,th,figcaption,input,textarea,select';
        return Array.from(document.querySelectorAll(selector)).filter(function (el) {
            if (el.matches('i,svg,img')) return false;
            if (!el.textContent || !el.textContent.trim()) return false;
            const children = Array.from(el.children);
            return children.length === 0 || children.every(function (child) {
                return child.matches('i,svg,img');
            });
        });
    }

    function prepareTextElements() {
        getTextElements().forEach(function (el) {
            if (!el.dataset.accessibilityBaseSize) {
                const size = parseFloat(window.getComputedStyle(el).fontSize);
                if (!isNaN(size)) el.dataset.accessibilityBaseSize = size;
            }
        });
    }

    function applyFontScale(scale) {
        prepareTextElements();
        getTextElements().forEach(function (el) {
            const base = parseFloat(el.dataset.accessibilityBaseSize);
            if (!isNaN(base)) {
                el.style.fontSize = (base * scale).toFixed(2) + 'px';
            }
        });
        document.documentElement.style.setProperty('--accessibility-scale', scale);
    }

    function updateButtons(settings) {
        document.querySelectorAll('[onclick*="toggleLinkHighlight"]').forEach(function (button) {
            button.classList.toggle('accessibility-active', !!settings.links);
        });
        document.querySelectorAll('[onclick*="changeFontSize(1)"]').forEach(function (button) {
            button.classList.toggle('accessibility-active', settings.scale > 1);
        });
        document.querySelectorAll('[onclick*="changeFontSize(-1)"]').forEach(function (button) {
            button.classList.toggle('accessibility-active', settings.scale < 1);
        });
    }

    window.changeFontSize = function (direction) {
        const settings = getSettings();
        let scale = Number(settings.scale) || 1;
        scale += direction > 0 ? step : -step;
        scale = Math.max(minScale, Math.min(maxScale, Number(scale.toFixed(2))));
        settings.scale = scale;
        saveSettings(settings);
        applyFontScale(scale);
        updateButtons(settings);
    };

    window.toggleLinkHighlight = function () {
        const settings = getSettings();
        settings.links = !settings.links;
        saveSettings(settings);
        document.body.classList.toggle('links-highlighted', settings.links);
        updateButtons(settings);
    };

    window.toggleGrayscale = function () {
        const settings = getSettings();
        settings.grayscale = !settings.grayscale;
        saveSettings(settings);
        document.documentElement.classList.toggle('accessibility-grayscale', settings.grayscale);
        updateButtons(settings);
    };

    window.toggleInvert = function () {
        const settings = getSettings();
        settings.invert = !settings.invert;
        saveSettings(settings);
        document.documentElement.classList.toggle('accessibility-invert', settings.invert);
        updateButtons(settings);
    };

    window.resetSettings = function () {
        const settings = { scale: 1, links: false, grayscale: false, invert: false };
        saveSettings(settings);
        applyFontScale(1);
        document.body.classList.remove('links-highlighted');
        document.documentElement.classList.remove('accessibility-grayscale', 'accessibility-invert');
        updateButtons(settings);
    };

    document.addEventListener('DOMContentLoaded', function () {
        const settings = getSettings();
        applyFontScale(Number(settings.scale) || 1);
        document.body.classList.toggle('links-highlighted', !!settings.links);
        document.documentElement.classList.toggle('accessibility-grayscale', !!settings.grayscale);
        document.documentElement.classList.toggle('accessibility-invert', !!settings.invert);
        updateButtons(settings);
    });
})();
</script>

