<style>
/* =========================================================
   HEADER PRINCIPAL - SETE BARRAS
   ========================================================= */

.site-header {
    position: relative;
    z-index: 1000;
    background: #ffffff !important;
    font-family: 'Poppins', sans-serif !important;
}

.header-accent {
    height: 4px !important;
    background: linear-gradient(90deg, #064b73 0%, #087b9c 50%, #078b72 100%) !important;
}

.header-main {
    background: #ffffff !important;
    background-image: none !important;
}

.header-main-inner {
    min-height: 112px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 35px;
}

.brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none !important;
}

.brand img {
    display: block;
    width: 285px !important;
    height: auto;
}

/* Linha dos três acessos */
.main-nav {
    display: flex !important;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;
    flex: 1;
}

.main-dropdown {
    position: relative;
    flex: 0 0 auto;
}

/* Botões Cidadão / Empresa / Servidor */
.main-dropdown-toggle {
    width: 170px;
    height: 64px;

    display: flex !important;
    align-items: center;
    gap: 12px;

    padding: 0 15px !important;

    border: 0 !important;
    border-radius: 14px !important;

    color: #ffffff !important;

    font-family: 'Poppins', sans-serif !important;
    font-size: 15px !important;
    font-weight: 700 !important;

    cursor: pointer;

    box-shadow: 0 8px 20px rgba(5, 65, 95, 0.14);

    transition: transform .2s ease, box-shadow .2s ease, filter .2s ease;
}

/* Cores diferentes */
.main-dropdown:nth-child(1) .main-dropdown-toggle {
    background: linear-gradient(135deg, #07527d 0%, #087da1 100%) !important;
}

.main-dropdown:nth-child(2) .main-dropdown-toggle {
    background: linear-gradient(135deg, #07527d 0%, #006f91 100%) !important;
}

.main-dropdown:nth-child(3) .main-dropdown-toggle {
    background: linear-gradient(135deg, #07566f 0%, #078b78 100%) !important;
}

.main-dropdown-toggle:hover,
.main-dropdown.open .main-dropdown-toggle {
    transform: translateY(-2px);
    filter: brightness(1.06);
    box-shadow: 0 12px 26px rgba(5, 65, 95, 0.22);
}

.dropdown-main-icon {
    width: 34px;
    flex: 0 0 34px;
    font-size: 28px !important;
    color: #ffffff !important;
    text-align: center;
}

.main-dropdown-toggle strong {
    flex: 1;
    text-align: left;
    color: #ffffff !important;
}

.dropdown-arrow {
    font-size: 12px !important;
    color: #ffffff !important;
    transition: transform .2s ease;
}

.main-dropdown.open .dropdown-arrow {
    transform: rotate(180deg);
}

/* Dropdown */
.main-dropdown-menu {
    position: absolute !important;
    top: calc(100% + 9px) !important;
    left: 0 !important;
    right: auto !important;

    width: 270px !important;

    display: block !important;

    padding: 8px !important;

    background: #ffffff !important;
    border: 1px solid #dce8ec !important;
    border-radius: 13px !important;

    box-shadow: 0 18px 40px rgba(4, 52, 75, .20) !important;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transform: translateY(8px);

    transition: opacity .18s ease, transform .18s ease, visibility .18s ease;
}

.main-dropdown.open .main-dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
}

.main-dropdown-menu .dropdown-title {
    display: block;
    padding: 10px 11px !important;
    margin-bottom: 4px !important;

    color: #064b73 !important;

    font-family: 'Poppins', sans-serif !important;
    font-size: 10px !important;
    font-weight: 700 !important;

    border-bottom: 1px solid #e8f0f2;
}

.main-dropdown-menu a {
