   ========================================================= */
.mobile-menu-button {
    display: none;
    width: 48px !important;
    height: 48px !important;
    flex: 0 0 48px;
    align-items: center;
    justify-content: center;
    border: 0 !important;
    border-radius: 13px !important;
    background: #087b78 !important;
    color: #ffffff !important;
    box-shadow: 0 7px 18px rgba(4, 80, 88, .18);
    cursor: pointer;
}
.mobile-menu-button i {
    color: #ffffff !important;
    font-size: 25px !important;
    line-height: 1;
}
.mobile-menu-panel {
    display: none;
}
@media (max-width: 991px) {
    .topbar-grid {
        grid-template-columns: 1fr auto !important;
    }
    .top-accessibility {
        display: none !important;
    }
    .top-contact {
        font-size: 11px !important;
    }
    .header-main-inner {
        min-height: 88px !important;
        gap: 12px !important;
    }
    .brand img {
        width: 235px !important;
        max-height: 82px !important;
    }
    .main-nav,
    .quick-nav {
        display: none !important;
    }
    .mobile-menu-button {
        display: flex !important;
    }
    .mobile-menu-panel {
        position: fixed;
        top: 0;
        right: 0;
        width: min(100%, 430px);
        height: 100dvh;
        display: flex;
        flex-direction: column;
        background: #ffffff;
        z-index: 999999;
        box-shadow: -12px 0 35px rgba(4, 50, 72, .18);
        transform: translateX(100%);
        visibility: hidden;
        transition: transform .25s ease, visibility .25s ease;
        overflow: hidden;
    }
    .mobile-menu-panel.is-open {
        transform: translateX(0);
        visibility: visible;
    }
    .mobile-menu-head {
        min-height: 68px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 18px 0 22px;
        background: linear-gradient(135deg, #064b73, #078b78);
        color: #fff;
        flex: 0 0 auto;
    }
    .mobile-menu-head strong {
        font: 700 19px/1 'Poppins', sans-serif;
        letter-spacing: .2px;
    }
    .mobile-menu-close {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 11px;
        background: rgba(255,255,255,.14);
        color: #fff;
        font-size: 20px;
    }
    .mobile-menu-nav {
        overflow-y: auto;
        padding: 8px 18px 28px;
        background: #fff;
    }
    .mobile-menu-nav > a,
    .mobile-menu-nav > details > summary {
        min-height: 56px;
        display: flex;
        align-items: center;
        gap: 13px;
        width: 100%;
        padding: 0 8px;
        border-bottom: 1px solid #e5eef1;
        color: #173f59;
        font: 600 15px/1.2 'Poppins', sans-serif;
        text-decoration: none;
        list-style: none;
        cursor: pointer;
    }
    .mobile-menu-nav > details > summary::-webkit-details-marker {
        display: none;
    }
    .mobile-menu-nav > a > i,
    .mobile-menu-nav > details > summary > i:first-child {
        width: 25px;
        color: #078b78;
        font-size: 21px;
        text-align: center;
    }
    .mobile-menu-nav > details > summary > i:last-child {
        margin-left: auto;
        color: #6b8794;
        font-size: 12px;
        transition: transform .2s ease;
    }
    .mobile-menu-nav > details[open] > summary > i:last-child {
        transform: rotate(180deg);
    }
    .mobile-submenu {
        padding: 5px 0 9px 46px;
        border-bottom: 1px solid #e5eef1;
    }
    .mobile-submenu a {
        display: block;
        padding: 9px 8px;
        color: #4c6877;
        font: 500 13px/1.35 'Poppins', sans-serif;
        text-decoration: none;
    }
    .mobile-submenu a:hover {
        color: #087b78;
        background: #eef8f7;
        border-radius: 7px;
    }
    .mobile-submenu strong {
        display: block;
        padding: 9px 8px 5px;
        color: #075a7c;
        font: 700 11px/1.2 'Poppins', sans-serif;
    }
    .mobile-secretarias {
        max-height: 260px;
        overflow-y: auto;
    }
    .mobile-section-title {
        margin: 28px 8px 12px;
        color: #173f59;
        font: 800 12px/1 'Poppins', sans-serif;
        text-transform: uppercase;
        letter-spacing: .6px;
    }
    .mobile-accessibility {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 0 8px;
    }
    .mobile-accessibility button {
        min-width: 50px;
        height: 46px;
        border: 0;
        border-radius: 10px;
        background: #eef5f7;
        color: #173f59;
        font: 600 14px 'Poppins', sans-serif;
    }
}
@media (max-width: 575px) {
    .header-main-inner {
        padding-left: 12px;
        padding-right: 12px;
    }
    .brand img {
        width: 210px !important;
    }
    .mobile-menu-panel {
        width: 100%;
    }
}



