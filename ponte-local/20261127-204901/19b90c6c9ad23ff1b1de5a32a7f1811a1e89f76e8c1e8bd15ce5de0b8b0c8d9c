<script>
  var pmcVideoIndex = 0;
  var pmcVideoTimer = null;

  function pmcVideos() {
    var slider = document.getElementById("pmcVideoSlider");
    return slider ? slider.querySelectorAll("video") : [];
  }

  function pmcDots() {
    var slider = document.getElementById("pmcVideoSlider");
    return slider ? slider.querySelectorAll(".pmc-slider-dot") : [];
  }

  function pmcPausarVideos(videos) {
    videos.forEach(function(video) {
      video.pause();
      video.currentTime = 0;
      video.classList.remove("pmc-video-active");
    });
  }

  function pmcIrParaVideo(indice) {
    var videos = pmcVideos();
    var dots = pmcDots();
    if (!videos.length) return;

    pmcVideoIndex = (indice + videos.length) % videos.length;
    pmcPausarVideos(videos);

    dots.forEach(function(dot) {
      dot.classList.remove("pmc-dot-active");
    });

    videos[pmcVideoIndex].classList.add("pmc-video-active");
    if (dots[pmcVideoIndex]) {
      dots[pmcVideoIndex].classList.add("pmc-dot-active");
    }

    var playPromise = videos[pmcVideoIndex].play();
    if (playPromise && typeof playPromise.catch === "function") {
      playPromise.catch(function() {});
    }

    pmcReiniciarTimerVideo();
  }

  function pmcProximoVideo() {
    pmcIrParaVideo(pmcVideoIndex + 1);
  }

  function pmcVideoAnterior() {
    pmcIrParaVideo(pmcVideoIndex - 1);
  }

  function pmcReiniciarTimerVideo() {
    if (pmcVideoTimer) {
      clearTimeout(pmcVideoTimer);
    }

    pmcVideoTimer = setTimeout(function() {
      pmcProximoVideo();
    }, 14000);
  }

  document.addEventListener("DOMContentLoaded", function() {
    var videos = pmcVideos();

    videos.forEach(function(video) {
      video.addEventListener("ended", pmcProximoVideo);
    });

    pmcIrParaVideo(0);
  });
