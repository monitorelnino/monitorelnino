<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
  function pmcNormalizar(texto) {
    return (texto || "")
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "");
  }

  function pmcFiltrarServicos() {
    var input = document.getElementById("pmcServiceSearch");
    var grid = document.getElementById("pmcServiceGrid");
    if (!input || !grid) return;

    var termo = pmcNormalizar(input.value);
    var cards = grid.querySelectorAll(".pmc-service-card");

    cards.forEach(function(card) {
      var texto = pmcNormalizar(
        (card.getAttribute("data-service") || "") + " " + card.innerText
      );
      card.style.display = texto.indexOf(termo) !== -1 ? "grid" : "none";
    });
  }

  function pmcLimparBusca() {
    var input = document.getElementById("pmcServiceSearch");
    if (input) {
      input.value = "";
      pmcFiltrarServicos();
      input.focus();
    }
  }

  function pmcFormatarData(dataIso) {
    try {
      return new Date(dataIso).toLocaleDateString("pt-BR", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric"
      });
    } catch (e) {
      return "";
    }
  }

  function pmcTextoLimpo(html) {
    var div = document.createElement("div");
    div.innerHTML = html || "";
    return div.textContent || div.innerText || "";
  }

  function pmcCarregarPostsCategoria(lista) {
    var slug = lista.getAttribute("data-category-slug");
    var fallbackUrl = lista.getAttribute("data-category-url");
    var label = lista.getAttribute("data-fallback-label") || "Publicação";

    fetch("/wp-json/wp/v2/categories?slug=" + encodeURIComponent(slug))
      .then(function(resp) {
        if (!resp.ok) throw new Error("Categoria não encontrada");
        return resp.json();
      })
      .then(function(categorias) {
        if (!categorias || !categorias.length) throw new Error("Categoria vazia");
        var id = categorias[0].id;
        return fetch(
          "/wp-json/wp/v2/posts?categories=" +
          id +
          "&per_page=3&_fields=link,title,date,excerpt"
        );
      })
      .then(function(resp) {
        if (!resp.ok) throw new Error("Posts não encontrados");
        return resp.json();
      })
      .then(function(posts) {
        if (!posts || !posts.length) throw new Error("Sem posts");

        lista.innerHTML = "";

        posts.forEach(function(post) {
          var li = document.createElement("li");
          var titulo = pmcTextoLimpo(post.title && post.title.rendered);
          var resumo = pmcTextoLimpo(post.excerpt && post.excerpt.rendered);

          resumo = resumo.length > 115
            ? resumo.substring(0, 115) + "..."
            : resumo;

          li.innerHTML =
            '<a class="pmc-post-title" href="' + post.link + '">' +
              titulo +
            '</a>' +
            '<time datetime="' + post.date + '">' +
              pmcFormatarData(post.date) +
            '</time>' +
            (resumo ? '<span>' + resumo + '</span>' : "");

