		<div class="np-home-bottom-section">
			<section id="block-51" class="widget widget_block"></section><section id="block-52" class="widget widget_block"><!--
PÁGINA INICIAL — PREFEITURA MUNICIPAL DE CABIXI/RO
Versão revisada:
- fontes maiores em PX, sem dependência do REM do tema do WordPress;
- textos institucionais revisados;
- melhor hierarquia visual;
- links normalizados;
- seletores CSS corrigidos;
- responsividade e acessibilidade aprimoradas.
-->

<style>
  .pmc-home,
  .pmc-home * {
    box-sizing: border-box;
  }

  .pmc-home {
    --pmc-verde: #0a6b18;
    --pmc-verde-escuro: #044d0e;
    --pmc-verde-profundo: #022f09;
    --pmc-verde-claro: #8bd80a;
    --pmc-amarelo: #ffd526;
    --pmc-branco: #ffffff;
    --pmc-texto: #17231c;
    --pmc-cinza: #536259;
    --pmc-borda: #dce5dd;
    --pmc-fundo: #f5f8f5;
    --pmc-fundo-verde: #eef7ee;
    --pmc-sombra: 0 14px 34px rgba(0, 47, 9, .09);
    --pmc-sombra-forte: 0 22px 58px rgba(0, 47, 9, .13);
    --pmc-raio: 22px;

    width: 100%;
    margin: 0;
    color: var(--pmc-texto);
    background: var(--pmc-branco);
    font-family: "Segoe UI", Arial, Helvetica, sans-serif;
    font-size: 20px;
    line-height: 1.68;
  }

  .pmc-home img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .pmc-home a {
    color: inherit;
  }

  .pmc-container {
    width: min(1540px, calc(100% - 32px));
    margin-inline: auto;
  }

  /* =========================================================
     ABERTURA
     ========================================================= */
  .pmc-body-card {
    position: relative;
    overflow: hidden;
    margin: 0 0 28px;
    padding: 46px;
    border: 1px solid var(--pmc-borda);
    border-radius: 0 0 30px 30px;
    color: var(--pmc-branco);
    background:
      radial-gradient(circle at 91% 4%, rgba(139, 216, 10, .26), transparent 29%),
      radial-gradient(circle at 8% 100%, rgba(255, 213, 38, .09), transparent 25%),
      linear-gradient(135deg, var(--pmc-verde-profundo), var(--pmc-verde-escuro) 58%, var(--pmc-verde));
    box-shadow: var(--pmc-sombra-forte);
  }

  .pmc-body-card::after {
    content: "";
    position: absolute;
    width: 440px;
    height: 440px;
    right: -235px;
    bottom: -250px;
    border: 62px solid rgba(255, 255, 255, .06);
    border-radius: 50%;
    pointer-events: none;
  }

  .pmc-top-title {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 32px;
    align-items: center;
    margin-bottom: 34px;
  }

  .pmc-kicker {
    margin: 0 0 10px !important;
    color: var(--pmc-verde-claro) !important;
    font-size: 15px !important;
    font-weight: 900 !important;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .pmc-top-title h1 {
    max-width: 980px;
    margin: 0;
    color: var(--pmc-branco);
    font-size: clamp(52px, 5vw, 78px);
    line-height: .98;
    letter-spacing: -.045em;
  }

  .pmc-top-title p {
    max-width: 930px;
    margin: 18px 0 0;
    color: rgba(255, 255, 255, .88);
    font-size: 22px;
    line-height: 1.62;
  }

  .pmc-top-actions {
    display: grid;
    gap: 12px;
    min-width: 250px;
  }

  /* =========================================================
     BOTÕES
     ========================================================= */
  .pmc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 14px 20px;
    border: 1px solid transparent;
    border-radius: 14px;
    color: var(--pmc-branco) !important;
    background: var(--pmc-verde);
    font-size: 17px;
    line-height: 1.25;
    font-weight: 900;
    text-align: center;
    text-decoration: none !important;
    transition: transform .16s ease, background .16s ease, box-shadow .16s ease, border-color .16s ease;
  }

  .pmc-body-card .pmc-btn {
    color: var(--pmc-verde-profundo) !important;
    background: var(--pmc-verde-claro);
  }

  .pmc-btn:hover,
  .pmc-btn:focus {
    transform: translateY(-2px);
    background: var(--pmc-verde-escuro);
    box-shadow: 0 12px 26px rgba(0, 0, 0, .14);
  }

  .pmc-body-card .pmc-btn:hover,
  .pmc-body-card .pmc-btn:focus {
    background: #b5ee43;
  }

  .pmc-btn-soft {
    color: var(--pmc-verde-escuro) !important;
    background: #edf7ed;
    border-color: #cde2ce;
  }

  .pmc-body-card .pmc-btn-soft {
    color: var(--pmc-branco) !important;
    background: rgba(255, 255, 255, .10);
    border-color: rgba(255, 255, 255, .24);
  }

  /* =========================================================
     SEÇÕES
     ========================================================= */
  .pmc-section {
    margin-bottom: 28px;
    padding: 38px;
    border: 1px solid var(--pmc-borda);
    border-radius: var(--pmc-raio);
    background: var(--pmc-branco);
    box-shadow: var(--pmc-sombra);
  }

  .pmc-section-alt {
    background:
      radial-gradient(circle at 96% 6%, rgba(139, 216, 10, .10), transparent 28%),
      var(--pmc-fundo);
  }

  .pmc-section-head {
    display: flex;
    gap: 24px;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 26px;
  }

  .pmc-section-head h2 {
    margin: 0;
    color: var(--pmc-verde-escuro);
    font-size: clamp(38px, 3.3vw, 54px);
    line-height: 1.06;
    letter-spacing: -.03em;
  }

  .pmc-section-head p {
    max-width: 980px;
    margin: 10px 0 0;
    color: var(--pmc-cinza);
    font-size: 20px;
    line-height: 1.65;
  }

  
  /* =========================================================
     ACESSO RÁPIDO
     ========================================================= */
  .pmc-access-area {
    position: relative;
    z-index: 2;
  }

  .pmc-access-box {
    padding: 28px;
    border: 1px solid rgba(255, 255, 255, .18);
    border-radius: 22px;
    background: rgba(255, 255, 255, .08);
    backdrop-filter: blur(7px);
  }

  .pmc-access-box h2 {
    margin: 0 0 20px;
    color: var(--pmc-branco);
    font-size: 32px;
    line-height: 1.2;
  }

  .pmc-side-buttons {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .pmc-quick-card {
    display: grid;
    grid-template-columns: 58px 1fr;
    gap: 16px;
    align-items: start;
    min-height: 160px;
    padding: 18px;
    border: 1px solid rgba(255, 255, 255, .16);
    border-radius: 20px;
    color: var(--pmc-texto) !important;
    background:
      radial-gradient(circle at 100% 0%, rgba(139, 216, 10, .18), transparent 35%),
      linear-gradient(135deg, #ffffff, #f4faf4);
    box-shadow: 0 10px 24px rgba(0, 0, 0, .10);
    text-decoration: none !important;
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }

  .pmc-quick-card:hover,
  .pmc-quick-card:focus {
    transform: translateY(-4px);
    box-shadow: 0 18px 30px rgba(0, 0, 0, .16);
    border-color: rgba(139, 216, 10, .45);
  }

  .pmc-quick-icon {
    width: 58px;
    height: 58px;
    border-radius: 17px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--pmc-branco);
    background:
      radial-gradient(circle at 32% 25%, rgba(255,255,255,.22), transparent 34%),
      linear-gradient(135deg, var(--pmc-verde-profundo), var(--pmc-verde));
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.18), 0 8px 16px rgba(0,0,0,.10);
  }

  .pmc-quick-icon svg {
    width: 28px;
    height: 28px;
    display: block;
  }

  .pmc-quick-content {
    align-self: center;
  }

  .pmc-quick-content strong {
    display: block;
    color: var(--pmc-verde-escuro);
    font-size: 20px;
    line-height: 1.2;
  }

  .pmc-quick-content span {
    display: block;
    margin-top: 6px;
    color: var(--pmc-cinza);
    font-size: 16px;
    line-height: 1.45;
  }

  .pmc-quick-card em {
    grid-column: 1 / -1;
    margin-top: 2px;
    font-style: normal;
    color: var(--pmc-verde);
    font-size: 14px;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  /* =========================================================
     REDES SOCIAIS
     ========================================================= */
  .pmc-social-card {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    align-items: center;
    margin-top: 20px;
    padding: 28px;
    border: 1px solid rgba(255, 255, 255, .18);
    border-radius: 22px;
    background: rgba(255, 255, 255, .08);
  }

  .pmc-social-card h2 {
    margin: 0;
    color: var(--pmc-branco);
    font-size: 32px;
    line-height: 1.2;
  }

  .pmc-social-card p {
    margin: 9px 0 0;
    color: rgba(255, 255, 255, .84);
    font-size: 19px;
    line-height: 1.5;
  }

  .pmc-social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: flex-end;
  }

  .pmc-social-link {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 14px;
    align-items: center;
    width: 285px;
    min-height: 86px;
    padding: 13px;
    border: 1px solid rgba(255, 255, 255, .20);
    border-radius: 16px;
    color: var(--pmc-branco) !important;
    background: rgba(255, 255, 255, .10);
    text-decoration: none !important;
    transition: transform .16s ease, background .16s ease;
  }

  .pmc-social-link:hover,
  .pmc-social-link:focus {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, .16);
  }

  .pmc-social-icon,
  .pmc-service-icon,
  .pmc-icon {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: #fff !important;
    background:
      radial-gradient(circle at 32% 25%, rgba(255, 255, 255, .22), transparent 34%),
      linear-gradient(135deg, var(--pmc-verde-escuro), var(--pmc-verde));
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .18), 0 8px 16px rgba(0, 0, 0, .10);
  }

  .pmc-social-icon {
    width: 60px;
    height: 60px;
    border-radius: 16px;
  }

  .pmc-social-icon svg,
  .pmc-service-icon svg {
    width: 31px;
    height: 31px;
    display: block !important;
    margin: auto !important;
    fill: #fff !important;
  }

  .pmc-social-icon svg path,
  .pmc-service-icon svg path {
    fill: #fff !important;
  }

  .pmc-social-link strong {
    display: block;
    color: #fff;
    font-size: 20px;
    line-height: 1.2;
  }

  .pmc-social-link span {
    display: block;
    margin-top: 4px;
    color: rgba(255, 255, 255, .80);
    font-size: 17px;
    line-height: 1.3;
  }

  /* =========================================================
     PUBLICAÇÕES
     ========================================================= */
  .pmc-publicacoes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .pmc-publicacao-card {
    min-width: 0;
    padding: 26px;
    border: 1px solid var(--pmc-borda);
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 7px 20px rgba(0, 47, 9, .05);
  }

  .pmc-publicacao-card h3,
  .pmc-mini-card h3,
  .pmc-info-compact h3 {
    display: flex;
    gap: 12px;
    align-items: center;
    margin: 0;
    color: var(--pmc-verde-escuro);
    font-size: 24px;
    line-height: 1.25;
  }

  .pmc-icon {
    flex: 0 0 auto;
    width: 50px;
    height: 50px;
    border-radius: 14px;
    font-size: 18px;
    font-weight: 900;
  }

  .pmc-posts {
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .pmc-posts li {
    padding: 17px 0;
    margin: 0;
    border-bottom: 1px solid var(--pmc-borda);
  }

  .pmc-posts li:last-child {
    border-bottom: 0;
  }

  .pmc-posts a.pmc-post-title {
    display: block;
    color: var(--pmc-texto);
    font-size: 20px;
    font-weight: 900;
    line-height: 1.38;
    text-decoration: none;
  }

  .pmc-posts a.pmc-post-title:hover {
    color: var(--pmc-verde);
    text-decoration: underline;
  }

  .pmc-posts time,
  .pmc-posts span {
    display: block;
    margin-top: 5px;
    color: var(--pmc-cinza);
    font-size: 16px;
    line-height: 1.48;
  }

  .pmc-loading {
    color: var(--pmc-cinza);
    font-size: 17px;
    font-weight: 800;
  }

  /* =========================================================
     SERVIÇOS ESSENCIAIS
     ========================================================= */
  .pmc-card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .pmc-mini-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 26px;
    border: 1px solid var(--pmc-borda);
    border-radius: 18px;
    background: #fff;
  }

  .pmc-mini-card p {
    flex: 1;
    margin: 14px 0 0;
    color: var(--pmc-cinza);
    font-size: 19px;
    line-height: 1.58;
  }

  .pmc-mini-card .pmc-btn {
    width: 100%;
    margin-top: 18px;
  }

  /* =========================================================
     SISTEMAS DIGITAIS
     ========================================================= */
  .pmc-services-wrap {
    padding: 26px;
    border: 1px solid var(--pmc-borda);
    border-radius: 18px;
    background: #fff;
  }

  .pmc-search {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px;
    margin-bottom: 20px;
  }

  .pmc-search input {
    width: 100%;
    min-height: 58px;
    padding: 0 18px;
    border: 1px solid var(--pmc-borda);
    border-radius: 14px;
    color: var(--pmc-texto);
    background: #fff;
    font-size: 18px;
  }

  .pmc-search button {
    min-height: 58px;
    padding: 0 22px;
    border: 0;
    border-radius: 14px;
    color: #fff;
    background: var(--pmc-verde);
    font-size: 17px;
    font-weight: 900;
    cursor: pointer;
  }

  .pmc-service-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .pmc-service-card {
    display: grid;
    grid-template-columns: 74px 1fr;
    gap: 16px;
    align-items: center;
    min-height: 128px;
    padding: 18px;
    border: 1px solid var(--pmc-borda);
    border-radius: 17px;
    color: var(--pmc-texto) !important;
