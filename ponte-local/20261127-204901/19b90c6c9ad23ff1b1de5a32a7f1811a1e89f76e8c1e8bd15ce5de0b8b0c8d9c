/03/17-1024x294.png 1024w, https://cabixi.ro.gov.br/wp-content/uploads/2025/03/17-768x220.png 768w, https://cabixi.ro.gov.br/wp-content/uploads/2025/03/17.png 1500w" sizes="(max-width: 300px) 100vw, 300px" /></a></section><section id="media_image-43" class="widget widget_media_image"><a href="https://frota.cabixi.ro.gov.br/frota/"><img width="300" height="86" src="https://cabixi.ro.gov.br/wp-content/uploads/2025/03/7-300x86.png" class="image wp-image-3202  attachment-medium size-medium" alt="" style="max-width: 100%; height: auto;" decoding="async" srcset="https://cabixi.ro.gov.br/wp-content/uploads/2025/03/7-300x86.png 300w, https://cabixi.ro.gov.br/wp-content/uploads/2025/03/7-1024x294.png 1024w, https://cabixi.ro.gov.br/wp-content/uploads/2025/03/7-768x220.png 768w, https://cabixi.ro.gov.br/wp-content/uploads/2025/03/7.png 1500w" sizes="(max-width: 300px) 100vw, 300px" /></a></section><section id="media_image-63" class="widget widget_media_image"><a href="https://scpi.cabixi.ro.gov.br/scpi9/"><img width="300" height="86" src="https://cabixi.ro.gov.br/wp-content/uploads/2025/03/9-300x86.png" class="image wp-image-3204  attachment-medium size-medium" alt="" style="max-width: 100%; height: auto;" decoding="async" srcset="https://cabixi.ro.gov.br/wp-content/uploads/2025/03/9-300x86.png 300w, https://cabixi.ro.gov.br/wp-content/uploads/2025/03/9-1024x294.png 1024w, https://cabixi.ro.gov.br/wp-content/uploads/2025/03/9-768x220.png 768w, https://cabixi.ro.gov.br/wp-content/uploads/2025/03/9.png 1500w" sizes="(max-width: 300px) 100vw, 300px" /></a></section>			</div><!-- .middle-aside -->
