    <script>
        const btnObras = document.querySelectorAll('[data-obra="button"]')
        const obras = document.querySelectorAll('[data-obra="obra"] a')
        let map;

        obras[0].classList.add("ativo")
        btnObras[0].classList.add("ativo")

        btnObras.forEach((item, index) => {
            item.addEventListener("click", () => {
                btnObras.forEach(item => item.classList.remove('ativo'))
                obras.forEach(item => item.classList.remove('ativo'))
                item.classList.add('ativo')
                obras[index].classList.add("ativo")

                montarMapa(item.dataset.lat, item.dataset.long)
            })
        })

        const montarMapa = (latitude, longitude) => {
            if (map === undefined) {
                map = L.map('mapa-obra').setView([latitude, longitude], 17);
            } else {
                map.remove()
                map = L.map('mapa-obra').setView([latitude, longitude], 17);
            }

            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
            }).addTo(map);

            var marker = L.marker([latitude, longitude],
                {
                    icon:
                        L.icon(
                            {
                                iconUrl: '../../Arquitetura/Icones/home/pin-obras.svg',
                                iconSize: [47, 47],
                                iconAnchor: [20, 47]
                            })
                }).addTo(map);

            marker.bindPopup(`<div style="text-align: center"><b>Obra encontrada</b></div>${btnObras[0].dataset.long}`);
        }

        montarMapa(btnObras[0].dataset.lat, btnObras[0].dataset.long)

    </script>

