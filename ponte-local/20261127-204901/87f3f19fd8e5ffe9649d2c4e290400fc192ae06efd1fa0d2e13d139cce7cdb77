<script defer>
    const headerMenu = document.querySelector(".site-header");
    const btnHamburgers = document.querySelectorAll('[data-btn="menu-topo"]');
    const menusConteudo = document.querySelectorAll('.menu-topo__conteudo');

    const fecharTodosOsMenus = () => {
        menusConteudo.forEach(menu => {
            menu.classList.remove("mostrar");
        });
        btnHamburgers.forEach(btn => {
            btn.classList.remove("ativo");
        });
    };

    btnHamburgers.forEach(btnHamburger => {
        const ativarMenu = (event) => {
            event.stopPropagation();
            const menuConteudo = btnHamburger.nextElementSibling;

            const isMenuAberto = menuConteudo.classList.contains('mostrar');

            fecharTodosOsMenus();

            if (!isMenuAberto) {
                menuConteudo.classList.add('mostrar');
                btnHamburger.classList.add("ativo");
                document.body.addEventListener('click', fecharMenu);
            }
        };

        const fecharMenu = (event) => {
            if (!btnHamburger.contains(event.target) && !event.target.closest('.menu-topo__conteudo')) {
                fecharTodosOsMenus();
                document.body.removeEventListener('click', fecharMenu);
            }
        };

        btnHamburger.addEventListener('click', ativarMenu);
    });

    // Pega direto pelo ID, impossível pegar o elemento errado
    const buscaInterna = document.getElementById("search-form");

    if (buscaInterna) {
        const inputBusca = buscaInterna.querySelector("input[type='search']");
        const botaoBusca = buscaInterna.querySelector("button");

        function ativarBuscaPeloHash() {
            if (window.location.hash === "#busca") {
                buscaInterna.classList.add("ativo");

                setTimeout(function () {
                    inputBusca.focus();
                }, 100);
            }
        }

        ativarBuscaPeloHash();

        window.addEventListener("hashchange", function () {
            ativarBuscaPeloHash();
        });

        botaoBusca.addEventListener("click", function (e) {
            if (!buscaInterna.classList.contains("ativo")) {
                e.preventDefault();
                buscaInterna.classList.add("ativo");
                inputBusca.focus();
                return;
            }

            if (inputBusca.value.trim() === "") {
                e.preventDefault();
                buscaInterna.classList.remove("ativo");
                inputBusca.blur();
                return;
            }
        });

        document.addEventListener("click", function (e) {
            if (!buscaInterna.contains(e.target) && inputBusca.value.trim() === "") {
                buscaInterna.classList.remove("ativo");
            }
        });
    }
</script>

