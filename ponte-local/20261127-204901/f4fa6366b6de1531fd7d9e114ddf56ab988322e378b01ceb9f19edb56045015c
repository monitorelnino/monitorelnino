		<script>
			(function() {
				const defaultFontSize = 16;
				const storageKey = 'newscrunch_font_size';

				function getFontSize() {
					return parseInt(localStorage.getItem(storageKey)) || defaultFontSize;
				}

				function setFontSize(size) {
					localStorage.setItem(storageKey, size);
					document.documentElement.style.fontSize = size + 'px';
				}

				document.getElementById('font-increase').addEventListener('click', function() {
					let currentSize = getFontSize();
					if (currentSize < 24) {
						setFontSize(currentSize + 2);
					}
				});

				document.getElementById('font-decrease').addEventListener('click', function() {
					let currentSize = getFontSize();
					if (currentSize > 12) {
						setFontSize(currentSize - 2);
					}
				});

				document.getElementById('font-reset').addEventListener('click', function() {
					setFontSize(defaultFontSize);
				});

				setFontSize(getFontSize());
			})();
		</script>
