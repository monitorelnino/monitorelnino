    <script>
                            $(function () {
                                $.fn.dataTable.ext.search.push(function (settings, searchData, index) {
                                    if (settings.nTable.id !== 'tb-materias') return true;
                                    var row     = $(settings.aoData[index].nTr);
                                    var tipo    = $('#gps-filtro-tipo').val();
                                    var status  = $('#gps-filtro-status').val();
                                    var autor   = $('#gps-filtro-autor').val();
                                    var dataIni = $('#gps-filtro-data-ini').val();
                                    var dataFim = $('#gps-filtro-data-fim').val();
                                    if (tipo   && row.attr('data-id-tipo') !== tipo)   return false;
                                    if (status && row.attr('data-status')  !== status) return false;
                                    if (autor  && row.attr('data-autor')   !== autor)  return false;
                                    var dataRow = row.attr('data-data-protocolo') || '';
                                    if (dataIni && dataRow && dataRow < dataIni) return false;
                                    if (dataFim && dataRow && dataRow > dataFim) return false;
                                    return true;
                                });

                                const fromHome = 1 == 1;
                                const pageLengthDesktop = fromHome ? 10 : 5;
                                // Teste local: troque para 1 (1 card + "Ver mais"); produção = 3
                                const MOBILE_PAGE = 3;
                                const mqGpsMobile = window.matchMedia('(max-width: 750px)');
                                var isMobileGps = mqGpsMobile.matches;

                                var tbMaterias = $('#tb-materias').DataTable({
                                    language: Object.assign({}, dt_traducao, fromHome ? { lengthMenu: '_MENU_' } : {}),
                                    colReorder: true,
                                    pageLength: isMobileGps ? MOBILE_PAGE : pageLengthDesktop,
                                    // Sempre cria o select no fromHome; no mobile o CSS esconde l/p
                                    bLengthChange: fromHome,
                                    lengthMenu: [[3, 5, 10, 25, 50, 100], [3, 5, 10, 25, 50, 100]],
                                    // Na home a rolagem é CSS (gps-dt-lista); fora dela usa scrollY do DataTables
                                    scrollY: fromHome ? false : 'calc(100vh - 360px)',
                                    scrollCollapse: false,
                                    order:      [],
                                    dom: fromHome
                                        ? '<"gps-dt-topo"fl><"gps-dt-lista"t><"gps-dt-rodape"ip>'
                                        : '<"gps-dt-topo"fl>rt<"gps-dt-rodape"ip>',
                                    initComplete: initDtFunctions(),
                                });

                                // Garante pageLength mobile (3) mesmo após init/lengthMenu
                                tbMaterias.page.len(isMobileGps ? MOBILE_PAGE : pageLengthDesktop).page(0).draw(false);

                                var $compGps = $('#tb-materias').closest('[comp-gps-legislativo-consulta]');
                                var $btnVerMais = $compGps.find('[data-gps-ver-mais]');
                                var $docsContador = $compGps.find('[data-gps-docs-contador]');

                                function aplicarLarguraSelectLength() {
                                    var $lenSelect = $('#tb-materias_wrapper .dataTables_length select');
                                    if (!$lenSelect.length || !fromHome || isMobileGps) return;
                                    $lenSelect[0].style.setProperty('width', '48px', 'important');
                                    $lenSelect[0].style.setProperty('min-width', '48px', 'important');
                                    $lenSelect[0].style.setProperty('max-width', '48px', 'important');
                                    $lenSelect[0].style.setProperty('height', '32px', 'important');
                                    $lenSelect[0].style.setProperty('padding', '0 18px 0 6px', 'important');
                                    $lenSelect[0].style.setProperty('box-sizing', 'border-box', 'important');
                                }
                                aplicarLarguraSelectLength();

                                function syncGpsPlaceholderMobile() {
                                    var $input = $('#consulta_endereco');
                                    if (!$input.length) return;
                                    if (!$input.attr('data-placeholder-desktop')) {
                                        $input.attr('data-placeholder-desktop', $input.attr('placeholder') || '');
                                    }
                                    var mobilePh = $input.attr('data-placeholder-mobile');
                                    var desktopPh = $input.attr('data-placeholder-desktop');
                                    $input.attr('placeholder', isMobileGps && mobilePh ? mobilePh : desktopPh);
                                }

                                var paginaGpsAnterior = null;

                                function atualizarGpsContador() {
                                    if (!$docsContador.length) return;
                                    var info = tbMaterias.page.info();
                                    var mostrando = Math.min(info.length, Math.max(0, info.recordsDisplay - info.start));
                                    if (info.recordsDisplay === 0 || mostrando === 0) {
                                        $docsContador.text('0 de 0');
                                        return;
                                    }
                                    var inicio = info.start + 1;
                                    var fim = info.start + mostrando;
                                    $docsContador.text(inicio + '–' + fim + ' de ' + info.recordsDisplay);
                                }

                                function atualizarGpsVerMais() {
                                    atualizarGpsContador();
                                    if (!$btnVerMais.length) return;
                                    var info = tbMaterias.page.info();
                                    var mostrando = Math.min(info.length, Math.max(0, info.recordsDisplay - info.start));
                                    var restantes = Math.max(0, info.recordsDisplay - (info.start + mostrando));
                                    if (!isMobileGps || restantes <= 0) {
                                        $btnVerMais.attr('hidden', true);
                                        return;
                                    }
                                    $btnVerMais.removeAttr('hidden');
                                    var rotulo = restantes === 1
                                        ? 'Ver mais 1 documento'
                                        : 'Ver mais ' + restantes + ' documentos';
                                    $btnVerMais.find('[data-gps-ver-mais-rotulo]').text(rotulo);
                                }

                                // Guarda o teto do blade (ex.: 500px) antes de qualquer clear no mobile
                                var $gpsConteudoAltura = $compGps.find('[gps-conteudo]').first();
                                var alturaGpsDesktop = ($gpsConteudoAltura.length && $gpsConteudoAltura[0].style.height)
                                    ? $gpsConteudoAltura[0].style.height
                                    : '500px';

                                function aplicarModoGpsMobile(mobile) {
                                    isMobileGps = !!mobile;
                                    syncGpsPlaceholderMobile();
                                    tbMaterias.page.len(isMobileGps ? MOBILE_PAGE : pageLengthDesktop).page(0).draw(false);
                                    aplicarLarguraSelectLength();
                                    atualizarGpsVerMais();
                                    if (typeof gmap !== 'undefined' && gmap && gmap.invalidateSize) {
                                        setTimeout(function () { gmap.invalidateSize(); }, 50);
                                    }
                                    setTimeout(sincronizarAlturaGpsHome, 80);
                                }

                                $btnVerMais.off('click.gpsVerMais').on('click.gpsVerMais', function () {
                                    if (!isMobileGps) return;
                                    tbMaterias.page.len(tbMaterias.page.len() + 5).draw(false);
                                    atualizarGpsVerMais();
                                });

                                tbMaterias.on('draw.dt', function () {
                                    atualizarGpsVerMais();
                                    if (!isMobileGps) {
                                        paginaGpsAnterior = tbMaterias.page.info().page;
                                        return;
                                    }
                                    var paginaAtual = tbMaterias.page.info().page;
                                    if (paginaGpsAnterior !== null && paginaGpsAnterior !== paginaAtual) {
                                        var tituloDocs = $compGps.find('[materias] > h3').get(0);
                                        if (tituloDocs) {
                                            tituloDocs.scrollIntoView({ behavior: 'smooth', block: 'start' });
                                        }
                                    }
                                    paginaGpsAnterior = paginaAtual;
                                });
                                atualizarGpsVerMais();
                                syncGpsPlaceholderMobile();

                                if (typeof mqGpsMobile.addEventListener === 'function') {
                                    mqGpsMobile.addEventListener('change', function (e) {
                                        aplicarModoGpsMobile(e.matches);
                                    });
                                } else if (typeof mqGpsMobile.addListener === 'function') {
                                    mqGpsMobile.addListener(function (e) {
                                        aplicarModoGpsMobile(e.matches);
                                    });
                                }

                                function sincronizarAlturaGpsHome() {
                                    var $comp = $('#tb-materias').closest('[comp-gps-legislativo-consulta]');
                                    var $gpsConteudo = $comp.find('[gps-conteudo]').first();
                                    var $materias = $comp.find('[materias]').first();
                                    var $linha = $comp.closest('.linha-agenda-gps');

                                    if (!fromHome || window.innerWidth <= 900) {
                                        if (fromHome && window.innerWidth <= 900) {
                                            $gpsConteudo.css({ height: '', 'min-height': '' });
                                            $materias.css({
                                                height: '', 'min-height': '', display: '', 'flex-direction': '', overflow: ''
                                            });
                                            if ($linha.length) {
                                                $linha.find('.bloco-agenda').first().css({ height: '', 'min-height': '' });
                                            }
                                        }
                                        return;
                                    }

                                    if (!$gpsConteudo.length || !$materias.length) return;

                                    // Volta o teto do blade; sem isso o clear do mobile deixa a lista ditar a altura
                                    $gpsConteudo.css({
                                        height: alturaGpsDesktop,
                                        'min-height': ''
                                    });

                                    $materias.css({
                                        height: '100%',
                                        'min-height': '0',
                                        display: 'flex',
                                        'flex-direction': 'column',
                                        overflow: 'hidden'
                                    });

                                    if (typeof gmap !== 'undefined' && gmap && gmap.invalidateSize) {
                                        gmap.invalidateSize();
                                    }

                                    if ($linha.length && window.innerWidth > 1100) {
                                        var $blocoGps = $linha.find('.bloco-gps-legislativo').first();
                                        var $blocoAgenda = $linha.find('.bloco-agenda').first();
                                        if ($blocoGps.length && $blocoAgenda.length) {
                                            $blocoAgenda.css({ height: '', 'min-height': '' });
                                            var h = $blocoGps.outerHeight();
                                            $blocoAgenda.css({ height: h + 'px', 'min-height': h + 'px' });
                                        }
                                    }
                                }

                                if (fromHome) {
                                    $('#tb-materias_wrapper .dataTables_length select')
                                        .off('change.gpsLength')
                                        .on('change.gpsLength', function () {
                                            tbMaterias.page.len(parseInt(this.value, 10)).page(0).draw(false);
                                        });

                                    tbMaterias.on('length.dt', function () {
                                        tbMaterias.page(0);
                                    });

                                    $(window).on('resize.gpsLista', function () {
                                        setTimeout(sincronizarAlturaGpsHome, 50);
                                    });

                                    setTimeout(sincronizarAlturaGpsHome, 0);
                                    setTimeout(sincronizarAlturaGpsHome, 300);
                                    setTimeout(sincronizarAlturaGpsHome, 800);

                                    if (window.ResizeObserver) {
                                        try {
                                            var $mapaObs = $('#tb-materias').closest('[comp-gps-legislativo-consulta]')
                                                .find('[comp-gps-legislativo-leaflet][dd="consulta"] [map]').first();
                                            var ro = new ResizeObserver(function () {
                                                sincronizarAlturaGpsHome();
                                            });
                                            if ($mapaObs[0]) ro.observe($mapaObs[0]);
                                        } catch (e) {}
                                    }
                                }

                                function filtrarMarcadores() {
                                    var tipo    = $('#gps-filtro-tipo').val();
                                    var status  = $('#gps-filtro-status').val();
                                    var autor   = $('#gps-filtro-autor').val();
                                    var dataIni = $('#gps-filtro-data-ini').val();
                                    var dataFim = $('#gps-filtro-data-fim').val();

                                    Object.keys(markersMateria).forEach(function (id) {
                                        var m = markersMateria[id];
                                        var mostrar = true;
                                        if (tipo    && m.idTipo        !== tipo)    mostrar = false;
                                        if (status  && m.status        !== status)  mostrar = false;
                                        if (autor   && m.autor         !== autor)   mostrar = false;
                                        if (dataIni && m.dataProtocolo && m.dataProtocolo < dataIni) mostrar = false;
                                        if (dataFim && m.dataProtocolo && m.dataProtocolo > dataFim) mostrar = false;

                                        if (m.marker) gpsSetVisible(m.marker, mostrar);
                                    });
                                }

                                $('#gps-filtro-tipo, #gps-filtro-status, #gps-filtro-autor').on('change', function () {
                                    tbMaterias.draw();
                                    filtrarMarcadores();
                                });
                                $('#gps-filtro-data-ini, #gps-filtro-data-fim').on('change', function () {
                                    tbMaterias.draw();
                                    filtrarMarcadores();
                                });
                            });
                        </script>

