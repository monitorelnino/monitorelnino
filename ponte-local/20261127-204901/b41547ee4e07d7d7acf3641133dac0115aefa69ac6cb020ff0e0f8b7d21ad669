                const SPEED_PX_PER_SECOND = 80;
                const MIN_DURATION = 20;

                function applyDuration(scroller) {
                    if (!scroller) return;
                    const segment = scroller.querySelector('.scrolling-content');
                    if (!segment) return;
                    const width = segment.scrollWidth;
                    if (!width) return;
                    const duration = Math.max(width / SPEED_PX_PER_SECOND, MIN_DURATION);
                    scroller.style.setProperty('--scroll-duration', duration + 's');
                }

                function updateAll() {
                    document.querySelectorAll('.scrolling-words').forEach(applyDuration);
                }

                const debouncedUpdate = (() => {
                    let frame;
                    return () => {
                        cancelAnimationFrame(frame);
                        frame = requestAnimationFrame(updateAll);
                    };
                })();

                document.addEventListener('DOMContentLoaded', debouncedUpdate);
                window.addEventListener('load', debouncedUpdate);
                window.addEventListener('resize', debouncedUpdate);

                let resizeObserver;
                if ('ResizeObserver' in window) {
                    resizeObserver = new ResizeObserver(debouncedUpdate);
