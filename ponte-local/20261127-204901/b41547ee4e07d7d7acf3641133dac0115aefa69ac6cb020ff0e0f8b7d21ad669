    <script>
        (function() {
            var param = new URLSearchParams(window.location.search).get('primary-color');
            if (!param) return;
            // Sanitização: permite apenas caracteres válidos em valores CSS de cor
            // (hex, rgb/rgba/hsl/hsla, nomes de cores) — bloqueia injeção CSS/HTML
            var safe = param.replace(/[^a-zA-Z0-9#(),%. +-]/g, '');
            if (!safe) return;
            // Se for apenas dígitos hex (ex: "ff0000" ou "f00"), adiciona o #
            if (/^[0-9a-fA-F]{3,8}$/.test(safe)) safe = '#' + safe;

            function clamp(value, min, max) {
                return Math.min(max, Math.max(min, value));
            }

            function parseColorToRgb(color) {
                var hexMatch = color.match(/^#?([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$/);
                if (hexMatch) {
                    var hex = hexMatch[1];
                    if (hex.length === 3 || hex.length === 4) {
                        hex = hex.split('').map(function(ch) {
                            return ch + ch;
                        }).join('');
                    }
                    return {
                        r: parseInt(hex.slice(0, 2), 16),
                        g: parseInt(hex.slice(2, 4), 16),
                        b: parseInt(hex.slice(4, 6), 16)
                    };
                }

                var rgbMatch = color.match(/^rgba?\(\s*([\d.]+)\s*,\s*([\d.]+)\s*,\s*([\d.]+)(?:\s*,\s*[\d.]+)?\s*\)$/i);
                if (rgbMatch) {
                    return {
                        r: clamp(parseFloat(rgbMatch[1]), 0, 255),
                        g: clamp(parseFloat(rgbMatch[2]), 0, 255),
                        b: clamp(parseFloat(rgbMatch[3]), 0, 255)
                    };
                }

                return null;
            }

            function parseHslTuple(color) {
                var hslMatch = color.match(/^hsla?\(\s*(-?[\d.]+)(?:deg)?\s*,\s*([\d.]+)%\s*,\s*([\d.]+)%(?:\s*,\s*[\d.]+)?\s*\)$/i);
                if (!hslMatch) return null;
                return {
                    h: ((parseFloat(hslMatch[1]) % 360) + 360) % 360,
                    s: clamp(parseFloat(hslMatch[2]), 0, 100),
                    l: clamp(parseFloat(hslMatch[3]), 0, 100)
                };
            }

            function rgbToHsl(rgb) {
                var r = rgb.r / 255;
                var g = rgb.g / 255;
                var b = rgb.b / 255;
                var max = Math.max(r, g, b);
                var min = Math.min(r, g, b);
                var h = 0;
                var s = 0;
                var l = (max + min) / 2;

                if (max !== min) {
                    var d = max - min;
                    s = l > 0.5 ? d / (2 - max - min) : d / (max + min);

                    if (max === r) h = (g - b) / d + (g < b ? 6 : 0);
                    else if (max === g) h = (b - r) / d + 2;
                    else h = (r - g) / d + 4;

                    h = h / 6;
                }

                return {
                    h: Math.round(h * 360),
                    s: Math.round(s * 100),
                    l: Math.round(l * 100)
                };
            }

            var baseHsl = parseHslTuple(safe);
            if (!baseHsl) {
                var rgb = parseColorToRgb(safe);
                if (rgb) baseHsl = rgbToHsl(rgb);
            }

            function applyCssVar(name, value) {
                document.documentElement.style.setProperty(name, value, 'important');
                if (document.body) {
                    document.body.style.setProperty(name, value, 'important');
                } else {
                    document.addEventListener('DOMContentLoaded', function() {
                        if (document.body) document.body.style.setProperty(name, value, 'important');
                    }, {
                        once: true
                    });
                }
            }

            applyCssVar('--color-primary', safe);

            if (baseHsl) {
                var h = baseHsl.h;
                var s = baseHsl.s;
                var l = baseHsl.l;
                var primaryDarkL = clamp(l - 12, 10, 70);
                var primaryLightL = clamp(l + 12, 20, 90);
                var primaryLighterL = clamp(l + 28, 30, 96);

                applyCssVar('--primary', h + ' ' + s + '% ' + l + '%');
                applyCssVar('--primary-dark', h + ' ' + clamp(s + 5, 0, 100) + '% ' + primaryDarkL + '%');
                applyCssVar('--primary-light', h + ' ' + clamp(s - 5, 0, 100) + '% ' + primaryLightL + '%');
                applyCssVar('--primary-lighter', h + ' ' + clamp(s - 10, 0, 100) + '% ' + primaryLighterL + '%');
                applyCssVar('--ring', h + ' ' + s + '% ' + l + '%');
            }
        })();
    </script>

