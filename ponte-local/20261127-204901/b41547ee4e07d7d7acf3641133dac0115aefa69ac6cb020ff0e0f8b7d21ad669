                        if (!el) return;

                        const total = Number(el.dataset.total || 0);
                        const perPageDesktop = Math.max(1, Math.min(5, total));
                        const perPageTablet = Math.max(1, Math.min(3, total));
                        const perPageMobile = Math.max(1, Math.min(2, total));
                        const permitirNavegacao = total > perPageDesktop;

                        new Splide(el, {
                            type: 'slide',
                            perPage: perPageDesktop,
                            perMove: 1,
                            gap: '20px',
                            rewind: permitirNavegacao,
                            drag: total > 1,
                            arrows: permitirNavegacao,
                            pagination: permitirNavegacao,
                            breakpoints: {
                                1024: {
                                    perPage: perPageTablet,
                                },
                                640: {
                                    perPage: perPageMobile,
                                },
                            },
                        }).mount();
                    })();
