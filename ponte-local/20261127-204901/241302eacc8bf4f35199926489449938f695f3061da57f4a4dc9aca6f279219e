<script>
function atualizarDataHoraTopBar() {
    const elementoRelogio = document.getElementById('top-bar-relogio');
    if (!elementoRelogio) return;

    const agora = new Date();

    // Formata a data (Ex: 13 de outubro de 2026)
    const opcoesData = { day: 'numeric', month: 'long', year: 'numeric' };
    const dataFormatada = agora.toLocaleDateString('pt-BR', opcoesData);

    // Formata as horas e minutos (Ex: 16:20)
    const horas = String(agora.getHours()).padStart(2, '0');
    const minutos = String(agora.getMinutes()).padStart(2, '0');

    // Atualiza o texto na top bar
    elementoRelogio.textContent = `${dataFormatada}, ${horas}:${minutos}`;
}

// Executa assim que o DOM estiver pronto e atualiza a cada 1 segundo
document.addEventListener("DOMContentLoaded", function() {
    atualizarDataHoraTopBar();
    setInterval(atualizarDataHoraTopBar, 1000);
});
