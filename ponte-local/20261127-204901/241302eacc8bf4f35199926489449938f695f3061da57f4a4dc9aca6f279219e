<!-- SCRIPT COMPLETO: AUTOPLAY + SETAS + BOLINHAS -->
<script>
  (function() {
    const container = document.getElementById('carrosselSlides');
    if (!container) return;

    const slides = container.querySelectorAll('.slide-item-flex');
    const pontos = document.querySelectorAll('.ponto-flex');
    const btnPrev = document.getElementById('btnPrev');
    const btnNext = document.getElementById('btnNext');
    
    let index = 0;
    const totalSlides = slides.length;
    let intervalo;

    function irParaSlide(novoIndex) {
      if (novoIndex >= totalSlides) index = 0;
      else if (novoIndex < 0) index = totalSlides - 1;
      else index = novoIndex;

      container.scrollTo({
        left: container.offsetWidth * index,
        behavior: 'smooth'
      });
      
      pontos.forEach(p => p.classList.remove('ativo'));
      if (pontos[index]) pontos[index].classList.add('ativo');
    }

    function proximoSlide() {
      irParaSlide(index + 1);
    }

    function slideAnterior() {
      irParaSlide(index - 1);
    }

    function iniciarTimer() {
      pararTimer();
      intervalo = setInterval(proximoSlide, 5000); // Roda a cada 5 segundos
    }

    function pararTimer() {
      if (intervalo) clearInterval(intervalo);
    }

    // Eventos de clique nas setas
    btnNext.addEventListener('click', () => { proximoSlide(); iniciarTimer(); });
    btnPrev.addEventListener('click', () => { slideAnterior(); iniciarTimer(); });

    // Eventos de clique nas bolinhas
    pontos.forEach((ponto, i) => {
      ponto.addEventListener('click', () => {
        irParaSlide(i);
        iniciarTimer();
      });
    });

    // Pausa ao passar o mouse por cima do carrossel
    const parentContainer = container.closest('.carrossel-destaques-abrangente');
