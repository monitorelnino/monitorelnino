    <script>
        function feedbackStars() {
            return {
                rate: 0,
                hoverRate: 0,
                starColor(i) {
                    const step = Math.min(this.displayRate, i * 2);
                    if (step <= (i - 1) * 2) return '#e5e7eb';

                    // posição global (1 a 10)
                    const position = step;

                    // interpolação HSL
                    const startHue = 45; // amarelo fraco
                    const endHue = 28; // laranja forte

                    const hue =
                        startHue - ((startHue - endHue) * (position - 1)) / 9;

                    return `hsl(${hue}, 95%, 60%)`;
                },

                get displayRate() {
                    return this.hoverRate || this.rate;
                },

                preview(i, event) {
                    const rect = event.currentTarget.getBoundingClientRect();
                    const half = (event.clientX - rect.left) < rect.width / 2;
                    this.hoverRate = half ? (i * 2 - 1) : (i * 2);
                },

                select(i, event) {
                    const rect = event.currentTarget.getBoundingClientRect();
                    const half = (event.clientX - rect.left) < rect.width / 2;
                    this.rate = half ? (i * 2 - 1) : (i * 2);
                    this.hoverRate = 0;
                    window.dispatchEvent(
                        new CustomEvent('open-modal', {
                            detail: 'feedback'
                        })
                    )
                },

                isFull(i) {
                    return this.displayRate >= i * 2;
                },

                isHalf(i) {
                    return this.displayRate === i * 2 - 1;
                }
            }
        }
    </script>
