<script type="text/javascript">
	(function () {
		if (window.__decCalendarioLigado) { return; }
		window.__decCalendarioLigado = true;

		function quadro() { return document.getElementById("decCalendario"); }

		function trocar(ano, mes) {
			var alvo = quadro();
			if (!alvo) { return; }

			var naHome = alvo.getAttribute("data-home") === "1";
			alvo.classList.add("dec-calendario-carregando");

			var url = "/diario-oficial/calendario?calAno=" + encodeURIComponent(ano)
			        + "&calMes=" + encodeURIComponent(mes)
			        + "&home=" + (naHome ? "true" : "false");

			fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } })
				.then(function (r) {
					if (!r.ok) { throw new Error(r.status); }
					return r.text();
				})
				.then(function (html) {
					var caixa = document.createElement("div");
					caixa.innerHTML = html.trim();
					var novoQuadro = caixa.querySelector("#decCalendario");
					if (!novoQuadro) { throw new Error("resposta sem calendário"); }

					var atual = quadro();
					atual.parentNode.replaceChild(novoQuadro, atual);

					// O endereço acompanha o mês que está na tela: assim recarregar
					// ou compartilhar o link cai no mesmo lugar.
					if (window.history && history.replaceState) {
						var u = new URL(window.location.href);
						u.searchParams.set("calAno", ano);
						u.searchParams.set("calMes", mes);
						history.replaceState(null, "", u.toString());
					}
				})
				.catch(function () {
					// Falhou a troca em pedaço: cai no comportamento de sempre, que
					// é a navegação normal. Ficar parado seria pior.
					var naHomeAgora = quadro() && quadro().getAttribute("data-home") === "1";
					window.location.href = (naHomeAgora ? "/" : "/diario-oficial")
						+ "?calAno=" + ano + "&calMes=" + mes;
				});
		}

		function doEndereco(href, nome) {
			var m = new RegExp("[?&]" + nome + "=([^&#]*)").exec(href || "");
			return m ? decodeURIComponent(m[1]) : null;
		}

		// As setas.
		document.addEventListener("click", function (e) {
			var seta = e.target.closest ? e.target.closest(".dec-calendario-navega") : null;
			if (!seta || !quadro() || !quadro().contains(seta)) { return; }

			var ano = doEndereco(seta.getAttribute("href"), "calAno");
			var mes = doEndereco(seta.getAttribute("href"), "calMes");
			if (!ano || !mes) { return; }   // sem os dois, deixa o link seguir

			e.preventDefault();
			trocar(ano, mes);
		});

		// Os combos de mês e ano.
		document.addEventListener("change", function (e) {
			var campo = e.target;
			if (!campo || (campo.id !== "calMes" && campo.id !== "calAno")) { return; }
			if (!quadro() || !quadro().contains(campo)) { return; }

			var mes = document.getElementById("calMes");
			var ano = document.getElementById("calAno");
			if (!mes || !ano) { return; }

			trocar(ano.value, mes.value);
		});

		// O botão "ir" só existe para quem não tem script. Some ao carregar, e
		// de novo a cada quadro novo — o de dentro do HTML trocado vem visível.
		function escondeIr() {
			var ir = document.getElementById("calendarioIr");
			if (ir) { ir.style.display = "none"; }
		}
		document.addEventListener("DOMContentLoaded", escondeIr);
		new MutationObserver(escondeIr).observe(document.documentElement,
			{ childList: true, subtree: true });
		escondeIr();
	}());
</script>

