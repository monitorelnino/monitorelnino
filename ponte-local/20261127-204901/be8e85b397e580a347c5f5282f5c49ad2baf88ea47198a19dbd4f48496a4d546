	<script>
		(function () {
			// Uma vez por pagina: o bloco pode aparecer mais de uma vez (a
			// ultima edicao no topo e a edicao aberta), e os manipuladores sao
			// delegados no documento.
			if (window.__decCompartilharLigado) { return; }
			window.__decCompartilharLigado = true;

			var temNativo = typeof navigator.share === 'function';

			document.querySelectorAll('.dec-compartilhar').forEach(function (bloco) {
				var nativo = bloco.querySelector('.dec-compartilhar-nativo');
				var links = bloco.querySelector('.dec-compartilhar-links');
				var copiar = bloco.querySelector('.dec-compartilhar-copiar');

				if (temNativo) {
					nativo.hidden = false;
					links.hidden = true;
				} else if (copiar) {
					// Sem a folha nativa, "copiar link" e o que substitui o
					// "enviar para qualquer outro aplicativo" dela.
					copiar.hidden = false;
				}
			});

			function avisa(bloco, frase) {
				var p = bloco.querySelector('.dec-compartilhar-aviso');
				if (!p) { return; }

				clearTimeout(p.__some);
				clearTimeout(p.__escreve);

				// ZERA ANTES DE ESCREVER. Regiao ao vivo anuncia MUDANCA: sem
				// isto, repetir a mesma acao (copiar o link duas vezes) escrevia
				// a mesma frase, nao mudava nada e nao dizia nada a quem usa
				// leitor de tela.
				p.textContent = '';
				p.classList.remove('dec-hide');
				p.__escreve = setTimeout(function () { p.textContent = frase; }, 50);

				// Passado o tempo, o aviso some da TELA mas o texto fica: apagar
				// tambem o texto seria mais uma mudanca para anunciar, e o
				// leitor de tela repetiria a frase sozinho quatro segundos
				// depois da acao.
				p.__some = setTimeout(function () { p.classList.add('dec-hide'); }, 4000);
			}

			document.addEventListener('click', function (e) {
				var botao = e.target.closest('.dec-compartilhar-nativo, .dec-compartilhar-copiar');
				if (!botao) { return; }

				var bloco = botao.closest('.dec-compartilhar');
				var link = bloco.getAttribute('data-link');
				var texto = bloco.getAttribute('data-texto');

				if (botao.classList.contains('dec-compartilhar-nativo')) {
					// AbortError e a pessoa fechando a folha - nao e falha, e
					// avisar "nao consegui" ali seria mentira.
					// title e text SEPARADOS: ha destino que mostra os dois em
					// seguida (o e-mail usa title de assunto), e mandar a mesma
					// frase nos dois faz a mensagem sair repetida.
					navigator.share({ title: bloco.getAttribute('data-titulo'), text: texto, url: link })
						.catch(function (erro) {
							if (erro && erro.name === 'AbortError') { return; }
							bloco.querySelector('.dec-compartilhar-links').hidden = false;
							avisa(bloco, 'Não consegui abrir o compartilhamento. Use as opções acima.');
						});
					return;
				}

				copiaLink(bloco, link);
			});

			function copiaLink(bloco, link) {
				function pelaTelaAntiga() {
					var campo = document.createElement('textarea');
					campo.value = link;
					campo.setAttribute('readonly', '');
					campo.style.cssText = 'position:fixed;top:-1000px;opacity:0';
					document.body.appendChild(campo);
					campo.select();
					var deu = false;
					try { deu = document.execCommand('copy'); } catch (erro) { deu = false; }
					document.body.removeChild(campo);
					return deu;
				}

				function resultado(ok) {
					avisa(bloco, ok ? 'Link copiado.' : 'Não consegui copiar. O endereço está na barra do navegador.');
				}

				// navigator.clipboard exige contexto seguro E permissao, e ela
				// pode ser NEGADA mesmo em https. Negada, o caminho antigo
