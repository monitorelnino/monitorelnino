	<script type="text/javascript">
		(function () {
			// Uma vez por página: o bloco pode aparecer mais de uma vez, e este
			// script varre todas as capas de uma vez.
			if (window.__decCapasLigadas) { return; }
			window.__decCapasLigadas = true;

			var telas = document.querySelectorAll(".dec-capa-canvas");
			if (!telas.length || !window.pdfjsLib) { return; }

			pdfjsLib.GlobalWorkerOptions.workerSrc = "/js/pdfjs/pdf.worker.min.js?v=6195a19b81679dfb";

			// GUARDA A CAPA JÁ DESENHADA NO NAVEGADOR DE QUEM VISITA.
			//
			// Desenhar a capa custa baixar o PDF, e a home é a página mais
			// visitada do portal: sem isto, toda visita puxaria o arquivo de
			// novo. Guardada, a segunda visita não gasta rede nenhuma.
			//
			// A chave leva a LARGURA porque a capa da home e a da página do
			// Diário não têm o mesmo tamanho, e esticar a menor borraria.
			var PREFIXO = "dec-capa-v1-";

			function leGuardado(chave) {
				try { return localStorage.getItem(chave); } catch (erro) { return null; }
			}

			function guarda(chave, imagem, idAtual) {
				try {
					// Capa de edição ANTIGA não serve mais para nada: publicada
					// uma nova, a anterior nunca mais é pedida.
					var apagar = [];
					for (var i = 0; i < localStorage.length; i++) {
						var k = localStorage.key(i);
						if (k && k.indexOf(PREFIXO) === 0 && k.indexOf(PREFIXO + idAtual + "-") !== 0) {
							apagar.push(k);
						}
					}
					for (var j = 0; j < apagar.length; j++) { localStorage.removeItem(apagar[j]); }

					localStorage.setItem(chave, imagem);
				} catch (erro) {
					// Cota cheia ou navegação privada. A capa continua na tela;
					// só não fica guardada para a próxima visita.
				}
			}

			function mostra(tela) {
				var reserva = tela.parentElement.querySelector(".dec-capa-reserva");
				// Só esconde o ícone DEPOIS de a capa existir: falhando o
				// desenho, o cartão continua com a marca de PDF em vez de um
				// retângulo vazio.
				if (reserva) { reserva.style.display = "none"; }
				tela.classList.add("pronta");
			}

			function pelaGuardada(tela, imagem) {
				return new Promise(function (resolve, reject) {
					var img = new Image();
					img.onload = function () {
						tela.width = img.width;
						tela.height = img.height;
						tela.style.width = "100%";
						tela.style.height = "auto";
						tela.getContext("2d").drawImage(img, 0, 0);
						mostra(tela);
						resolve();
					};
					img.onerror = reject;
					img.src = imagem;
				});
			}

			function peloPdf(tela, largura, chave) {
				var enderecos = [tela.getAttribute("data-arquivo"), tela.getAttribute("data-proxy")];

				function abre(i) {
					// disableAutoFetch: só os bytes necessários para a PRIMEIRA
					// página, e não o PDF inteiro. Servidor sem suporte a Range
					// simplesmente baixa tudo, como antes.
					return pdfjsLib.getDocument({ url: enderecos[i], disableAutoFetch: true }).promise
						.catch(function (erro) {
							if (i + 1 < enderecos.length) { return abre(i + 1); }
							throw erro;
						});
				}

				return abre(0)
					.then(function (pdf) { return pdf.getPage(1); })
					.then(function (pagina) {
						// A altura acompanha a proporção da página real: A4 e A3
						// não têm a mesma forma.
						var natural = pagina.getViewport({ scale: 1 });
						var visao = pagina.getViewport({ scale: largura / natural.width });

						var densidade = window.devicePixelRatio || 1;
						tela.width = Math.floor(visao.width * densidade);
						tela.height = Math.floor(visao.height * densidade);
						tela.style.width = "100%";
						tela.style.height = "auto";

						var ctx = tela.getContext("2d");
						// Fundo branco antes de desenhar: o que sobra
						// transparente vira PRETO ao guardar em JPEG.
						ctx.fillStyle = "#fff";
						ctx.fillRect(0, 0, tela.width, tela.height);
						ctx.setTransform(densidade, 0, 0, densidade, 0, 0);

						return pagina.render({ canvasContext: ctx, viewport: visao }).promise;
					})
					.then(function () {
						mostra(tela);
						try {
							guarda(chave, tela.toDataURL("image/jpeg", 0.72),
								   tela.getAttribute("data-edicao"));
						} catch (erro) { /* sem guardar; a capa ja esta na tela */ }
					});
			}

			Array.prototype.forEach.call(telas, function (tela) {
				var largura = Math.round(tela.parentElement.clientWidth || 200);
				var chave = PREFIXO + tela.getAttribute("data-edicao") + "-" + largura;
				var guardada = leGuardado(chave);

				var trabalho = guardada
					? pelaGuardada(tela, guardada).catch(function () { return peloPdf(tela, largura, chave); })
					: peloPdf(tela, largura, chave);

				trabalho.catch(function () { /* fica o icone */ });
			});
		}());
	</script>


