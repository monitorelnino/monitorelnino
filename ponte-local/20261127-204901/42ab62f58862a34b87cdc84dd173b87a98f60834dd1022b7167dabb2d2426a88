    <script>
    document.getElementById('pesquisaTabela').addEventListener('keyup', function () {
        let filtro = this.value.toLowerCase();
        let linhas = document.querySelectorAll('#tabelaDados tbody tr');
    
        linhas.forEach(function(linha) {
            let textoLinha = linha.innerText.toLowerCase();
            linha.style.display = textoLinha.includes(filtro) ? '' : 'none';
        });
    });
    </script>   
    <script>
    function exportTableToCSV(filename) {
      // Obtém a tabela
      const table = document.getElementById("tabelaDados");
      
      // Cria o conteúdo CSV
      let csv = [];
      
      // Percorre as linhas da tabela
      for (let i = 0; i < table.rows.length; i++) {
        const row = table.rows[i];
        const rowData = [];
        
        // Percorre as células da linha
        for (let j = 0; j < row.cells.length; j++) {
          // Adiciona o conteúdo da célula entre aspas para lidar com vírgulas
          rowData.push('"' + row.cells[j].innerText.replace(/"/g, '""') + '"');
        }
        
        csv.push(rowData.join(","));
      }
      
      // Junta todas as linhas com quebra de linha
      const csvContent = csv.join("\n");
      
      // Cria um blob com o conteúdo
      const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
      
      // Cria um link para download
      const link = document.createElement("a");
      const url = URL.createObjectURL(blob);
      
      link.setAttribute("href", url);
      link.setAttribute("download", filename);
      link.style.visibility = "hidden";
      
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }
    </script>                    
