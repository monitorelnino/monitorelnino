    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var carousel = document.querySelector(".home-noticias-instagram-servicos-section .videos-lista");

            if (!carousel) return;

            var slides = Array.from(carousel.querySelectorAll(".videos-lista-item"));
            var intervaloPadrao = 8000;
            var atual = null;
            var interagiu = false;
            var slider = null;

            function atualizarControles(item) {
                if (!item) return;

                var video = item.querySelector(".video-insta");
                var botaoPlay = item.querySelector(".btn-insta-play");
                var botaoSom = item.querySelector(".btn-insta-som");

                if (!video) return;

                video.controls = !video.muted && !video.paused;

                if (botaoPlay) {
                    botaoPlay.style.display = video.paused ? "flex" : "none";
                }

                if (botaoSom) {
                    botaoSom.style.display = !video.paused && video.muted ? "flex" : "none";
                }
            }

            function alterarIntervalo(tempo) {
                tempo = Math.max(1000, Math.ceil(tempo));

                if (carousel.getAttribute("data-interval") !== String(tempo)) {
                    carousel.setAttribute("data-interval", String(tempo));
                }

                if (slider && slider.options) {
                    slider.options.interval = tempo;
                }
            }

            function atualizarIntervaloVideo(video, item) {
                if (atual !== item) return;

                if (isFinite(video.duration) && video.duration > 0) {
                    alterarIntervalo(video.duration * 1000);
                }
            }

            function carregarVideoAtivo(video) {
                var fonte = video.querySelector("source[data-src]");

                if (!fonte) return;

                fonte.src = fonte.getAttribute("data-src");
                fonte.removeAttribute("data-src");

                video.preload = "metadata";
                video.load();
            }

            function pararVideoAnterior(item) {
                if (!item) return;

                var video = item.querySelector(".video-insta");

                if (!video) return;

                video.pause();
                video.muted = true;
                video.controls = false;

                atualizarControles(item);
            }

            function iniciarVideo(item, video) {
                if (atual !== item || interagiu) return;

                atualizarIntervaloVideo(video, item);

                video.muted = true;
                video.controls = false;
                video.loop = false;

                if (video.currentTime > 0) {
                    video._reinicioAutomatico = true;

                    try {
                        video.currentTime = 0;
                    } catch (e) {
                        video._reinicioAutomatico = false;
                    }
                }

                var reproducao = video.play();

                if (reproducao && typeof reproducao.catch === "function") {
                    reproducao.catch(function () {
                        atualizarControles(item);
                    });
                }

                atualizarControles(item);
            }

            function atualizarTempoCarousel() {
                if (!slider) return;

                var item = slider.currentElement;

                if (!item || item === atual) return;

                var anterior = atual;

                atual = item;
                interagiu = false;

                pararVideoAnterior(anterior);

                if (!carousel.hasAttribute("data-play")) {
                    carousel.setAttribute("data-play", "");
                }

                slider.pause();

                var video = item.querySelector(".video-insta");

                if (!video) {
                    alterarIntervalo(intervaloPadrao);
                    slider.play();
                    return;
                }

                alterarIntervalo(intervaloPadrao);

                if (video.readyState >= 1) {
                    iniciarVideo(item, video);
                } else {
                    carregarVideoAtivo(video);
                }
            }

            function pausarAutoplay() {
                interagiu = true;

                carousel.removeAttribute("data-play");

                if (slider) {
                    slider.pause();
                }
            }

            function ativarVideo(item) {
                if (atual !== item) return;

                var video = item.querySelector(".video-insta");

                if (!video) return;

                pausarAutoplay();

                video.muted = false;
                video.controls = true;

                if (video.paused) {
                    var reproducao = video.play();

                    if (reproducao && typeof reproducao.catch === "function") {
                        reproducao.catch(function () {
                            atualizarControles(item);
                        });
                    }
                }

                atualizarControles(item);
            }

            slides.forEach(function (item) {
                var video = item.querySelector(".video-insta");

                if (!video) return;

                var botaoPlay = item.querySelector(".btn-insta-play");
                var botaoSom = item.querySelector(".btn-insta-som");

                video.loop = false;
                video.muted = true;
                video.controls = false;
                video.autoplay = false;

                video.addEventListener("loadedmetadata", function () {
                    if (atual !== item) return;

                    atualizarIntervaloVideo(video, item);

                    if (video.paused && !interagiu) {
                        iniciarVideo(item, video);
                    }
                });

                video.addEventListener("durationchange", function () {
                    atualizarIntervaloVideo(video, item);
                });

                video.addEventListener("click", function (e) {
                    if (atual !== item) return;

                    if (video.controls && !video.muted) {
                        return;
                    }

                    e.preventDefault();
                    e.stopPropagation();

                    ativarVideo(item);
                });

                [botaoPlay, botaoSom].forEach(function (botao) {
                    if (!botao) return;

                    botao.addEventListener("click", function (e) {
                        e.preventDefault();
                        e.stopPropagation();

                        ativarVideo(item);
                    });
                });

                video.addEventListener("play", function () {
                    atualizarControles(item);
                });

                video.addEventListener("pause", function () {
                    atualizarControles(item);
                });

                video.addEventListener("volumechange", function () {
                    atualizarControles(item);
                });

                video.addEventListener("ended", function () {
                    atualizarControles(item);

                    if (!slider || atual !== item || interagiu || !carousel.hasAttribute("data-play")) {
                        return;
                    }

                    if (slides.length === 1) {
                        iniciarVideo(item, video);
                    } else {
                        slider.goNext();
                    }
                });

                video.addEventListener("seeked", function () {
                    if (video._reinicioAutomatico) {
                        video._reinicioAutomatico = false;
                        return;
                    }

                    if (atual !== item) return;

                    pausarAutoplay();
                });

                video.addEventListener("error", function () {
                    atualizarControles(item);

                    if (slider && atual === item && !interagiu && slides.length > 1) {
                        slider.goNext();
                    }
                });
            });

            function conectarSlider() {
                if (!carousel.slider) return false;

                slider = carousel.slider;

                var playOriginal = slider.play.bind(slider);
                var pauseOriginal = slider.pause.bind(slider);

                slider.play = function () {
                    if (!carousel.hasAttribute("data-play") || interagiu) {
                        pauseOriginal();
                        return slider;
                    }

                    if (slider.currentElement && slider.currentElement.querySelector(".video-insta")) {
                        pauseOriginal();
                        return slider;
                    }

                    slider.options.interval = intervaloPadrao;

                    pauseOriginal();

                    return playOriginal();
                };

                carousel.addEventListener("render", atualizarTempoCarousel);

                atualizarTempoCarousel();

                return true;
            }

            if (!conectarSlider()) {
                var tentativas = 0;

                var buscarSlider = setInterval(function () {
                    tentativas++;

                    if (conectarSlider() || tentativas >= 100) {
                        clearInterval(buscarSlider);
                    }
                }, 50);
            }
        });
    </script>

    

