                    li.setAttribute('aria-label', 'Destaque ' + (idx + 1) + ' de ' + slideLis.length);
                });

                function updateSliderTabindex() {
                    slideLis.forEach(function(li) {
                        var isActive = li.classList.contains('flex-active-slide') || 
                                       (window.getComputedStyle(li).display !== 'none' && window.getComputedStyle(li).opacity !== '0');
                        var links = li.querySelectorAll('a, button');
                        links.forEach(function(el) {
                            if (isActive) {
                                el.setAttribute('tabindex', '0');
                                el.removeAttribute('aria-hidden');
                            } else {
                                el.setAttribute('tabindex', '-1');
                                el.setAttribute('aria-hidden', 'true');
                            }
                        });
                    });
                }

                updateSliderTabindex();

                // Observar transições do slider para atualizar tabindex dos slides
                var observer = new MutationObserver(function() {
                    updateSliderTabindex();
                });
                observer.observe(slider, { attributes: true, subtree: true, attributeFilter: ['class', 'style'] });

                if (window.jQuery) {
                    window.jQuery('#flexslider').on('after', function() {
                        setTimeout(updateSliderTabindex, 50);
                    });
                }

                // Pausar slider quando usuário focar nele (WCAG 2.2.2)
                slider.addEventListener('focusin', function() {
                    if (window.jQuery && window.jQuery.fn.flexslider) {
                        try { window.jQuery('#flexslider').flexslider('pause'); } catch(e){}
                    }
                });

                // Setas com rotulos descritivos
                var prevBtn = slider.querySelector('.flex-prev');
                var nextBtn = slider.querySelector('.flex-next');
                if (prevBtn) prevBtn.setAttribute('aria-label', 'Slide anterior');
                if (nextBtn) nextBtn.setAttribute('aria-label', 'Próximo slide');

                // Adicionar classe visual nos links focados do slide
                slider.addEventListener('focusin', function(e) {
                    if (e.target && e.target.tagName === 'A') {
                        e.target.classList.add('ghome-focused-slide');
                    }
                });
                slider.addEventListener('focusout', function(e) {
                    if (e.target && e.target.tagName === 'A') {
                        e.target.classList.remove('ghome-focused-slide');
                    }
                });

                // NAVEGACAO PELAS TECLAS DIRECIONAIS NO SLIDE (ArrowLeft / ArrowRight / Home / End)
                slider.addEventListener('keydown', function(e) {
                    if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
                        e.preventDefault();
                        if (nextBtn) {
                            nextBtn.click();
                        } else if (window.jQuery && window.jQuery.fn.flexslider) {
                            window.jQuery('#flexslider').flexslider('next');
                        }
                        setTimeout(function() {
                            updateSliderTabindex();
                            var activeLink = slider.querySelector('.flex-active-slide a');
                            if (activeLink) activeLink.focus();
                        }, 80);
                    } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
                        e.preventDefault();
                        if (prevBtn) {
                            prevBtn.click();
                        } else if (window.jQuery && window.jQuery.fn.flexslider) {
                            window.jQuery('#flexslider').flexslider('prev');
