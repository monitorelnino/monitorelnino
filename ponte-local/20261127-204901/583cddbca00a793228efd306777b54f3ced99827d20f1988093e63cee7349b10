                                var linkTitle = a.getAttribute('title') || a.getAttribute('aria-label') || a.innerText || a.textContent || '';
                                loadAndReadPdf(h, linkTitle);
                                return false;
                            }
                            if (/\.(docx?|xlsx?|pptx?|zip|rar|7z|csv|odt|ods)(\?.*)?$/i.test(h)) {
                                e.preventDefault();
                                e.stopPropagation();
                                e.stopImmediatePropagation();
                                speakVoiceNotice('Este documento está em formato de anexo e não pode ser lido diretamente por voz.');
                                return false;
                            }
                        }
                    }
                }
            }, true);

            function checkAndAutoStartTtsContinuity() {
                if (!isTtsActiveMode()) return;

                // Detectar se a página foi recarregada (ex: tecla F5 ou Ctrl+R)
                var isReload = false;
                try {
                    var navEntries = (window.performance && window.performance.getEntriesByType) 
                        ? window.performance.getEntriesByType('navigation') 
                        : null;
                    if (navEntries && navEntries.length > 0) {
                        isReload = (navEntries[0].type === 'reload');
                    } else if (window.performance && window.performance.navigation) {
                        isReload = (window.performance.navigation.type === 1);
                    }
                } catch(e){}

                var hasUserActivation = true;
                if (window.navigator && window.navigator.userActivation && typeof window.navigator.userActivation.hasBeenActive === 'boolean') {
                    hasUserActivation = window.navigator.userActivation.hasBeenActive;
                }

                // Se a página sofreu refresh (F5) ou o navegador ainda não possui ativação do usuário:
                // Prepara a fila e o player em estado pausado e elegante, sem correr pelos tópicos!
                if (isReload || !hasUserActivation) {
                    buildReadingQueue();
                    if (readingQueue.length === 0) return;

                    var p = getOrCreatePlayer();
                    p.classList.add('is-visible');
                    loadVoices();
                    populateVoiceSelect();

                    currentIndex = defaultStartIndex;
                    isPlaying = false;
                    isPaused = true;
                    updatePlayerUI();

                    var pill = p.querySelector('#ghome-tts-pill');
                    if (pill) {
                        pill.textContent = isMobileDevice ? '⏸️ Dê um toque na tela para ouvir' : '⏸️ Pressione Espaço ou clique para ouvir';
                    }

                    // Registra o desbloqueador suave para o primeiro toque/tecla
                    setupUserGestureUnlock();
                    return;
                }

                var attempts = 0;
                var autoStarted = false;
                function tryAutoStart() {
                    if (autoStarted || !isTtsActiveMode() || isPlaying) return;

                    loadVoices();
                    if (availablePtVoices.length === 0 && attempts < 20) {
                        attempts++;
                        setTimeout(tryAutoStart, 100);
                        return;
                    }

                    autoStarted = true;
                    startReading(defaultStartIndex);
                }

                // Inicia assim que as vozes do navegador ficarem disponíveis (sem espera fixa)
                try {
                    if (window.speechSynthesis && window.speechSynthesis.addEventListener) {
                        window.speechSynthesis.addEventListener('voiceschanged', function onVoicesReady() {
                            window.speechSynthesis.removeEventListener('voiceschanged', onVoicesReady);
                            tryAutoStart();
                        });
                    }
                } catch(e){}

                setTimeout(tryAutoStart, 30);
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', checkAndAutoStartTtsContinuity);
            } else {
                checkAndAutoStartTtsContinuity();
            }
        })();

