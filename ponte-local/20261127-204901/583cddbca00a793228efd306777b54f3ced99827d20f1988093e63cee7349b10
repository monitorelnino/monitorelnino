                            <td style="padding: 7px 10px; border: 1px solid #cbd5e1;">Pula direto para o <strong>campo de busca do portal</strong></td>
                        </tr>
                        <tr>
                            <td style="padding: 7px 10px; border: 1px solid #cbd5e1;"><kbd style="background: #e2e8f0; padding: 2px 6px; border-radius: 4px; font-weight: 700;">Alt + 4</kbd></td>
                            <td style="padding: 7px 10px; border: 1px solid #cbd5e1;">Pula direto para o <strong>rodapé institucional</strong></td>
