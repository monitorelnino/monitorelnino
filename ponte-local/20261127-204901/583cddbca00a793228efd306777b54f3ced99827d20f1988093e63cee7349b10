                curTopicIdx++;
                readingQueue = readingQueue.concat(extractBreadcrumbsReadingItems(curTopicIdx, pageTitle));

                // PONTO DE ENTRADA DO ÁUDIO NA PÁGINA INTERNA:
                // O áudio inicia imediatamente no conteúdo da página (título/acolhimento),
                // permitindo ao cidadão voltar com a Seta para Cima (ArrowUp) até o topo do website!
                defaultStartIndex = readingQueue.length;

                curTopicIdx++;

                // D) ACOLHIMENTO E TÍTULO DA PÁGINA INTERNA
                // Detectar se a página possui controle de exercícios / anos e publicações oficiais
                var yearWrap = document.querySelector('.gp-year-nav-wrap, .gd-year-nav-wrap, .gr-year-nav-wrap, .glic-year-nav-wrap, .gaud-year-nav-wrap, .ged-year-nav-wrap, [class*="-year-nav-wrap"], [class*="-year-pills"]');
                var yearPills = yearWrap ? Array.from(yearWrap.querySelectorAll('button.gp-year-pill, button.gd-year-pill, button.gr-year-pill, button.glic-year-pill, button.gaud-year-pill, button.ged-year-pill, button[data-year], a[data-year], .gp-year-pill, .gd-year-pill, .gr-year-pill, .glic-year-pill, .gaud-year-pill, .ged-year-pill, [class*="-year-pill"]')).filter(function(yp) {
                    if (!isElementVisible(yp)) return false;
                    // Exclui rigorosamente containers wrapper que agrupam os botões de anos
                    if (yp.tagName === 'DIV' || yp.classList.contains('gp-year-pills') || yp.classList.contains('gd-year-pills') || yp.classList.contains('gr-year-pills') || yp.classList.contains('glic-year-pills') || yp.classList.contains('gaud-year-pills') || yp.classList.contains('ged-year-pills') || (yp.className && yp.className.indexOf('-year-pills') !== -1) || yp.querySelector('button, [data-year]')) {
                        return false;
                    }
                    return true;
                }) : [];

                // REGRA UNIVERSAL: Começar SEMPRE pelo último ano (ano numérico mais recente, ex: 2026) em ordem decrescente, e deixar 'Todos os Anos' sempre por último!
                yearPills.sort(function(a, b) {
                    var aVal = (a.getAttribute('data-year') || a.textContent || '').trim().toLowerCase();
                    var bVal = (b.getAttribute('data-year') || b.textContent || '').trim().toLowerCase();
                    var aIsAll = (aVal === 'all' || aVal.indexOf('todos') !== -1 || a.textContent.toLowerCase().indexOf('todos') !== -1);
                    var bIsAll = (bVal === 'all' || bVal.indexOf('todos') !== -1 || b.textContent.toLowerCase().indexOf('todos') !== -1);

                    if (aIsAll && !bIsAll) return 1;  // 'Todos os Anos' vai sempre para o fim da fila
                    if (!aIsAll && bIsAll) return -1; // Anos numéricos têm prioridade máxima no início
                    if (aIsAll && bIsAll) return 0;

                    var aNum = parseInt(aVal.replace(/\D/g, ''), 10) || 0;
                    var bNum = parseInt(bVal.replace(/\D/g, ''), 10) || 0;
                    return bNum - aNum; // Ordem decrescente: o último ano (mais recente, maior número) fica em primeiro lugar absoluto
                });

                var pTitleLower = pageTitle.toLowerCase();
                var docTypeSingular = 'publicação';
                var docTypePlural = 'publicações';
                if (pTitleLower.indexOf('portaria') !== -1 || document.querySelector('.gp-card') !== null) {
