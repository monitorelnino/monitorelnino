                    // Item 1: Instruções completas de navegação adaptadas por dispositivo
                    var navNoticeText = isMobileDevice
                        ? ('Instruções de navegação do documento no celular: Dê um toque em qualquer lugar da tela para pausar ou continuar a leitura. Deslize para a direita para avançar para o próximo parágrafo ou para a esquerda para voltar. Para retornar à página anterior, deslize para cima com dois dedos ou use o botão voltar.')
