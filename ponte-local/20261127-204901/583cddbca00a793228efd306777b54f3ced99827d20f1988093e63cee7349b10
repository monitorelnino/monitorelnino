                    <caption class="screen-reader-text">Tabela de comandos de teclado para navegação no player de voz</caption>
                    <thead>
                        <tr style="background: #f1f5f9; text-align: left;">
                            <th scope="col" style="padding: 7px 10px; border: 1px solid #cbd5e1; width: 140px;">Tecla</th>
                            <th scope="col" style="padding: 7px 10px; border: 1px solid #cbd5e1;">Ação no Leitor de Voz</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 7px 10px; border: 1px solid #cbd5e1;"><kbd style="background: #e2e8f0; padding: 2px 6px; border-radius: 4px; font-weight: 700;">Barra de Espaço</kbd></td>
