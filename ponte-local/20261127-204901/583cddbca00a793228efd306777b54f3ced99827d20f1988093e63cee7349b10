                    selectEl.innerHTML = '<option value="" style="background:#0b1329 !important; color:#ffffff !important;">⭐ Voz do Google</option>';
                    return;
                }

                selectEl.innerHTML = '';
                for (var i = 0; i < availablePtVoices.length; i++) {
                    var v = availablePtVoices[i];
                    var opt = document.createElement('option');
                    opt.value = v.name;
                    opt.style.backgroundColor = '#0b1329';
                    opt.style.color = '#ffffff';

                    var label = v.name;
                    if (isGoogleVoice(v)) {
                        label = '⭐ Voz do Google';
                    } else if (isNaturalFemaleVoice(v)) {
                        label = '✨ Francisca Natural (Microsoft)';
                    } else if (v.name.indexOf('Maria') !== -1) {
                        label = '👩 Maria (Nativa)';
                    } else if (v.name.indexOf('Luciana') !== -1 || v.name.indexOf('Heloisa') !== -1) {
                        label = '🍎 Siri / Apple (pt-BR)';
                    } else if (v.name.indexOf('Daniel') !== -1) {
                        label = '👨 Daniel (SAPI)';
                    }

                    opt.textContent = label;
                    if (ptVoice && ptVoice.name === v.name) {
                        opt.selected = true;
                    }
                    selectEl.appendChild(opt);
                }
            }

