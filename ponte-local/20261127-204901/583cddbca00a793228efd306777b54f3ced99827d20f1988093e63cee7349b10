        function getSuggestions(query) {
            var rawQ = (query || '').trim();
            var q = cleanStr(rawQ);
            if (!q || q.length < 2) return [];

            var mAno = q.match(/\b(20[123]\d)\b/);
            var ano = mAno ? mAno[1] : '';

            var catalog = (window.ghomeSmartCatalog && Array.isArray(window.ghomeSmartCatalog)) ? window.ghomeSmartCatalog : [];

            var qTokens = q.split(/\s+/).filter(function(w) { return w.length > 1 && w !== 'ano'; });
            var scoredItems = [];
            var seenUrls = {};

            for (var i = 0; i < catalog.length; i++) {
                var it = catalog[i];
                if (!it || !it.title || !it.url) continue;

                var itemTitle = it.title;
                var itemBadge = it.badge || '';
                var itemUrl = it.url;
                var itemDesc = it.desc || '';
                var itemIcon = it.icon || '📌';

                if (ano && it.has_year) {
                    itemTitle = itemTitle.replace(/\{ano\}/g, ano);
                    itemBadge = itemBadge.replace(/\{ano\}/g, ano);
                    if (itemUrl.indexOf('?') > -1) {
                        itemUrl = itemUrl.replace(/([?&]ano=)[^&]*/, '$1' + ano);
                        if (itemUrl.indexOf('ano=') === -1) itemUrl += '&ano=' + ano;
                    } else {
                        itemUrl += '?ano=' + ano;
                    }
                } else if (it.has_year) {
                    itemTitle = itemTitle.replace(/\s*\{ano\}/g, '');
                    itemBadge = itemBadge.replace(/\s*\{ano\}/g, '');
                }

                // Se houver número de ato identificado na busca, repassar o parâmetro exato para o link da sugestão
                if (num) {
                    var numParamName = '';
                    if (itemUrl.indexOf('portaria') > -1) numParamName = 'gp_num';
                    else if (itemUrl.indexOf('decreto') > -1) numParamName = 'gd_num';
                    else if (itemUrl.indexOf('resoluc') > -1) numParamName = 'gr_num';
                    else if (itemUrl.indexOf('licita') > -1 || itemUrl.indexOf('pregao') > -1 || itemUrl.indexOf('dispensa') > -1) numParamName = 'glic_num';
                    else if (itemUrl.indexOf('audiencia') > -1) numParamName = 'gaud_num';
                    else if (itemUrl.indexOf('edita') > -1) numParamName = 'ged_num';

                    if (numParamName) {
                        var sep = itemUrl.indexOf('?') > -1 ? '&' : '?';
                        itemUrl += sep + numParamName + '=' + encodeURIComponent(num);
                    }
                }

                var cleanTitle = cleanStr(itemTitle);
                var cleanBadge = cleanStr(itemBadge);
                var cleanDesc = cleanStr(itemDesc);
                var tags = Array.isArray(it.tags) ? it.tags : [];

                var score = 0;

                // 1. Título idêntico ou prefixo
                if (cleanTitle === q) {
                    score += 200;
                } else if (cleanTitle.indexOf(q) === 0) {
                    score += 120;
                } else if (cleanTitle.indexOf(q) > -1) {
                    score += 80;
                }

                // 2. Tags correspondentes
                for (var t = 0; t < tags.length; t++) {
                    var tagClean = cleanStr(tags[t]);
                    if (!tagClean || tagClean === 'ano') continue;
                    if (tagClean === q) {
                        score += 150;
                        break;
                    } else if (tagClean.indexOf(q) === 0) {
                        score += 90;
                        break;
                    } else if (q.indexOf(tagClean) === 0 || (tagClean.length >= 4 && q.indexOf(tagClean) > -1) || qTokens.indexOf(tagClean) > -1) {
                        score += 60;
                        break;
                    }
                }

                // 3. Verificação de tokens da busca
                if (qTokens.length > 0) {
                    var tokensFound = 0;
                    for (var tk = 0; tk < qTokens.length; tk++) {
                        var tok = qTokens[tk];
                        var foundThisToken = false;

                        if (cleanTitle.indexOf(tok) > -1) {
                            foundThisToken = true;
                        } else if (cleanBadge.indexOf(tok) > -1) {
                            foundThisToken = true;
                        } else if (cleanDesc.indexOf(tok) > -1) {
                            foundThisToken = true;
                        } else {
                            for (var tg = 0; tg < tags.length; tg++) {
                                var tgClean = cleanStr(tags[tg]);
                                if (tgClean && tgClean !== 'ano' && tgClean.indexOf(tok) > -1) {
                                    foundThisToken = true;
                                    break;
                                }
                            }
                        }

                        if (foundThisToken) tokensFound++;
                    }

                    if (tokensFound === qTokens.length) {
                        score += 50 + (tokensFound * 15);
                    } else if (tokensFound > 0) {
                        score += (tokensFound * 10);
                    }
                }

                // 4. Badge ou descrição
                if (cleanBadge.indexOf(q) > -1) score += 30;
                if (cleanDesc.indexOf(q) > -1) score += 20;

                if (score > 0) {
                    var normUrl = itemUrl.toLowerCase().replace(/\/+$/, '');
                    if (!seenUrls[normUrl] || seenUrls[normUrl] < score) {
                        seenUrls[normUrl] = score;
                        scoredItems.push({
                            score: score,
                            item: {
                                icon: itemIcon,
                                title: itemTitle,
                                badge: itemBadge,
                                desc: itemDesc,
                                url: itemUrl,
                                _score: score
                            }
                        });
                    }
                }
            }

            scoredItems.sort(function(a, b) {
                return b.score - a.score;
            });

            var results = [];
            var finalUrls = {};
            for (var s = 0; s < scoredItems.length; s++) {
                var u = scoredItems[s].item.url.toLowerCase().replace(/\/+$/, '');
                if (!finalUrls[u]) {
                    finalUrls[u] = true;
                    results.push(scoredItems[s].item);
                }
                if (results.length >= 6) break;
            }

            return results;
        }

