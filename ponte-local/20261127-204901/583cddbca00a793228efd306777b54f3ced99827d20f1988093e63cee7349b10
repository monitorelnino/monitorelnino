            function assistiveLevenshteinDist(a, b) {
                if (a.length === 0) return b.length;
                if (b.length === 0) return a.length;
                var matrix = [];
                for (var i = 0; i <= b.length; i++) { matrix[i] = [i]; }
                for (var j = 0; j <= a.length; j++) { matrix[0][j] = j; }
                for (var i = 1; i <= b.length; i++) {
                    for (var j = 1; j <= a.length; j++) {
                        if (b.charAt(i - 1) === a.charAt(j - 1)) {
                            matrix[i][j] = matrix[i - 1][j - 1];
                        } else {
                            matrix[i][j] = Math.min(
                                matrix[i - 1][j - 1] + 1,
                                matrix[i][j - 1] + 1,
                                matrix[i - 1][j] + 1
                            );
                        }
                    }
                }
                return matrix[b.length][a.length];
            }

            function assistiveWordSimilarity(w1, w2) {
                if (!w1 || !w2) return 0;
                if (w1 === w2) return 1.0;
                var p1 = phoneticPtAssistive(w1);
                var p2 = phoneticPtAssistive(w2);
                if (p1 === p2) return 0.95;
                var maxLen = Math.max(w1.length, w2.length);
                if (maxLen === 0) return 1.0;
                var dist = assistiveLevenshteinDist(w1, w2);
                var sim = 1.0 - (dist / maxLen);
                var pMax = Math.max(p1.length, p2.length);
                var pDist = assistiveLevenshteinDist(p1, p2);
                var pSim = pMax > 0 ? 1.0 - (pDist / pMax) : 0;
                return Math.max(sim, pSim);
            }

