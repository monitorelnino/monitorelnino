        // 3.1 PADRONIZADOR UNIVERSAL DE BOTÕES E LINKS DE DOWNLOAD DE ARQUIVOS (PDF, WORD, ETC.)
        function standardizeDownloadButtons() {
            var downloadLinks = document.querySelectorAll('a[href*=".pdf"], a[href*=".docx"], a[href*=".doc"], a[href*=".xlsx"], a[href*=".xls"], a[href*=".zip"]');
            downloadLinks.forEach(function(a) {
                var href = a.getAttribute('href') || '';
                if (!href || href === '#' || href.indexOf('javascript:') === 0) return;

                // NUNCA sobrescrever botões estruturados de cards/módulos que já possuem rótulo próprio (glic, gp, gd, gr, gaud, gagro, etc.)
                if (a.querySelector('[class*="-btn-label"]') || 
                    a.classList.contains('glic-btn-file') || 
                    a.classList.contains('glic-btn-principal') || 
                    a.classList.contains('gp-btn-file') || 
                    a.classList.contains('gd-btn-file') || 
                    a.classList.contains('gr-btn-file') || 
                    a.classList.contains('gaud-btn-file') || 
                    a.closest('.glic-card, .gp-card, .gd-card, .gr-card, .gaud-card, .gobras-card, .glic-principal-wrap')) {
                    var currentLabel = a.textContent.trim().replace(/\s+/g, ' ');
                    if (!a.getAttribute('aria-label') && currentLabel) {
                        var cleanAria = currentLabel.replace(/[➔\->]+/g, '').replace(/\s+/g, ' ').trim();
                        a.setAttribute('aria-label', 'Baixar arquivo ' + cleanAria.replace(/^Baixar\s*/i, ''));
                    }
                    return;
                }
                
                var extMatch = href.match(/\.([a-z0-9]+)(\?|$)/i);
                var ext = extMatch ? extMatch[1].toUpperCase() : 'PDF';
                if (ext === 'DOC' || ext === 'DOCX') ext = 'Word';
                else if (ext === 'XLS' || ext === 'XLSX') ext = 'Planilha';

                var currentLabel = a.textContent.trim().replace(/\s+/g, ' ');
                // Se já estiver no padrão "Baixar ➔ ..."
                if (currentLabel.indexOf('Baixar ➔') !== -1 || currentLabel.indexOf('Baixar ->') !== -1) {
                    if (!a.getAttribute('aria-label')) {
                        var cleanAria = currentLabel.replace(/[➔\->]+/g, '').replace(/\s+/g, ' ').trim();
                        a.setAttribute('aria-label', 'Baixar arquivo ' + cleanAria.replace(/^Baixar\s*/i, ''));
                    }
                    return;
                }

                // Se for item de anexo secundário (que tem badge própria), apenas garantir o aria-label
                if (a.classList.contains('glic-anexo-card-item') || a.classList.contains('gp-anexo-card-item') || a.classList.contains('gd-anexo-card-item') || a.classList.contains('gr-anexo-card-item') || a.classList.contains('gaud-anexo-card-item')) {
                    if (!a.getAttribute('aria-label')) {
                        var anexoNameEl = a.querySelector('[class*="-anexo-name"]');
                        var anexoName = anexoNameEl ? anexoNameEl.textContent.trim() : a.textContent.trim();
                        a.setAttribute('aria-label', 'Baixar anexo ' + anexoName);
                    }
                    return;
                }

                // Obter contexto do documento a partir do card ou elemento pai
                var container = a.closest('article, tr, li, .entry, .post-listing, .cat-box');
                var badgeEl = container ? container.querySelector('[class*="-num-badge"], .badge, .entry-title, h1, h2, h3') : null;
                var context = '';
                if (badgeEl) {
                    context = badgeEl.textContent.trim().replace(/\s+/g, ' ');
                } else if (a.getAttribute('title')) {
                    context = a.getAttribute('title').trim();
                } else {
                    var filename = decodeURIComponent(href.split('/').pop().split('?')[0]);
                    context = filename.replace(/\.[^/.]+$/, "").replace(/[-_]+/g, ' ');
                }

                // Preposição gramatical (do / da)
                var prep = /^(portaria|resolu|dispensa|tomada|concorr|audi|ata|obra)/i.test(context) ? 'da ' : 'do ';
                if (/^(decreto|edital|preg|processo|leil)/i.test(context)) prep = 'do ';

                var newText = 'Baixar ➔ ' .concat(ext, ' ', prep, context);
                var accessibleText = 'Baixar arquivo ' .concat(ext, ' ', prep, context);

                // Apenas altera o texto se for link puramente genérico (como "Baixar", "Download", "Arquivo Oficial")
                if (/^(baixar|baixar pdf|download|arquivo oficial|arquivo oficial \(pdf\))$/i.test(currentLabel)) {
                    a.textContent = newText;
                }

                a.setAttribute('aria-label', accessibleText);
                if (!a.getAttribute('title')) {
                    a.setAttribute('title', accessibleText);
                }
            });
        }
        standardizeDownloadButtons();

