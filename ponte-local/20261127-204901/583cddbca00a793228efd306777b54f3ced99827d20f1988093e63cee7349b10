                            var nextIdx = (index + 1) % widgetLinks.length;
                            widgetLinks[nextIdx].focus();
                        } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
                            e.preventDefault();
                            var prevIdx = (index - 1 + widgetLinks.length) % widgetLinks.length;
