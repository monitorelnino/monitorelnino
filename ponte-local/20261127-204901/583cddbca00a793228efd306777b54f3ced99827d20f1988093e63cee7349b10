                                    window.ghomeSpeak('Leitura da página concluída.');
                                }
                                stopReading();
                            }
                        }, 300);
                    }
                };

                utter.onerror = function(err) {
                    speechStartTime = 0;
                    if (!isPlaying || isPaused || err.error === 'interrupted' || err.error === 'canceled') return;

                    if (err.error === 'not-allowed') {
                        console.warn('Proteção de voz: chunk bloqueado (not-allowed). Pausando sem pular tópicos.');
                        isPlaying = false;
                        isPaused = true;
                        updatePlayerUI();
                        var pill = playerEl ? playerEl.querySelector('#ghome-tts-pill') : null;
                        if (pill) {
                            pill.textContent = isMobileDevice ? '⏸️ Dê um toque na tela para ouvir' : '⏸️ Pressione Espaço ou clique para ouvir';
                        }
                        setupUserGestureUnlock();
                        return;
                    }

                    var now = Date.now();
                    if (now - lastErrorTimestamp < 500) {
                        consecutiveErrorCount++;
                    } else {
                        consecutiveErrorCount = 1;
                    }
                    lastErrorTimestamp = now;

                    if (consecutiveErrorCount >= 2) {
                        console.warn('Proteção de voz: múltiplos erros em sequência no chunk (' + err.error + '). Pausando.');
                        isPlaying = false;
                        isPaused = true;
                        updatePlayerUI();
                        var pill = playerEl ? playerEl.querySelector('#ghome-tts-pill') : null;
                        if (pill) {
                            pill.textContent = isMobileDevice ? '⏸️ Leitura em pausa • Dê um toque na tela para retomar' : '⏸️ Leitura em pausa • Pressione Espaço para retomar';
                        }
                        setupUserGestureUnlock();
                        return;
                    }

                    currentIndex++;
                    if (currentIndex < readingQueue.length) {
                        speakCurrentItem();
                    } else {
                        stopReading();
                    }
                };

                currentUtterance = utter;
                isPlaying = true;
                isPaused = false;
                speechStartTime = Date.now();

                var chunkSession = ttsStopSession;
                setTimeout(function() {
                    if (chunkSession !== ttsStopSession || !isPlaying) return;
                    try {
                        if (synth.paused) synth.resume();
                        synth.speak(utter);
                    } catch(e) {
                        console.warn('Erro ao disparar fala chunk:', e);
                    }
                }, 30);
            }

            function resumeFromSavedOffset() {
                if (currentIndex >= readingQueue.length) {
                    stopReading();
                    return;
                }
                var item = readingQueue[currentIndex];
                if (!item || !item.text) {
                    currentIndex++;
                    speakCurrentItem();
                    return;
                }

                var fullText = item.text;
                var offset = savedPauseCharIndex || lastSpokenCharIndex || 0;

                if (offset >= fullText.length - 4) {
                    savedPauseCharIndex = 0;
                    lastSpokenCharIndex = 0;
                    speechStartTime = 0;
                    currentIndex++;
                    if (currentIndex < readingQueue.length) {
                        speakCurrentItem();
                    } else {
                        if (window.ghomeSpeak) window.ghomeSpeak('Leitura da página concluída.');
                        stopReading();
                    }
                    return;
                }

                var remaining = fullText.substring(offset).trim();
                if (remaining.length > 0) {
                    speakTextChunk(remaining, item, offset);
                } else {
                    currentIndex++;
                    speakCurrentItem();
                }
            }

            function pauseReading() {
                if (isPaused) return;

                // Captura exatamente a palavra onde o áudio estava no milissegundo do comando
                var currentPos = getLiveSpokenCharIndex();
                lastSpokenCharIndex = currentPos;
                savedPauseCharIndex = currentPos;
                speechStartTime = 0;

                if (waitingActionTimer) {
                    clearTimeout(waitingActionTimer);
                    waitingActionTimer = null;
                    wasWaitingInteractive = true;
                } else {
                    wasWaitingInteractive = false;
                }

                isPaused = true;
                isPlaying = true;

                // Cancela o áudio imediatamente evitando bugs do Chrome de congelar ou resetar
                try {
                    synth.cancel();
                } catch(e){}

                updatePlayerUI();
                if (window.ghomeSpeak) {
                    window.ghomeSpeak(isMobileDevice ? 'Leitura pausada. Dê um toque em qualquer lugar da tela para continuar.' : 'Leitura pausada. Pressione a barra de espaço para continuar.');
                }
            }

            function resumeReading() {
                if (!isPaused) return;

                isPaused = false;
                isPlaying = true;
                updatePlayerUI();

                if (window.ghomeSpeak) {
                    window.ghomeSpeak('Continuando leitura.');
                }

                // Se o usuário pausou durante a janela de espera interativa (após o término da fala)
                if (wasWaitingInteractive) {
                    wasWaitingInteractive = false;
                    startInteractiveWaitWindow();
                    return;
                }

                // Continua exatamente de onde parou usando o offset salvo
                resumeFromSavedOffset();
            }

            function togglePlayPause() {
