                            } else if (e.key === 'ArrowUp') {
                                e.preventDefault();
                                if (sIdx > 0) subLinks[sIdx - 1].focus();
                                else topLink.focus();
                            } else if (e.key === 'ArrowRight') {
                                closeMenu(false);
                                if (topIdx < allTopLis.length - 1) {
                                    var nextA = allTopLis[topIdx + 1].querySelector(':scope > a');
