                    if (pdfItems.length <= 2) {
                        speakVoiceNotice('Este documento PDF é uma cópia digitalizada em imagem e não possui camada de texto pesquisável para leitura automática.');
                        if (pill) pill.textContent = '⚠️ PDF em Imagem (sem texto)';
                        if (snippet) snippet.innerHTML = '<strong>Documento em Imagem</strong><div style="margin-top:4px; font-size:12px; color:#f87171;">Não foi detectada camada de texto legível neste documento.</div>';
                        return;
                    }

                    previousQueue = readingQueue;
                    previousIndex = currentIndex;
                    isReadingPdf = true;

                    readingQueue = pdfItems;
                    currentIndex = 0;
                    speakCurrentItem();
                }

                // 1. TENTATIVA PRIORITÁRIA: Extração direta no servidor via AJAX (instantâneo e sem barreiras de rede)
                var isDone = false;
                var ajaxUrl = (window.ghomeA11yConfig && window.ghomeA11yConfig.ajaxUrl) ? window.ghomeA11yConfig.ajaxUrl : '/prefeitura/wp-admin/admin-ajax.php';
                var formData = new FormData();
                formData.append('action', 'ghome_extract_pdf_text');
                formData.append('pdf_url', pdfUrl);

                fetch(ajaxUrl, {
                    method: 'POST',
                    body: formData,
                    credentials: 'same-origin'
                }).then(function(res) {
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                }).then(function(json) {
                    if (json && json.success && json.data && json.data.pages && json.data.pages.length > 0) {
                        isDone = true;
                        buildAndStartPdfQueue(json.data.pages, json.data.totalPages || json.data.pages.length);
                    } else {
                        throw new Error(json && json.data && json.data.message ? json.data.message : 'Falha na extração de texto via servidor');
                    }
                }).catch(function(err) {
                    console.warn('Extração via AJAX não retornou, ativando fallback PDF.js:', err);
                    if (!isDone) {
                        startPdfJsFallback();
                    }
                });

                // 2. FALLBACK ROBUSTO CLIENT-SIDE COM PDF.JS (URL Segura + Blob Worker)
                function startPdfJsFallback() {
                    var safeUrl = pdfUrl.trim()
                        .replace(/^https?:\/\/(?:www\.)?sistemaslogic\.com\.br(?::\d+)?/i, '')
                        .replace(/^http:\/\//i, 'https://');

                    function processWithPdfJs(pdfjsLib) {
                        try {
                            if (!pdfjsLib.GlobalWorkerOptions.workerSrc) {
                                var blob = new Blob([
                                    'importScripts("https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js");'
                                ], { type: 'application/javascript' });
                                pdfjsLib.GlobalWorkerOptions.workerSrc = URL.createObjectURL(blob);
                            }
                        } catch(e) {}

                        var loadingTask = pdfjsLib.getDocument({ url: safeUrl, withCredentials: true });
                        loadingTask.promise.then(async function(pdf) {
                            var totalPages = pdf.numPages;
                            var rawPages = [];

                            for (var pageNum = 1; pageNum <= totalPages; pageNum++) {
                                try {
                                    var page = await pdf.getPage(pageNum);
                                    var textContent = await page.getTextContent();
                                    var pageStrings = textContent.items.map(function(item) { return item.str; }).filter(Boolean);
                                    var pageText = pageStrings.join(' ').replace(/\s+/g, ' ').trim();
                                    if (pageText.length > 5) {
                                        rawPages.push({ pageNum: pageNum, text: pageText });
                                    }
                                } catch(errPage) {
                                    console.warn('Erro ao extrair página PDF via PDF.js:', errPage);
                                }
                            }

                            buildAndStartPdfQueue(rawPages, totalPages);
                        }).catch(function(err) {
                            console.error('Erro no fallback PDF.js:', err);
                            if (pdfSession !== ttsStopSession) return;
                            speakVoiceNotice('Não foi possível extrair o texto deste documento PDF para leitura direta.');
                            if (pill) pill.textContent = '⚠️ Falha ao ler PDF';
                            if (snippet) snippet.innerHTML = '<strong>Não foi possível ler o PDF</strong><div style="margin-top:4px; font-size:12px; color:#f87171;">Documento não disponível para leitura de voz direta.</div>';
                        });
                    }

                    if (window.pdfjsLib) {
                        processWithPdfJs(window.pdfjsLib);
                    } else {
                        var script = document.createElement('script');
                        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
                        script.onload = function() {
                            if (window.pdfjsLib) {
                                processWithPdfJs(window.pdfjsLib);
                            }
                        };
                        script.onerror = function() {
                            if (pdfSession !== ttsStopSession) return;
                            speakVoiceNotice('Falha na conexão ao carregar o motor de PDF.');
                            if (pill) pill.textContent = '⚠️ Erro de rede';
                            if (snippet) snippet.innerHTML = '<strong>Erro de conexão</strong><div style="margin-top:4px; font-size:12px; color:#f87171;">Falha ao carregar motor de PDF. Pressione [ENTER] para baixar.</div>';
                        };
                        document.head.appendChild(script);
                    }
                }
            }

