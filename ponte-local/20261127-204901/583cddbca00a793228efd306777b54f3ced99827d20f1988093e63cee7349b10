                            })(it.url);
                            listEl.appendChild(li);
                        }
                        dropdown.style.display = 'block';
                    }

                    input.addEventListener('input', function() {
                        var val = this.value;
                        if (!val || val.trim().length < 2) {
                            dropdown.style.display = 'none';
                            return;
                        }
                        var items = getSuggestions(val);
                        renderDropdown(items);
                    });

                    input.addEventListener('focus', function() {
                        var val = this.value;
                        if (val && val.trim().length >= 2) {
                            var items = getSuggestions(val);
                            renderDropdown(items);
                        }
                    });

                    document.addEventListener('click', function(e) {
                        if (!parentWrap.contains(e.target)) {
                            dropdown.style.display = 'none';
                        }
                    });

                    if (form) {
                        form.addEventListener('submit', function(e) {
                            var val = input.value;
                            var smartUrl = resolveSmartSearch(val);
                            if (smartUrl) {
                                e.preventDefault();
                                dropdown.style.display = 'none';
                                window.location.href = smartUrl;
                                return false;
                            }
                            // Permite a submissão padrão do formulário do WordPress (?s=...)
                            dropdown.style.display = 'none';
                        });
                    }

                    input.addEventListener('keydown', function(e) {
                        if (e.key === 'Enter') {
                            var val = this.value;
                            var smartUrl = resolveSmartSearch(val);
                            if (smartUrl) {
                                e.preventDefault();
                                dropdown.style.display = 'none';
                                window.location.href = smartUrl;
                                return false;
                            } else if (form) {
                                e.preventDefault();
                                dropdown.style.display = 'none';
                                form.submit();
                                return false;
                            }
                        } else if (e.key === 'Escape') {
                            dropdown.style.display = 'none';
                        }
                    });
                })(searchInputs[i]);
            }
        }

