            // Gerador de Regex Insensível a Acentos, Plurais e Maiúsculas/Minúsculas
            var charAccentsMap = {
                'a': '[aáàâãä]',
                'e': '[eéèêë]',
                'i': '[iíìîï]',
                'o': '[oóòôõö]',
                'u': '[uúùûü]',
                'c': '[cç]'
            };

            function buildAccentInsensitiveWordPattern(cleanWord) {
                var words = cleanWord.trim().split(/\s+/);
                var wordPats = [];
                for (var w = 0; w < words.length; w++) {
                    var word = words[w];
                    var wp = '';
                    for (var c = 0; c < word.length; c++) {
                        var ch = word[c];
                        if (charAccentsMap[ch]) {
                            wp += charAccentsMap[ch];
                        } else if (/[-\/\\^$*+?.()|[\]{}]/.test(ch)) {
                            wp += '\\' + ch;
                        } else {
                            wp += ch;
                        }
                    }
                    wp += '(?:s|es)?';
                    wordPats.push(wp);
                }
                return wordPats.join('\\s+');
            }

            // Mapeamento inverso para localizar a chave correspondente no dicionário
            function findTermData(matchedText) {
                if (!matchedText) return null;
                var norm = matchedText.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
                if (civicDictionary[norm]) return civicDictionary[norm];
                
                // Tenta singular
                var singular = norm.split(/\s+/).map(function(w) {
                    return w.replace(/(?:es|s)$/i, '');
                }).join(' ');
                if (civicDictionary[singular]) return civicDictionary[singular];

                for (var k in civicDictionary) {
                    if (norm === k || norm.indexOf(k) === 0 || k.indexOf(norm) === 0) {
                        return civicDictionary[k];
                    }
                }
                return null;
            }

            var popoverEl = null;
            function getOrCreatePopover() {
                if (popoverEl) return popoverEl;
                var p = document.getElementById('ghome-simple-popover');
                if (!p) {
                    p = document.createElement('div');
                    p.id = 'ghome-simple-popover';
                    p.setAttribute('role', 'dialog');
                    p.setAttribute('aria-modal', 'false');
                    p.setAttribute('aria-labelledby', 'ghome-popover-term');
                    p.innerHTML = 
                        '<div class="ghome-popover-head">' +
                            '<div class="ghome-popover-title-row">' +
                                '<span aria-hidden="true">💡</span>' +
                                '<strong class="ghome-popover-term" id="ghome-popover-term">Termo</strong>' +
                                '<span class="ghome-popover-tag">Linguagem Simples</span>' +
                            '</div>' +
                            '<button type="button" class="ghome-popover-close" id="ghome-popover-close" aria-label="Fechar explicação">&times;</button>' +
                        '</div>' +
                        '<p class="ghome-popover-body" id="ghome-popover-body"></p>' +
                        '<div class="ghome-popover-actions">' +
                            '<button type="button" class="ghome-popover-speak-btn" id="ghome-popover-speak">' +
                                '<span aria-hidden="true">🔊</span> <span>Ouvir explicação</span>' +
                            '</button>' +
                            '<span style="font-size: 11px; color: #64748b;">Pressione Esc para fechar</span>' +
                        '</div>';
                    document.body.appendChild(p);

                    var closeBtn = p.querySelector('#ghome-popover-close');
                    if (closeBtn) closeBtn.addEventListener('click', closePopover);

                    var speakBtn = p.querySelector('#ghome-popover-speak');
                    if (speakBtn) {
                        speakBtn.addEventListener('click', function() {
                            var t = p.querySelector('#ghome-popover-term').textContent;
                            var d = p.querySelector('#ghome-popover-body').textContent;
                            if ('speechSynthesis' in window) {
                                window.speechSynthesis.cancel();
                                var u = new SpeechSynthesisUtterance((t + ': ' + d).replace(/_/g, ' '));
                                var v = (window.ghomeGetSelectedVoice ? window.ghomeGetSelectedVoice() : null);
                                if (v) {
                                    u.voice = v;
                                    if (v.voiceURI) u.voiceURI = v.voiceURI;
                                }
                                u.lang = (v && v.lang) ? v.lang : 'pt-BR';
                                u.rate = 1.0;
                                u.pitch = 1.0;
                                window.speechSynthesis.speak(u);
                            }
                        });
                    }
                }
                popoverEl = p;
                return p;
            }

            var currentActiveTerm = null;

            function showPopover(termSpan, termData) {
                if (!isSimpleLanguageActive()) return;
                var pop = getOrCreatePopover();
                currentActiveTerm = termSpan;

                pop.querySelector('#ghome-popover-term').textContent = termData.term;
                pop.querySelector('#ghome-popover-body').textContent = termData.desc;

                // Se o termo estiver contido dentro de um link navegável, adiciona botão para ir à página se desejado
                var parentLink = termSpan.closest('a');
                var navBtn = pop.querySelector('.ghome-popover-nav-btn');
                if (parentLink && parentLink.href && parentLink.href !== '#' && parentLink.href.indexOf('javascript:') === -1) {
                    if (!navBtn) {
                        navBtn = document.createElement('a');
                        navBtn.className = 'ghome-popover-nav-btn';
                        navBtn.style.cssText = 'display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 7px 12px; background: #0284c7; color: #ffffff !important; text-decoration: none; border-radius: 6px; font-size: 12px; font-weight: 700; margin-top: 6px; transition: background 0.15s ease;';
                        var actionsEl = pop.querySelector('.ghome-popover-actions');
                        if (actionsEl) actionsEl.parentNode.insertBefore(navBtn, actionsEl);
                    }
                    navBtn.href = parentLink.href;
                    navBtn.target = parentLink.target || '_self';
                    navBtn.innerHTML = 'Acessar link de ' + termData.term + ' &rarr;';
                    navBtn.style.display = 'inline-flex';
                } else if (navBtn) {
                    navBtn.style.display = 'none';
                }

                termSpan.setAttribute('aria-expanded', 'true');
                pop.classList.add('is-visible');

                var rect = termSpan.getBoundingClientRect();
                var scrollX = window.pageXOffset || document.documentElement.scrollLeft || 0;
                var scrollY = window.pageYOffset || document.documentElement.scrollTop || 0;

                var popWidth = 320;
                var left = rect.left + scrollX + (rect.width / 2) - (popWidth / 2);
                if (left < 10) left = 10;
                if (left + popWidth > window.innerWidth - 10) {
                    left = window.innerWidth - popWidth - 10;
                }

                var top = rect.bottom + scrollY + 8;
                if (rect.bottom + 180 > window.innerHeight && rect.top > 180) {
                    top = rect.top + scrollY - 140;
                }

                pop.style.left = left + 'px';
                pop.style.top = top + 'px';

                if (window.ghomeSpeak) {
                    window.ghomeSpeak(termData.term + ': ' + termData.desc);
                }
            }

            function closePopover() {
                if (popoverEl) {
                    popoverEl.classList.remove('is-visible');
                }
                if (currentActiveTerm) {
                    currentActiveTerm.setAttribute('aria-expanded', 'false');
                    currentActiveTerm = null;
                }
            }

            document.addEventListener('click', function(e) {
                if (popoverEl && popoverEl.classList.contains('is-visible')) {
                    if (!popoverEl.contains(e.target) && !e.target.closest('.ghome-simple-term')) {
                        closePopover();
                    }
                }
            });

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && popoverEl && popoverEl.classList.contains('is-visible')) {
                    closePopover();
                }
            });

            // Motor Universal de Escaneamento e Destaque de Termos
            function scanAndHighlightTerms() {
                var sortedKeys = Object.keys(civicDictionary).sort(function(a, b) {
                    return b.length - a.length;
                });
                if (sortedKeys.length === 0) return;

                var patterns = [];
                for (var i = 0; i < sortedKeys.length; i++) {
                    var k = sortedKeys[i];
                    var pat = buildAccentInsensitiveWordPattern(k);
                    if (pat) patterns.push(pat);
                }
                if (patterns.length === 0) return;

                var combinedRegex;
                try {
                    combinedRegex = new RegExp('(?<![a-zA-Z0-9À-ÿ])(' + patterns.join('|') + ')(?![a-zA-Z0-9À-ÿ])', 'gi');
                } catch (e) {
                    combinedRegex = new RegExp('(?:^|([^a-zA-Z0-9À-ÿ]))(' + patterns.join('|') + ')(?=[^a-zA-Z0-9À-ÿ]|$)', 'gi');
                    combinedRegex.isFallback = true;
                }

                var walker = document.createTreeWalker(
                    document.body,
                    NodeFilter.SHOW_TEXT,
                    {
                        acceptNode: function(node) {
                            var parent = node.parentNode;
                            if (!parent) return NodeFilter.FILTER_REJECT;
                            var tag = parent.tagName ? parent.tagName.toLowerCase() : '';
                            if (tag === 'script' || tag === 'style' || tag === 'noscript' || 
                                tag === 'code' || tag === 'pre' || tag === 'input' || 
                                tag === 'textarea' || tag === 'select' || tag === 'option' || 
                                tag === 'svg' || tag === 'math') {
                                return NodeFilter.FILTER_REJECT;
                            }
                            // Rejeita apenas elementos do sistema, player de voz, popover e barra de administração
                            if (parent.closest('#top-nav, .ghome-gov-topbar, #ghome-tts-player, #ghome-simple-popover, #wpadminbar, .ghome-simple-term, [contenteditable="true"]')) {
                                return NodeFilter.FILTER_REJECT;
                            }
                            return NodeFilter.FILTER_ACCEPT;
                        }
                    },
                    false
                );

                var textNodes = [];
                while (walker.nextNode()) {
                    textNodes.push(walker.currentNode);
                }

                textNodes.forEach(function(node) {
                    var text = node.nodeValue;
                    if (!text || text.trim().length < 2) return;

                    combinedRegex.lastIndex = 0;
                    if (!combinedRegex.test(text)) return;

                    combinedRegex.lastIndex = 0;
                    var frag = document.createDocumentFragment();
                    var lastIdx = 0;
                    var hasReplacements = false;
                    var m;

                    while ((m = combinedRegex.exec(text)) !== null) {
                        var matchText = combinedRegex.isFallback ? m[2] : m[1];
                        var matchOffset = combinedRegex.isFallback ? (m.index + (m[1] ? m[1].length : 0)) : m.index;
                        
                        if (!matchText) {
                            if (combinedRegex.lastIndex <= matchOffset) combinedRegex.lastIndex = matchOffset + 1;
                            continue;
                        }

                        var termInfo = findTermData(matchText);
                        if (!termInfo) {
                            if (combinedRegex.lastIndex <= matchOffset) combinedRegex.lastIndex = matchOffset + 1;
                            continue;
                        }

                        if (matchOffset > lastIdx) {
                            frag.appendChild(document.createTextNode(text.substring(lastIdx, matchOffset)));
                        }

                        var span = document.createElement('span');
                        span.className = 'ghome-simple-term';
                        span.setAttribute('aria-haspopup', 'dialog');
                        span.setAttribute('aria-expanded', 'false');
                        span.setAttribute('aria-label', matchText + ': ' + termInfo.desc);
                        if (isSimpleLanguageActive()) {
                            span.setAttribute('tabindex', '0');
                            span.setAttribute('role', 'button');
                        }
                        span.textContent = matchText;

                        var badge = document.createElement('span');
                        badge.className = 'ghome-simple-badge';
                        badge.setAttribute('aria-hidden', 'true');
                        badge.textContent = '💡';
                        span.appendChild(badge);

                        (function(boundSpan, boundInfo) {
                            boundSpan.addEventListener('click', function(e) {
                                if (!isSimpleLanguageActive()) {
                                    // Comportamento normal do link ou texto quando Linguagem Simples estiver inativa
                                    return;
                                }
                                e.preventDefault();
                                e.stopPropagation();
                                if (currentActiveTerm === boundSpan) {
                                    closePopover();
                                } else {
                                    showPopover(boundSpan, boundInfo);
                                }
                            });

                            boundSpan.addEventListener('keydown', function(e) {
                                if (!isSimpleLanguageActive()) return;
                                if (e.key === 'Enter' || e.key === ' ') {
                                    e.preventDefault();
                                    e.stopPropagation();
                                    if (currentActiveTerm === boundSpan) {
                                        closePopover();
                                    } else {
                                        showPopover(boundSpan, boundInfo);
                                    }
                                }
                            });
                        })(span, termInfo);

                        frag.appendChild(span);
                        lastIdx = matchOffset + matchText.length;
                        hasReplacements = true;

                        if (combinedRegex.lastIndex <= matchOffset) {
                            combinedRegex.lastIndex = matchOffset + 1;
                        }
                    }

                    if (hasReplacements) {
                        if (lastIdx < text.length) {
                            frag.appendChild(document.createTextNode(text.substring(lastIdx)));
                        }
                        if (node.parentNode) {
                            node.parentNode.replaceChild(frag, node);
                        }
                    }
                });
            }

            function isSimpleLanguageActive() {
                return document.body.classList.contains('ghome-simple-lang-active') || 
                       document.documentElement.classList.contains('ghome-simple-lang-active');
            }

            function toggleSimpleLanguage(forceState) {
                var isActive = isSimpleLanguageActive();
                var newState = (forceState !== undefined) ? forceState : !isActive;

                if (newState) {
                    document.body.classList.add('ghome-simple-lang-active');
                    document.documentElement.classList.add('ghome-simple-lang-active');
                    document.body.classList.remove('ghome-hide-simple-lang');
                    localStorage.setItem('ghome_simple_language', '1');
                    // Escanear e destacar imediatamente em todo o documento
                    scanAndHighlightTerms();
                } else {
                    document.body.classList.remove('ghome-simple-lang-active');
                    document.documentElement.classList.remove('ghome-simple-lang-active');
                    document.body.classList.add('ghome-hide-simple-lang');
                    localStorage.setItem('ghome_simple_language', '0');
                    closePopover();
                }

                var btn = document.getElementById('ghome-btn-simple-lang');
                if (btn) {
                    btn.classList.toggle('is-active', newState);
                    btn.setAttribute('aria-pressed', newState ? 'true' : 'false');
                }

                var allTerms = document.querySelectorAll('.ghome-simple-term');
                allTerms.forEach(function(t) {
                    if (newState) {
                        t.setAttribute('tabindex', '0');
                        t.setAttribute('role', 'button');
                    } else {
                        t.removeAttribute('tabindex');
                        t.removeAttribute('role');
                    }
                });

                if (forceState === undefined && window.ghomeSpeak) {
                    window.ghomeSpeak(newState ? 'Destaques e explicações em Linguagem Simples ativados.' : 'Linguagem Simples desativada.');
                }
            }

            window.ghomeToggleSimpleLanguage = toggleSimpleLanguage;

            // Inicialização padrão com base na preferência salva
            var savedLang = localStorage.getItem('ghome_simple_language');
            if (savedLang === '1') {
                toggleSimpleLanguage(true);
            } else {
                toggleSimpleLanguage(false);
            }

            var topSimpleBtn = document.getElementById('ghome-btn-simple-lang');
            if (topSimpleBtn) {
                topSimpleBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    toggleSimpleLanguage();
                });
            }

            // Escaneamento inicial e garantia pós-carregamento completo
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', function() {
                    scanAndHighlightTerms();
                    setTimeout(scanAndHighlightTerms, 600);
                });
            } else {
                scanAndHighlightTerms();
                setTimeout(scanAndHighlightTerms, 600);
            }
        })();

    })();
