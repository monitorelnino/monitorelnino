            function splitIntoParagraphs(text) {
                if (!text || text.trim().length === 0) return [];
                var rawParas = text.split(/(?:\r?\n){2,}/);
                var result = [];

                rawParas.forEach(function(rp) {
                    var clean = cleanSpeechText(rp);
                    if (!clean || clean.length < 3) return;

                    if (clean.length > 400) {
                        var sentences = clean.match(/[^.!?]+[.!?]+(?:\s+|$)|[^.!?]+$/g) || [clean];
                        var curChunk = '';
                        sentences.forEach(function(sent) {
                            if ((curChunk + ' ' + sent).trim().length > 280 && curChunk.trim().length > 80) {
                                result.push(curChunk.trim());
                                curChunk = sent;
                            } else {
                                curChunk = (curChunk + ' ' + sent).trim();
                            }
                        });
                        if (curChunk.trim().length > 0) {
                            result.push(curChunk.trim());
                        }
                    } else {
                        result.push(clean);
                    }
                });

                return result.length > 0 ? result : [cleanSpeechText(text)];
            }

