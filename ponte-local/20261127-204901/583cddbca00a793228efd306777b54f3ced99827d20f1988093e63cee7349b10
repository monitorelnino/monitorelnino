            // Alinhamento inteligente na fronteira de palavras para não cortar fonemas ou falar meias palavras
            function alignToWordBoundary(text, index) {
                if (!text || index <= 0) return 0;
                if (index >= text.length - 1) return Math.max(0, text.length - 1);

                if (text.charAt(index - 1) === ' ') {
                    return index;
                }

                var wordStart = text.lastIndexOf(' ', index);
                if (wordStart !== -1 && (index - wordStart) < 25) {
                    return wordStart + 1;
                }
                return index;
            }

            // Rastreamento híbrido em tempo real da posição falada (compatível com Voz do Google e Chromium)
            function getLiveSpokenCharIndex() {
                if (currentIndex >= readingQueue.length) return 0;
                var item = readingQueue[currentIndex];
                if (!item || !item.text) return 0;

                var fullText = item.text;
                if (!isPlaying || speechStartTime === 0) {
                    return lastSpokenCharIndex || savedPauseCharIndex || 0;
                }

                if (boundaryFiredForCurrentUtterance && lastSpokenCharIndex > speechChunkBaseOffset) {
                    var timeSinceBoundary = Date.now() - (lastBoundaryTime || speechStartTime);
                    if (timeSinceBoundary < 250) {
                        return alignToWordBoundary(fullText, lastSpokenCharIndex);
                    }
                    var rate = currentRate || 1.0;
                    var charsPerMs = (15.5 * rate) / 1000;
                    var extraChars = Math.floor(timeSinceBoundary * charsPerMs);
                    return alignToWordBoundary(fullText, Math.min(fullText.length - 1, lastSpokenCharIndex + extraChars));
                }

                var elapsedMs = Date.now() - speechStartTime;
                if (elapsedMs <= 100) {
                    return speechChunkBaseOffset;
                }

                var rate = currentRate || 1.0;
                var charsPerMs = (15.2 * rate) / 1000;
                var estimatedChars = Math.floor(elapsedMs * charsPerMs);
                var estimatedIndex = speechChunkBaseOffset + estimatedChars;

                return alignToWordBoundary(fullText, Math.min(fullText.length - 1, estimatedIndex));
            }

            // Persistência contínua do modo de voz ao navegar entre páginas (WCAG / e-MAG)
            function setTtsActiveMode(active) {
                try {
                    if (active) {
                        sessionStorage.setItem('ghome_tts_mode_active', '1');
                        localStorage.setItem('ghome_tts_mode_active', '1');
                        localStorage.setItem('ghome_tts_mode_timestamp', String(Date.now()));
                    } else {
                        sessionStorage.removeItem('ghome_tts_mode_active');
                        localStorage.removeItem('ghome_tts_mode_active');
                        localStorage.removeItem('ghome_tts_mode_timestamp');
                    }
                } catch(e){}
            }

            function isTtsActiveMode() {
                try {
                    if (sessionStorage.getItem('ghome_tts_mode_active') === '1') return true;
                    var l = localStorage.getItem('ghome_tts_mode_active') === '1';
                    var ts = parseInt(localStorage.getItem('ghome_tts_mode_timestamp') || '0', 10);
                    if (l && ts && (Date.now() - ts < 30 * 60 * 1000)) {
                        return true;
                    }
                } catch(e){}
                return false;
            }

            function isGoogleVoice(v) {
                if (!v) return false;
                var n = (v.name || '').toLowerCase();
                var l = (v.lang || '').toLowerCase();
                return n.indexOf('google') !== -1 && (l.indexOf('pt') !== -1 || n.indexOf('portugu') !== -1 || n.indexOf('brasil') !== -1 || n.indexOf('brazil') !== -1);
            }

            function isNaturalFemaleVoice(v) {
                if (!v) return false;
                var n = (v.name || '').toLowerCase();
                var l = (v.lang || '').toLowerCase();
                var isPt = l.indexOf('pt') !== -1 || n.indexOf('portugu') !== -1 || n.indexOf('brasil') !== -1 || n.indexOf('brazil') !== -1;
                if (!isPt) return false;
                if (n.indexOf('francisca') !== -1) return true;
                if (n.indexOf('natural') !== -1 && (n.indexOf('female') !== -1 || n.indexOf('online') !== -1)) return true;
                return false;
            }

            function isFemaleVoice(v) {
                if (!v) return false;
                var n = (v.name || '').toLowerCase();
                return n.indexOf('maria') !== -1 || n.indexOf('luciana') !== -1 || n.indexOf('heloisa') !== -1 || n.indexOf('leticia') !== -1 || n.indexOf('francisca') !== -1 || n.indexOf('yara') !== -1 || n.indexOf('vitoria') !== -1;
            }

            function loadVoices() {
                var voices = synth.getVoices() || [];
                if (!voices || voices.length === 0) return;

                var ptList = [];
                for (var i = 0; i < voices.length; i++) {
                    var v = voices[i];
                    var l = (v.lang || '').toLowerCase();
                    var n = (v.name || '').toLowerCase();
                    if (l.indexOf('pt') === 0 || l.indexOf('pt-br') !== -1 || l.indexOf('pt_br') !== -1 || n.indexOf('portugu') !== -1 || n.indexOf('brasil') !== -1 || n.indexOf('brazil') !== -1) {
                        ptList.push(v);
                    }
                }
                availablePtVoices = ptList;

                // 0. Preferência personalizada salva anteriormente pelo usuário
                var savedVoiceName = '';
                try { savedVoiceName = localStorage.getItem('ghome_tts_voice_name') || ''; } catch(e){}
                if (savedVoiceName) {
                    for (var s = 0; s < ptList.length; s++) {
                        if (ptList[s].name === savedVoiceName) {
                            ptVoice = ptList[s];
                            populateVoiceSelect();
                            return;
                        }
                    }
                }

                // 1º LUGAR ABSOLUTO: A VOZ DA MULHER DO GOOGLE ("Google português do Brasil")
                for (var g = 0; g < ptList.length; g++) {
                    if (isGoogleVoice(ptList[g])) {
                        ptVoice = ptList[g];
                        populateVoiceSelect();
                        return;
                    }
                }

                // 2º LUGAR: Microsoft Francisca Online (Natural) - voz neural feminina super realista do Edge
                for (var f = 0; f < ptList.length; f++) {
                    if (isNaturalFemaleVoice(ptList[f])) {
                        ptVoice = ptList[f];
                        populateVoiceSelect();
                        return;
                    }
                }

                // 3º LUGAR: Qualquer outra voz feminina online / nuvem
                for (var o = 0; o < ptList.length; o++) {
                    if (ptList[o].localService === false && isFemaleVoice(ptList[o])) {
                        ptVoice = ptList[o];
                        populateVoiceSelect();
                        return;
                    }
                }

                // 4º LUGAR: Qualquer voz feminina nativa do sistema (ex: Maria Desktop, Luciana Siri, Letícia)
                for (var w = 0; w < ptList.length; w++) {
                    if (isFemaleVoice(ptList[w])) {
                        ptVoice = ptList[w];
                        populateVoiceSelect();
                        return;
                    }
                }

                // 5º LUGAR: Qualquer voz pt-BR que NÃO seja o robótico "Daniel"
                for (var d = 0; d < ptList.length; d++) {
                    if (ptList[d].name.indexOf('Daniel') === -1) {
                        ptVoice = ptList[d];
                        populateVoiceSelect();
                        return;
                    }
                }

                // 6º LUGAR: Fallback final para a primeira voz pt encontrada
                if (ptList.length > 0) {
                    ptVoice = ptList[0];
                }
                populateVoiceSelect();
            }

            function populateVoiceSelect() {
                var p = playerEl || document.getElementById('ghome-tts-player');
