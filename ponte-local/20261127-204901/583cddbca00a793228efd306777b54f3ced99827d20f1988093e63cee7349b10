    <script>
    (function(){
        var cards = document.querySelectorAll('.glic-list .glic-card[data-post-id]');
        if (!cards || !cards.length) return;

        var canReorder = false;
        var ajaxUrl = '';
        var nonce = '';
        var toastEl = document.getElementById('gord-front-toast');
        var toastTimer = null;

        var containerParamMap = {
            'gsaude-saude-app': 'gsaude_id',
            'gedu-educacao-app': 'gedu_id',
            'gasoc-social-app': 'gasoc_id',
            'gdef-portal-app': 'gdef_id',
            'gesp-social-app': 'gesp_id',
            'gagro-social-app': 'gagro_id',
            'garea-portal-app': 'garea_id'
        };

        function getParamNameForCard(card) {
            var container = card.closest('.glic-licitacoes-container');
            if (container && container.id && containerParamMap[container.id]) {
                return containerParamMap[container.id];
            }
            return 'garea_id';
        }

        function buildDirectLink(card) {
            var pid = card.getAttribute('data-post-id');
            var paramName = getParamNameForCard(card);
            return window.location.origin + window.location.pathname + '?' + paramName + '=' + encodeURIComponent(pid);
        }

        function copyTextToClipboard(text, onDone) {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(function(){
                    onDone(true);
                }).catch(function(){
                    fallbackCopy(text, onDone);
                });
            } else {
                fallbackCopy(text, onDone);
            }
        }

        function fallbackCopy(text, onDone) {
            try {
                var ta = document.createElement('textarea');
                ta.value = text;
                ta.setAttribute('readonly', '');
                ta.style.position = 'fixed';
                ta.style.left = '-9999px';
                document.body.appendChild(ta);
                ta.select();
                var ok = document.execCommand('copy');
                document.body.removeChild(ta);
                onDone(!!ok);
            } catch (err) {
                onDone(false);
            }
        }

        function showToast(msg, ok) {
            if (!toastEl) return;
            toastEl.textContent = msg;
            toastEl.style.background = ok ? '#15803d' : '#b91c1c';
            toastEl.style.display = 'block';
            clearTimeout(toastTimer);
            toastTimer = setTimeout(function(){ toastEl.style.display = 'none'; }, 2400);
        }

        function getVisibleSiblings(listEl) {
            return Array.prototype.filter.call(
                listEl.querySelectorAll(':scope > .glic-card[data-post-id]'),
                function(el){ return el.style.display !== 'none'; }
            );
        }

        function persistOrder(listEl) {
            var visibleCards = getVisibleSiblings(listEl);
            var ids = visibleCards.map(function(c){ return c.getAttribute('data-post-id'); });
            if (!ids.length) return;

            var body = new URLSearchParams();
            body.append('action', 'gord_save_order');
            body.append('nonce', nonce);
            ids.forEach(function(id){ body.append('order[]', id); });

            fetch(ajaxUrl, {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                body: body.toString()
            })
            .then(function(r){ return r.json(); })
            .then(function(res){
                if (res && res.success) {
                    showToast('✅ Ordem atualizada no portal!', true);
                } else {
                    showToast('⚠️ Não foi possível salvar a ordem.', false);
                }
            })
            .catch(function(){
                showToast('⚠️ Erro de conexão ao salvar a ordem.', false);
            });
        }

        cards.forEach(function(card){
            if (card.querySelector('.gord-front-bar')) return;
            var bar = document.createElement('div');
            bar.className = 'gord-front-bar';

            var html = '<button type="button" class="gord-copy-btn" title="Copiar link direto desta publicação" aria-label="Copiar link direto desta publicação">🔗 Copiar Link</button>';
            if (canReorder) {
                html += '<span class="gord-order-group" aria-hidden="true">' +
                    '<span class="gord-front-lbl">Ordenar:</span>' +
                    '<button type="button" class="gord-front-btn gord-move-up" title="Mover para cima">⬆️ Subir</button>' +
                    '<button type="button" class="gord-front-btn gord-move-down" title="Mover para baixo">⬇️ Descer</button>' +
                    '</span>';
            }
            bar.innerHTML = html;

            bar.addEventListener('click', function(e){
                e.stopPropagation();

                var copyBtn = e.target.closest('.gord-copy-btn');
                if (copyBtn) {
                    e.preventDefault();
                    var directUrl = buildDirectLink(card);
                    copyTextToClipboard(directUrl, function(ok){
                        if (ok) {
                            copyBtn.classList.add('gord-copied');
                            copyBtn.textContent = '✅ Link Copiado!';
                            showToast('🔗 Link direto da publicação copiado!', true);
                            setTimeout(function(){
                                copyBtn.classList.remove('gord-copied');
                                copyBtn.textContent = '🔗 Copiar Link';
                            }, 2200);
                        } else {
                            window.prompt('Copie o link direto da publicação:', directUrl);
                        }
                    });
                    return;
                }

                if (!canReorder) return;
                var btn = e.target.closest('.gord-front-btn');
                if (!btn) return;
                e.preventDefault();

                var listEl = card.parentElement;
                var visible = getVisibleSiblings(listEl);
                var idx = visible.indexOf(card);
                if (idx === -1) return;

                if (btn.classList.contains('gord-move-up') && idx > 0) {
                    listEl.insertBefore(card, visible[idx - 1]);
                } else if (btn.classList.contains('gord-move-down') && idx < visible.length - 1) {
                    var targetNext = visible[idx + 1];
                    listEl.insertBefore(card, targetNext.nextSibling);
                } else {
                    return;
                }

                card.classList.add('gord-card-flash');
                setTimeout(function(){ card.classList.remove('gord-card-flash'); }, 500);
                persistOrder(listEl);
            });

            card.insertBefore(bar, card.firstChild);
        });
    })();
    </script>
