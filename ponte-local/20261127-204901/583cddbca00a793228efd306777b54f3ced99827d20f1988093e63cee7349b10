                        if (target.closest && target.closest('#ghome-tts-close')) {
                            e.preventDefault();
                            stopReading();
                            if (window.ghomeSpeak) {
                                window.ghomeSpeak('Modo de leitura encerrado. Retornando ao modo visual normal.');
                            }
                            return false;
                        }
                        if (target.closest && target.closest('#ghome-tts-voice-select')) {
                            return true;
                        }
                        // No celular o controle é 100% tátil no touchend: 1 toque = pausar/retomar, 2 toques = acessar
                        e.preventDefault();
                        e.stopPropagation();
                        return false;
                    }
                    var a = e.target.closest ? e.target.closest('a[href]') : null;
                    if (a && a.href) {
                        var h = (a.getAttribute('href') || a.href || '').trim();
                        if (/\.pdf(\?.*)?$/i.test(h)) {
                            // No modo "ouvir página", NUNCA abre o documento PDF nem anexos no navegador: APENAS lê em áudio!
                            e.preventDefault();
                            e.stopPropagation();
                            e.stopImmediatePropagation();
                            var linkTitle = a.getAttribute('title') || a.getAttribute('aria-label') || a.innerText || a.textContent || '';
                            loadAndReadPdf(h, linkTitle);
                            return false;
                        }
                        if (/\.(docx?|xlsx?|pptx?|zip|rar|7z|csv|odt|ods)(\?.*)?$/i.test(h)) {
                            e.preventDefault();
                            e.stopPropagation();
                            e.stopImmediatePropagation();
                            speakVoiceNotice('Este documento está em formato de anexo e não pode ser lido diretamente por voz.');
                            return false;
                        }
                        if (!a.closest('#ghome-tts-player') || a.id === 'ghome-tts-link') {
                            setTtsActiveMode(true);
                        }
                    }
                }
            }, true);

            document.addEventListener('keydown', function(e) {
                var ttsActive = isPlaying || isPaused || isTtsActiveMode() || (playerEl && playerEl.classList.contains('is-visible'));

                // TECLA ESC: Fechar modo Ouvir Página imediatamente e voltar ao modo normal
                if ((e.key === 'Escape' || e.key === 'Esc' || e.keyCode === 27) && ttsActive) {
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();
                    stopReading();
