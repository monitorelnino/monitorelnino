    <!-- MOTOR JAVASCRIPT DO ZOOM (DESKTOP E CELULAR) -->
    <script>
    (function() {
        var lightbox = document.getElementById('gobras-zoom-lightbox');
        var img = document.getElementById('gobras-zoom-img');
        var viewport = document.getElementById('gobras-zoom-viewport');
        var counterEl = document.getElementById('gobras-zoom-counter');
        var obraTitleEl = document.getElementById('gobras-zoom-obra-title');
        var badgeLevel = document.getElementById('gobras-zoom-level-badge');
        var prevBtn = document.getElementById('gobras-zoom-prev-btn');
        var nextBtn = document.getElementById('gobras-zoom-next-btn');

        var photos = [];
        var currentIndex = 0;
        var currentTitle = '';

        // Estado do Zoom & Pan
        var scale = 1;
        var minScale = 1;
        var maxScale = 5;
        var posX = 0;
        var posY = 0;
        var isDragging = false;
        var startX = 0;
        var startY = 0;

        // Gestos Touch Mobile
        var touchStartDist = 0;
        var touchStartScale = 1;
        var touchStartX = 0;
        var touchStartY = 0;
        var lastTapTime = 0;
        var isPinching = false;

        function updateTransform() {
            scale = Math.min(Math.max(scale, minScale), maxScale);
            if (scale <= 1) {
                posX = 0;
                posY = 0;
            }
            img.style.transform = 'translate(' + posX + 'px, ' + posY + 'px) scale(' + scale + ')';
            if (badgeLevel) {
                badgeLevel.textContent = Math.round(scale * 100) + '%';
            }
        }

        function resetZoom() {
            scale = 1;
            posX = 0;
            posY = 0;
            updateTransform();
        }

        function loadPhoto(index) {
            if (!photos || photos.length === 0) return;
            if (index < 0) index = photos.length - 1;
            if (index >= photos.length) index = 0;
            currentIndex = index;

            resetZoom();
            img.src = photos[currentIndex];
            if (counterEl) {
                counterEl.textContent = 'Foto ' + (currentIndex + 1) + ' de ' + photos.length;
            }
            if (obraTitleEl) {
                obraTitleEl.textContent = currentTitle;
            }

            // Ocultar setas se houver apenas 1 foto
            if (prevBtn && nextBtn) {
                prevBtn.style.display = (photos.length > 1) ? 'flex' : 'none';
                nextBtn.style.display = (photos.length > 1) ? 'flex' : 'none';
            }
        }

        // API Pública Global
        window.gobrasOpenZoomGallery = function(photosList, startIndex, title) {
            if (!photosList || photosList.length === 0) return;
            photos = photosList.filter(function(u) { return !!u; });
            if (photos.length === 0) return;
            currentTitle = title || 'Obra Pública';
            currentIndex = startIndex || 0;
            loadPhoto(currentIndex);
            lightbox.style.display = 'flex';
            document.body.style.overflow = 'hidden'; // trava scroll de fundo
        };

        window.gobrasCloseZoomGallery = function() {
            lightbox.style.display = 'none';
            isDragging = false;
            isPinching = false;
            resetZoom();

            var modal = document.getElementById('gobras-modal');
            if (modal && modal.style.display === 'flex') {
                document.body.style.overflow = 'hidden';
                var modalContent = modal.querySelector('.gobras-modal-content');
                if (modalContent) {
                    modalContent.style.overflowY = 'auto';
                    modalContent.focus();
                }
            } else {
                document.body.style.overflow = '';
                document.body.style.removeProperty('overflow');
                document.documentElement.style.overflow = '';
                document.documentElement.style.removeProperty('overflow');
            }
        };

        // CONTROLES DE BOTÃO
        document.getElementById('gobras-btn-zoom-in').addEventListener('click', function(e) {
            e.stopPropagation();
            scale += 0.5;
            updateTransform();
        });

        document.getElementById('gobras-btn-zoom-out').addEventListener('click', function(e) {
            e.stopPropagation();
            scale -= 0.5;
            updateTransform();
        });

        document.getElementById('gobras-btn-zoom-reset').addEventListener('click', function(e) {
            e.stopPropagation();
            resetZoom();
        });

        document.getElementById('gobras-btn-zoom-close').addEventListener('click', function(e) {
            e.stopPropagation();
            gobrasCloseZoomGallery();
        });

        prevBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            loadPhoto(currentIndex - 1);
        });

        nextBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            loadPhoto(currentIndex + 1);
        });

        // TELA CHEIA
        document.getElementById('gobras-btn-fullscreen').addEventListener('click', function(e) {
            e.stopPropagation();
            if (!document.fullscreenElement) {
                lightbox.requestFullscreen ? lightbox.requestFullscreen() : (lightbox.webkitRequestFullscreen && lightbox.webkitRequestFullscreen());
            } else {
                document.exitFullscreen ? document.exitFullscreen() : (document.webkitExitFullscreen && document.webkitExitFullscreen());
            }
        });

        // 1. ZOOM COM RODA DO MOUSE (DESKTOP)
        viewport.addEventListener('wheel', function(e) {
            e.preventDefault();
            var delta = e.deltaY < 0 ? 0.25 : -0.25;
            scale += delta;
            updateTransform();
        }, { passive: false });

        // 2. ARRASTAR COM MOUSE (PANNING NO DESKTOP)
        viewport.addEventListener('mousedown', function(e) {
            if (e.button !== 0) return; // apenas clique esquerdo
            if (scale > 1) {
                isDragging = true;
                startX = e.clientX - posX;
                startY = e.clientY - posY;
                viewport.classList.add('is-dragging');
            }
        });

        window.addEventListener('mousemove', function(e) {
            if (!isDragging) return;
            posX = e.clientX - startX;
            posY = e.clientY - startY;
            updateTransform();
        });

        window.addEventListener('mouseup', function() {
            if (isDragging) {
                isDragging = false;
                viewport.classList.remove('is-dragging');
            }
        });

        // 3. DUPLO-CLIQUE PARA ZOOM (DESKTOP)
        img.addEventListener('dblclick', function(e) {
            e.preventDefault();
            if (scale > 1) {
                resetZoom();
            } else {
                scale = 2.5;
                updateTransform();
            }
        });

        // 4. SUPORTE TOUCH MULTI-TOQUE (CELULAR & TABLET)
        viewport.addEventListener('touchstart', function(e) {
            if (e.touches.length === 2) {
                // PINCH ZOOM
                isPinching = true;
                touchStartDist = Math.hypot(
                    e.touches[0].clientX - e.touches[1].clientX,
                    e.touches[0].clientY - e.touches[1].clientY
                );
                touchStartScale = scale;
            } else if (e.touches.length === 1) {
                // TOQUE ÚNICO: DRAG OU SWIPE
                isPinching = false;
                var now = Date.now();
                if (now - lastTapTime < 300) {
                    // DUPLO TOQUE NO CELULAR
                    e.preventDefault();
                    if (scale > 1) {
                        resetZoom();
                    } else {
                        scale = 2.5;
                        updateTransform();
                    }
                    lastTapTime = 0;
                    return;
                }
                lastTapTime = now;

                touchStartX = e.touches[0].clientX;
                touchStartY = e.touches[0].clientY;
                if (scale > 1) {
                    startX = e.touches[0].clientX - posX;
                    startY = e.touches[0].clientY - posY;
                    isDragging = true;
                }
            }
        }, { passive: false });

        viewport.addEventListener('touchmove', function(e) {
            if (e.touches.length === 2 && isPinching) {
                // PINCH ZOOM EM TEMPO REAL
                e.preventDefault();
                var currentDist = Math.hypot(
                    e.touches[0].clientX - e.touches[1].clientX,
                    e.touches[0].clientY - e.touches[1].clientY
                );
                if (touchStartDist > 0) {
                    scale = touchStartScale * (currentDist / touchStartDist);
                    updateTransform();
                }
            } else if (e.touches.length === 1 && isDragging && scale > 1) {
                // PANNING COM 1 DEDO NO CELULAR QUANDO COM ZOOM
                e.preventDefault();
                posX = e.touches[0].clientX - startX;
                posY = e.touches[0].clientY - startY;
                updateTransform();
            }
        }, { passive: false });

        viewport.addEventListener('touchend', function(e) {
            if (isPinching && e.touches.length < 2) {
                isPinching = false;
            }
            if (isDragging && e.touches.length === 0) {
                isDragging = false;
            }

            // SWIPE HORIZONTAL PARA TROCAR FOTO NO CELULAR (QUANDO SEM ZOOM)
            if (scale <= 1 && e.changedTouches.length === 1 && !isPinching) {
                var diffX = e.changedTouches[0].clientX - touchStartX;
                var diffY = e.changedTouches[0].clientY - touchStartY;
                if (Math.abs(diffX) > 50 && Math.abs(diffX) > Math.abs(diffY)) {
                    if (diffX < 0) {
                        loadPhoto(currentIndex + 1); // Próxima
                    } else {
                        loadPhoto(currentIndex - 1); // Anterior
                    }
                }
            }
        });

        // TECLADO (DESKTOP)
        window.addEventListener('keydown', function(e) {
            if (lightbox.style.display !== 'flex') return;
            if (e.key === 'Escape') {
                gobrasCloseZoomGallery();
            } else if (e.key === 'ArrowLeft') {
                loadPhoto(currentIndex - 1);
            } else if (e.key === 'ArrowRight') {
                loadPhoto(currentIndex + 1);
            } else if (e.key === '+' || e.key === '=') {
                scale += 0.5;
                updateTransform();
            } else if (e.key === '-' || e.key === '_') {
                scale -= 0.5;
                updateTransform();
            }
        });
    })();
    </script>
