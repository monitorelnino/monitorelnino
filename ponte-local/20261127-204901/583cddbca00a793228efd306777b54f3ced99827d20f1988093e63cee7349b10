            // Contador de sessão: incrementado a cada parada (Esc/Parar). Qualquer fala, aviso ou leitura de PDF
            // agendada antes da parada é descartada, garantindo silêncio imediato e definitivo.
            var ttsStopSession = 0;

            function setupUserGestureUnlock() {
                if (isWaitingUserGesture) return;
                isWaitingUserGesture = true;

                function unlockAndPlay(e) {
                    window.removeEventListener('keydown', unlockAndPlay, true);
                    window.removeEventListener('click', unlockAndPlay, true);
                    window.removeEventListener('pointerdown', unlockAndPlay, true);
                    isWaitingUserGesture = false;

                    if (e && e.key === 'Escape') {
                        stopReading();
                        return;
                    }

                    if (isTtsActiveMode()) {
                        try { synth.resume(); } catch(err){}
                        isPlaying = true;
                        isPaused = false;
                        consecutiveErrorCount = 0;
                        rapidSilentEndCount = 0;
