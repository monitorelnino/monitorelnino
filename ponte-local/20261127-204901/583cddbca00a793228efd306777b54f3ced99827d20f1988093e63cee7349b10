                    docTypePlural = 'audiências';
                }

                // Identificar busca específica por número de ato/documento (?gp_num=..., ?gd_num=..., etc.)
                var urlParams = new URLSearchParams(window.location.search);
                var specificNum = (urlParams.get('gp_num') || urlParams.get('gd_num') || urlParams.get('gr_num') || urlParams.get('glic_num') || urlParams.get('gaud_num') || urlParams.get('ged_num') || urlParams.get('gconcurso_num') || urlParams.get('num') || urlParams.get('numero') || '').trim();
                var specificAno = (urlParams.get('ano') || urlParams.get('gp_ano') || urlParams.get('gd_ano') || urlParams.get('gr_ano') || urlParams.get('glic_ano') || urlParams.get('gaud_ano') || '').trim();

                // Se não vier na URL, checa se há valor já preenchido no input de filtro por número da página
                if (!specificNum) {
                    var numFilterInputEl = document.querySelector('input#gp-filter-numero, input#gd-filter-numero, input#gr-filter-numero, input#glic-filter-numero, input#gaud-filter-numero, input#gconcurso-filter-num, input[id$="-filter-numero"], input[id*="-filter-num"], input[name="numero"]');
                    if (numFilterInputEl && numFilterInputEl.value && numFilterInputEl.value.trim().length > 0) {
                        specificNum = numFilterInputEl.value.trim();
                    }
                }

                if (urlParams.get('gp_num')) {
                    docTypeSingular = 'portaria';
                    docTypePlural = 'portarias';
