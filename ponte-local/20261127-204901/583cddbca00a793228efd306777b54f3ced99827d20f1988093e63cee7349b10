            function speakVoiceNotice(msg, onEnd) {
                if (!('speechSynthesis' in window)) return;

                // Cancela qualquer timer de espera pendente para que nenhuma leitura anterior corte este aviso
                if (waitingActionTimer) {
                    clearTimeout(waitingActionTimer);
                    waitingActionTimer = null;
                }

                synth.cancel();
                msg = adaptSpeechForDevice(String(msg || '').replace(/_/g, ' '));
                if (window.ghomeSpeak) {
                    window.ghomeSpeak(msg);
                }

                var p = playerEl || document.getElementById('ghome-tts-player');
                if (p) {
                    var snip = p.querySelector('#ghome-tts-snippet');
                    if (snip) snip.textContent = msg;
                }

                var utter = new SpeechSynthesisUtterance(msg);
                currentUtterance = utter; // Previne garbage collection prematuro no Chrome/Edge

                if (ptVoice) {
                    utter.voice = ptVoice;
                    if (ptVoice.voiceURI) utter.voiceURI = ptVoice.voiceURI;
                }
                utter.lang = (ptVoice && ptVoice.lang) ? ptVoice.lang : 'pt-BR';
                utter.rate = currentRate;
                utter.pitch = 1.0;

                if (onEnd) {
                    var noticeSession = ttsStopSession;
                    var executed = false;
                    var guardedOnEnd = function(ev) {
                        if (executed) return;
                        executed = true;
                        if (noticeSession !== ttsStopSession) return;
                        // Pausa natural de 400ms para que toda a frase termine de sair limpa na caixa de som antes de iniciar o documento
                        setTimeout(function() {
                            if (noticeSession !== ttsStopSession) return;
                            onEnd(ev);
                        }, 400);
                    };
                    utter.onend = guardedOnEnd;
                    utter.onerror = function(ev) {
                        // Não dispara se cancelado intencionalmente por avanço manual de tecla (Seta para a direita/baixo)
                        if (ev && ev.error === 'canceled') return;
                        guardedOnEnd(ev);
                    };
                }

                var speakSession = ttsStopSession;
                setTimeout(function() {
                    if (speakSession !== ttsStopSession) return;
                    try {
                        if (synth.paused) synth.resume();
                        synth.speak(utter);
                    } catch(e){}
                }, 40);
            }

            function changeTtsSpeed(direction) {
                var curIdx = -1;
                for (var s = 0; s < speedRates.length; s++) {
                    if (Math.abs(speedRates[s] - currentRate) < 0.05) {
                        curIdx = s;
                        break;
                    }
                }
                if (curIdx === -1) curIdx = 0;
                if (direction > 0) {
                    if (curIdx < speedRates.length - 1) {
                        curIdx++;
                    } else {
                        var maxMsg = 'Velocidade máxima de 1 vírgula 5 vezes atingida.';
                        if (isPlaying && !isPaused) {
                            var currentPosMax = getLiveSpokenCharIndex();
                            lastSpokenCharIndex = currentPosMax;
                            savedPauseCharIndex = currentPosMax;
                            speechStartTime = 0;
                            try { synth.cancel(); } catch(e){}
                            speakVoiceNotice(maxMsg, function() {
                                if (isPlaying && !isPaused) {
                                    resumeFromSavedOffset();
                                }
                            });
                        } else {
                            speakVoiceNotice(maxMsg);
                        }
                        return;
                    }
                } else {
                    if (curIdx > 0) {
                        curIdx--;
                    } else {
                        var minMsg = 'Velocidade mínima de 1 vírgula 0 vezes atingida.';
                        if (isPlaying && !isPaused) {
                            var currentPosMin = getLiveSpokenCharIndex();
                            lastSpokenCharIndex = currentPosMin;
                            savedPauseCharIndex = currentPosMin;
                            speechStartTime = 0;
                            try { synth.cancel(); } catch(e){}
                            speakVoiceNotice(minMsg, function() {
                                if (isPlaying && !isPaused) {
                                    resumeFromSavedOffset();
                                }
                            });
                        } else {
                            speakVoiceNotice(minMsg);
                        }
                        return;
                    }
                }
                currentRate = speedRates[curIdx];
                try {
                    localStorage.setItem('ghome_tts_speed_rate', String(currentRate));
                } catch(e){}

                var p = getOrCreatePlayer();
                var sBtns = p.querySelectorAll('.ghome-tts-speed-btn');
                sBtns.forEach(function(sb) {
                    var r = parseFloat(sb.getAttribute('data-rate')) || 1.0;
                    sb.classList.toggle('is-active', Math.abs(r - currentRate) < 0.05);
                });

                var rateLabel = currentRate.toFixed(2).replace(/\.00$/, '').replace(/\.0$/, '');
                var feedback = (direction > 0 ? 'Velocidade aumentada para ' : 'Velocidade reduzida para ') + rateLabel.replace('.', ' vírgula ') + ' vezes.';
                if (window.ghomeSpeak) {
                    window.ghomeSpeak(feedback);
                }
                updatePlayerUI();

                // Continua imediatamente de onde está na nova velocidade, sem reiniciar do início
                if (isPlaying && !isPaused) {
                    var currentPos = getLiveSpokenCharIndex();
                    lastSpokenCharIndex = currentPos;
                    savedPauseCharIndex = currentPos;
                    speechStartTime = 0;
                    try { synth.cancel(); } catch(e){}
                    speakVoiceNotice(feedback, function() {
                        if (isPlaying && !isPaused) {
                            resumeFromSavedOffset();
                        }
                    });
                } else {
                    speakVoiceNotice(feedback);
                }
            }

