                                if (prevA) { e.preventDefault(); prevA.focus(); }
                            }
                        }
                    });

                    var subLinks = subMenu.querySelectorAll('a');
                    subLinks.forEach(function(subA, sIdx) {
                        subA.addEventListener('keydown', function(e) {
                            if (e.key === 'Escape') {
                                e.preventDefault();
                                e.stopPropagation();
                                closeMenu(true);
                                if (window.ghomeSpeak) window.ghomeSpeak('Submenu fechado.');
                            } else if (e.key === 'ArrowDown') {
                                e.preventDefault();
                                if (sIdx < subLinks.length - 1) subLinks[sIdx + 1].focus();
