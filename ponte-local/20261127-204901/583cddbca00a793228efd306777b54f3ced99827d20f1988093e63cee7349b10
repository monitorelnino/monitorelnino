            function isElementVisible(el) {
                if (!el) return false;
                if (el.style && el.style.display === 'none') return false;
                if (el.offsetParent === null && el.tagName !== 'BODY' && el.tagName !== 'HTML') return false;
                try {
                    var style = window.getComputedStyle ? window.getComputedStyle(el) : null;
                    if (style && (style.display === 'none' || style.visibility === 'hidden' || style.opacity === '0')) return false;
                } catch(e){}
                return true;
            }

            function cleanSpeechText(txt) {
                if (!txt) return '';
                return txt
                    .replace(/[🕒📅📄⚡📌📎🏛️💬🗺️📊🔍👥⚖️📜⭐✨👩👨🍎📁🔗➡️📰🚫⚠️🚨💉🌿🎧⌨️🛠️]/g, '')
                    .replace(/n[ºo°]\s*(\d+)/gi, 'número $1')
                    .replace(/->|-->|→|>>|<<|◀|▶/g, ' ')
                    .replace(/_+/g, ' ')
                    .replace(/\bPDF\b/g, 'P D F')
                    .replace(/\s+/g, ' ')
                    .trim();
            }

            function formatBadgeSpeech(rawText) {
                var txt = cleanSpeechText(rawText);
                txt = txt.replace(/n[ºo°]\s*(\d+)/gi, 'número $1');
                txt = txt.replace(/(\d+)\/(\d{4})/, '$1 de $2');
                return txt;
            }

            function formatDateSpeech(rawDate) {
                if (!rawDate) return '';
                var cleanD = cleanSpeechText(rawDate);
                var m = cleanD.match(/(\d{1,2})\/(\d{1,2})\/(\d{4})/);
                if (m) {
                    var day = parseInt(m[1], 10);
                    var monthNum = parseInt(m[2], 10);
                    var year = m[3];
                    var months = ['', 'janeiro', 'fevereiro', 'março', 'abril', 'maio', 'junho', 'julho', 'agosto', 'setembro', 'outubro', 'novembro', 'dezembro'];
                    var monthName = months[monthNum] || m[2];
                    return 'Data de publicação: ' + day + ' de ' + monthName + ' de ' + year;
                }
                return (cleanD.indexOf('/') !== -1 && cleanD.toLowerCase().indexOf('data') === -1)
                    ? ('Data de publicação: ' + cleanD)
                    : cleanD;
            }

            function formatAberturaSpeech(rawText) {
                var txt = cleanSpeechText(rawText);
                var isReabertura = /reabertura/i.test(txt);
                txt = txt.replace(/^(reabertura|sessão de reabertura|abertura|sessão de abertura)[:\s]*/i, '');
                txt = txt.replace(/(\d{1,2}:\d{2})h\b/i, '$1 horas');
                txt = txt.replace(/(\d{1,2}:\d{2})\s*hrs?\b/i, '$1 horas');
                return (isReabertura ? 'Sessão de Reabertura dia ' : 'Sessão de Abertura dia ') + txt;
            }

