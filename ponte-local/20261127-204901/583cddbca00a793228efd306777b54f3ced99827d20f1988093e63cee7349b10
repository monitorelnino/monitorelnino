                                    var hasEditais = cardEditais.length > 0;
                                    var hasDecretos = cardDecretos.length > 0;
                                    var hasAnexos = cardAnexos.length > 0;
                                    var hasSubItems = hasEditais || hasDecretos || hasAnexos;
                                    var cardPrompt = buildCardPromptText(badgeSpeech, hasEditais, hasDecretos, hasAnexos);

                                    var speechParts = [];
                                    if (badgeSpeech) speechParts.push(badgeSpeech);
                                    if (dateSpeech) speechParts.push(dateSpeech);
                                    if (ementaSpeech) speechParts.push(ementaSpeech);
                                    speechParts.push(cardPrompt);

                                    var fallbackSpeech = speechParts.join('. ').replace(/\.\s*\./g, '.');

                                    var dynamicCardItem = {
                                        text: fallbackSpeech,
                                        el: targetCard,
                                        interactiveEl: princBtn || targetCard,
                                        interactiveType: isPdf ? 'pdf' : (pHref ? 'link' : null),
                                        isPdf: isPdf,
                                        pdfUrl: isPdf ? pHref : null,
                                        destName: badgeSpeech || 'Documento Oficial',
                                        promptText: cardPrompt,
                                        isPublicationCard: true,
                                        hasAnexos: hasSubItems,
                                        anexoCount: (cardEditais.length + cardDecretos.length + cardAnexos.length),
                                        topicIndex: 99
                                    };

                                    readingQueue.push(dynamicCardItem);
                                    currentIndex = readingQueue.length - 1;
                                    speakCurrentItem();
                                }
                                return;
                            } else {
                                var notFoundNotice = 'Digite o número da ' + docType + ' desejada ou use as setas para ouvir as opções.';
                                if (window.ghomeSpeak) {
                                    window.ghomeSpeak(notFoundNotice);
                                }
                                speakVoiceNotice(notFoundNotice);
                                return;
                            }
                        }

                        if (item.isSearchField && item.interactiveEl) {
                            if (e && e.preventDefault) try{ e.preventDefault(); }catch(err){}
                            if (e && e.stopPropagation) try{ e.stopPropagation(); }catch(err){}
                            if (e && e.stopImmediatePropagation) try{ e.stopImmediatePropagation(); }catch(err){}

                            if (waitingActionTimer) {
                                clearTimeout(waitingActionTimer);
                                waitingActionTimer = null;
                            }
                            synth.cancel();

                            var searchVal = (item.interactiveEl.value || '').trim();
                            if (searchVal.length > 0) {
                                // 1. RESOLVER CORRESPONDÊNCIA INTELIGENTE OU ASSISTIVA DIRETA (Ex: Concursos, Pregão, Licitações, etc.)
                                var target = item.interactiveEl._ghomePendingSearchTarget;
                                if (!target && typeof matchAssistiveSearchIntent === 'function') {
                                    var match = matchAssistiveSearchIntent(searchVal);
                                    if (match && match.target) {
                                        target = match.target;
                                    }
                                }

                                if (target && target.url) {
                                    setTtsActiveMode(true);
                                    synth.cancel();
                                    window.location.href = target.url;
                                    return;
                                }

                                // 2. VERIFICA SE É FILTRO DE PÁGINA LOCAL (Legislação, Departamentos, Telefones)
                                var isLocalPageFilter = item.interactiveEl.id === 'gleg-search-input' || 
                                                        item.interactiveEl.id === 'gdep-search-input' || 
                                                        item.interactiveEl.id === 'gtel-search-input' ||
                                                        item.interactiveEl.id === 'gcep-filter-cep' ||
                                                        item.interactiveEl.id === 'gcep-search-input' ||
                                                        item.interactiveEl.classList.contains('gleg-search-input') ||
                                                        item.interactiveEl.classList.contains('gcep-input');
                                if (isLocalPageFilter) {
                                    var nextVisibleIdx = -1;
                                    for (var si = currentIndex + 1; si < readingQueue.length; si++) {
                                        if (readingQueue[si].el && isElementVisible(readingQueue[si].el)) {
                                            nextVisibleIdx = si;
                                            break;
                                        }
                                    }
                                    if (nextVisibleIdx !== -1) {
                                        currentIndex = nextVisibleIdx;
                                        speakCurrentItem();
                                    } else {
                                        if (window.ghomeSpeak) {
                                            window.ghomeSpeak('Nenhum resultado encontrado para ' + searchVal);
                                        }
                                    }
                                    return;
                                }

                                // 3. FALLBACK: BUSCA GERAL
                                setTtsActiveMode(true);
                                if (window.ghomeSpeak) {
                                    window.ghomeSpeak('Pesquisando por ' + searchVal);
                                }
                                var sForm = item.interactiveEl.form || item.interactiveEl.closest('form');
                                if (sForm) {
                                    sForm.submit();
                                } else {
                                    window.location.href = '/prefeitura/?s=' + encodeURIComponent(searchVal);
                                }
                            } else {
                                item.interactiveEl.focus();
                                if (window.ghomeSpeak) {
                                    window.ghomeSpeak('Digite o que você deseja pesquisar e pressione Enter.');
                                }
                            }
                            return;
                        }

                        // =========================================================================
                        // VERIFICAÇÃO DE PDF/DOCUMENTO: PRIORIDADE TOTAL PARA LEITURA EM ÁUDIO
                        // EM MODO 'OUVIR PÁGINA', NUNCA ABRIR NO NAVEGADOR OU BAIXAR ARQUIVO!
                        // =========================================================================
                        var targetPdfUrl = item.pdfUrl;
                        if (!targetPdfUrl && item.interactiveEl) {
                            var rawIElHref = (item.interactiveEl.getAttribute('href') || item.interactiveEl.href || '').trim();
                            if (/\.pdf(\?.*)?$/i.test(rawIElHref)) {
                                targetPdfUrl = rawIElHref;
                            }
                        }
                        if (!targetPdfUrl && item.el) {
                            var inElPdf = (item.el.closest && item.el.closest('a[href*=".pdf"]')) || (item.el.querySelector && item.el.querySelector('a[href*=".pdf"]'));
                            if (inElPdf) {
                                targetPdfUrl = (inElPdf.getAttribute('href') || inElPdf.href || '').trim();
                            }
                        }
                        if (!targetPdfUrl && document.activeElement && document.activeElement.tagName === 'A') {
                            var rawActHref = (document.activeElement.getAttribute('href') || document.activeElement.href || '').trim();
                            if (/\.pdf(\?.*)?$/i.test(rawActHref)) {
                                targetPdfUrl = rawActHref;
                            }
                        }

                        if (targetPdfUrl && /\.pdf(\?.*)?$/i.test(targetPdfUrl)) {
                            if (e && e.preventDefault) try{ e.preventDefault(); }catch(err){}
                            if (e && e.stopPropagation) try{ e.stopPropagation(); }catch(err){}
                            if (e && e.stopImmediatePropagation) try{ e.stopImmediatePropagation(); }catch(err){}

                            if (waitingActionTimer) {
                                clearTimeout(waitingActionTimer);
                                waitingActionTimer = null;
                            }

                            synth.cancel();
                            isPaused = false;
                            loadAndReadPdf(targetPdfUrl, item.destName || item.topicTitle || item.text);
                            return;
                        }

                        if (item.interactiveEl) {
                            if (e && e.preventDefault) try{ e.preventDefault(); }catch(err){}
                            if (e && e.stopPropagation) try{ e.stopPropagation(); }catch(err){}
                            if (e && e.stopImmediatePropagation) try{ e.stopImmediatePropagation(); }catch(err){}

                            if (waitingActionTimer) {
                                clearTimeout(waitingActionTimer);
                                waitingActionTimer = null;
                            }

                            synth.cancel();

                            var targetEl = item.interactiveEl;
                            var href = (targetEl.getAttribute('href') || targetEl.href || '').trim();
                            if (!href && targetEl.closest) {
                                var pAnchor = targetEl.closest('a[href]');
                                if (pAnchor) {
                                    href = (pAnchor.getAttribute('href') || pAnchor.href || '').trim();
                                    targetEl = pAnchor;
                                }
                            }
                            if (!href && targetEl.querySelector) {
                                var cAnchor = targetEl.querySelector('a[href]');
                                if (cAnchor) {
                                    href = (cAnchor.getAttribute('href') || cAnchor.href || '').trim();
                                    targetEl = cAnchor;
                                }
                            }

                            // Se for anexo de arquivo para download não-PDF (ex: docx, xlsx, zip)
                            if (item.interactiveType === 'download' || (href && /\.(docx?|xlsx?|pptx?|zip|rar|7z|csv|odt|ods)(\?.*)?$/i.test(href))) {
                                speakVoiceNotice('Este documento está em formato de anexo (' + (item.destName || 'arquivo') + ') e não pode ser lido diretamente por voz.');
                                return;
                            }

                            var targetAttr = (targetEl.getAttribute('target') || targetEl.target || '').trim();
                            setTtsActiveMode(true);

                            if (href && href !== '#' && !href.startsWith('javascript:')) {
                                setTtsActiveMode(true);
                                synth.cancel();
                                if (targetAttr === '_blank') {
                                    window.open(href, '_blank');
                                } else {
                                    window.location.href = href;
                                }
                                return;
                            } else {
                                try {
                                    targetEl.click();
                                } catch(err){}
                            }
                        } else if (item.el && item.el.closest && item.el.closest('a[href]')) {
                            var parentCardAnchor = item.el.closest('a[href]');
                            var parentCardHref = (parentCardAnchor.getAttribute('href') || parentCardAnchor.href || '').trim();
                            if (parentCardHref && parentCardHref !== '#' && !parentCardHref.startsWith('javascript:')) {
                                if (e && e.preventDefault) try{ e.preventDefault(); }catch(err){}
                                if (e && e.stopPropagation) try{ e.stopPropagation(); }catch(err){}
                                if (e && e.stopImmediatePropagation) try{ e.stopImmediatePropagation(); }catch(err){}
                                if (waitingActionTimer) {
                                    clearTimeout(waitingActionTimer);
                                    waitingActionTimer = null;
                                }
                                synth.cancel();

                                if (/\.pdf(\?.*)?$/i.test(parentCardHref)) {
                                    isPaused = false;
                                    loadAndReadPdf(parentCardHref, item.destName || item.topicTitle || item.text);
                                    return;
                                }

                                setTtsActiveMode(true);
                                synth.cancel();
                                window.location.href = parentCardHref;
                                return;
                            }
                        } else if (item.isTopicStart || currentIndex === 0) {
                            // Se o usuário deu dois toques no cabeçalho de uma área ou na introdução, entra diretamente no conteúdo da área
                            if (currentIndex + 1 < readingQueue.length) {
                                if (waitingActionTimer) {
                                    clearTimeout(waitingActionTimer);
                                    waitingActionTimer = null;
                                }
                                synth.cancel();
                                currentIndex++;
                                speakCurrentItem();
                                return;
                            }
                        }
                    }
                    return;
            }

            // Atalhos de Teclado Universais durante Leitura de Voz (WCAG / e-MAG para Deficiência Visual Total)
            window.addEventListener('keydown', function(e) {
                if (e.repeat) return;
                if (!isPlaying && readingQueue.length === 0) return;

                var tag = (e.target && e.target.tagName) ? e.target.tagName.toLowerCase() : '';
                var isTextInput = (tag === 'input' || tag === 'textarea' || (e.target && e.target.isContentEditable));

                // Se o foco estiver em um campo de digitação:
                if (isTextInput) {
                    var inputVal = (e.target.value || '').trim();

                    // Seta para BAIXO: sempre avança para a próxima área (ex: Menu Principal)
                    if (e.key === 'ArrowDown') {
                        e.preventDefault();
                        e.stopPropagation();
                        e.stopImmediatePropagation();
                        if (e.target.blur) e.target.blur();
                        if (window.ghomeSpeak) {
                            window.ghomeSpeak('Saindo da pesquisa e avançando para a próxima área.');
                        }
                        jumpToNextTopic();
                        return;
                    }

                    // Seta para CIMA: sempre volta para a área anterior
                    if (e.key === 'ArrowUp') {
                        e.preventDefault();
                        e.stopPropagation();
                        e.stopImmediatePropagation();
                        if (e.target.blur) e.target.blur();
                        if (window.ghomeSpeak) {
                            window.ghomeSpeak('Retornando à área anterior.');
                        }
                        jumpToPrevTopic();
                        return;
                    }

                    // Seta para DIREITA (campo vazio): avança para o próximo item
                    if (e.key === 'ArrowRight' && inputVal.length === 0) {
                        e.preventDefault();
                        e.stopPropagation();
                        e.stopImmediatePropagation();
                        if (e.target.blur) e.target.blur();
                        stepNextItem();
                        return;
                    }

                    // Seta para ESQUERDA (campo vazio): volta para o item anterior
                    if (e.key === 'ArrowLeft' && inputVal.length === 0) {
                        e.preventDefault();
                        e.stopPropagation();
                        e.stopImmediatePropagation();
                        if (e.target.blur) e.target.blur();
                        stepPrevItem();
                        return;
                    }

                    if (e.key === 'Escape') {
                        e.preventDefault();
                        e.target.value = '';
                        if (e.target.blur) e.target.blur();
                        if (window.ghomeSpeak) {
                            window.ghomeSpeak('Pesquisa cancelada.');
                        }
                        return;
                    }

                    if (inputVal.length > 0 && e.key !== 'Enter') {
                        return;
                    }
                } else if (tag === 'select') {
                    return;
                }

                // 1. BARRA DE ESPAÇO: Pausar ou continuar leitura exatamente de onde parou
                if (e.key === ' ' || e.code === 'Space') {
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();
                    togglePlayPause();
                    return;
                }

                // 2. SETA PARA DIREITA: Avança o texto com 1 toque, ou aumenta a velocidade com 2 toques rápidos
                if (e.key === 'ArrowRight') {
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();

                    if (arrowLeftTimeout) {
                        clearTimeout(arrowLeftTimeout);
                        arrowLeftTimeout = null;
                        lastArrowLeftTime = 0;
                    }

                    var nowRight = Date.now();
                    if (nowRight - lastArrowRightTime < 380) {
                        // Dois toques rápidos detectados: acelera a velocidade da leitura
                        if (arrowRightTimeout) {
                            clearTimeout(arrowRightTimeout);
                            arrowRightTimeout = null;
                        }
                        lastArrowRightTime = 0;
                        changeTtsSpeed(1);
                        return;
                    }

                    lastArrowRightTime = nowRight;
                    if (arrowRightTimeout) clearTimeout(arrowRightTimeout);
                    arrowRightTimeout = setTimeout(function() {
                        lastArrowRightTime = 0;
                        arrowRightTimeout = null;
                        stepNextItem();
                    }, 280);
                    return;
                }

                // 3. SETA PARA ESQUERDA: Volta o texto com 1 toque, ou reduz a velocidade com 2 toques rápidos
                if (e.key === 'ArrowLeft') {
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();

                    if (arrowRightTimeout) {
                        clearTimeout(arrowRightTimeout);
                        arrowRightTimeout = null;
                        lastArrowRightTime = 0;
                    }

                    var nowLeft = Date.now();
                    if (nowLeft - lastArrowLeftTime < 380) {
                        // Dois toques rápidos detectados: desacelera a velocidade da leitura
                        if (arrowLeftTimeout) {
                            clearTimeout(arrowLeftTimeout);
                            arrowLeftTimeout = null;
                        }
                        lastArrowLeftTime = 0;
                        changeTtsSpeed(-1);
                        return;
                    }

                    lastArrowLeftTime = nowLeft;
                    if (arrowLeftTimeout) clearTimeout(arrowLeftTimeout);
                    arrowLeftTimeout = setTimeout(function() {
                        lastArrowLeftTime = 0;
                        arrowLeftTimeout = null;
                        var curItem = readingQueue[currentIndex];
                        var isMenuItem = curItem && (curItem.isMenu || curItem.parentMenuLi || (curItem.topicTitle && curItem.topicTitle.indexOf('Menu') !== -1) || (curItem.topicIndex === 2 && !curItem.slideIndex));
                        if (isMenuItem) {
                            stepNextItem();
                        } else {
                            stepPrevItem();
                        }
                    }, 280);
                    return;
                }

                // 4. SETA PARA BAIXO: Pula para o primeiro anexo (se houver), próximo anexo ou próximo tópico/card
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();

                    if (waitingActionTimer) {
                        clearTimeout(waitingActionTimer);
                        waitingActionTimer = null;
                    }
                    synth.cancel();
                    isPaused = false;

                    var curItem = readingQueue[currentIndex];
                    // Se estiver no card principal e ele possuir anexos: pula diretamente para o primeiro anexo!
                    if (curItem && curItem.isPublicationCard && curItem.hasAnexos) {
                        if (currentIndex + 1 < readingQueue.length && readingQueue[currentIndex + 1].isAnexo) {
                            currentIndex++;
                            speakCurrentItem();
                            return;
                        }
                    }

                    // Se estiver navegando pelos anexos do card:
                    if (curItem && curItem.isAnexo) {
                        // Se houver um próximo anexo no mesmo card:
                        if (currentIndex + 1 < readingQueue.length && readingQueue[currentIndex + 1].isAnexo) {
                            currentIndex++;
                            speakCurrentItem();
                            return;
                        }
                        // Se era o último anexo: pula para o próximo tópico/card
                        jumpToNextTopic();
                        return;
                    }

                    jumpToNextTopic();
                    return;
                }

                // 5. SETA PARA CIMA: Volta para o anexo anterior, volta para o card principal do documento ou tópico anterior
                if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();

                    if (waitingActionTimer) {
                        clearTimeout(waitingActionTimer);
                        waitingActionTimer = null;
                    }
                    synth.cancel();
                    isPaused = false;

                    var curItem = readingQueue[currentIndex];
                    // Se estiver em um anexo:
                    if (curItem && curItem.isAnexo) {
                        // Se houver anexo anterior: volta para ele
                        if (currentIndex - 1 >= 0 && readingQueue[currentIndex - 1].isAnexo) {
                            currentIndex--;
                            speakCurrentItem();
                            return;
                        }
                        // Se for o primeiro anexo: volta para o card principal do documento
                        if (curItem.parentCardIndex !== undefined && readingQueue[curItem.parentCardIndex]) {
                            currentIndex = curItem.parentCardIndex;
                            speakCurrentItem();
                            return;
                        }
                    }

                    jumpToPrevTopic();
                    return;
                }

                // ATALHO PARA VOLTAR À PÁGINA ANTERIOR OU SAIR DO PDF (BACKSPACE, B OU ALT+ESQUERDA)
                // NOTA: A tecla Escape NUNCA navega páginas nem altera histórico; apenas encerra o modo de leitura ou sai do PDF.
                if ((e.key === 'Backspace' || e.key === 'b' || e.key === 'B' || (e.altKey && e.key === 'ArrowLeft')) && !['input', 'textarea', 'select'].includes(tag)) {
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();
                    synth.cancel();
                    if (waitingActionTimer) {
                        clearTimeout(waitingActionTimer);
                        waitingActionTimer = null;
                    }

                    if (isReadingPdf && previousQueue) {
                        speakVoiceNotice('Retornando à página da Prefeitura onde você estava.', function() {
                            isReadingPdf = false;
                            readingQueue = previousQueue;
                            currentIndex = previousIndex;
                            previousQueue = null;
                            updatePlayerUI();
                            setTimeout(speakCurrentItem, 400);
                        });
                        return;
                    }

                    // Se já estiver na página inicial, não volta no histórico do navegador
                    var currentPath = window.location.pathname.replace(/\/+$/, '');
                    if (document.body.classList.contains('home') || currentPath === '' || currentPath === '/prefeitura') {
                        if (window.ghomeSpeak) {
                            window.ghomeSpeak('Você já está na página inicial.');
                        }
                        return;
                    }

                    if (window.ghomeSpeak) {
                        window.ghomeSpeak('Retornando à página anterior onde você estava.');
                    }
                    setTtsActiveMode(true);
                    setTimeout(function() {
                        if (window.history && window.history.length > 1) {
                            window.history.back();
                        } else {
                            window.location.href = '/prefeitura/';
                        }
                    }, 400);
                    return;
                }

                // ATALHO ALT + 2: PULAR DIRETO PARA O MENU PRINCIPAL NA LEITURA DE VOZ
                if (e.altKey && (e.key === '2' || e.code === 'Digit2')) {
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();
                    var menuIdx = -1;
                    for (var m = 0; m < readingQueue.length; m++) {
                        if (readingQueue[m].topicTitle === 'Menu Principal' || (readingQueue[m].parentMenuLi && readingQueue[m].parentMenuLi.closest('#main-nav'))) {
                            menuIdx = m;
                            break;
                        }
                    }
                    if (menuIdx !== -1) {
                        currentIndex = menuIdx;
                        speakCurrentItem();
                    } else {
                        var nav = document.getElementById('main-nav') || document.querySelector('.main-nav');
                        if (nav) {
                            var firstLink = nav.querySelector('a');
                            if (firstLink) firstLink.focus();
                            var mNotice = 'Menu principal de navegação da Prefeitura.';
                            if (window.ghomeSpeak) window.ghomeSpeak(mNotice);
                            speakVoiceNotice(mNotice);
                        }
                    }
                    return;
                }

                // ATALHO ALT + 3: PULAR DIRETO PARA O CAMPO DE PESQUISA
                if (e.altKey && (e.key === '3' || e.code === 'Digit3')) {
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();
                    var searchIdx = -1;
                    for (var s = 0; s < readingQueue.length; s++) {
                        if (readingQueue[s].isSearchField && readingQueue[s].interactiveEl) {
                            searchIdx = s;
                            break;
                        }
                    }
                    if (searchIdx !== -1) {
                        currentIndex = searchIdx;
                        speakCurrentItem();
                    } else {
                        var sInput = document.querySelector('.ghome-top-search-input, input[name="s"], #s');
                        if (sInput) {
                            sInput.focus();
                            if (sInput.select) sInput.select();
                            var sNotice = 'Campo de pesquisa da Prefeitura. Digite o que deseja buscar e pressione Enter.';
                            if (window.ghomeSpeak) window.ghomeSpeak(sNotice);
                            speakVoiceNotice(sNotice);
                        }
                    }
                    return;
                }

                // ATALHO ALT + T: PULAR DIRETO PARA OS LINKS DO TOPO NA LEITURA DE VOZ
                if (e.altKey && (e.key === 't' || e.key === 'T')) {
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();
                    var topIdx = -1;
                    for (var tp = 0; tp < readingQueue.length; tp++) {
                        if (readingQueue[tp].topicTitle && readingQueue[tp].topicTitle.indexOf('Topo') !== -1) {
                            topIdx = tp;
                            break;
                        }
                    }
                    if (topIdx !== -1) {
                        currentIndex = topIdx;
                        speakCurrentItem();
                    } else {
                        var topBar = document.querySelector('.ghome-top-bar, .top-bar, #top-bar');
                        if (topBar) {
                            var topBtn = topBar.querySelector('a, button');
                            if (topBtn) topBtn.focus();
                            var tNotice = 'Barra superior e atalhos de acessibilidade.';
                            if (window.ghomeSpeak) window.ghomeSpeak(tNotice);
                            speakVoiceNotice(tNotice);
                        }
                    }
                    return;
                }

                // 6. TECLA L: Ouvir documento PDF na íntegra sem baixar
                if (e.key === 'l' || e.key === 'L') {
                    var curItem = readingQueue[currentIndex];
                    if (curItem && curItem.isPdf && curItem.pdfUrl) {
                        e.preventDefault();
                        e.stopPropagation();
                        e.stopImmediatePropagation();
                        isPaused = false;
                        loadAndReadPdf(curItem.pdfUrl, curItem.text);
                        return;
                    }
                }

                // 7. TECLA ENTER: Ouvir PDF na íntegra, acessar link ou executar pesquisa
                if (e.key === 'Enter') {
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();
                    triggerCurrentItemAction(e);
                    return;
                }

                // 8. TECLA ESC: Encerrar leitura imediatamente e voltar ao modo normal
                if (e.key === 'Escape' || e.key === 'Esc' || e.keyCode === 27) {
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();
                    stopReading();
                    try { synth.cancel(); } catch(err){}
                    return false;
                }
            }, true);

            // =========================================================================
            // MODO MÓVEL DEDICADO PARA PESSOAS COM DEFICIÊNCIA VISUAL (ACESSIBILIDADE CEGA)
            // GESTOS TÁTEIS EM QUALQUER LUGAR DA TELA (SEM PRECISAR CAÇAR BOTÕES NO VISOR)
            // =========================================================================
            var touchStartX = 0;
            var touchStartY = 0;
            var touchStartTime = 0;
            var touchEndX = 0;
            var touchEndY = 0;
            var touchPoints = 1;
            var isTrackingTouch = false;
            var longPressTimer = null;
            var isLongPress = false;
            var lastTapHandledTime = 0;
            var tapCount = 0;
            var singleTapTimer = null;
            var lastTapTime = 0;

            function clearLongPress() {
                if (longPressTimer) {
                    clearTimeout(longPressTimer);
                    longPressTimer = null;
                }
            }

            window.addEventListener('touchstart', function(e) {
                var ttsActive = isPlaying || isPaused || isTtsActiveMode() || (playerEl && playerEl.classList.contains('is-visible'));
                if (!ttsActive) return;

                var target = e.target;
                if (target.closest && (target.closest('#ghome-tts-close') || target.closest('#ghome-tts-voice-select'))) {
                    return;
                }

                if (e.touches && e.touches.length > 0) {
                    touchPoints = e.touches.length;
                    touchStartX = e.touches[0].clientX;
                    touchStartY = e.touches[0].clientY;
                    touchEndX = touchStartX;
                    touchEndY = touchStartY;
                    touchStartTime = Date.now();
                    isTrackingTouch = true;
                    isLongPress = false;

                    // Inicia detecção de segurar na tela (Long Press de 1.5s para SAIR do leitor e voltar à tela normal)
                    clearLongPress();
                    longPressTimer = setTimeout(function() {
                        isLongPress = true;
                        clearLongPress();
                        if (navigator.vibrate) {
                            try { navigator.vibrate([100, 50, 100]); } catch(err){}
                        }
                        stopReading();
                        if (window.ghomeSpeak) {
                            window.ghomeSpeak('Modo de leitura encerrado. Retornando ao modo visual normal.');
                        }
                    }, 1500);
                }
            }, { passive: true });

            window.addEventListener('touchmove', function(e) {
                if (!isTrackingTouch) return;
                if (e.touches && e.touches.length > 0) {
                    touchEndX = e.touches[0].clientX;
                    touchEndY = e.touches[0].clientY;
                    // Se moveu o dedo mais de 15px, é um gesto de deslizar, cancela o Long Press de saída
                    if (Math.abs(touchEndX - touchStartX) > 15 || Math.abs(touchEndY - touchStartY) > 15) {
                        clearLongPress();
                    }
                }
            }, { passive: true });

            window.addEventListener('touchend', function(e) {
                if (!isTrackingTouch) return;
                isTrackingTouch = false;
                clearLongPress();

                var ttsActive = isPlaying || isPaused || isTtsActiveMode() || (playerEl && playerEl.classList.contains('is-visible'));
                if (!ttsActive) return;

                if (isLongPress) {
                    isLongPress = false;
                    if (e.cancelable) e.preventDefault();
                    return;
                }

                var target = e.target;
                if (target.closest && (target.closest('#ghome-tts-close') || target.closest('#ghome-tts-voice-select'))) {
                    return;
                }

                var deltaX = touchEndX - touchStartX;
                var deltaY = touchEndY - touchStartY;
                var absX = Math.abs(deltaX);
                var absY = Math.abs(deltaY);
                var duration = Date.now() - touchStartTime;

                // GESTO COM 2 DEDOS: RETORNO DE PDF OU ALTERNAR PAUSA/CONTINUAR
                if (touchPoints >= 2) {
                    if (isReadingPdf && previousQueue) {
                        if (e.cancelable) e.preventDefault();
                        synth.cancel();
                        if (waitingActionTimer) {
                            clearTimeout(waitingActionTimer);
                            waitingActionTimer = null;
                        }
                        speakVoiceNotice('Retornando à página da Prefeitura onde você estava.', function() {
                            isReadingPdf = false;
                            readingQueue = previousQueue;
                            currentIndex = previousIndex;
                            previousQueue = null;
                            updatePlayerUI();
                            setTimeout(speakCurrentItem, 400);
                        });
                        return;
                    } else {
                        if (e.cancelable) e.preventDefault();
                        togglePlayPause();
                        return;
                    }
                }

                // 1. TOQUE TÁTIL (TAP < 350ms e < 20px)
                // - 1 TOQUE: Pausa se estiver lendo, ou Retoma se estiver pausado
                // - 2 TOQUES RÁPIDOS (Duplo toque < 350ms): Acessa o item / entra no ano / ouve PDF na íntegra
                if (absX < 20 && absY < 20 && duration < 400) {
                    if (e.cancelable) e.preventDefault();
                    lastTapHandledTime = Date.now();

                    var now = Date.now();
                    var timeSinceLastTap = now - lastTapTime;
                    lastTapTime = now;

                    // Se for o 2º toque de um DUPLO TOQUE (< 350ms):
                    if (tapCount === 1 && timeSinceLastTap < 350) {
                        // === DUPLO TOQUE (2 TOQUES NA TELA): ACESSA O ITEM ===
                        tapCount = 0;
                        if (singleTapTimer) {
                            clearTimeout(singleTapTimer);
                            singleTapTimer = null;
                        }

                        if (navigator.vibrate) {
                            try { navigator.vibrate([40, 40, 40]); } catch(err){}
                        }

                        // Aciona imediatamente a ação do item anunciado
                        triggerCurrentItemAction(e);
                        return;
                    }

                    // Se for o 1º toque, agenda a confirmação de TOQUE SIMPLES
                    tapCount = 1;
                    if (singleTapTimer) {
                        clearTimeout(singleTapTimer);
                        singleTapTimer = null;
                    }

                    singleTapTimer = setTimeout(function() {
                        tapCount = 0;
                        singleTapTimer = null;

                        // === TOQUE SIMPLES (1 TOQUE NA TELA): PAUSA OU CONTINUA ===
                        if (isPaused) {
                            resumeReading();
                        } else {
                            pauseReading();
                        }
                    }, 280);

                    return;
                }

                // 2. GESTO HORIZONTAL: DESLIZAR PARA A DIREITA OU ESQUERDA
                if (absX > 30 && absX > absY * 1.2) {
                    if (singleTapTimer) {
                        clearTimeout(singleTapTimer);
                        singleTapTimer = null;
                    }
                    tapCount = 0;
                    if (deltaX > 0) {
                        // Deslizar para a direita: vai pra frente (próximo item)
                        if (e.cancelable) e.preventDefault();
                        stepNextItem();
                        return;
                    } else {
                        // Deslizar para a esquerda: volta (item anterior)
                        if (e.cancelable) e.preventDefault();
                        stepPrevItem();
                        return;
                    }
                }

                // 3. GESTO VERTICAL: DESLIZAR PARA BAIXO OU PARA CIMA
                if (absY > 40 && absY > absX * 1.2) {
                    if (singleTapTimer) {
                        clearTimeout(singleTapTimer);
                        singleTapTimer = null;
                    }
                    tapCount = 0;
                    if (deltaY > 0) {
                        // Deslizar para baixo: pula de tópico (vai para anexos ou pula card)
                        if (e.cancelable) e.preventDefault();
                        if (waitingActionTimer) {
                            clearTimeout(waitingActionTimer);
                            waitingActionTimer = null;
                        }
                        synth.cancel();
                        isPaused = false;

                        var curIt = readingQueue[currentIndex];
                        if (curIt && curIt.isPublicationCard && curIt.hasAnexos) {
                            if (currentIndex + 1 < readingQueue.length && readingQueue[currentIndex + 1].isAnexo) {
                                currentIndex++;
                                speakCurrentItem();
                                return;
                            }
                        }
                        if (curIt && curIt.isAnexo) {
                            if (currentIndex + 1 < readingQueue.length && readingQueue[currentIndex + 1].isAnexo) {
                                currentIndex++;
                                speakCurrentItem();
                                return;
                            }
                        }
                        jumpToNextTopic();
                        return;
                    } else {
                        // Deslizar para cima: volta de tópico (anexo anterior ou tópico anterior)
                        if (e.cancelable) e.preventDefault();
                        if (waitingActionTimer) {
                            clearTimeout(waitingActionTimer);
                            waitingActionTimer = null;
                        }
                        synth.cancel();
                        isPaused = false;

                        var curItPrev = readingQueue[currentIndex];
                        if (curItPrev && curItPrev.isAnexo) {
                            if (currentIndex - 1 >= 0 && readingQueue[currentIndex - 1].isAnexo) {
                                currentIndex--;
                                speakCurrentItem();
                                return;
                            }
                            if (curItPrev.parentCardIndex !== undefined && readingQueue[curItPrev.parentCardIndex]) {
                                currentIndex = curItPrev.parentCardIndex;
                                speakCurrentItem();
                                return;
                            }
                        }
                        jumpToPrevTopic();
                        return;
                    }
                }
            }, { passive: false });

