                if (arrowRightTimeout) {
                    clearTimeout(arrowRightTimeout);
                    arrowRightTimeout = null;
                }
                lastArrowRightTime = 0;
                if (arrowLeftTimeout) {
                    clearTimeout(arrowLeftTimeout);
                    arrowLeftTimeout = null;
                }
                lastArrowLeftTime = 0;
            }
