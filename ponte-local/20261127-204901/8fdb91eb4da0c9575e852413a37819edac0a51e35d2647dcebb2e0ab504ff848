<script>
(function(){
  var startX = 0, startY = 0;

  document.addEventListener('pointerdown', function(ev){
    startX = ev.clientX || 0;
    startY = ev.clientY || 0;
  }, { passive: true });

  document.addEventListener('click', function(ev){
    var a = ev.target.closest(
      '.quick-services-grid .qs-card, .qs-card-more, .help-card'
    );
    if (!a) return;

    var dx = Math.abs((ev.clientX || 0) - startX);
    var dy = Math.abs((ev.clientY || 0) - startY);

    if (dx > 10 || dy > 10) {
      ev.preventDefault();
      return;
    }

    var href = a.getAttribute('href');
    if (!href || href === '#') {
      ev.preventDefault();
    }
  }, true);
})();
</script>


<script>
(function(){
  var popup = document.getElementById('sitePopup');
  if (!popup) return;

  var id = popup.getAttribute('data-popup-id') || '0';
  var once = popup.getAttribute('data-once') === '1';
  var key = 'popup_home_fechado_' + id;

  if (once && sessionStorage.getItem(key) === '1') return;

  function fechar(){
    popup.setAttribute('hidden', 'hidden');
    if (once) sessionStorage.setItem(key, '1');
  }

  setTimeout(function(){
    popup.removeAttribute('hidden');
  }, 700);

  popup.addEventListener('click', function(ev){
    if (ev.target === popup) fechar();
  });

  var btn = popup.querySelector('.site-popup-close');
  if (btn) btn.addEventListener('click', fechar);

  document.addEventListener('keydown', function(ev){
    if (ev.key === 'Escape' && !popup.hasAttribute('hidden')) fechar();
  });
})();
</script>

