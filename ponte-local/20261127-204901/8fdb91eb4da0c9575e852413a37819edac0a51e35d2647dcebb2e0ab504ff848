<script>
(function(){
  let tamanhoFonte = parseInt(localStorage.getItem('pmcFonte') || '100', 10);
  let contrasteAtivo = localStorage.getItem('pmcContraste') === '1';

  function aplicarFonte(){
    document.documentElement.style.fontSize = tamanhoFonte + '%';
    localStorage.setItem('pmcFonte', String(tamanhoFonte));
  }

  function aplicarContraste(){
    document.body.classList.toggle('modo-contraste', contrasteAtivo);
    localStorage.setItem('pmcContraste', contrasteAtivo ? '1' : '0');
  }

  aplicarFonte();
  aplicarContraste();

  document.addEventListener('DOMContentLoaded', function(){

    const botoes = document.querySelectorAll('.top-access button');

    const btnAmais = botoes[0] || null;
    const btnAmenos = botoes[1] || null;
    const btnContraste = botoes[2] || null;

    const linkLeitor = Array.from(document.querySelectorAll('.top-access a')).find(function(a){
      return (a.textContent || '').toLowerCase().includes('leitor');
    });

    if (btnAmais) {
      btnAmais.addEventListener('click', function(){
        tamanhoFonte += 10;
        if (tamanhoFonte > 140) tamanhoFonte = 140;
        aplicarFonte();
      });
    }

    if (btnAmenos) {
      btnAmenos.addEventListener('click', function(){
        tamanhoFonte -= 10;
        if (tamanhoFonte < 80) tamanhoFonte = 80;
        aplicarFonte();
      });
    }

    if (btnContraste) {
      btnContraste.addEventListener('click', function(){
        contrasteAtivo = !contrasteAtivo;
        aplicarContraste();
      });
    }

    if (linkLeitor) {
      linkLeitor.addEventListener('click', function(e){
        e.preventDefault();

        if (!('speechSynthesis' in window)) {
          alert('Seu navegador não oferece suporte ao leitor de voz.');
          return;
        }

        if (window.speechSynthesis.speaking) {
          window.speechSynthesis.cancel();
          return;
        }

        const area = document.querySelector('#conteudo') || document.body;
        let texto = area.innerText || '';

        texto = texto.replace(/\s+/g, ' ').trim();

        if (!texto) {
          texto = 'Não há conteúdo principal para leitura nesta página.';
        }

        const fala = new SpeechSynthesisUtterance(texto);
        fala.lang = 'pt-BR';
        fala.rate = 0.95;
        fala.pitch = 1;

        window.speechSynthesis.cancel();
        window.speechSynthesis.speak(fala);
      });
    }

  });
})();
</script>

