                    .then(response => response.json())
                    .then(data => {
                        const temperatura = data.main.temp;
                        const descricao = data.weather[0].description;

                        document.getElementById('clima').textContent =
                            `Agora em ${cidade}: ${temperatura}°C, ${descricao}`;
