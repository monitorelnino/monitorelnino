    document.addEventListener("DOMContentLoaded", function () {
        const itens = document.querySelectorAll('[data-noticia="item"]');
        let current = 0;

        if (itens.length > 0) {
            itens[0].classList.add('ativo');

            const trocarItem = () => {
                const total = itens.length;
                const atual = itens[current];
                const proximoIndex = (current + 1) % total;
                const proximo = itens[proximoIndex];

                atual.classList.remove('ativo');
                atual.classList.add('saindo');

                proximo.classList.add('ativo');

                setTimeout(() => {
                    atual.classList.remove('saindo');
                }, 500);

                current = proximoIndex;
            }

            setTimeout(() => {
                trocarItem();

                setInterval(trocarItem, 5000);
            }, 5000);
        }
    });
</script>

