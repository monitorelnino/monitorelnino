    $('#showMenuAcessibilidade').click(function(e) {

        e.preventDefault();


        $('#menuAcessibilidade')
            .animate({
                marginLeft: '0'
            }, 300);


    });




    $('#hideMenuAcessibilidade').click(function() {


        $('#menuAcessibilidade')
            .animate({
                marginLeft: '-500px'
            }, 300);


    });





    $('#aumentarFonte').click(function() {


        var tamanho = parseFloat($('body').css('font-size'));


        $('body').css(

            'font-size',

            (tamanho + 2) + 'px'

        );


    });





    $('#diminuirFonte').click(function() {


        var tamanho = parseFloat($('body').css('font-size'));


        $('body').css(

            'font-size',

            (tamanho - 2) + 'px'

        );


    });





    $('#fonteOriginal').click(function() {


        $('body').css(

            'font-size',

            '16px'

        );


    });





    /* ================================
     ALTO CONTRASTE
    ================================ */


    document.getElementById("btnContraste")
        .addEventListener("click", function() {


            var css = document.getElementById("css_contraste");



            if (css) {


                css.parentNode.removeChild(css);


            } else {


                var link = document.createElement("link");


                link.id = "css_contraste";

                link.rel = "stylesheet";

                link.type = "text/css";

                link.href = "css/contraste.css";



                document
                    .getElementsByTagName("head")[0]
                    .appendChild(link);



            }


        });
