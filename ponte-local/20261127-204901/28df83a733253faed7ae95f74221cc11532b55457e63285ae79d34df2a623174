<script>
    document.addEventListener("DOMContentLoaded", () => {
        const boxes = document.querySelectorAll(".home-instagram-section .box-video");

        const allPause = (exc) => boxes.forEach(b => {
            const v = b.querySelector(".video-insta");
            const btn = b.querySelector('[data-play-insta="btn"]');
            if (!v || !btn || v === exc) return;
            v.pause(); v.muted = true;
            btn.style.display = "block";
        });

        boxes.forEach(b => {
            const v = b.querySelector(".video-insta");
            const btn = b.querySelector('[data-play-insta="btn"]');
            if (!v || !btn) return;

            v.muted = true;
            btn.style.display = "none"; // começa sem play

            const toggle = (e) => {
                e.preventDefault(); e.stopPropagation();

                // se está tocando com som -> pausa e mostra play
                if (!v.paused && !v.muted) {
                    v.pause(); v.muted = true;
                    btn.style.display = "block";
                    return;
                }

                // senão -> foca nele
                allPause(v);
                v.muted = false;
                v.play().catch(() => { });
                btn.style.display = "none";
            };

            v.addEventListener("click", toggle);
            btn.addEventListener("click", toggle); // ✅ importante
        });
    });
</script>

