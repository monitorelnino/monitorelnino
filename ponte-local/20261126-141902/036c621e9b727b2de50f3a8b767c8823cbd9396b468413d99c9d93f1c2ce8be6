                            const fullRelativeUrl = portalURL + layoutRelativeURL;

                            const title = data.title;

                            const facebookShareLink = document.getElementById('sharer_com_liferay_login_web_portlet_LoginPortlet').querySelector('.facebook');
                            if (facebookShareLink) {
