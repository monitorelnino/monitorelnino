                        .then(data => {
                            const dateModified = new Date(data.dateModified);

                            const day = String(dateModified.getDate()).padStart(2, '0');
                            const month = String(dateModified.getMonth() + 1).padStart(2, '0');
                            const year = dateModified.getFullYear();
                            const hours = String(dateModified.getHours()).padStart(2, '0');
                            const minutes = String(dateModified.getMinutes()).padStart(2, '0');

                            const formattedDate = day + '/' + month + '/' + year + ' às ' + hours + 'h' + minutes;

                            const timeTextElement = document.getElementById('time-text_com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet_INSTANCE_templateSearch');
                            if (timeTextElement) {
                                timeTextElement.textContent = 'Atualizado em ' + formattedDate;
                            }

                            const layoutRelativeURL = Liferay.ThemeDisplay.getLayoutRelativeURL();
                            const fullRelativeUrl = portalURL + layoutRelativeURL;

                            const title = data.title;

                            const facebookShareLink = document.getElementById('sharer_com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet_INSTANCE_templateSearch').querySelector('.facebook');
                            if (facebookShareLink) {
                                facebookShareLink.setAttribute('href', 'https://www.facebook.com/sharer.php?u=' + encodeURIComponent(fullRelativeUrl));
                            }

                            const twitterShareLink = document.getElementById('sharer_com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet_INSTANCE_templateSearch').querySelector('.twitter');
                            if (twitterShareLink) {
                                twitterShareLink.setAttribute('href', 'http://twitter.com/intent/tweet?text=' + encodeURIComponent(title) + '&url=' + encodeURIComponent(fullRelativeUrl));
                            }
                        })
                        .catch(error => {});
                })();
            }
        }
