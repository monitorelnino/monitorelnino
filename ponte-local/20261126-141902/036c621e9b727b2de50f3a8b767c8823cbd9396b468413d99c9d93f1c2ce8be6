                            const twitterShareLink = document.getElementById('sharer_com_liferay_login_web_portlet_LoginPortlet').querySelector('.twitter');
                            if (twitterShareLink) {
                                twitterShareLink.setAttribute('href', 'http://twitter.com/intent/tweet?text=' + encodeURIComponent(title) + '&url=' + encodeURIComponent(fullRelativeUrl));
                            }
                        })
                        .catch(error => {});
                })();
