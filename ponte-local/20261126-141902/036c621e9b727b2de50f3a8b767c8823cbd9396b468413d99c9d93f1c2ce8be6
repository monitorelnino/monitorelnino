      (function () {
        var root = document.getElementById('_com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet_INSTANCE_5LGMawjSF3q0_buscaServicos');

        if (!root) {
          return;
        }

        var input = document.getElementById('_com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet_INSTANCE_5LGMawjSF3q0_buscaServicos_input');
        var lista = document.getElementById('_com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet_INSTANCE_5LGMawjSF3q0_buscaServicos_lista');
        var servicos = JSON.parse(document.getElementById('_com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet_INSTANCE_5LGMawjSF3q0_buscaServicos_dados').textContent);
        var maxResultados = 10;
        var resultados = [];
        var ativo = -1;
        var form = root.closest('form');

        // A barra de busca do Liferay fica dentro de um form; aqui ela nunca pesquisa.
        if (form) {
          form.addEventListener('submit', function (event) {
            event.preventDefault();
          });
        }

        function externo(url) {
          try {
            return new URL(url, location.href).host !== location.host;
          }
          catch (error) {
            return false;
          }
        }

        function normalize(text) {
          return text.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();
        }

        servicos.forEach(function (servico) {
          servico.nome = normalize(servico.n);
          servico.busca = normalize(servico.n + ' ' + servico.g);
        });

        function fechar() {
          lista.hidden = true;
          ativo = -1;
          input.setAttribute('aria-expanded', 'false');
          input.removeAttribute('aria-activedescendant');
        }

        function destacar(index) {
          var opcoes = lista.querySelectorAll('[role="option"]');

          if (!opcoes.length) {
            return;
          }

          ativo = (index + opcoes.length) % opcoes.length;

          opcoes.forEach(function (opcao, i) {
            opcao.classList.toggle('is-ativa', i === ativo);
            opcao.setAttribute('aria-selected', i === ativo);
          });

          input.setAttribute('aria-activedescendant', opcoes[ativo].id);
          opcoes[ativo].scrollIntoView({block: 'nearest'});
        }

        function renderizar() {
          lista.innerHTML = '';

          if (!resultados.length) {
            var vazio = document.createElement('li');

            vazio.className = 'busca-servicos__vazio';
            vazio.textContent = 'Nenhum serviço encontrado.';
            lista.appendChild(vazio);
          }

          resultados.forEach(function (servico, index) {
            var opcao = document.createElement('li');
            var link = document.createElement('a');

            opcao.className = 'busca-servicos__opcao';
            opcao.id = '_com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet_INSTANCE_5LGMawjSF3q0_buscaServicos_opcao_' + index;
            opcao.setAttribute('aria-selected', 'false');
            opcao.setAttribute('role', 'option');

            link.href = servico.u;
            link.tabIndex = -1;
            link.setAttribute('data-senna-off', 'true');
            link.textContent = servico.n;

            if (servico.t || externo(servico.u)) {
              link.target = '_blank';
              link.rel = 'noopener noreferrer';
            }

            if (servico.g) {
              var grupo = document.createElement('span');

              grupo.className = 'busca-servicos__grupo';
              grupo.textContent = servico.g;
              link.appendChild(grupo);
            }

            opcao.appendChild(link);
            lista.appendChild(opcao);
          });

          ativo = -1;
          lista.hidden = false;
          input.setAttribute('aria-expanded', 'true');
          input.removeAttribute('aria-activedescendant');
        }

        function filtrar() {
          var consulta = normalize(input.value);

          if (consulta.length < 2) {
            fechar();

            return;
          }

          var termos = consulta.split(/\s+/);

          resultados = servicos.filter(function (servico) {
            return termos.every(function (termo) {
              return servico.busca.indexOf(termo) > -1;
            });
          }).sort(function (a, b) {
            return (b.nome.indexOf(consulta) === 0) - (a.nome.indexOf(consulta) === 0);
          }).slice(0, maxResultados);

          renderizar();
        }

        input.addEventListener('input', filtrar);
        input.addEventListener('focus', filtrar);

        input.addEventListener('keydown', function (event) {
          if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
            event.preventDefault();

            if (lista.hidden) {
              filtrar();
            }

            destacar(ativo + (event.key === 'ArrowDown' ? 1 : -1));
          }
          else if (event.key === 'Enter') {
            event.preventDefault();

            var opcao = ativo > -1 && lista.querySelectorAll('[role="option"]')[ativo];

            if (opcao) {
              opcao.querySelector('a').click();
            }
          }
          else if (event.key === 'Escape') {
            fechar();
          }
        });

        document.addEventListener('click', function (event) {
          if (!root.contains(event.target)) {
            fechar();
          }
        });
      })();
