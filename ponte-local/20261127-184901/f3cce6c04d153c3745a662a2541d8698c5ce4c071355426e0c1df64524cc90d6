    <script type="text/javascript">
        function setCookie(name, value) {
            document.cookie = name + "=" + value + ";path=/";
        }
        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
        }

        var currentDate = new Date();
        var dataLimiteIptu = new Date('2024-07-02');

        function exibirIptu() {
            if (getCookie('modalIptuExibido') !== 'true') {
                setCookie('modalIptuExibido', 'true');
            } else {
                function abrirModal() {
                    homeCarousel = document.getElementById("homeCarousel");
                    homeCarousel.setAttribute('data-bs-ride', 'false');
                    $('#modal_iptu').modal('show');
                    sessionStorage.setItem('modalIPTUExibido', 'true');
                }
                setTimeout(abrirModal, 200);
            }
        }

        if (currentDate < dataLimiteIptu) {
            exibirIptu();
        }

    </script>

