    function carregarCota(codcot) {
        $.ajax({
            type: 'post',
            url: '/service/cota/get',
            data: 'codcot=' + codcot,
            dataType: 'json',
            success: function (data) {
                $('#endereco').html(data.enderecoFormatado);
                $('#cota').html(data.cotaFormatada + " m");
