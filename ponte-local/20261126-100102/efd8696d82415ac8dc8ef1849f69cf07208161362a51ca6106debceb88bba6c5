							tag: 'search',
							gname: googleSearchElementName
					});
			};

			if (document.readyState == 'complete') {
					renderizaBuscaGoogle();
			} else {
					google.setOnLoadCallback(renderizaBuscaGoogle, true);
			}
	};
	window.__gcse = {
			parsetags: 'explicit',
			callback: myCallback
	};
