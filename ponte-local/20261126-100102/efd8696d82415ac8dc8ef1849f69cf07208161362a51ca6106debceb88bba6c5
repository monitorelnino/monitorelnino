			'.busca_google_engine .gsc-search-box,.busca_google_engine form.gsc-search-box{display:none!important}' +
			'.busca_google_engine .gsc-control-cse{padding:0!important;background:transparent!important;border:0!important}' +
			'</style>';
	$('head').append(cssBuscaGoogleCustom);

	var executaBuscaGoogle = function(termo, tentativas) {
			termo = $.trim(termo || '');
			tentativas = tentativas || 0;

			if (!termo) {
					return;
			}

			if (window.google && google.search && google.search.cse && google.search.cse.element) {
					var elementoGoogle = google.search.cse.element.getElement(googleSearchElementName);
					if (elementoGoogle && typeof elementoGoogle.execute == 'function') {
							elementoGoogle.execute(termo);
							return;
					}
			}

			var $inputGoogle = $('#' + idDivBusca + ' input.gsc-input');
			var $botaoGoogle = $('#' + idDivBusca + ' button.gsc-search-button, #' + idDivBusca + ' input.gsc-search-button');
			if ($inputGoogle.length && $botaoGoogle.length) {
					$inputGoogle.val(termo);
					$botaoGoogle.first().trigger('click');
					return;
			}

			if (tentativas < 20) {
					setTimeout(function() {
							executaBuscaGoogle(termo, tentativas + 1);
					}, 100);
					return;
			}

			window.location.href = 'https://www.google.com/search?q=' + encodeURIComponent('site:antonioprado.rs.gov.br ' + termo);
	};

	$(document).on('input', '.input_busca_google', function() {
			$('#' + idDivBusca + ' input.gsc-input').val($(this).val());
	});

	$(document).on('submit', '.form_busca_google', function(event) {
			event.preventDefault();
			executaBuscaGoogle($(this).find('.input_busca_google').val());
	});

	var myCallback = function() {
			var renderizaBuscaGoogle = function() {
					google.search.cse.element.render(
