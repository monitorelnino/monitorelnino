	}

	var googleSearchElementName = 'buscaGoogleSite';
	var cssBuscaGoogleCustom = '<style>' +
			'.form_busca_google{display:flex;width:100%;max-width:320px;margin:0}' +
			'.form_busca_google input{width:calc(100% - 45px);height:36px;padding:0 10px;border:1px solid #ddd;border-right:0;outline-color:#e9982c;color:#666;font-size:14px}' +
