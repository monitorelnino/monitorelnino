    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const images = document.querySelectorAll(".hstry-feat-pstt img, .hstry-ffeat-pstt img , .prtf-bx4 img");
            const lightbox = document.getElementById("lightbox");
            const lightboxImg = document.getElementById("lightbox-img");
            const prevBtn = document.getElementById("prevBtn");
            const nextBtn = document.getElementById("nextBtn");

            let scale = 1;
            let currentIndex = 0;
            let startX = 0;
            let endX = 0;
            let diffX = 0;
            let isDragging = false;

            let imageList = Array.from(images);

            function showImage(index) {
                if (!imageList[index]) return;
                scale = 1;
                currentIndex = index;
                lightboxImg.src = imageList[currentIndex].src;
                lightboxImg.style.transform = `scale(${scale})`;
                lightbox.style.display = "flex";
            }

            images.forEach((img, index) => {
                img.addEventListener("click", function () {
                    showImage(index);
                });
            });

            const lupaBotoes = document.querySelectorAll(".img-open");
            lupaBotoes.forEach(btn => {
                btn.addEventListener("click", function (e) {
                    e.preventDefault();
                    const img = this.closest(".prtf-bx4").querySelector("img");
                    const index = imageList.indexOf(img);
                    if (index !== -1) {
                        showImage(index);
                    }
                });
            });

            const closeBtn = document.getElementById("closeBtn");
            closeBtn.addEventListener("click", function () {
                lightbox.style.display = "none";
            });

            lightboxImg.addEventListener("click", function () {
                scale += 0.5;
                if (scale > 2) scale = 1;
                this.style.transform = `scale(${scale})`;
            });

            lightbox.addEventListener("click", function (event) {
                if (event.target === lightbox) {
                    lightbox.style.display = "none";
                }
            });

            prevBtn.addEventListener("click", function (e) {
                e.stopPropagation();
                currentIndex = (currentIndex - 1 + imageList.length) % imageList.length;
                showImage(currentIndex);
            });

            nextBtn.addEventListener("click", function (e) {
                e.stopPropagation();
                currentIndex = (currentIndex + 1) % imageList.length;
                showImage(currentIndex);
            });

            // Funcionalidade de arraste com transição suave
            lightboxImg.addEventListener("touchstart", function (e) {
                startX = e.changedTouches[0].pageX;
                isDragging = true;
            });

            lightboxImg.addEventListener("touchmove", function (e) {
                if (!isDragging) return;
                endX = e.changedTouches[0].pageX;
                diffX = endX - startX;
                lightboxImg.style.transition = "none"; // Remove a transição ao arrastar
                lightboxImg.style.transform = `translateX(${diffX}px)`; // Move a imagem com o arrasto
            });

            lightboxImg.addEventListener("touchend", function (e) {
                isDragging = false;
                if (Math.abs(diffX) > 100) { // Se o arrasto foi longo o suficiente
                    if (diffX > 0) { // Arrastou para a direita
                        currentIndex = (currentIndex - 1 + imageList.length) % imageList.length;
                    } else { // Arrastou para a esquerda
                        currentIndex = (currentIndex + 1) % imageList.length;
                    }
                    showImage(currentIndex);
                } else {
                    // Se o arrasto não for longo o suficiente, volta para o lugar original
                    lightboxImg.style.transition = "transform 0.3s ease-in-out";
                    lightboxImg.style.transform = `translateX(0)`;
                }
            });

            // Para desktop, adicionar o comportamento de arraste com o mouse
            lightboxImg.addEventListener("mousedown", function (e) {
                startX = e.pageX;
                isDragging = true;
                lightboxImg.style.transition = "none"; // Remove a transição ao arrastar
            });

            lightboxImg.addEventListener("mousemove", function (e) {
                if (!isDragging) return;
                endX = e.pageX;
                diffX = endX - startX;
                lightboxImg.style.transform = `translateX(${diffX}px)`; // Move a imagem com o arrasto
            });

            lightboxImg.addEventListener("mouseup", function () {
                isDragging = false;
                if (Math.abs(diffX) > 100) { // Se o arrasto foi longo o suficiente
                    if (diffX > 0) { // Arrastou para a direita
                        currentIndex = (currentIndex - 1 + imageList.length) % imageList.length;
                    } else { // Arrastou para a esquerda
                        currentIndex = (currentIndex + 1) % imageList.length;
                    }
                    showImage(currentIndex);
                } else {
                    // Se o arrasto não for longo o suficiente, volta para o lugar original
                    lightboxImg.style.transition = "transform 0.3s ease-in-out";
                    lightboxImg.style.transform = `translateX(0)`;
                }
            });

            lightboxImg.addEventListener("mouseleave", function () {
                if (isDragging) {
                    isDragging = false;
                    lightboxImg.style.transition = "transform 0.3s ease-in-out";
                    lightboxImg.style.transform = `translateX(0)`;
                }
            });
        });
    </script>


	<script>
		document.addEventListener("DOMContentLoaded", function() {
			// Função para aumentar a fonte
			function aumentarFonte() {
				document.querySelectorAll("body *").forEach(function(el) {
					// Pega o tamanho atual da fonte
					let style = window.getComputedStyle(el, null).getPropertyValue('font-size');
					let currentSize = parseFloat(style);
		
					// Aumenta 10%
					el.style.fontSize = (currentSize * 1.1) + "px";
				});
			}
		
			// Função para diminuir a fonte
			function diminuirFonte() {
				document.querySelectorAll("body *").forEach(function(el) {
					let style = window.getComputedStyle(el, null).getPropertyValue('font-size');
					let currentSize = parseFloat(style);
					el.style.fontSize = (currentSize / 1.1) + "px"; // reduz ~10%
				});
			}
		
			// Exemplo de uso: botões com id="aumentar" e id="diminuir"
			const btnAumentar = document.getElementById("aumentar");
			if (btnAumentar) btnAumentar.addEventListener("click", aumentarFonte);
			
			const btnDiminuir = document.getElementById("diminuir");
			if (btnDiminuir) btnDiminuir.addEventListener("click", diminuirFonte);
			
			// menu mobile usa ids proprios porque id repetido so liga no primeiro elemento
			const btnAumentarMobile = document.getElementById("aumentar_mobile");
			if (btnAumentarMobile) btnAumentarMobile.addEventListener("click", aumentarFonte);
			
			const btnDiminuirMobile = document.getElementById("diminuir_mobile");
			if (btnDiminuirMobile) btnDiminuirMobile.addEventListener("click", diminuirFonte);
			
		});
	</script>



