			document.documentElement.classList.toggle("modo-contraste");
		
			if (document.documentElement.classList.contains("modo-contraste")) {
				localStorage.setItem("altoContraste", "ativo");
			} else {
				localStorage.removeItem("altoContraste");
			}
		
			const modo = document.documentElement.classList.contains("modo-contraste") ? "ativado" : "desativado";
			if (leituraAtivada) lerMensagemDeAtivacao(`Modo alto contraste ${modo}`);
		}
		
		if (altoContraste) {
			altoContraste.addEventListener('click', alternarAltoContraste);
		}
		
		// id proprio no mobile porque getElementById so enxerga o primeiro elemento
		if (altoContrasteMobile) {
			altoContrasteMobile.addEventListener('click', alternarAltoContraste);
		}


		
	
		function lerTexto(texto) {
			const fala = new SpeechSynthesisUtterance(texto);
			speechSynthesis.speak(fala);
		}
	
		function lerMensagemDeAtivacao(mensagem) {
			lendoMensagemDeAtivacao = true;
			const fala = new SpeechSynthesisUtterance(mensagem);
			fala.onend = () => lendoMensagemDeAtivacao = false;
			speechSynthesis.cancel();
			speechSynthesis.speak(fala);
		}
	
		// --- Leitura por mouseover ---
		document.addEventListener('mouseover', (evento) => {
			if (leituraAtivada && !lendoMensagemDeAtivacao) {
				const texto = evento.target.textContent || evento.target.alt || "";
				if (texto.trim()) {
					speechSynthesis.cancel();
					lerTexto(texto);
				}
			}
		});
	
		document.addEventListener('mouseout', () => {
			if (leituraAtivada && !lendoMensagemDeAtivacao) {
				speechSynthesis.cancel();
			}
		});
	});
</script>

	
