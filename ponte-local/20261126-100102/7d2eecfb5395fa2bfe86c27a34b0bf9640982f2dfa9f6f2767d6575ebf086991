            var menu = $(".rsnp-mnu");
            if (menu.is(":visible")) {
                menu.fadeOut(200);
                $("body").removeClass("menu-aberto");
            } else {
                menu.fadeIn(200);
                $("body").addClass("menu-aberto");
            }
        });

        // Fecha o menu ao clicar no botão de fechar
        $(".rspn-mnu-cls").on("click", function () {
            $(".rsnp-mnu").fadeOut(200);
            $("body").removeClass("menu-aberto");
        });

        // Fecha o menu ao clicar fora dele
        $(document).on("click", function (e) {
            var target = $(e.target);
            if (
                !target.closest(".rsnp-mnu").length && // Não clicou dentro do menu
                !target.closest(".rspn-mnu-btn").length // Nem no botão de abrir
            ) {
                $(".rsnp-mnu").fadeOut(200);
                $("body").removeClass("menu-aberto");
            }
        });

        // Evita que cliques dentro do menu fechem ele
        $(".rsnp-mnu").on("click", function (e) {
            e.stopPropagation();
        });

        // Ao clicar no menu principal (sem link), abrir submenu e filhos automaticamente
        $(".mbl-item-com-submenu > .mbl-link").on("click", function (e) {
            e.preventDefault();

            var dropdown = $(this).next(".mbl-dropdown");

            // Fecha todos os outros dropdowns e submenus
            $(".mbl-dropdown").not(dropdown).slideUp();
            $(".mbl-submenu-list").slideUp();

            // Abre este submenu
            dropdown.slideToggle();

            // Também abre todos os sub-submenus dentro dele
            dropdown.find(".mbl-submenu-list").slideDown();
        });

        // Submenus com filhos - o link navega normalmente, mas também abre/fecha os filhos
        $(".mbl-submenu.has-submenu > a").on("click", function (e) {
            var sub = $(this).next(".mbl-submenu-list");
            $(".mbl-submenu-list").not(sub).slideUp();
            sub.slideToggle();
        });
		
		// Botão "X" dentro do menu mobile fecha o menu
		$(".rspn-mnu-cls-x").on("click", function () {
			$(".rsnp-mnu").fadeOut(200);
			$("body").removeClass("menu-aberto");
		});

    });
	
</script>


<script>
	document.addEventListener('DOMContentLoaded', function () {
		const submenus = document.querySelectorAll('.styl8-menu ul li ul');
	
		submenus.forEach(menu => {
			const parent = menu.parentElement;
	
			parent.addEventListener('mouseenter', () => {
				const rect = menu.getBoundingClientRect();
				const windowWidth = window.innerWidth;
	
				// Se o submenu passar da borda direita → abre para a esquerda
				if (rect.right > windowWidth) {
					menu.classList.add('inverte-lado');
				} else {
					menu.classList.remove('inverte-lado');
				}
			});
	
			// Garante que a posição é recalculada quando o mouse sai e volta
			parent.addEventListener('mouseleave', () => {
				menu.classList.remove('inverte-lado');
			});
		});
	});
	
	document.addEventListener("DOMContentLoaded", function() {
    const imgs = document.querySelectorAll('img[data-src]');
    const obs = new IntersectionObserver((entries, observer) => {
			entries.forEach(e => {
				if (e.isIntersecting) {
					e.target.src = e.target.dataset.src;
					observer.unobserve(e.target);
				}
			});
		});
		imgs.forEach(img => obs.observe(img));
	});

</script>

<script>
	// Evita repaints desnecessários durante o scroll
	let ticking = false;
	window.addEventListener('scroll', function() {
	if (!ticking) {
		window.requestAnimationFrame(function() {
		ticking = false;
		});
		ticking = true;
	}
	});
	
	// Desativa animações enquanto a aba estiver em segundo plano
	document.addEventListener('visibilitychange', function() {
	if (document.hidden) {
		document.body.classList.add('paused');
	} else {
		document.body.classList.remove('paused');
	}
	});
	
	// Habilita aceleração GPU em elementos animados visíveis
	const animatedEls = document.querySelectorAll('.animated, .banner, .fade-in');
	const observer = new IntersectionObserver(entries => {
	entries.forEach(entry => {
		if (entry.isIntersecting) {
		entry.target.style.willChange = 'transform, opacity';
		entry.target.style.transform = 'translateZ(0)';
		} else {
		entry.target.style.willChange = 'auto';
		entry.target.style.transform = '';
		}
	});
	});
	animatedEls.forEach(el => observer.observe(el));
	
	// Ativa lazy-loading em imagens e vídeos antigos
	document.addEventListener("DOMContentLoaded", function() {
	document.querySelectorAll('img, iframe, video').forEach(el => {
		if (!el.hasAttribute('loading')) {
		el.setAttribute('loading', 'lazy');
		}
		el.decoding = 'async';
	});
	});
	
</script>

