        var aceito = false;

        // modo anonimo/storage bloqueado lanca excecao na leitura
        try {
            aceito = localStorage.getItem(CHAVE) === "1";
        } catch (e) { }

        if (aceito) return;

        aviso.hidden = false;
        requestAnimationFrame(function () {
