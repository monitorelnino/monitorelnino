<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Banner de Cookies</title>
    <style>
        :root {
            --primary-color: #017c38;
            --text-color: #333333;
            --bg-color: #ffffff;
            --shadow-color: rgba(47, 54, 64, 0.39);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
        }

        .cookie-container {
            position: fixed;
            z-index: 99999999;
            bottom: -100%;
            left: 0;
            right: 0;
            background: var(--bg-color);
            color: var(--text-color);
            padding: 20px;
            box-shadow: 0 -2px 16px var(--shadow-color);
            transition: transform 0.4s ease-in-out, bottom 0.4s ease-in-out;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        @media (min-width: 768px) {
            .cookie-container {
                flex-direction: row;
                text-align: left;
                padding: 15px 32px;
            }
        }

        .cookie-container.active {
            bottom: 0;
        }

        .cookie-txt {
            margin-bottom: 15px;
            line-height: 1.6;
            font-size: 16px;
            flex: 1;
        }

        @media (min-width: 768px) {
            .cookie-txt {
                margin: 0 20px 0 0;
                padding-right: 20px;
            }
        }

        .cookie-txt a {
            color: var(--primary-color);
            text-decoration: underline;
            font-weight: 600;
        }

        .cookie-txt a:hover {
            opacity: 0.8;
        }

        .cookie-buttons {
            display: flex;
            flex-direction: row;
            gap: 10px;
        }

        .cookie-btn {
            background: var(--primary-color);
            border: 0;
            color: white;
            padding: 10px 20px;
            font-size: 16px;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.3s;
            min-width: 100px;
            font-weight: 600;
        }

        .cookie-btn:hover {
            background-color: #015c28;
        }

        .cookie-btn.cookie-decline {
            background-color: transparent;
            border: 1px solid var(--primary-color);
            color: var(--primary-color);
        }

        .cookie-btn.cookie-decline:hover {
            background-color: rgba(1, 124, 56, 0.1);
        }

        @media (max-width: 480px) {
            .cookie-container {
                padding: 15px;
            }

            .cookie-txt {
                font-size: 14px;
                margin-bottom: 10px;
            }

            .cookie-btn {
                padding: 8px 15px;
                font-size: 14px;
                min-width: 80px;
            }
        }
    </style>
</head>

<body>
    <div class="cookie-container">
        <p class="cookie-txt">
            Este site ultiliza cookies e outras tecnologias semelhantes para
            melhorar a sua experi&ecirc;ncia em nossa plataforma. Voc&ecirc; aceita
            a <a href="https://www.ourizona.pr.gov.br/index.php?sessao=p0" >politica de privacidade</a>?
        </p>
        <div class="cookie-buttons">
            <button class="cookie-btn cookie-accept">Aceitar</button>
            <button class="cookie-btn cookie-decline">Recusar</button>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const cookieContainer = document.querySelector(".cookie-container");
            const acceptButton = document.querySelector(".cookie-accept");
            const declineButton = document.querySelector(".cookie-decline");

            // Função para aceitar cookies
            function acceptCookies() {
                cookieContainer.classList.remove("active");
                localStorage.setItem("cookieBannerDisplayed", "accepted");
                setTimeout(() => {
                    cookieContainer.style.display = "none";
                }, 400);
            }

            // Função para recusar cookies
            function declineCookies() {
                cookieContainer.classList.remove("active");
                // Não salvamos nada no localStorage ao recusar
                // Isso fará o banner reaparecer na próxima vez que a página for carregada
                setTimeout(() => {
                    cookieContainer.style.display = "none";
                }, 400);
            }

            // Adicionar event listeners
            acceptButton.addEventListener("click", acceptCookies);
            declineButton.addEventListener("click", declineCookies);

            // Verificar se o banner já foi mostrado e aceito
            setTimeout(() => {
                const cookieStatus = localStorage.getItem("cookieBannerDisplayed");
                // Só não exibe o banner se os cookies foram explicitamente aceitos
                if (cookieStatus !== "accepted") {
                    cookieContainer.classList.add("active");
                }
            }, 1000);
        });
    </script>
</body>

