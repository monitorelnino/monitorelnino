                text: "Digite o nome de um programa para buscar.",
                });
            }
        }

        let inputProgramas = document.getElementById('inputProgramas');
        inputProgramas.addEventListener("keyup", ({key}) => {
            console.log(inputProgramas.value.length);
            if(inputProgramas.value.length >=1)
            {
                buscaProgramas(inputProgramas.value,1,'texto');
            }
            else if(inputProgramas.value.length ==0)
            {
                buscaProgramas('geral',1,'geral');
            }
            if (key === "Enter") {
                buscaProgramas(inputProgramas.value,1,'texto');
