  <!-- Lógica Javascript do Carrossel Em Alta (Loop Infinito Verdadeiro) -->
    <script>
    document.addEventListener("DOMContentLoaded", function() {
        const carrossel = document.getElementById('carrosselEmAlta');
        const btnPrev = document.getElementById('btnPrevEmAlta');
        const btnNext = document.getElementById('btnNextEmAlta');

        if(!carrossel || carrossel.children.length === 0) return;

        // 1. Clona os cards originais para criar a "esteira infinita"
        const cardsOriginais = Array.from(carrossel.children);
        cardsOriginais.forEach(card => {
            const clone = card.cloneNode(true);
            carrossel.appendChild(clone);
        });

        let isPaused = false;
        let isInteracting = false;
        const velocidadeRolagem = 0.5; // Velocidade da rolagem (aumente se quiser mais rápido)

        // Calcula a largura exata de um "set" completo de cards
        function getPontoDeCorte() {
            // A diferença de posição entre o primeiro card clonado e o primeiro original
            return carrossel.children[cardsOriginais.length].offsetLeft - carrossel.children[0].offsetLeft;
        }

        // Função que faz o carrossel andar sozinho
        function autoScroll() {
            if (!isPaused && !isInteracting) {
                carrossel.scrollLeft += velocidadeRolagem;

                // Quando atinge exatamente o início do card clonado, volta para a posição 0 de forma invisível
                if (carrossel.scrollLeft >= getPontoDeCorte()) {
                    carrossel.scrollLeft -= getPontoDeCorte();
                }
            }
            requestAnimationFrame(autoScroll);
        }

        // Inicia a rolagem
        requestAnimationFrame(autoScroll);

        // Pausa quando o usuário passa o mouse ou toca na tela do celular
        carrossel.addEventListener('mouseenter', () => isPaused = true);
        carrossel.addEventListener('mouseleave', () => isPaused = false);
        carrossel.addEventListener('touchstart', () => isPaused = true);
        carrossel.addEventListener('touchend', () => setTimeout(() => isPaused = false, 1000));

        // Controle dos botões com salto invisível
        function moverCarrossel(direcao) {
            isInteracting = true; 
            const pontoDeCorte = getPontoDeCorte();

            // Se for voltar e estiver perto do limite esquerdo, dá um salto para a cópia primeiro
            if (direcao === 'prev' && carrossel.scrollLeft < 350) {
                carrossel.scrollLeft += pontoDeCorte;
                carrossel.offsetHeight; // Força o navegador a aplicar o salto imediatamente
            } 
            // Se for avançar e já tiver passado da cópia, volta pro original
            else if (direcao === 'next' && carrossel.scrollLeft >= pontoDeCorte) {
                carrossel.scrollLeft -= pontoDeCorte;
                carrossel.offsetHeight; 
            }

            // Distância para pular ao clicar no botão
            const distancia = direcao === 'next' ? 350 : -350; 
            carrossel.scrollBy({ left: distancia, behavior: 'smooth' });

            // Aguarda a animação suave terminar
            setTimeout(() => {
                isInteracting = false;
            }, 800); 
        }

        if(btnNext) btnNext.addEventListener('click', () => moverCarrossel('next'));
        if(btnPrev) btnPrev.addEventListener('click', () => moverCarrossel('prev'));
    });
    </script>
