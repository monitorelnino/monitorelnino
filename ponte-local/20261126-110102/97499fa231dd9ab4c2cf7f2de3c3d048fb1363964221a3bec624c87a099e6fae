.s-dark .smart-head-main .smart-head-bot,
.smart-head-main .s-dark.smart-head-bot { background-color: #006db9; }
.smart-head-main .smart-head-bot { border-bottom-width: 2px; border-bottom-color: #69abce; }
.navigation-main .menu > li > a { font-size: 17px; font-weight: bold; letter-spacing: 0.04em; }
.navigation-main .menu > li li a { line-height: 1.3; letter-spacing: 0.05em; }
.navigation-main { height: 60px; --nav-items-space: 8px; }
.s-light .navigation-main { --c-nav: #ffffff; --c-nav-hov: #ffffff; }
.s-light .navigation { --c-nav-blip: #ffffff; --c-nav-drop-bg: #eebe08; --c-nav-drop-hov-bg: #034eac; --c-nav-drop: #0a0a0a; --c-nav-drop-hov: #ffffff; }
.smart-head-mobile .smart-head-mid { background-color: #034eac; }
.s-dark .smart-head-mobile .smart-head-mid,
.smart-head-mobile .s-dark.smart-head-mid { border-top-color: #f4f4f4; }
.smart-head-mobile .smart-head-mid { border-bottom-color: #cd051f; }
.off-canvas { background-color: #034eac; }
.s-dark .off-canvas, .off-canvas.s-dark { background-color: #034eac; }
.trending-ticker .heading { color: #ffffff; }
@media (min-width: 941px) and (max-width: 1200px) { .navigation-main .menu > li > a { font-size: calc(10px + (17px - 10px) * .7); } }


