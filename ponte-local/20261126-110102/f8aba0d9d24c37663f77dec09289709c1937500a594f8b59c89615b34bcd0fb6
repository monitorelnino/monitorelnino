<script>
    var itens = document.querySelectorAll(".youtube-playlist__grid-list__item-link");
    var videoPrincipal = document.querySelector(".youtube-playlist__grid-main__item");

    for (i = 0; i < itens.length; i++) {
        itens[i].addEventListener("click", trocarIframe, false);
    }

    function trocarIframe(evento) {
        evento.preventDefault();
        if (!this.parentElement.classList.contains("selecionado")) {
            videoPrincipal.style = "display: none;";
            videoPrincipal.nextElementSibling.removeAttribute("hidden");
            videoPrincipal.setAttribute("src", this.getAttribute("href"));
            document.querySelector(".youtube-playlist__grid-list__item.selecionado").classList.remove("selecionado");
            this.parentElement.classList.add("selecionado");
            document.querySelector(".youtube-playlist__grid-main__item").onload = function () {
                videoPrincipal.nextElementSibling.setAttribute("hidden", true);
                videoPrincipal.style = "display: block;";
            }
        }
    }

    var thumbs = document.querySelectorAll(".youtube-playlist__grid-list__item-link__img");
    setTimeout(() => {
        for (i = 0; i < itens.length; i++) {
            if (thumbs[i].naturalWidth < 640) {
                thumbs[i].src = thumbs[i].src.replace("sddefault.jpg", "hqdefault.jpg");
            };
        };
    }, 3000);
</script>


    

