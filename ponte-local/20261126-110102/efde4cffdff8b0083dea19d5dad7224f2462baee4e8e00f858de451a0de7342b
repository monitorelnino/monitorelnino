<script defer>
    const pathsSVGMapa = document.querySelectorAll('.box-mapa map area')
    const lugaresMapa = document.querySelectorAll('.lugares-mapa-interativo .lugares-mapa-interativo__grid-item')

    const fecharModalDetalhes = () => {
        lugaresMapa.forEach(item => item.classList.remove('ativo'))
        pathsSVGMapa.forEach(item => item.classList.remove('ativo'))
    }

    const mostrarDetalhesLugar = (lugar, index) => {
        lugaresMapa.forEach(item => item.classList.remove('ativo'))
        pathsSVGMapa.forEach(item => item.classList.remove('ativo'))
        lugaresMapa[index].classList.add('ativo')
        lugar.classList.add('ativo')
    }

    pathsSVGMapa.forEach((item, index) => {
        item.addEventListener('click', (event) => {
            event.stopPropagation()
            event.preventDefault()
            mostrarDetalhesLugar(item, index)
        })
    })

    document.addEventListener('click', (event) => {
        const isClickInsideMapa = [...pathsSVGMapa].some(el => el.contains(event.target))
        const isClickInsideLugar = [...lugaresMapa].some(el => el.contains(event.target))

        if (!isClickInsideMapa && !isClickInsideLugar) {
            fecharModalDetalhes()
        }
    })
</script>
</main>



