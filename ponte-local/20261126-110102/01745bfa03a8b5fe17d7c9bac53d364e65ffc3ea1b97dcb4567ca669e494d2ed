<script defer>
    const linkPDF = document.querySelectorAll('[data-link]');

    const baixarEditais = (btn, links) => {
        btn.addEventListener('click', async () => {
            for (const linkUrl of links) {
                try {
                    const response = await fetch(linkUrl.trim());
                    if (!response.ok) {
                        console.error(`Erro ao baixar o arquivo: ${linkUrl}`);
                        continue;
                    }

                    const file = await response.blob();
                    const link = document.createElement("a");
                    link.href = URL.createObjectURL(file);
                    link.download = `edital-${new Date().getTime()}`;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                } catch (error) {
                    console.error(`Erro ao processar o link ${linkUrl}:`, error);
                }
            }
        });
    };

    linkPDF.forEach((btn) => {
        const linksArray = btn.dataset.link.split(';').filter(link => link.trim() !== "");
        baixarEditais(btn, linksArray);
    });
</script>

    

