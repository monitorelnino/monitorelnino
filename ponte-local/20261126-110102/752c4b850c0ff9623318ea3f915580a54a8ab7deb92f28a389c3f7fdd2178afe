    const meses = document.querySelectorAll('[data-button="mes"]')
    const listaEventosMes = document.querySelectorAll('[data-eventos="lista"]')
    const mesAtual = document.querySelector("#mes-atual").value


    const mostrarEventosMes = (mes, index) => {
        meses.forEach(item => item.classList.remove('ativo'))
        listaEventosMes.forEach(item => item.classList.remove('ativo'))
        mes.classList.add("ativo")
        listaEventosMes[index].classList.add("ativo")
    }

    meses.forEach((item, index) => {
        if (item.innerText.toLowerCase() === mesAtual) {
            meses[index].classList.add('ativo')
            listaEventosMes[index].classList.add('ativo')
        }

        item.addEventListener('click', () => {
            mostrarEventosMes(item, index)
        })
    })
</script>

        


