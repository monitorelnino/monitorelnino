<script>
    document.addEventListener("DOMContentLoaded", function () {

        const menuItems = document.querySelectorAll(".menu-link__item");
        const listagens = document.querySelectorAll(".home-servicos-section .listagem");

        menuItems.forEach((item, index) => {

            item.addEventListener("click", function () {

                // Remove selected de todos
                menuItems.forEach(i => i.classList.remove("selected"));

                // Marca o clicado
                this.classList.add("selected");

                // Esconde todas as listagens
                listagens.forEach(lista => lista.classList.remove("ativa"));

                // Ativa a listagem com mesmo índice
                if (listagens[index]) {
                    listagens[index].classList.add("ativa");
                }

            });

        });

    });</script>

    


