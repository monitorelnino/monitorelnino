    <style>
        .row>* {
            flex-shrink: 0;
            width: 100%;
            max-width: 100%;
            padding-right: calc(var(--bs-gutter-x) * .5);
            padding-left: calc(var(--bs-gutter-x) * .5);
            margin-top: var(--bs-gutter-y);
        }

        .inner-noticia {
            border-top-left-radius: 20px;
            color: #507b84;
            margin: 0 auto;
            width: 98%;
        }

        .inner-noticia .foto img {
            border-top-left-radius: 20px;
            width: 100%;
            height: 250px;
            transition: all 0.8s;
            object-fit: cover;
        }

        .inner-noticia:hover .foto img {
            opacity: 0.8;
        }

        .inner-noticia .titulo {
            font-weight: bold;
            font-size: 18px;
            padding-top: 5px;
        }

        .inner-noticia .data {
            text-align: right;
            font-size: 12px;
            color: #507b84;
            padding-top: 5px;
        }

        .btn-ver-todas {
            display: block;
            text-align: center;
            padding: 8px;
            width: 240px;
            font-weight: bold;
            margin: 0 auto;
            border: 1px solid #507b84;
            text-decoration: none;
            color: #507b84;
            border-top-left-radius: 20px;
        }

        .btn-ver-todas:hover {
            background-color: #507b84;
            color: #ffffff;
        }

        .container-btn-noticias {
            padding: 30px;
            width: 100%;
        }

        .link-not {
            display: inline-block;
            text-decoration: none;
            color: #507b84;
            width: 100%;
        }

        .link-not:hover {
            color: #507b84;
        }

        .col-md-4 {
            width: 33.3333%;
            float: left;
            margin-bottom: 20px;
        }

        @media (max-width: 768px) {
            .col-md-4 {
                width: 100%;
            }
        }
    </style>
</head>

<body>

