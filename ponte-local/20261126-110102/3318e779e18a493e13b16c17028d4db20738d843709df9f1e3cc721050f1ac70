<script>
    jQuery.post('https://webdos.pmaparecidadoeste.sp.gov.br/api/index.php?app=noticias')
        .done(function (data) {

            var html = '';
            html += '<div class="row">';

            $.each(JSON.parse(data), function (i, vl) {
                html += `
                    <div class="col-md-4">
                        <div class="inner-noticia">
                            <div class="foto">
                                <img decoding="async" src="https://webdos.pmaparecidadoeste.sp.gov.br/assets/uploads/${vl.noticia_capa}">
                            </div>
                            <a class="link-not" href="/noticia/?noticia=${vl.noticia_id}">
                                <div class="data">${dataFormat(vl.created_at)}</div>
                                <div class="titulo">${vl.noticia_titulo}</div>
                            </a>
                        </div>
                    </div>
                `;
            });

            html += `
                <div class="container-btn-noticias">
                    <a href="https://www.pmaparecidadoeste.sp.gov.br/noticias-geral/" 
                       class="btn-ver-todas">
                        veja todas as noticias >
                    </a>
                </div>
            `;

            html += '</div>';

            $('#containerNoticias').html(html);
        });

    function dataFormat(data) {
        var dt = data.split(' ');
        var date = dt[0].split('-');
        return date[2] + '/' + date[1] + '/' + date[0];
    }
</script>

</body>
