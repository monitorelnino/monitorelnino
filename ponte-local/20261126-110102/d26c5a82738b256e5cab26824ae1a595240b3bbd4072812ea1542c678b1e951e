<script>
    const meses = document.querySelectorAll(".header-meses__grid li a")
    const mesAtualElemento = document.querySelectorAll("[data-mes-atual]")
    const date = new Date();
    const mesAtual = date.getMonth();
    const mesSemEventos = document.createElement('li')
    const arrayMeses = Array.from(mesAtualElemento).map(item => Number(item.dataset.mesAtual))

    mesAtualElemento.forEach(item => {
        mesSharp = parseInt(item.dataset.mesAtual)

        if (mesAtual != mesSharp) {
            item.classList.add("esconder-evento")
        }
    })

    if (!arrayMeses.includes(mesAtual)) {
        meses.forEach(item => {
            const li = document.createElement('li')
            if (!item.innerText.includes("Abril")) {
                li.remove()
            } else {
                li.innerHTML = '<div class="sem-eventos"><img src="https://ecrie.com.br/sistema/conteudos/imagem/g_201_0_1_23012024162945.png" alt="Sem Compromissos" /></div>'
                document.querySelector('.eventos__grid').appendChild(li)
            }
        })
    }

    function mostarEventoPorMes(index) {
        meses.forEach(mes => mes.classList.remove('mes-atual'))
        meses[index].classList.add("mes-atual")

        mesAtualElemento.forEach(item => item.classList.add("esconder-evento"))
        mesAtualElemento.forEach(item => {
            if (+item.dataset.mesAtual === index) {
                item.classList.remove("esconder-evento")
            }
        })

        if (index !== 3) {
            const elemento = document.querySelector(".sem-eventos")
            if (elemento) {
                elemento.parentElement.remove()
            }
        }

        const condicao = index === 3 //temporária

        if (mesAtualElemento[index] === undefined || condicao) {
            mesSemEventos.innerHTML = '<div class="sem-eventos"><img src="https://ecrie.com.br/sistema/conteudos/imagem/g_201_0_1_23012024162945.png" alt="Sem Compromissos" /></div>'
            document.querySelector('.eventos__grid').appendChild(mesSemEventos)
        } else {
            mesSemEventos.remove()
        }
    }

    meses.forEach((item, index) => {
        if (index === mesAtual) {
            item.classList.add('mes-atual')
        } else {
            item.classList.remove('mes-atual')
        }

        item.addEventListener("click", (event) => {
            event.preventDefault()
            mostarEventoPorMes(index)
        })
    })
</script>

    


