    var votosEnquetesVotadasStr = localStorage.getItem('votos');
	
    if(enquetesVotadasStr && votosEnquetesVotadasStr)
    {
      enquetesVotadas = JSON.parse(enquetesVotadasStr);
      votosEnquetesVotadas = JSON.parse(votosEnquetesVotadasStr);
	  console.log(votosEnquetesVotadas);
      var indiceEnquete = enquetesVotadas.indexOf(enquete);
      if(indiceEnquete >= 0)
      {
          podeVotar = false;
      }
    }
    else
    {
        localStorage.setItem('enquetes', JSON.stringify([]));
        enquetesVotadas = [];
        votosEnquetesVotadas = [];
    }
    podeVotar = true;
    if(podeVotar)
    {
      var resposta;
      
      if($("#resposta1_"+enquete+":checked").val())
        resposta = "resposta_1";
      else if($("#resposta2_"+enquete+":checked").val())
        resposta = "resposta_2";
      else if($("#resposta3_"+enquete+":checked").val())
        resposta = "resposta_3";
      else if($("#resposta4_"+enquete+":checked").val())
        resposta = "resposta_4";
      else if($("#resposta5_"+enquete+":checked").val())
        resposta = "resposta_5";
      if(resposta)
      {
        xmlhttp = new XMLHttpRequest();
        console.log("/ajax/?evento=enquete_votar&idenquete="+enquete+"&opcao="+resposta);
        xmlhttp.open("GET","/ajax/?evento=enquete_votar&idenquete="+enquete+"&opcao="+resposta,true);
        xmlhttp.onreadystatechange=function()
        {
          if (xmlhttp.readyState==4 && xmlhttp.status==200)
          {

            if(enquetesVotadas)
            {
              enquetesVotadas.push(enquete);
              votosEnquetesVotadas.push(resposta.replace("resposta_",""));
              localStorage.setItem('enquetes', JSON.stringify(enquetesVotadas));
              localStorage.setItem('votos', JSON.stringify(votosEnquetesVotadas));
            }
            $("#fieldset_"+enquete).hide();
            $("#button_"+enquete).hide();

            var resultado = JSON.parse(xmlhttp.response);

            var options = {
                responsive:false
            };

            var data = [
                {
                    value: resultado.votos_resposta_1*1,
                    color:"#AFE398",
                    highlight: "#85B76F",
                    label: resultado.votos_opcao_1
                },
                {
                    value: resultado.votos_resposta_2*1,
                    color: "#FF5A5E",
                    highlight: "#F7464A",
                    label: resultado.votos_opcao_2
                },
                {
                    value: resultado.votos_resposta_3*1,
                    color: "#C5C5C5",
                    highlight: "#898989",
                    label: resultado.votos_opcao_3
                },
                 {
                    value: resultado.votos_resposta_4*1,
                    color: "#FDB45C",
                    highlight: "#006699",
                    label: resultado.votos_opcao_4
                }
                ,
                 {
                    value: resultado.votos_resposta_5*1,
                    color: "#000",
                    highlight: "#006600",
                    label: resultado.votos_opcao_5
                }
            ]
            console.log(data);

            $("#GraficoPizza_"+enquete).show();
			
			$("#GraficoPizza_"+enquete).removeAttr("style");

			$("#GraficoPizza_"+enquete).attr({
				"width": 200,
				"height": 100
			});
						
            var ctx = document.getElementById("GraficoPizza_"+enquete).getContext("2d");
			
            var PizzaChart = new Chart(ctx).Pie(data, options);
            
          }
        }
        xmlhttp.send();
      }
      else
      {
        alert("Selecione uma opção antes de votar!");
      }
    }
    else
    {
      alert("Você já votou nessa enquete.");
    }
  }

  var votarWidget = votar;
</script>
    
