<script>
(function () {
    // Alto Contraste — persiste via sessionStorage
    function atualizarLogo() {
        var logo = document.getElementById('logo');
        if (!logo) return;
        if (document.body.classList.contains('contrast')) {
            logo.src = logo.getAttribute('data-logo-contrast');
        } else {
            logo.src = logo.getAttribute('data-logo-default');
        }
    }

    // Restaura estado salvo
    if (sessionStorage.getItem('accessibility-class') === 'contrast') {
        document.body.classList.add('contrast');
    }
    atualizarLogo();

    document.querySelectorAll('.change-me').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var isContrast = document.body.classList.toggle('contrast');
            sessionStorage.setItem('accessibility-class', isContrast ? 'contrast' : '');
            atualizarLogo();
        });
    });

    // Tamanho de fonte — persiste via localStorage
    var KEY = 'fontSize', DEFAULT = 16, STEP = 1.6;
    var saved = parseFloat(localStorage.getItem(KEY));
    if (!isNaN(saved)) document.documentElement.style.fontSize = saved + 'px';

    function setFont(size) {
        document.documentElement.style.fontSize = size + 'px';
        localStorage.setItem(KEY, size.toString());
    }

    var btnA = document.querySelector('.aumentar-fonte');
    var btnD = document.querySelector('.diminuir-fonte');
    var btnR = document.querySelector('.resetar-fonte');
    if (btnA) btnA.addEventListener('click', function () { setFont((parseFloat(localStorage.getItem(KEY)) || DEFAULT) + STEP); });
    if (btnD) btnD.addEventListener('click', function () { setFont((parseFloat(localStorage.getItem(KEY)) || DEFAULT) - STEP); });
    if (btnR) btnR.addEventListener('click', function () { setFont(DEFAULT); });
})();
</script>

