<script>
// Variáveis globais
var currentScale = 1;
var maxScale = 1.5;    // 150%
var minScale = 0.8;    // 80%
var scaleStep = 0.1;   // 10%

// Toggle Contraste Alto
function toggleContrast() {
    var body = document.body;
    var btn = document.getElementById('btn-contrast');
    
    body.classList.remove('accessibility-grayscale');
    var grayBtn = document.getElementById('btn-grayscale');
    if (grayBtn) grayBtn.classList.remove('active');
    
    if (body.classList.contains('accessibility-high-contrast')) {
        body.classList.remove('accessibility-high-contrast');
        if (btn) btn.classList.remove('active');
        localStorage.removeItem('accessibilityContrast');
    } else {
        body.classList.add('accessibility-high-contrast');
        if (btn) btn.classList.add('active');
        localStorage.setItem('accessibilityContrast', 'true');
    }
}

// Toggle Escala de Cinza
function toggleGrayscale() {
    var body = document.body;
    var btn = document.getElementById('btn-grayscale');
    
    body.classList.remove('accessibility-high-contrast');
    var contrastBtn = document.getElementById('btn-contrast');
    if (contrastBtn) contrastBtn.classList.remove('active');
    
    if (body.classList.contains('accessibility-grayscale')) {
        body.classList.remove('accessibility-grayscale');
        if (btn) btn.classList.remove('active');
        localStorage.removeItem('accessibilityGrayscale');
    } else {
        body.classList.add('accessibility-grayscale');
        if (btn) btn.classList.add('active');
        localStorage.setItem('accessibilityGrayscale', 'true');
    }
}

// Alterar tamanho da fonte - AFETA TODO O SITE
function changeFontSize(action) {
    if (action === 'increase') {
        if (currentScale < maxScale) {
            currentScale += scaleStep;
        }
    } else if (action === 'decrease') {
        if (currentScale > minScale) {
            currentScale -= scaleStep;
        }
    }
    
    // Aplica escala no body usando zoom (afeta tudo)
    applyFontScale();
    localStorage.setItem('accessibilityFontScale', currentScale);
}

// Aplica a escala de fonte global
function applyFontScale() {
    // Remove classes anteriores
    document.body.classList.remove('font-scale-80', 'font-scale-90', 'font-scale-100', 
                                   'font-scale-110', 'font-scale-120', 'font-scale-130', 
                                   'font-scale-140', 'font-scale-150');
    
    // Adiciona classe correspondente (arredonda para múltiplo de 10)
    var scaleClass = 'font-scale-' + Math.round(currentScale * 100);
    document.body.classList.add(scaleClass);
    
    // Atualiza CSS custom property para cálculos dinâmicos
    document.documentElement.style.setProperty('--accessibility-scale', currentScale);
}

// Resetar
function resetAccessibility() {
    var body = document.body;
    
    body.classList.remove('accessibility-high-contrast');
    body.classList.remove('accessibility-grayscale');
    
    var contrastBtn = document.getElementById('btn-contrast');
    var grayBtn = document.getElementById('btn-grayscale');
    if (contrastBtn) contrastBtn.classList.remove('active');
    if (grayBtn) grayBtn.classList.remove('active');
    
    // Reset fonte
    currentScale = 1;
    applyFontScale();
    
    localStorage.removeItem('accessibilityContrast');
    localStorage.removeItem('accessibilityGrayscale');
    localStorage.removeItem('accessibilityFontScale');
}

// Carregar configurações
function loadAccessibilitySettings() {
    var body = document.body;
    
    if (localStorage.getItem('accessibilityContrast') === 'true') {
        body.classList.add('accessibility-high-contrast');
        var btn = document.getElementById('btn-contrast');
        if (btn) btn.classList.add('active');
    }
    
    if (localStorage.getItem('accessibilityGrayscale') === 'true') {
        body.classList.add('accessibility-grayscale');
        var btn = document.getElementById('btn-grayscale');
        if (btn) btn.classList.add('active');
    }
    
    var savedScale = localStorage.getItem('accessibilityFontScale');
    if (savedScale) {
        currentScale = parseFloat(savedScale);
        applyFontScale();
    }
}

// Inicializa
document.addEventListener('DOMContentLoaded', loadAccessibilitySettings);
</script>

