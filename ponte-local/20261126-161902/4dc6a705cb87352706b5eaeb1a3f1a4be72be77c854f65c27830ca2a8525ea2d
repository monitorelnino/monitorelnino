        document.getElementById("myNav").style.width = "100%";
    }

    function closeNav() {
        document.getElementById("myNav").style.width = "0%";
    }


    jQuery(function($) {
        $('.full-menu-toggle').on('click', function(e) {
            e.preventDefault();
    
            var container = $(this).data('container');
    
            if (!container || !$('.full-menu').hasClass('full-menu--open')) {
                $('.full-menu').toggleClass('full-menu--open');
            }
    
            if (container) {
                $('.full-menu .full-menu--middle > .container:not(' + container + ')').removeClass('active');
                $('.full-menu .full-menu--middle > .container' + container).addClass('active');
            }
        });
        $('body').on('click', function(e) {
            var target = $(e.target);

            if (!target.closest('.full-menu').length && !(target.hasClass('full-menu-toggle') || target.closest('.full-menu-toggle').length)) {
                $('.full-menu').removeClass('full-menu--open');
            }
        });

        $(window).scroll(function() {
            setTimeout(() => {
                $('.full-menu').removeClass('full-menu--open');
            }, 10);
        });
    });

    function resizeFooterMargins() {
        var height = 0;

        if ($(window).width() > '576') {
            var height = $('#footer').height();
        }

        $('#page-container').css({
            'marginBottom': height + 'px'
        });
    };
    
    jQuery(function($) {
        setTimeout(resizeFooterMargins, 10);

        $(window).on('resize', function() {
            setTimeout(resizeFooterMargins, 10);
        });
    });
</script>
