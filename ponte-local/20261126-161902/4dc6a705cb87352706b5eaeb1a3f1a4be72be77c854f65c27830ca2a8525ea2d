<script>
function toggleHeaderMenu() {
    var nav     = document.getElementById('header-main-nav');
    var btn     = document.querySelector('.menu-toggle');
    var icon    = btn ? btn.querySelector('i') : null;
    var btnText = btn ? btn.querySelector('.menu-toggle-text') : null;
    if (!nav) return;
    nav.classList.toggle('is-open');
    var open = nav.classList.contains('is-open');
    if (btn)     btn.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    if (icon)    { icon.classList.toggle('fa-bars', !open); icon.classList.toggle('fa-times', open); }
    if (btnText) btnText.textContent = open ? 'Fechar' : 'Menu';
}

