            font-weight: 700;
            margin-bottom: 20px;
            position: relative;
            padding-bottom: 12px;
            text-transform: none;
        }

        #footer h3::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 40px;
            height: 3px;
            background: linear-gradient(135deg, #059669 0%, #047857 100%);
            border-radius: 2px;
        }

        /* Listas de links */
        #footer ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        #footer ul li {
            margin-bottom: 10px;
            position: relative;
        }

        #footer ul li a {
            color: #9ca3af;
            text-decoration: none;
            font-size: 14px;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        #footer ul li a:hover {
            color: #10b981;
            transform: translateX(4px);
        }

        #footer ul li a::before {
            content: '\f054';
            font-family: 'Font Awesome 5 Free';
            font-weight: 900;
            font-size: 10px;
            color: #059669;
            opacity: 0;
            transition: opacity 0.2s;
        }

        #footer ul li a:hover::before {
            opacity: 1;
        }

        /* Coluna de Atendimento */
        #footer .col-md-3:last-child h4 {
            color: #ffffff;
            font-size: 13px;
            font-weight: 600;
            margin: 16px 0 6px 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        #footer .col-md-3:last-child h4 i {
            color: #059669;
            font-size: 14px;
            width: 16px;
        }

        #footer .col-md-3:last-child p {
            font-size: 14px;
            line-height: 1.5;
            margin: 0 0 12px 0;
            color: #9ca3af;
        }

        /* Redes Sociais */
        #footer .social-links {
            display: flex;
            gap: 10px;
            margin-top: 12px;
            flex-wrap: wrap;
        }

        #footer .social-links a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            background: #1f2937;
            border-radius: 8px;
            color: #9ca3af;
            text-decoration: none;
            transition: all 0.3s ease;
