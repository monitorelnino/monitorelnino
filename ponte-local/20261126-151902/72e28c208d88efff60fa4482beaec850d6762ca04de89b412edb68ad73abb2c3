<script>
document.addEventListener("DOMContentLoaded", function() {

    const blocos = document.querySelectorAll('.vc_column-inner');

    blocos.forEach(function(bloco) {

        let texto = bloco.innerText.toLowerCase();

        let label = '';
        let link = '';

        if (texto.includes('cultura')) {
            label = 'Acessar área de Cultura do município de Juquitiba';
            link = 'https://juquitiba.sp.gov.br/cultura/';
        } 
        else if (texto.includes('educação')) {
            label = 'Acessar área de Educação do município de Juquitiba';
            link = 'https://juquitiba.sp.gov.br/educacao/';
        } 
        else if (texto.includes('turismo')) {
            label = 'Acessar área de Turismo do município de Juquitiba';
            link = 'https://turismo.juquitiba.sp.gov.br/';
        }

        if (label !== '') {
            bloco.setAttribute('role', 'link');
            bloco.setAttribute('tabindex', '0');
            bloco.setAttribute('aria-label', label);

            bloco.addEventListener('click', function() {
                window.location.href = link;
            });

            bloco.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    window.location.href = link;
                }
            });
        }

    });

});
</script>
