<!-- Código de contraste -->
<script type="text/javascript">
    var controle = 0;

    function contraste() {
        
        if (controle == 0) {
            var all = document.getElementsByTagName("*");
            for (var i = 0, max = all.length; i < max; i++) {
                var elemento = all[i];
                
                // Nao aplica fundo escuro no botao de pesquisa e indicadores do carrossel
                var isBotaoPesquisa = (elemento.id === "botaoBuscar");
                var isIndicadorCarrossel = elemento.classList && elemento.classList.contains('carousel-indicators');
                var isIndicadorItem = elemento.parentNode && elemento.parentNode.classList && elemento.parentNode.classList.contains('carousel-indicators');
                
                if (!isBotaoPesquisa && !isIndicadorCarrossel && !isIndicadorItem) {
                    elemento.style.color = "#fff";
                    elemento.style.background = "#333";
                }
                
                // Configuraçoes especificas de bordas
                var objCab = document.getElementById("box_cab");
                if(objCab) objCab.style.borderBottomColor = "#333";
                var objAcessibilidade = document.getElementById("box_acessibilidade");
                if(objAcessibilidade) objAcessibilidade.style.borderBottomColor = "white";
                var objFoot = document.getElementById("box_foot");
                if(objFoot) objFoot.style.borderTopColor = "white";
                var objSubmenu = document.getElementById("sub_menu_icones");
                if(objSubmenu) objSubmenu.style.borderBottomColor = "white";
            }

            // Mantam a cor verde no botão de pesquisa
            var botaoPesquisa = document.getElementById("botaoBuscar");
            if(botaoPesquisa) {
                botaoPesquisa.style.background = "#19ccb2";
                botaoPesquisa.style.color = "white";
                botaoPesquisa.style.border = "none";
            }

            // Força os indicadores do carrossel a manterem a cor original
            var indicadores = document.querySelectorAll('.carousel-indicators li');
            for(var k = 0; k < indicadores.length; k++) {
                indicadores[k].style.backgroundColor = "rgba(255,255,255,0.5)"; // Cor original dos indicadores
            }
            
            var indicadorAtivo = document.querySelector('.carousel-indicators li.active');
            if(indicadorAtivo) {
                indicadorAtivo.style.backgroundColor = "#fff"; // Cor do indicador ativo
            }

            // Selo da Prefeitura - contorno mais fino com transparecia
            var seloImg = document.querySelector("#selo_prefeitura img");
            if(seloImg) {
                seloImg.style.background = "transparent";
                seloImg.style.filter = "drop-shadow(1px 1px 0 rgba(255,255,255,0.7)) drop-shadow(-1px -1px 0 rgba(255,255,255,0.7)) drop-shadow(1px -1px 0 rgba(255,255,255,0.7)) drop-shadow(-1px 1px 0 rgba(255,255,255,0.7)) drop-shadow(0 0 2px rgba(255,255,255,0.5))";
            }

            // Todas as imagens dos icones - contorno mais fino com transparencia
            var iconesImgs = document.querySelectorAll("#nav_icones img");
            for(var j = 0; j < iconesImgs.length; j++) {
                iconesImgs[j].style.background = "transparent";
                iconesImgs[j].style.filter = "drop-shadow(1px 1px 0 rgba(255,255,255,0.7)) drop-shadow(-1px -1px 0 rgba(255,255,255,0.7)) drop-shadow(1px -1px 0 rgba(255,255,255,0.7)) drop-shadow(-1px 1px 0 rgba(255,255,255,0.7)) drop-shadow(0 0 2px rgba(255,255,255,0.5))";
            }
            
            controle = 1;
        } else {
            window.location.reload(false);
        }
    }
    
    document.addEventListener('DOMContentLoaded', function() {
        var botaoContraste = document.getElementById('contraste');
        if(botaoContraste) {
            botaoContraste.onclick = contraste;
        }
    });
</script>
