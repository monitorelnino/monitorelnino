	<script>
	function shareNoticia() {
		// Pega o título da notícia que foi definido dinamicamente no <head>
		const title = document.title; 
		// Pega a URL atual da página
		const url = window.location.href; 

		if (navigator.share) {
			// Se o navegador suporta a Web Share API (celulares e navegadores modernos)
			navigator.share({
				title: title,
				url: url,
			}).then(() => {
				console.log('Compartilhamento bem-sucedido');
			}).catch((error) => {
				console.log('Erro ao compartilhar', error);
			});
		} else {
			// Fallback para navegadores que não suportam (desktop/navegadores antigos)
			// Você pode adicionar um modal ou uma mensagem aqui, ou copiar para a área de transferência.
			alert('Seu navegador não suporta o compartilhamento direto. A URL foi copiada para a área de transferência.');
			navigator.clipboard.writeText(url);
		}
	}
	</script>
