            if (href === '' || href === '#' || href.charAt(0) === '#') return true;
            if (/^(javascript:|mailto:|tel:|sms:|whatsapp:)/i.test(href)) return true;
            if (a.dataset.toggle === 'modal' || a.dataset.bsToggle === 'modal') return true;
            if (!isSameOrigin(a.href)) return true;
            // Same page (only hash differs)
            var dest = new URL(a.href, window.location.href);
            if (dest.pathname === window.location.pathname &&
                dest.search === window.location.search &&
                dest.hash !== '') return true;
