<script>
    (function () {
        if (window.__internalBackDownloadLoaderBound) {
            return;
        }
        window.__internalBackDownloadLoaderBound = true;

        function ensureLoader() {
            var loader = document.querySelector('[data-internal-export-loader]');
            if (loader) {
                return loader;
            }

            loader = document.createElement('div');
            loader.className = 'internal-export-loader';
            loader.setAttribute('data-internal-export-loader', '');
            loader.setAttribute('role', 'status');
            loader.setAttribute('aria-live', 'polite');
            loader.innerHTML = [
                '<div class="internal-export-loader__box">',
                '<strong class="internal-export-loader__title">Preparando download</strong>',
                '<p class="internal-export-loader__status" data-export-loader-status>Processando arquivo...</p>',
                '<div class="internal-export-loader__track">',
                '<div class="internal-export-loader__bar is-indeterminate" data-export-loader-bar></div>',
                '</div>',
                '<span class="internal-export-loader__percent" data-export-loader-percent>Aguardando resposta do servidor</span>',
                '</div>'
            ].join('');
            document.body.appendChild(loader);

            return loader;
        }

        function showLoader(label) {
            var loader = ensureLoader();
            var status = loader.querySelector('[data-export-loader-status]');
            var percent = loader.querySelector('[data-export-loader-percent]');
            var bar = loader.querySelector('[data-export-loader-bar]');

            status.textContent = 'Processando ' + (label || 'arquivo') + '...';
            percent.textContent = 'Aguardando resposta do servidor';
            bar.classList.add('is-indeterminate');
            bar.style.width = '40%';
            loader.classList.add('is-active');

            var pageLoader = document.getElementById('page-loader');
            if (pageLoader) {
                pageLoader.classList.remove('is-visible');
                pageLoader.setAttribute('aria-hidden', 'true');
            }
        }

        function updateLoader(loaded, total) {
            var loader = ensureLoader();
            var status = loader.querySelector('[data-export-loader-status]');
            var percent = loader.querySelector('[data-export-loader-percent]');
            var bar = loader.querySelector('[data-export-loader-bar]');

            if (!total) {
                status.textContent = 'Recebendo arquivo...';
                percent.textContent = loaded ? Math.round(loaded / 1024) + ' KB recebidos' : 'Recebendo dados';
                return;
            }

            var progress = Math.min(100, Math.round((loaded / total) * 100));
            status.textContent = 'Recebendo arquivo...';
            percent.textContent = progress + '%';
            bar.classList.remove('is-indeterminate');
            bar.style.width = progress + '%';
        }

        function hideLoader() {
            var loader = ensureLoader();
            loader.classList.remove('is-active');
        }

        function filenameFromDisposition(disposition, fallback) {
            if (!disposition) {
                return fallback;
            }

            var utf8Match = disposition.match(/filename\*=UTF-8''([^;]+)/i);
            if (utf8Match && utf8Match[1]) {
                return decodeURIComponent(utf8Match[1].replace(/["']/g, ''));
            }

            var match = disposition.match(/filename="?([^"]+)"?/i);
            return match && match[1] ? match[1] : fallback;
        }

        function isSameOrigin(url) {
            try {
                return new URL(url, window.location.href).origin === window.location.origin;
            } catch (e) {
                return false;
            }
        }

        function isBackProcessedDownload(link, event) {
            if (!link || !link.href) return false;
            if (event && (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0)) return false;
            if (link.dataset.noBackDownload !== undefined) return false;
            if (link.closest('[data-no-back-download]')) return false;
            if (link.dataset.toggle === 'modal' || link.dataset.bsToggle === 'modal') return false;
            if (!isSameOrigin(link.href)) return false;

            var href = link.getAttribute('href') || '';
            if (href === '' || href === '#' || href.charAt(0) === '#') return false;
            if (/^(javascript:|mailto:|tel:|sms:|whatsapp:)/i.test(href)) return false;

            var path = new URL(link.href, window.location.href).pathname;
            return link.hasAttribute('data-export-download') ||
                !!link.closest('.internal-export') ||
                /(^|\/)(exporta?|download)(\/|$)/i.test(path);
        }

        async function downloadBackFile(link) {
            var pathPart = link.href.split('?')[0].split('/').pop() || 'arquivo';
            var fallbackName = link.getAttribute('data-export-name') || 'download-' + Date.now() + '.' + pathPart;
            var label = link.getAttribute('data-export-label') || link.textContent.trim() || 'arquivo';
            showLoader(label);

            var response = await fetch(link.href, {
                credentials: 'same-origin',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (!response.ok) {
                throw new Error('Não foi possível preparar o arquivo.');
            }

            var total = parseInt(response.headers.get('content-length') || '0', 10);
            var filename = filenameFromDisposition(response.headers.get('content-disposition'), fallbackName);

            if (!response.body || !response.body.getReader) {
                var directBlob = await response.blob();
                updateLoader(directBlob.size, directBlob.size);
                triggerDownload(directBlob, filename);
                return;
            }

            var reader = response.body.getReader();
            var chunks = [];
            var loaded = 0;

            while (true) {
                var result = await reader.read();
                if (result.done) {
                    break;
                }

                chunks.push(result.value);
                loaded += result.value.length;
                updateLoader(loaded, total);
            }

            triggerDownload(new Blob(chunks, { type: response.headers.get('content-type') || 'application/octet-stream' }), filename);
        }

        function triggerDownload(blob, filename) {
            var url = URL.createObjectURL(blob);
            var anchor = document.createElement('a');
            anchor.href = url;
            anchor.download = filename;
            document.body.appendChild(anchor);
            anchor.click();
            anchor.remove();
            URL.revokeObjectURL(url);
            hideLoader();
        }

        document.addEventListener('click', function (event) {
            var link = event.target.closest && event.target.closest('a');
            if (!isBackProcessedDownload(link, event)) {
                return;
            }

            event.preventDefault();
            downloadBackFile(link).catch(function (error) {
                hideLoader();
                window.location.href = link.href;
                console.error(error);
            });
        });
    })();
</script>
