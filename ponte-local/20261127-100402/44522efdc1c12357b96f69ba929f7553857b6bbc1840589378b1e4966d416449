        function isBackDownloadUrl(url) {
            try {
                var dest = new URL(url, window.location.href);
                return /(^|\/)(exporta?|download)(\/|$)/i.test(dest.pathname);
            } catch (e) {
                return false;
            }
        }

        function shouldSkipLink(a, e) {
            if (!a || !a.href) return true;
            if (a.hasAttribute('download')) return true;
            if (a.dataset.noLoader !== undefined) return true;
            if (a.hasAttribute('data-export-download')) return true;
            if (a.closest('.internal-export')) return true;
            if (a.closest('[data-no-loader]')) return true;
            if (isBackDownloadUrl(a.href)) return true;
            var target = a.getAttribute('target');
            if (target && target !== '' && target !== '_self') return true;
            if (e && (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0)) return true;
