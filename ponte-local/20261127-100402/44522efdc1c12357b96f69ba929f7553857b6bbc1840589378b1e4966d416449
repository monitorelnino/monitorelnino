        <script>
    (function () {
        const modal = document.querySelector('[data-pdf-viewer]');
        const frame = document.querySelector('[data-pdf-viewer-frame]');
        const title = document.querySelector('[data-pdf-viewer-title]');
        const status = document.querySelector('[data-pdf-viewer-status]');
        const loader = document.querySelector('[data-pdf-viewer-loader]');
        const loaderText = document.querySelector('[data-pdf-viewer-loader-text]');
        const shareButton = document.querySelector('[data-pdf-viewer-share]');
        const shareFeedback = document.querySelector('[data-pdf-viewer-share-feedback]');
        const closeButtons = document.querySelectorAll('[data-pdf-viewer-close]');
        let loadTimer = null;
        let feedbackTimer = null;
        let activeShareUrl = null;
        let activeReturnUrl = null;

        if (!modal || !frame || !title) {
            return;
        }

        const setStatus = function (message, type) {
            if (!status) {
                return;
            }

            status.textContent = message || '';
            status.hidden = !message;
            status.classList.toggle('pdf-viewer-modal__status--error', type === 'error');
        };

        const setLoading = function (isLoading, message) {
            if (!loader) {
                return;
            }

            loader.hidden = !isLoading;
            modal.classList.toggle('pdf-viewer-modal--loading', isLoading);

            if (loaderText && message) {
                loaderText.textContent = message;
            }
        };

        const isExplicitlyUnsupported = function (button) {
            const type = (button.getAttribute('data-pdf-type') || '').toLowerCase();
            return type !== '' && type.indexOf('pdf') === -1;
        };

        const absoluteUrl = function (url) {
            if (!url) {
                return null;
            }

            try {
                return new URL(url, window.location.href).toString();
            } catch (error) {
                return null;
            }
        };

        const setShareFeedback = function (message) {
            if (!shareFeedback) {
                return;
            }

            if (feedbackTimer) {
                window.clearTimeout(feedbackTimer);
                feedbackTimer = null;
            }

            shareFeedback.textContent = message || '';
            shareFeedback.hidden = !message;

            if (message) {
                feedbackTimer = window.setTimeout(function () {
                    shareFeedback.textContent = '';
                    shareFeedback.hidden = true;
                    feedbackTimer = null;
                }, 2500);
            }
        };

        const setShareUrl = function (shareUrl) {
            activeShareUrl = absoluteUrl(shareUrl);

            if (!shareButton) {
                return;
            }

            shareButton.hidden = !activeShareUrl;
            setShareFeedback('');
        };

        const updateBrowserUrl = function (url, replace) {
            const targetUrl = absoluteUrl(url);

            if (!targetUrl || !window.history || targetUrl === window.location.href) {
                return;
            }

            if (replace) {
                window.history.replaceState({ pdfViewer: !modal.hidden }, '', targetUrl);
                return;
            }

            window.history.pushState({ pdfViewer: true }, '', targetUrl);
        };

        const writeToClipboard = async function (text) {
            if (navigator.clipboard && window.isSecureContext) {
                await navigator.clipboard.writeText(text);
                return;
            }

            const input = document.createElement('textarea');
            input.value = text;
            input.setAttribute('readonly', 'readonly');
            input.style.position = 'fixed';
            input.style.top = '-9999px';
            document.body.appendChild(input);
            input.select();
            document.execCommand('copy');
            document.body.removeChild(input);
        };

        const shouldUseNativeShare = function () {
            return Boolean(
                navigator.share
                && (
                    window.matchMedia('(pointer: coarse)').matches
                    || window.matchMedia('(hover: none)').matches
                    || window.innerWidth <= 768
                )
            );
        };

        const closeModal = function (options) {
            options = options || {};

            const returnUrl = activeReturnUrl;

            modal.hidden = true;
            modal.setAttribute('aria-hidden', 'true');
            document.body.classList.remove('pdf-viewer-open');
            frame.removeAttribute('src');
            setStatus('');
            setLoading(false);
            setShareUrl(null);
            activeReturnUrl = null;

            if (loadTimer) {
                window.clearTimeout(loadTimer);
                loadTimer = null;
            }

            if (!options.skipHistory && returnUrl) {
                updateBrowserUrl(returnUrl, true);
            }
        };

        const validateSameOriginPreview = async function (pdfLink) {
            try {
                const url = new URL(pdfLink, window.location.href);

                if (url.origin !== window.location.origin) {
                    return true;
                }

                const response = await fetch(url.toString(), {
                    method: 'HEAD',
                    redirect: 'manual',
                    credentials: 'same-origin'
                });

                return response.status === 0 || response.status < 400 || response.status === 405;
            } catch (error) {
                return true;
            }
        };

        const openModal = async function (button, options) {
            options = options || {};

            const pdfLink = button.getAttribute('data-pdf-link');
            const pdfTitle = button.getAttribute('data-pdf-title') || 'Visualização do documento';
            const shareUrl = button.getAttribute('data-pdf-share-url');
            const returnUrl = button.getAttribute('data-pdf-return-url');

            activeReturnUrl = absoluteUrl(returnUrl) || window.location.href;
            setShareUrl(shareUrl);

            if (shareUrl && !options.skipHistory) {
                updateBrowserUrl(shareUrl, false);
            }

            if (!pdfLink || pdfLink === '#') {
                title.textContent = pdfTitle;
                modal.hidden = false;
                modal.setAttribute('aria-hidden', 'false');
                document.body.classList.add('pdf-viewer-open');
                setLoading(false);
                setStatus('Este documento não possui link de visualização disponível no armazenamento.', 'error');
                frame.removeAttribute('src');
                return;
            }

            if (isExplicitlyUnsupported(button)) {
                title.textContent = pdfTitle;
                modal.hidden = false;
                modal.setAttribute('aria-hidden', 'false');
                document.body.classList.add('pdf-viewer-open');
                setLoading(false);
                setStatus('Este arquivo não é um PDF visualizável. Use o botão Download para acessar o documento.', 'error');
                frame.removeAttribute('src');
                return;
            }

            title.textContent = pdfTitle;
            if (loadTimer) {
                window.clearTimeout(loadTimer);
                loadTimer = null;
            }
            setStatus('');
            setLoading(true, 'Preparando a visualização do PDF...');
            modal.hidden = false;
            modal.setAttribute('aria-hidden', 'false');
            document.body.classList.add('pdf-viewer-open');

            const canPreview = await validateSameOriginPreview(pdfLink);

            if (!canPreview) {
                setLoading(false);
                setStatus('Este documento não está disponível para visualização no momento. Use o botão Download para tentar acessar o arquivo.', 'error');
                frame.removeAttribute('src');
                return;
            }

            frame.setAttribute('src', pdfLink);

            if (loadTimer) {
                window.clearTimeout(loadTimer);
            }

            loadTimer = window.setTimeout(function () {
                setLoading(true, 'O arquivo está demorando um pouco mais para abrir...');
            }, 8000);
        };

        const openInitialDocument = function () {
            const initialDocument = window.portalPdfViewerInitialDocument;

            if (!initialDocument || !initialDocument.shareUrl) {
                return;
            }

            const button = document.createElement('button');
            button.type = 'button';
            button.setAttribute('data-pdf-link', initialDocument.link || '');
            button.setAttribute('data-pdf-title', initialDocument.title || 'Visualização do documento');
            button.setAttribute('data-pdf-type', initialDocument.type || 'application/pdf');
            button.setAttribute('data-pdf-share-url', initialDocument.shareUrl);
            button.setAttribute('data-pdf-return-url', initialDocument.returnUrl || '');

            openModal(button, { skipHistory: true });
        };

        frame.addEventListener('load', function () {
            if (loadTimer) {
                window.clearTimeout(loadTimer);
                loadTimer = null;
            }
            setLoading(false);
            setStatus('');
        });

        document.addEventListener('click', function (event) {
            const button = event.target.closest('[data-pdf-viewer-open]:not([disabled]):not([aria-disabled="true"])');

            if (!button) {
                return;
            }

            event.preventDefault();
            openModal(button);
        });

        closeButtons.forEach(function (button) {
            button.addEventListener('click', function () {
                closeModal();
            });
        });

        if (shareButton) {
            shareButton.addEventListener('click', async function () {
                if (!activeShareUrl) {
                    return;
                }

                try {
                    if (shouldUseNativeShare()) {
                        await navigator.share({
                            title: title.textContent || 'Documento',
                            url: activeShareUrl
                        });
                        return;
                    }

                    await writeToClipboard(activeShareUrl);
                    setShareFeedback('Link copiado');
                } catch (error) {
                    if (error && error.name === 'AbortError') {
                        return;
                    }

                    try {
                        await writeToClipboard(activeShareUrl);
                        setShareFeedback('Link copiado');
                    } catch (copyError) {
                        setShareFeedback('Não foi possível copiar');
                    }
                }
            });
        }

        window.addEventListener('popstate', function () {
            if (!modal.hidden) {
                closeModal({ skipHistory: true });
            }
        });

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape' && !modal.hidden) {
                closeModal();
            }
        });

        openInitialDocument();
    })();
</script>
