const itemsCards1 = document.querySelectorAll('.cards-mobile');
const nextButton1 = document.querySelector('.carousel-btn-next');
const prevButton1 = document.querySelector('.carousel-btn-prev');

let currentIndex1 = 0; // Corrigido o nome da variável
const itemWidth1 = itemsCards1[0].offsetWidth; // Mede a largura do item
const totalItems1 = itemsCards1.length;

// Atualiza o deslocamento do carrossel
function updateCarousel() {
  const offset = -currentIndex1 * itemWidth1; // Corrigido o nome da variável
  cardsProgramasMobile.style.transform = `translateX(${offset}px)`;
}

// Botão "próximo"
nextButton1.addEventListener('click', () => {
  currentIndex1 = (currentIndex1 + 1) % totalItems1; // Incrementa o índice circularmente
  updateCarousel();
});

// Botão "anterior"
prevButton1.addEventListener('click', () => {
  currentIndex1 = (currentIndex1 - 1 + totalItems1) % totalItems1; // Decrementa o índice circularmente
  updateCarousel();
});


</script>
