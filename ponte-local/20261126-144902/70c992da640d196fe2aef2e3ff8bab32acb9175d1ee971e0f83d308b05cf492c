<script>
    document.addEventListener('DOMContentLoaded', function () {
    const items = document.querySelectorAll('.carousel-item');
    const itemsMobile = document.querySelectorAll('.item-mobile');
    const dotsContainer = document.querySelector('.custom-carousel-indicators');
    const prevButton = document.querySelector('.prev');
    const nextButton = document.querySelector('.next');

    let currentIndex = 0;
    let startTouchX = 0; // Variável para armazenar a posição inicial do toque
    let endTouchX = 0;   // Variável para armazenar a posição final do toque

    function updateDots() {
        const windowWidth = window.innerWidth;
        const totalDots = windowWidth > 768 ? 3 : 6;

        // Atualiza os dots de acordo com o número desejado
        dotsContainer.innerHTML = ''; // Remove dots existentes
        for (let i = 0; i < totalDots; i++) {
            const dot = document.createElement('div');
            dot.className = 'custom-dot';
            if (i === currentIndex) dot.classList.add('active');
            dot.addEventListener('click', () => {
                currentIndex = i;
                updateCarousel();
            });
            dotsContainer.appendChild(dot);
        }
    }

    function updateCarousel() {
        const windowWidth = window.innerWidth;
        const isDesktop = windowWidth > 768;

        const carouselItems = isDesktop ? items : itemsMobile;
        const totalItems = isDesktop ? 3 : 6;

        // Atualiza a posição dos itens no carrossel
        carouselItems.forEach((item, index) => {
            const offset = (index - currentIndex) * 100;
            item.style.transform = `translateX(${offset}%)`;
        });

        // Atualiza o estado ativo dos dots
        const dots = dotsContainer.querySelectorAll('.custom-dot');
        dots.forEach((dot, index) => {
            dot.classList.toggle('active', index === currentIndex);
        });
    }

    // Adiciona eventos aos botões de navegação
    nextButton.addEventListener('click', () => {
        const totalItems = window.innerWidth > 768 ? 3 : 6;
        currentIndex = (currentIndex + 1) % totalItems;
        updateCarousel();
    });

    prevButton.addEventListener('click', () => {
        const totalItems = window.innerWidth > 768 ? 3 : 6;
        currentIndex = (currentIndex - 1 + totalItems) % totalItems;
        updateCarousel();
    });

    // Função para detectar o movimento de toque
    function handleTouchStart(e) {
        startTouchX = e.touches[0].clientX; // Pega a posição inicial do toque
    }

    function handleTouchMove(e) {
        endTouchX = e.touches[0].clientX; // Pega a posição final do toque
    }

    function handleTouchEnd() {
        // Detecta o movimento (esquerda ou direita)
        const touchDifference = startTouchX - endTouchX;

        if (touchDifference > 50) {
            // Deslizou para a esquerda (próximo item)
            const totalItems = window.innerWidth > 768 ? 3 : 6;
            currentIndex = (currentIndex + 1) % totalItems;
            updateCarousel();
        } else if (touchDifference < -50) {
            // Deslizou para a direita (item anterior)
            const totalItems = window.innerWidth > 768 ? 3 : 6;
            currentIndex = (currentIndex - 1 + totalItems) % totalItems;
            updateCarousel();
        }
    }

    // Adiciona eventos de toque no carrossel
    const carouselContainer = document.querySelector('.carousel-container1');
    carouselContainer.addEventListener('touchstart', handleTouchStart);
    carouselContainer.addEventListener('touchmove', handleTouchMove);
    carouselContainer.addEventListener('touchend', handleTouchEnd);

    // Atualiza os dots e carrossel ao redimensionar a janela
    window.addEventListener('resize', () => {
        updateDots();
        updateCarousel();
    });

    // Inicializa o carrossel
    updateDots();
    updateCarousel();
});



</script></div></div></div></div></div>
