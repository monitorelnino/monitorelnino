<script>
    // Função para abrir abas
    function openTab(event, tabId, row) {
        const btnClass = `.tab-buttons.row${row} button`;
        const tabClass = `.tab-content.row${row}`;
        // Remove active class de todos os botões e conteúdos
        document.querySelectorAll(btnClass).forEach(button => {
            button.classList.remove('active');
        });
        document.querySelectorAll(tabClass).forEach(content => {
            content.classList.remove('active');
        });

        // Adiciona a classe 'active' ao botão clicado e ao conteúdo correspondente
        event.currentTarget.classList.add('active');
        document.getElementById(tabId).classList.add('active');
    }

    // Função para redirecionar com base no dropdown
    function redirectToLink() {
        // Obtém o valor selecionado do dropdown
        var selectedValue = document.getElementById("unidade").value;

        // Constrói o link baseado no valor selecionado
        var link = "index.php/servicos?category=" + selectedValue;

        // Redireciona para o novo URL
        window.location.href = link;
    }

    // Redireciona ao clicar em qualquer parte de um tabCard
    function makeTabCardClickable() {
        document.querySelectorAll('.tabCard').forEach(card => {
            card.addEventListener('click', function () {
                const link = this.querySelector('.tabLink a'); // Seleciona o link interno
                if (link) {
                    window.location.href = link.href; // Redireciona para o URL do link
                }
            });
        });
    }

    // Configuração inicial ao carregar a página
    window.addEventListener('load', function () {
        // Inicializa o slick slider
        $('.ta-mobile-slides').slick({
            dots: true,
            infinite: true,
            slidesToShow: 1,
            adaptiveHeight: true,
        });

        // Torna os tabCards clicáveis
        makeTabCardClickable();
    });
