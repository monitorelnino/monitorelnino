        $('.em_destaque div').filter(function() {
          let item = removeAcento($(this).text().toLowerCase());
          $(this).toggle(item.indexOf(value) > -1);
        });

        $(".bloco-tabs ul li").filter(function() {
          let item = removeAcento($(this).text().toLowerCase());

          $(this).toggle(item.indexOf(value) > -1);

          if ($(bloco_tabs).is(":hidden")) {
            return $('.openTabs').click();
          }
        });
      }, 500);
