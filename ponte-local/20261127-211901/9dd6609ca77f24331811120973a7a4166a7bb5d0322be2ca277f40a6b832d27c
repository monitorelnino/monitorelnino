  <script>
    (function () {
      const chave = 'cookies-pref' + 'https:saodomingosdonorte';
      const container = document.querySelector('.cookies-container');
      const btnAceitar = document.querySelector('.cookies-save');
      const btnRejeitar = document.querySelector('.rejeitar-cookies');
      if (!container) return;

      // O que cada preferencia ativa
      const funcoes = {
        analytics: function () {
          if (window.carregarAnalytics) window.carregarAnalytics();
        },
        simplecookie: function () {
          console.log('Politica de Privacidade Autorizada');
        },
        rejeitado: function () {
          apagarCookiesAnalytics();
        }
      };

      function lerPref() {
        try { return JSON.parse(localStorage.getItem(chave)); } catch (e) { return null; }
      }

      function salvarPref(pref) {
        try { localStorage.setItem(chave, JSON.stringify(pref)); } catch (e) {}
      }

      function prefDoFormulario() {
        return [...document.querySelectorAll('[data-function]')]
          .filter((el) => el.checked)
          .map((el) => el.getAttribute('data-function'));
      }

      function aplicar(pref) {
        pref.forEach((f) => { if (funcoes[f]) funcoes[f](); });
        container.style.display = 'none';
      }

      // Remove _ga, _gid, _gat_* que possam ter ficado de visitas anteriores
      function apagarCookiesAnalytics() {
        const host = location.hostname;
        const dominios = ['', host, '.' + host, '.' + host.replace(/^www\./, '')];
        document.cookie.split('; ').forEach((c) => {
          const nome = c.split('=')[0];
          if (/^(_ga|_gid|_gat)/.test(nome)) {
            dominios.forEach((d) => {
              document.cookie = nome + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/' + (d ? '; domain=' + d : '');
            });
          }
        });
      }

      // Ja escolheu antes? aplica e esconde o aviso. Senao, mostra o aviso.
      // Se o portal passou a usar algo novo (ex.: GA ativado depois do aceite),
      // pergunta de novo. Quem rejeitou continua rejeitado.
      function prefValida(pref) {
        if (!Array.isArray(pref)) return false;
        if (pref.indexOf('rejeitado') !== -1) return true;
        return prefDoFormulario().every((f) => pref.indexOf(f) !== -1);
      }

      const pref = lerPref();
      if (prefValida(pref)) aplicar(pref);
      else container.style.display = 'block';

      if (btnAceitar) btnAceitar.addEventListener('click', function () {
        const p = prefDoFormulario();
        salvarPref(p);
        aplicar(p);
      });

      if (btnRejeitar) btnRejeitar.addEventListener('click', function () {
        const p = ['rejeitado'];
        salvarPref(p);
        aplicar(p);
      });
    })();
  </script>
