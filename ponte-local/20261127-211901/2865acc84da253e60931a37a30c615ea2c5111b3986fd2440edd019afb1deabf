<style>
    /* Container principal do slider */
    .custom-slider-container {
        position: relative;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        overflow: hidden;
        padding: 20px 0;
    }

    /* Janela de exibição que esconde os itens fora de foco */
    .custom-slider-track-wrapper {
        overflow: hidden;
        width: 100%;
    }

    /* Trilha que segura todos os slides */
    .custom-slider-track {
        display: flex;
        width: 100%;
        transition: transform 0.4s ease-in-out;
    }

    /* Cada slide individual */
    .custom-slide-item {
        flex: 0 0 25%; /* Exibe 4 itens por vez em telas grandes */
        text-align: center;
        padding: 10px 15px;
        box-sizing: border-box;
    }

    /* Estilização dos links e imagens */
    .custom-slide-item a {
        display: block;
        text-decoration: none;
        transition: transform 0.2s ease-in-out;
    }

    .custom-slide-item a:hover {
        transform: scale(1.05);
    }

    .custom-slide-item img {
        max-width: 100%;
        height: auto;
        max-height: 85px; /* Mantém o alinhamento visual proporcional dos logos */
        object-fit: contain;
        display: inline-block;
    }

    /* Botões de navegação (Setas) */
    .custom-slider-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background-color: rgba(0, 0, 0, 0.15);
        color: #333;
        border: none;
        width: 35px;
        height: 35px;
        border-radius: 50%;
        cursor: pointer;
        font-size: 16px;
        font-weight: bold;
        z-index: 10;
        transition: all 0.3s ease;
    }

    .custom-slider-btn:hover {
        background-color: rgba(0, 0, 0, 0.6);
        color: #fff;
    }

    .custom-slider-btn.prev { left: 5px; }
    .custom-slider-btn.next { right: 5px; }

    /* Responsividade para telas menores e dispositivos móveis */
    @media (max-width: 1024px) {
        .custom-slide-item { flex: 0 0 33.333%; } /* Mostra 3 em tablets */
    }

    @media (max-width: 768px) {
        .custom-slide-item { flex: 0 0 50%; } /* Mostra 2 em celulares grandes */
    }

    @media (max-width: 480px) {
        .custom-slide-item { flex: 0 0 100%; } /* Mostra 1 em celulares pequenos */
    }
</style>

<script>
    let currentIndex = 0;
    let autoPlayTimer = null;
    const autoPlayInterval = 3000; // Tempo de transição em milissegundos (3 segundos)
    const track = document.getElementById('sliderTrack');
    const container = document.getElementById('customSliderContainer');
    
    function getVisibleItemsCount() {
        const width = window.innerWidth;
        if (width > 1024) return 4;
        if (width > 768) return 3;
        if (width > 480) return 2;
        return 1;
    }

    function moveSlider(direction) {
        const totalItems = document.querySelectorAll('.custom-slide-item').length;
        const visibleItems = getVisibleItemsCount();
        const maxIndex = totalItems - visibleItems;

        currentIndex += direction;

        // Se passar do limite máximo, volta para o primeiro slide (loop infinito ao avançar)
        if (currentIndex > maxIndex) {
            currentIndex = 0;
        } 
        // Se for menor que zero, vai para o último índice possível
        else if (currentIndex < 0) {
            currentIndex = maxIndex;
        }

        const percentageToMove = -(currentIndex * (100 / visibleItems));
        track.style.transform = `translateX(${percentageToMove}%)`;
    }

    // Funções do Temporizador Automático
    function startAutoPlay() {
        stopAutoPlay(); // Previne múltiplos timers ativos ao mesmo tempo
        autoPlayTimer = setInterval(() => {
            moveSlider(1);
        }, autoPlayInterval);
    }

    function stopAutoPlay() {
        if (autoPlayTimer) {
            clearInterval(autoPlayTimer);
        }
    }

    // Inicia o autoplay ao carregar a página
    window.addEventListener('DOMContentLoaded', startAutoPlay);

    // Pausa o slide se o usuário passar o mouse por cima e retoma ao tirar
    container.addEventListener('mouseenter', stopAutoPlay);
    container.addEventListener('mouseleave', startAutoPlay);

    // Reseta o posicionamento se a tela mudar de tamanho para evitar quebras
    window.addEventListener('resize', () => {
        currentIndex = 0;
        track.style.transform = 'translateX(0%)';
    });
</script>				</div>
