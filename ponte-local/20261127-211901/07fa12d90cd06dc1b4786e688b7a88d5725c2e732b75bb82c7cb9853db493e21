<script>
    (function () {
        var container = document.querySelector('[data-weather-forecast]');

        if (!container) {
            return;
        }

        var labels = {
            0: ['Céu limpo', 'fa-solid fa-sun', '#f59e0b', '#fffbeb', '#fef3c7', 'linear-gradient(135deg, #fff7ed 0%, #fef3c7 52%, #bae6fd 100%)'],
            1: ['Poucas nuvens', 'fa-solid fa-cloud-sun', '#0284c7', '#f0f9ff', '#bae6fd', 'linear-gradient(135deg, #f0f9ff 0%, #dbeafe 52%, #fef3c7 100%)'],
            2: ['Parcialmente nublado', 'fa-solid fa-cloud-sun', '#0f766e', '#f0fdfa', '#ccfbf1', 'linear-gradient(135deg, #f0fdfa 0%, #e0f2fe 58%, #fef9c3 100%)'],
            3: ['Nublado', 'fa-solid fa-cloud', '#475569', '#f8fafc', '#e2e8f0', 'linear-gradient(135deg, #f8fafc 0%, #e2e8f0 56%, #dbeafe 100%)'],
            45: ['Neblina', 'fa-solid fa-smog', '#64748b', '#f8fafc', '#e2e8f0', 'linear-gradient(135deg, #f8fafc 0%, #e5e7eb 56%, #cbd5e1 100%)'],
            48: ['Neblina', 'fa-solid fa-smog', '#64748b', '#f8fafc', '#e2e8f0', 'linear-gradient(135deg, #f8fafc 0%, #e5e7eb 56%, #cbd5e1 100%)'],
            51: ['Garoa fraca', 'fa-solid fa-cloud-rain', '#2563eb', '#eff6ff', '#bfdbfe', 'linear-gradient(135deg, #eff6ff 0%, #dbeafe 54%, #bfdbfe 100%)'],
            53: ['Garoa', 'fa-solid fa-cloud-rain', '#2563eb', '#eff6ff', '#bfdbfe', 'linear-gradient(135deg, #eff6ff 0%, #dbeafe 54%, #bfdbfe 100%)'],
            55: ['Garoa forte', 'fa-solid fa-cloud-rain', '#1d4ed8', '#eff6ff', '#bfdbfe', 'linear-gradient(135deg, #eff6ff 0%, #bfdbfe 52%, #93c5fd 100%)'],
            61: ['Chuva fraca', 'fa-solid fa-cloud-rain', '#2563eb', '#eff6ff', '#bfdbfe', 'linear-gradient(135deg, #eff6ff 0%, #dbeafe 54%, #bfdbfe 100%)'],
            63: ['Chuva', 'fa-solid fa-cloud-showers-heavy', '#1d4ed8', '#eff6ff', '#bfdbfe', 'linear-gradient(135deg, #eff6ff 0%, #bfdbfe 52%, #93c5fd 100%)'],
            65: ['Chuva forte', 'fa-solid fa-cloud-showers-heavy', '#1e40af', '#eff6ff', '#bfdbfe', 'linear-gradient(135deg, #dbeafe 0%, #93c5fd 54%, #60a5fa 100%)'],
            80: ['Pancadas fracas', 'fa-solid fa-cloud-rain', '#2563eb', '#eff6ff', '#bfdbfe', 'linear-gradient(135deg, #eff6ff 0%, #dbeafe 54%, #bfdbfe 100%)'],
            81: ['Pancadas de chuva', 'fa-solid fa-cloud-showers-heavy', '#1d4ed8', '#eff6ff', '#bfdbfe', 'linear-gradient(135deg, #eff6ff 0%, #bfdbfe 52%, #93c5fd 100%)'],
            82: ['Pancadas fortes', 'fa-solid fa-cloud-showers-heavy', '#1e40af', '#eff6ff', '#bfdbfe', 'linear-gradient(135deg, #dbeafe 0%, #93c5fd 54%, #60a5fa 100%)'],
            95: ['Trovoadas', 'fa-solid fa-cloud-bolt', '#7c3aed', '#f5f3ff', '#ddd6fe', 'linear-gradient(135deg, #f5f3ff 0%, #ddd6fe 52%, #bfdbfe 100%)'],
            96: ['Trovoadas', 'fa-solid fa-cloud-bolt', '#7c3aed', '#f5f3ff', '#ddd6fe', 'linear-gradient(135deg, #f5f3ff 0%, #ddd6fe 52%, #bfdbfe 100%)'],
            99: ['Trovoadas fortes', 'fa-solid fa-cloud-bolt', '#6d28d9', '#f5f3ff', '#ddd6fe', 'linear-gradient(135deg, #ede9fe 0%, #c4b5fd 52%, #93c5fd 100%)']
        };

        function round(value) {
            return Math.round(Number(value));
        }

        function dayLabel(date) {
            return new Intl.DateTimeFormat('pt-BR', {
                weekday: 'short',
                day: '2-digit',
                month: '2-digit',
                timeZone: 'America/Sao_Paulo'
            }).format(new Date(date + 'T12:00:00'));
        }

        function weatherMeta(day) {
            return day.code in labels ? labels[day.code] : ['Previsão', 'fa-solid fa-cloud', '#0f766e', '#f0fdfa', '#ccfbf1', 'linear-gradient(135deg, #f0fdfa 0%, #e0f2fe 100%)'];
        }

        function weatherCard(day, index) {
            var code = weatherMeta(day);
            var rain = day.rain === null || day.rain === undefined ? '-' : round(day.rain) + '%';

            return [
                '<article class="bg-white p-4 ring-1 ring-slate-200 transition duration-300 hover:-translate-y-1 hover:shadow-md" style="animation: weatherFade .45s ease both; animation-delay: ' + (index * 55) + 'ms;">',
                    '<div class="flex items-start justify-between gap-3">',
                        '<div>',
                            '<span class="block text-xs font-bold uppercase tracking-wide text-slate-500">' + (index === 0 ? 'Hoje' : dayLabel(day.date)) + '</span>',
                            '<strong class="mt-2 block text-2xl font-semibold text-slate-950">' + round(day.max) + '°</strong>',
                            '<span class="text-sm font-semibold text-slate-500">mín. ' + round(day.min) + '°</span>',
                        '</div>',
                        '<span class="grid h-10 w-10 shrink-0 place-items-center rounded-md text-lg" style="background:' + code[3] + '; color:' + code[2] + ';"><i class="' + code[1] + '"></i></span>',
                    '</div>',
                    '<p class="mt-4 min-h-10 text-sm font-semibold leading-5 text-slate-700">' + code[0] + '</p>',
                    '<span class="mt-3 inline-flex items-center gap-2 text-xs font-bold text-slate-500"><i class="fa-solid fa-droplet" style="color:' + code[2] + ';"></i> Chuva ' + rain + '</span>',
                '</article>'
            ].join('');
        }

        function todayPanel(day) {
            var code = weatherMeta(day);
            var rain = day.rain === null || day.rain === undefined ? '-' : round(day.rain) + '%';

            return [
                '<article class="relative overflow-hidden p-6 shadow-sm ring-1 ring-slate-200" style="background:' + code[5] + '; border-top: 4px solid ' + code[2] + '; animation: weatherFade .45s ease both;">',
                    '<span class="pointer-events-none absolute -right-10 -top-12 h-36 w-36 rounded-full bg-white/45"></span>',
                    '<span class="pointer-events-none absolute -bottom-16 right-16 h-32 w-32 rounded-full bg-white/30"></span>',
                    '<div class="relative flex items-start justify-between gap-4">',
                        '<div>',
                            '<span class="inline-flex items-center gap-2 rounded-md px-3 py-2 text-xs font-bold uppercase tracking-wide" style="background:' + code[3] + '; color:' + code[2] + ';">Agora na cidade</span>',
                            '<h3 class="mt-5 text-4xl font-semibold tracking-tight text-slate-950">' + round(day.max) + '°</h3>',
                            '<p class="mt-2 text-sm font-semibold text-slate-500">mínima prevista de ' + round(day.min) + '°</p>',
                        '</div>',
                        '<span class="grid h-16 w-16 shrink-0 place-items-center rounded-lg text-3xl" style="background:' + code[4] + '; color:' + code[2] + ';"><i class="' + code[1] + '"></i></span>',
                    '</div>',
                    '<p class="relative mt-6 text-lg font-semibold leading-7 text-slate-900">' + code[0] + '</p>',
                    '<div class="relative mt-5 grid gap-3 sm:grid-cols-2">',
                        '<span class="flex items-center gap-3 bg-white/65 p-3 text-sm font-semibold text-slate-700 ring-1 ring-white/70"><i class="fa-solid fa-droplet" style="color:' + code[2] + ';"></i> Chuva ' + rain + '</span>',
                        '<span class="flex items-center gap-3 bg-white/65 p-3 text-sm font-semibold text-slate-700 ring-1 ring-white/70"><i class="fa-regular fa-calendar" style="color:' + code[2] + ';"></i> ' + dayLabel(day.date) + '</span>',
                    '</div>',
                '</article>'
            ].join('');
        }

        fetch('https://api.open-meteo.com/v1/forecast?latitude=-21.0719&longitude=-42.6358&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max&forecast_days=7&timezone=America%2FSao_Paulo')
            .then(function (response) {
                if (!response.ok) {
                    throw new Error('weather_unavailable');
                }

                return response.json();
            })
            .then(function (forecast) {
                var daily = forecast.daily || {};
                var days = (daily.time || []).map(function (date, index) {
                    return {
                        date: date,
                        code: daily.weather_code[index],
                        max: daily.temperature_2m_max[index],
                        min: daily.temperature_2m_min[index],
                        rain: daily.precipitation_probability_max ? daily.precipitation_probability_max[index] : null
                    };
                });

                if (!days.length) {
                    throw new Error('weather_empty');
                }

                container.innerHTML = [
                    todayPanel(days[0]),
                    '<div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">',
                        days.slice(1).map(function (day, index) {
                            return weatherCard(day, index + 1);
                        }).join(''),
                    '</div>'
                ].join('');
            })
            .catch(function () {
                container.innerHTML = '<div class="bg-white p-5 text-sm font-semibold text-slate-600 ring-1 ring-slate-200 lg:col-span-2">Não foi possível carregar a previsão do tempo agora. Tente novamente mais tarde.</div>';
            });
    }());
</script>
