<script>
    document.querySelectorAll('[data-mobile-menu-toggle]').forEach(function (button) {
        var target = document.getElementById(button.getAttribute('aria-controls'));

        if (!target) {
            return;
        }

        button.addEventListener('click', function () {
            var isOpen = !target.classList.contains('hidden');
            target.classList.toggle('hidden', isOpen);
            button.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
            var icon = button.querySelector('[data-mobile-menu-icon]');
            if (icon) {
                icon.classList.toggle('fa-bars', isOpen);
                icon.classList.toggle('fa-xmark', !isOpen);
            }
        });
    });

    document.querySelectorAll('[data-carousel]').forEach(function (carousel) {
        var slides = carousel.querySelectorAll('[data-slide]');
        var dots = carousel.querySelectorAll('[data-dot]');
        var current = 0;

        function show(index) {
            if (!slides.length) {
                return;
            }

            current = (index + slides.length) % slides.length;
            slides.forEach(function (slide, slideIndex) {
                slide.classList.toggle('hidden', slideIndex !== current);
            });
            dots.forEach(function (dot, dotIndex) {
                dot.classList.toggle('bg-white', dotIndex === current);
                dot.classList.toggle('bg-white/40', dotIndex !== current);
            });
        }

        carousel.querySelectorAll('[data-carousel-next]').forEach(function (button) {
            button.addEventListener('click', function () { show(current + 1); });
        });
        carousel.querySelectorAll('[data-carousel-prev]').forEach(function (button) {
            button.addEventListener('click', function () { show(current - 1); });
        });
        dots.forEach(function (dot, index) {
            dot.addEventListener('click', function () { show(index); });
        });
        show(0);

        if (slides.length > 1) {
            setInterval(function () { show(current + 1); }, 6500);
        }
    });

    document.querySelectorAll('[data-scroll-carousel]').forEach(function (carousel) {
        var track = carousel.querySelector('[data-scroll-track]');
        if (!track) {
            return;
        }
        carousel.querySelectorAll('[data-scroll-next]').forEach(function (button) {
            button.addEventListener('click', function () {
                track.scrollBy({ left: Math.max(280, track.clientWidth * 0.8), behavior: 'smooth' });
            });
        });
        carousel.querySelectorAll('[data-scroll-prev]').forEach(function (button) {
            button.addEventListener('click', function () {
                track.scrollBy({ left: -Math.max(280, track.clientWidth * 0.8), behavior: 'smooth' });
            });
        });
    });

    (function () {
        var root = document.documentElement;
        var panel = document.querySelector('[data-accessibility-panel]');
        var toggle = document.querySelector('[data-accessibility-toggle]');
        var close = document.querySelector('[data-accessibility-close]');
        var fontLevel = 0;
        var contrast = false;
        try {
            fontLevel = Math.max(0, Math.min(2, Number(localStorage.getItem('accessibilityFontLevel')) || 0));
            contrast = localStorage.getItem('accessibilityContrast') === '1';
        } catch (error) { /* The controls still work when browser storage is disabled. */ }

        function apply() {
            root.classList.toggle('accessibility-font-lg', fontLevel === 1);
            root.classList.toggle('accessibility-font-xl', fontLevel === 2);
            root.classList.toggle('accessibility-contrast', contrast);
            var contrastControl = document.querySelector('[data-accessibility-contrast]');
            if (contrastControl) contrastControl.setAttribute('aria-pressed', contrast ? 'true' : 'false');
            try {
                localStorage.setItem('accessibilityFontLevel', String(fontLevel));
                localStorage.setItem('accessibilityContrast', contrast ? '1' : '0');
            } catch (error) { /* Preference persistence is optional. */ }
        }

        function setPanel(open) {
            if (!panel || !toggle) {
                return;
            }

            panel.hidden = !open;
            toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            if (open && close) close.focus();
            if (!open) toggle.focus();
        }

        apply();
        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape' && panel && !panel.hidden) setPanel(false);
        });

        if (toggle) {
            toggle.addEventListener('click', function () {
                setPanel(panel ? panel.hidden : false);
            });
        }

        if (close) {
            close.addEventListener('click', function () {
                setPanel(false);
            });
        }

        document.querySelectorAll('[data-accessibility-font]').forEach(function (button) {
            button.addEventListener('click', function () {
                var action = button.getAttribute('data-accessibility-font');
                fontLevel = action === 'increase' ? Math.min(2, fontLevel + 1) : Math.max(0, fontLevel - 1);
                apply();
            });
        });

        var contrastButton = document.querySelector('[data-accessibility-contrast]');
        if (contrastButton) {
            contrastButton.addEventListener('click', function () {
                contrast = !contrast;
                apply();
            });
        }

        var resetButton = document.querySelector('[data-accessibility-reset]');
        if (resetButton) {
            resetButton.addEventListener('click', function () {
                fontLevel = 0;
                contrast = false;
                apply();
            });
        }
    })();
    if (window.VLibras) {
        new window.VLibras.Widget('https://vlibras.gov.br/app');
    }
</script>
