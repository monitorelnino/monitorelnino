/* ========================================================
   DreamTeamWP: Galerias Modernas e Lightbox (WP 7.0)
   ======================================================== */

/* Container Base da Galeria */
.wp-block-gallery, 
.gallery {
    display: grid !important;
    gap: 16px !important;
    margin: 2rem 0 !important;
    padding: 0 !important;
    list-style: none !important;
}

/* Responsividade Automática para Telas Menores */
@media (max-width: 768px) {
    .wp-block-gallery, 
    .gallery {
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)) !important;
    }
}

/* Tratamento de Colunas (Desktops e Tablets) */
@media (min-width: 769px) {
    .wp-block-gallery.columns-1, .gallery.gallery-columns-1 { grid-template-columns: 1fr !important; }
    .wp-block-gallery.columns-2, .gallery.gallery-columns-2 { grid-template-columns: repeat(2, 1fr) !important; }
    .wp-block-gallery.columns-3, .gallery.gallery-columns-3 { grid-template-columns: repeat(3, 1fr) !important; }
    .wp-block-gallery.columns-4, .gallery.gallery-columns-4 { grid-template-columns: repeat(4, 1fr) !important; }
    .wp-block-gallery.columns-5, .gallery.gallery-columns-5 { grid-template-columns: repeat(5, 1fr) !important; }
    .wp-block-gallery.columns-6, .gallery.gallery-columns-6 { grid-template-columns: repeat(6, 1fr) !important; }
}

/* Estilo das Imagens e Efeito Hover */
.wp-block-gallery .wp-block-image, 
.wp-block-gallery .wp-block-image figure,
.gallery .gallery-item {
    margin: 0 !important;
    width: 100% !important;
    height: 100% !important;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    cursor: zoom-in; /* Indica que é clicável */
    position: relative;
    background-color: #f4f7f7;
}

/* Forçando o enquadramento (Object Fit) */
.wp-block-gallery img, 
.gallery img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    aspect-ratio: 1 / 1; /* Garante quadrados perfeitos, altere para 4/3 ou 16/9 se preferir */
    transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    display: block;
}

/* Efeito Hover na Imagem */
.wp-block-gallery .wp-block-image:hover img, 
.gallery .gallery-item:hover img {
    transform: scale(1.08);
}

/* ========================================================
   Estilos do Lightbox Nativo (Elemento <dialog>)
   ======================================================== */
::backdrop {
    background: rgba(15, 23, 42, 0.95);
    backdrop-filter: blur(10px);
}

dialog.dt-native-lightbox {
    border: none;
    background: transparent;
    padding: 0;
    max-width: 95vw;
    max-height: 95vh;
    overflow: visible;
    border-radius: 8px;
    box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);
    outline: none;
}

dialog.dt-native-lightbox img {
    max-width: 100vw;
    max-height: 90vh;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    border-radius: 4px;
    margin: 0 auto;
    animation: dtFadeIn 0.3s ease forwards;
}

dialog.dt-native-lightbox .dt-lightbox-close {
    position: fixed;
    top: 20px;
    right: 30px;
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border: 1px solid rgba(255,255,255,0.2);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    backdrop-filter: blur(5px);
}

dialog.dt-native-lightbox .dt-lightbox-close:hover {
    background: #5A9C1E; /* Cor baseada no seu layout anterior */
    border-color: #5A9C1E;
    transform: scale(1.1);
}

@keyframes dtFadeIn {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
}
