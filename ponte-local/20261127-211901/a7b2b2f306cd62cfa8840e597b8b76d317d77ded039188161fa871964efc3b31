    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const galleries = document.querySelectorAll('.wp-block-gallery, .gallery');
            if (!galleries.length) return;

            const dialog = document.createElement('dialog');
            dialog.className = 'dt-native-lightbox';
            dialog.innerHTML = `
                <button class="dt-lightbox-close" aria-label="Fechar modal">&times;</button>
                <img src="" alt="Imagem ampliada">
            `;
            document.body.appendChild(dialog);

            const dialogImg = dialog.querySelector('img');
            const closeBtn  = dialog.querySelector('.dt-lightbox-close');

            const closeLightbox = () => {
                dialog.close();
                dialogImg.src = '';
            };

            closeBtn.addEventListener('click', closeLightbox);

            dialog.addEventListener('click', (event) => {
                if (event.target === dialog) {
                    closeLightbox();
                }
            });

            galleries.forEach(gallery => {
                const images = gallery.querySelectorAll('img');
                
                images.forEach(img => {
                    const parentLink = img.closest('a');
                    
                    if (parentLink) {
                        parentLink.addEventListener('click', (e) => {
                            e.preventDefault();
                        });
                    }

                    img.addEventListener('click', () => {
                        let highResUrl = img.src;
                        
                        if (parentLink && parentLink.href.match(/\.(jpeg|jpg|gif|png|webp|avif)$/i)) {
                            highResUrl = parentLink.href;
                        }

                        highResUrl = highResUrl.replace(/-\d+x\d+(\.\w+)$/, '$1');

                        dialogImg.src = highResUrl;
                        dialogImg.alt = img.alt || 'Imagem em tela cheia';
                        
                        dialog.showModal();
                    });
                });
            });
        });
    </script>
