<script>
document.addEventListener('DOMContentLoaded', function() {
    // 1. Menu Mobile Toggle Principal
    const toggleBtn = document.getElementById('dtMobileToggle');
    const menu = document.querySelector('.dt-main-menu');

    if(toggleBtn && menu) {
        toggleBtn.addEventListener('click', function() {
            this.classList.toggle('active');
            menu.classList.toggle('active');
        });
    }

    // 2. SOLUÇÃO MOBILE: Controle de Dropdown por Clique (Toggle Perfeito)
    const parentLinks = document.querySelectorAll('.dt-main-menu .menu-item-has-children > a');
    
    parentLinks.forEach(link => {
        link.addEventListener('click', function(e) {
            // Aplica a regra estrita de abrir/fechar apenas no mobile (<= 900px)
            if (window.innerWidth <= 900) {
                e.preventDefault(); // Bloqueia totalmente o link pai. Ele funcionará apenas como "sanfona".
                
                const parentLi = this.parentElement;
                
                // Se clicou e JÁ ESTÁ ABERTO, então FECHA.
                if (parentLi.classList.contains('mobile-open')) {
                    parentLi.classList.remove('mobile-open');
                } 
                // Se clicou e ESTÁ FECHADO, fecha os outros e ABRE este.
                else {
                    document.querySelectorAll('.dt-main-menu .menu-item-has-children').forEach(li => {
                        li.classList.remove('mobile-open');
                    });
                    parentLi.classList.add('mobile-open');
                }
            }
        });
    });

    // 3. Header Fixo & Compensação do Body
    const header = document.getElementById('site-header');
    const body = document.body;

    function updateBodyPadding() {
        if(header) {
            const headerHeight = header.offsetHeight;
            body.style.paddingTop = headerHeight + 'px';
        }
    }

    updateBodyPadding();
    window.addEventListener('resize', updateBodyPadding);
    setTimeout(updateBodyPadding, 500); 

    // 4. Efeito "Sticky" com animação ao rolar a página
    window.addEventListener('scroll', function() {
        if (window.scrollY > 40) {
            header.classList.add('scrolled');
        } else {
            header.classList.remove('scrolled');
        }
    });
});
