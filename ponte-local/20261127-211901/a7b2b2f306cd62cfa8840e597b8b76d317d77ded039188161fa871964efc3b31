        document.addEventListener("DOMContentLoaded", function() {
            const painel = document.getElementById('mun-painel-opcoes');
            const btnMenu = document.getElementById('mun-btn-acessibilidade');
            const btnVlibras = document.getElementById('mun-btn-vlibras');

            // 1. Lógica do Menu de Acessibilidade
            btnMenu.addEventListener('click', function(e) {
                e.stopPropagation();
                painel.classList.toggle('mun-fechado');
            });

            // Fecha ao clicar fora
            document.addEventListener('click', function(e) {
                if (!painel.contains(e.target) && !btnMenu.contains(e.target)) {
                    painel.classList.add('mun-fechado');
                }
            });

            // 2. Lógica do VLibras Proxy (O Pulo do Gato)
            // Quando o usuário clica no nosso botão unificado, forçamos o clique no botão invisível do governo.
            btnVlibras.addEventListener('click', function() {
                const btnNativoVlibras = document.querySelector('[vw-access-button]');
                if (btnNativoVlibras) {
                    btnNativoVlibras.click();
                } else {
                    console.error("VLibras ainda não carregou.");
                }
            });

            // Carrega preferências salvas
            munCarregarMemorias();
        });

        // =========================================================
        // FUNÇÕES DE ACESSIBILIDADE E LOCALSTORAGE
        // =========================================================
        let munTamanhoFonte = 100;
        
        function munMudarFonte(fator) {
            munTamanhoFonte += fator;
            if(munTamanhoFonte > 140) munTamanhoFonte = 140; 
            if(munTamanhoFonte < 85) munTamanhoFonte = 85;   
            
            document.documentElement.style.setProperty('font-size', munTamanhoFonte + '%', 'important');
            localStorage.setItem('mun_pref_fonte', munTamanhoFonte);
        }

        function munResetarFonte() {
            munTamanhoFonte = 100;
            document.documentElement.style.setProperty('font-size', '100%', 'important');
            localStorage.setItem('mun_pref_fonte', munTamanhoFonte);
        }

        function munAlternarContraste() {
            document.body.classList.toggle('mun-modo-contraste');
            localStorage.setItem('mun_pref_contraste', document.body.classList.contains('mun-modo-contraste') ? 'sim' : 'nao');
        }

        function munAlternarCinza() {
            document.body.classList.toggle('mun-modo-cinza');
            localStorage.setItem('mun_pref_cinza', document.body.classList.contains('mun-modo-cinza') ? 'sim' : 'nao');
        }

        function munCarregarMemorias() {
            const fonteSalva = localStorage.getItem('mun_pref_fonte');
            if(fonteSalva) {
                munTamanhoFonte = parseInt(fonteSalva);
                document.documentElement.style.setProperty('font-size', munTamanhoFonte + '%', 'important');
            }
            if(localStorage.getItem('mun_pref_contraste') === 'sim') {
                document.body.classList.add('mun-modo-contraste');
            }
            if(localStorage.getItem('mun_pref_cinza') === 'sim') {
                document.body.classList.add('mun-modo-cinza');
            }
        }
