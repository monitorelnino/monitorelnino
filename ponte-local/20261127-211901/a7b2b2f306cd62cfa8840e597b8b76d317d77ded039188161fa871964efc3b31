    <style>
        /* ========================================================
           DreamTeamWP: Header Customizado (Harmonia Minimalista)
           ======================================================== */
        
        /* Reset e Base */
        body { margin: 0; padding: 0; }
        .dt-header * { box-sizing: border-box; }

        .dt-header {
            font-family: 'Poppins', sans-serif;
            width: 100%;
            z-index: 9999;
            position: fixed;
            top: 0;
            left: 0;
            transition: all 0.4s ease;
            background-color: transparent;
        }

        /* Compensação da barra do WordPress Logado */
        body.admin-bar .dt-header { top: 32px; }
        @media screen and (max-width: 782px) {
            body.admin-bar .dt-header { top: 46px; }
        }

        .dt-container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 20px;
            position: relative;
        }

        /* --- Efeito Scrolled --- */
        .dt-header.scrolled {
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
        }
        .dt-header.scrolled .dt-top-bar {
            padding: 10px 0;
        }
        .dt-header.scrolled .dt-logo-img {
            height: 65px; 
        }

        /* --- Barra Superior --- */
        .dt-top-bar {
            background-color: #1A4B51; 
            color: #ffffff;
            padding: 20px 0;
            transition: padding 0.4s ease;
        }
        
        .dt-top-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .dt-logo-and-toggle {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: auto;
        }
        
        .dt-logo-area {
            display: flex;
            align-items: center;
            gap: 18px;
            text-decoration: none !important;
            color: #ffffff !important; 
        }
        
        .dt-logo-area:hover,
        .dt-logo-area:focus,
        .dt-logo-area:active {
            color: #ffffff !important;
            opacity: 1 !important;
            background: transparent !important;
            text-decoration: none !important;
            outline: none !important;
        }

        .dt-logo-area h1,
        .dt-logo-area span {
            color: #ffffff !important;
            transition: none !important;
        }

        .dt-logo-img {
            height: 82px; 
            width: auto;
            object-fit: contain;
            transition: height 0.4s ease;
        }

        .dt-logo-text {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .dt-logo-subtitle {
            font-size: 14px;
            font-weight: 400;
            margin-bottom: -4px;
            letter-spacing: 0.5px;
            opacity: 0.95;
        }

        .dt-logo-title {
            font-size: 27px;
            font-weight: 700;
            margin: 0;
            line-height: 1.2;
            letter-spacing: -0.2px;
        }

        .dt-top-links {
            display: flex;
            gap: 25px;
            align-items: center;
        }
        .dt-top-links a {
            color: #ffffff;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: opacity 0.3s ease;
        }
        .dt-top-links a:hover {
            opacity: 0.7;
        }
        .dt-top-links i {
            font-size: 17px;
        }

        /* --- Barra Inferior (Navegação Desktop) --- */
        .dt-bottom-bar {
            background-color: #ffffff;
            position: relative;
            z-index: 9998;
        }
        
        .dt-nav-inner {
            display: flex;
            justify-content: center;
        }

        .dt-main-nav {
            width: 100%;
            display: flex;
            justify-content: center;
        }

        .dt-main-menu {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            gap: 40px;
        }

        /* Link Principal (Nível 1) */
        .dt-main-menu > li {
            position: relative;
        }

        .dt-main-menu > li > a {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 20px 0;
            color: #000000;
            text-decoration: none;
            font-weight: 700;
            font-size: 14px;
            border-bottom: 3px solid transparent;
            transition: color 0.3s ease, border-color 0.3s ease;
        }
        
        /* Desktop Hover state */
        @media (min-width: 901px) {
            .dt-main-menu > li:hover > a,
            .dt-main-menu > li.current-menu-item > a,
            .dt-main-menu > li.current_page_item > a {
                color: #5A9C1E;
                border-bottom: 3px solid #5A9C1E;
            }
            .dt-main-menu > li.menu-item-has-children:hover > a::after {
                transform: rotate(180deg);
            }
        }

        /* Ícone de Seta (Dropdown) */
        .dt-main-menu li.menu-item-has-children > a::after {
            content: "\f078"; /* fa-chevron-down */
            font-family: "Font Awesome 6 Free";
            font-weight: 900;
            font-size: 10px;
            margin-top: 2px;
            margin-left: 4px;
            transition: transform 0.25s ease;
        }

        /* --- SUBMENU (DROPDOWN MINIMALISTA E FIEL AO PRINT) --- */
        .dt-main-menu .sub-menu {
            position: absolute;
            top: 100%;
            left: 0; 
            background-color: #ffffff;
            min-width: 220px;
            list-style: none;
            padding: 15px 0;
            margin: 0;
            border-top: 3px solid #5A9C1E; 
            box-shadow: 0 4px 15px rgba(0,0,0,0.06); 
            opacity: 0;
            visibility: hidden;
            transform: translateY(8px); 
            transition: all 0.2s ease-out;
            z-index: 10000;
        }

        /* Animação Hover no Submenu (Apenas Desktop) */
        @media (min-width: 901px) {
            .dt-main-menu > li:hover > .sub-menu {
                opacity: 1;
                visibility: visible;
                transform: translateY(0);
            }
        }

        /* Links do Submenu */
        .dt-main-menu .sub-menu li {
            width: 100%;
        }

        .dt-main-menu .sub-menu a {
            display: block;
            padding: 10px 24px;
            color: #333333;
            font-size: 14px;
            font-weight: 400; 
            text-decoration: none;
            transition: color 0.2s ease;
        }

        /* Hover Limpo no Submenu */
        .dt-main-menu .sub-menu a:hover {
            color: #5A9C1E; 
            background-color: transparent;
        }

        /* --- Botão Hambúrguer --- */
        .dt-mobile-toggle {
            display: none;
            background: transparent !important;
            border: none !important;
            outline: none !important;
            cursor: pointer;
            padding: 10px;
            z-index: 10001;
        }
        .dt-hamburger {
            display: block;
            width: 26px;
            height: 3px;
            background-color: #ffffff; 
            margin: 5px auto;
            border-radius: 2px;
            transition: all 0.3s ease-in-out;
        }
        .dt-mobile-toggle.active .dt-hamburger:nth-child(1) {
            transform: translateY(8px) rotate(45deg);
        }
        .dt-mobile-toggle.active .dt-hamburger:nth-child(2) {
            opacity: 0;
        }
        .dt-mobile-toggle.active .dt-hamburger:nth-child(3) {
            transform: translateY(-8px) rotate(-45deg);
        }

        /* ========================================================
           Responsivo / Mobile
           ======================================================== */
        @media (max-width: 1080px) {
            .dt-main-menu { gap: 20px; }
            .dt-logo-title { font-size: 22px; }
            .dt-logo-img { height: 70px; }
        }

        @media (max-width: 900px) {
            .dt-top-inner { flex-direction: column; align-items: stretch; gap: 15px; }
            .dt-logo-and-toggle { width: 100%; display: flex; }
            .dt-logo-img { height: 60px; }
            .dt-logo-title { font-size: 19px; }
            .dt-logo-subtitle { font-size: 12px; }
            .dt-mobile-toggle { display: block; margin-left: auto; }

            .dt-top-links {
                justify-content: center; border-top: 1px solid rgba(255, 255, 255, 0.15); 
                padding-top: 15px; gap: 20px; flex-wrap: wrap;
            }
            .dt-top-links a { font-size: 12px; }

            .dt-nav-inner { justify-content: center; padding: 0; }
            
            .dt-main-menu {
                position: absolute; top: 0; left: 0; width: 100%;
                background-color: #ffffff; flex-direction: column; gap: 0;
                max-height: 0; overflow: hidden; visibility: hidden; opacity: 0;
                transition: max-height 0.4s ease, opacity 0.3s ease, visibility 0.4s ease;
                box-shadow: 0 10px 15px rgba(0,0,0,0.1); z-index: -1;
            }

            .dt-main-menu.active {
                max-height: 80vh; overflow-y: auto; visibility: visible; opacity: 1;
                border-top: 2px solid #5A9C1E; 
            }

            .dt-main-menu li { width: 100%; text-align: center; }
            
            .dt-main-menu > li > a {
                padding: 18px 20px; border-bottom: 1px solid #f0f0f0;
                font-size: 16px; justify-content: center;
            }

