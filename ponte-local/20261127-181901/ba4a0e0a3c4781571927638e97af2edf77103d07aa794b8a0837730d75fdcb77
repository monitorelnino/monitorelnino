    Acessibilidade = {
        
        
        init: function() { 
            
            var elementBody = document.querySelector('body'); 
            var fontSize = 100;
            var increaseDecrease = 10;
            
            $(document).on('click', '[data-click=ac_fontmenos]', function(e) {
                
                fontSize = fontSize - increaseDecrease;
                elementBody.style.fontSize = fontSize + '%';
                
            });
            
            $(document).on('click', '[data-click=ac_fontmais]', function(e) {
                
                
                fontSize = fontSize + increaseDecrease;
                elementBody.style.fontSize = fontSize + '%';
                
            });
            
            document.onkeydown=function(e){
                
                console.log(e.which);
                
                
                if(e.which == 18)
                    pressedCtrl = true;
                if(e.which == 49 && pressedCtrl == true) {
                    window.toggleContrast();
                }
                
                if(e.which == 18)
                    pressedCtrl = true;
                if(e.which == 97 && pressedCtrl == true) {
                    window.toggleContrast();
                }
                
                //plus
                if(e.which == 18)
                    pressedCtrl = true;
                if(e.which == 107 && pressedCtrl == true) {
                    fontSize = fontSize + increaseDecrease;
                    elementBody.style.fontSize = fontSize + '%';
                }
                
                //minus
                if(e.which == 18)
                    pressedCtrl = true;
                if(e.which == 109 && pressedCtrl == true) {
                    fontSize = fontSize - increaseDecrease;
                    elementBody.style.fontSize = fontSize + '%';
                }
                
            }
            
            
        }
    }    
	
