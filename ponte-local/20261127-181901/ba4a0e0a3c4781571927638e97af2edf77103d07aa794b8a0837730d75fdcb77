    BoxHora = {
		init: function() {
			
            if ($("#hora").length){     
                BoxHora.initTimer();
            }
		},
    
        showTimer: function() {
            
            var time = new Date();
            
            var hora = time.getHours()   ;
            
            var hour = hora;
            var minute=time.getMinutes();
            var second=time.getSeconds();
            if(hour<10) hour ="0"+hour;
            if(minute<10) minute="0"+minute;
            if(second<10) second="0"+second;
            var st=hour+":"+minute+":"+second;
            var icon="<i class='glyphicon glyphicon-time'></i> ";
            document.getElementById("hora").innerHTML=icon+st;
        },
    
        initTimer: function() {
          setInterval(function() {  BoxHora.showTimer();  },1000);  
        }
    
    

	} 
        
    CookiesLGPD = {
		init: function() {
			
                var consent = CookiesLGPD.getCookie("cookies_consent");

                if (consent == null || consent == "" || consent == undefined){
                    $('#barlgpd_cookies').show();
                }
            
                $("#lgpd_cookie_accept").click(function(){
                    CookiesLGPD.setCookie("cookies_consent", 1, 30);
                });
            
		},
        
        setCookie: function(c_name,value,exdays){

            var exdate = new Date();
            exdate.setDate(exdate.getDate() + exdays);
            var c_value = escape(value) + ((exdays==null) ? "" : "; expires="+exdate.toUTCString());
            document.cookie = c_name + "=" + c_value+"; path=/";

            $('#barlgpd_cookies').hide('slow');
        },


        getCookie:function(c_name){
            var i,x,y,ARRcookies=document.cookie.split(";");
            for (i=0;i<ARRcookies.length;i++){
                x=ARRcookies[i].substr(0,ARRcookies[i].indexOf("="));
                y=ARRcookies[i].substr(ARRcookies[i].indexOf("=")+1);
                x=x.replace(/^\s+|\s+$/g,"");
                if (x==c_name)
                {
                    return unescape(y);
                }
            }
        },
    
       
           

	}      
   
