    <script>
        (function() {
            var SIZE = 34;
            var shadowCss = [
                '#vlibras-access{display:block!important;position:relative!important;top:auto!important;right:auto!important;bottom:auto!important;left:auto!important;width:' + SIZE + 'px!important;height:' + SIZE + 'px!important;overflow:hidden!important;transition:none!important;}',
                '#vlibras-access:hover{width:' + SIZE + 'px!important;}',
                '#vlibras-popup{display:none!important;visibility:hidden!important;opacity:0!important;pointer-events:none!important;}',
                '#vlibras-button{position:relative!important;width:' + SIZE + 'px!important;height:' + SIZE + 'px!important;border:none!important;padding:0!important;border-radius:10px!important;overflow:hidden!important;cursor:pointer!important;}',
                '#vlibras-button img{display:block!important;width:100%!important;height:100%!important;object-fit:cover!important;}'
            ].join('');

            function aplicarEstiloShadow(wrapper) {
                var shadow = wrapper && wrapper.shadowRoot;
                if (!shadow) return;

                var style = shadow.getElementById('gw-vlibras-topo-style');
                if (!style) {
                    style = document.createElement('style');
                    style.id = 'gw-vlibras-topo-style';
                    shadow.appendChild(style);
                }
                style.textContent = shadowCss;
            }

            var fixing = false;

            function fixarVLibras() {
                if (fixing) return;

                var slot = document.getElementById('gw-vlibras-slot');
                var wrapper = document.getElementById('vlibras-access-wrapper');
                if (!wrapper || !slot) return;

                fixing = true;
                try {
                    if (wrapper.parentElement !== slot) {
                        slot.appendChild(wrapper);
                    }

                    wrapper.style.setProperty('position', 'static', 'important');
                    wrapper.style.setProperty('width', SIZE + 'px', 'important');
                    wrapper.style.setProperty('height', SIZE + 'px', 'important');
                    wrapper.style.setProperty('overflow', 'hidden', 'important');
                    aplicarEstiloShadow(wrapper);
                    document.body.classList.add('gw-vlibras-no-topo');
                } finally {
                    fixing = false;
                }
            }

            function observarVLibras() {
                if (document.documentElement._gwVlibrasObserved) return;
                document.documentElement._gwVlibrasObserved = true;

                var observer = new MutationObserver(function(mutations) {
                    for (var i = 0; i < mutations.length; i++) {
                        var nodes = mutations[i].addedNodes;
                        for (var j = 0; j < nodes.length; j++) {
                            var node = nodes[j];
                            if (node && (node.id === 'vlibras-access-wrapper' || (node.querySelector && node.querySelector('#vlibras-access-wrapper')))) {
                                fixarVLibras();
                                return;
                            }
                        }
                    }
                });
                observer.observe(document.body, { childList: true });
            }

            function carregarVLibras() {
                if (window.gwVlibrasCarregando || window.VLibras) return;

                var script = document.createElement('script');
                script.src = 'https://vlibras.gov.br/app/vlibras-plugin.js';
                script.async = true;
                script.onload = function() {
                    if (window.VLibras && !window.gwVlibrasWidgetCriado) {
                        try {
                            new window.VLibras.Widget('https://vlibras.gov.br/app');
                            window.gwVlibrasWidgetCriado = true;
                        } catch (e) {}
                    }
                    fixarVLibras();
                };
                script.onerror = function() {
                    window.gwVlibrasCarregando = false;
                };
                window.gwVlibrasCarregando = true;
                document.head.appendChild(script);
            }

            window.addEventListener('load', function() {
                fixarVLibras();
                observarVLibras();
                window.setTimeout(fixarVLibras, 300);
                window.setTimeout(fixarVLibras, 1200);

                // O tradutor é externo e pode demorar. Começa após a página pronta,
                // sem bloquear o carregamento nem atrasar a tela do painel.
                if ('requestIdleCallback' in window) {
                    window.requestIdleCallback(carregarVLibras, { timeout: 2500 });
                } else {
                    window.setTimeout(carregarVLibras, 1200);
                }
            });

            window.gwFixarVLibras = fixarVLibras;
        })();
    </script>

            
