    </style>
    <script>
        // Enquanto um slide de vídeo está ativo, ele toca (mudo, como um banner
        // animado) e o carrossel aguarda o vídeo terminar (máx. 1 min) antes de
        // avançar; vídeos fora de exibição ficam pausados.
        // Não condicionar ao prefers-reduced-motion: muitos Windows têm as
        // animações desativadas, o que congelaria o vídeo sem controles.
        window.gwConfigurarBannerVideo = window.gwConfigurarBannerVideo || function (splide) {
            const raiz = splide.root;
            if (!raiz) return;

            const videos = raiz.querySelectorAll('video.banner-video');
            if (!videos.length) return;

            const totalSlides = raiz.querySelectorAll('.splide__slide:not(.splide__slide--clone)').length;

            const sincronizarVideo = (video) => {
                const slide = video.closest('.splide__slide');
                if (!slide) return;

                if (totalSlides > 1) video.removeAttribute('loop');

                if (slide.classList.contains('is-active')) {
                    const autoplay = splide.Components && splide.Components.Autoplay;
                    if (autoplay && totalSlides > 1) autoplay.pause();
                    video.onended = () => {
                        if (autoplay && totalSlides > 1) autoplay.play();
                        splide.go('>');
                    };
                    if (video.paused && !video.ended) {
                        const tentativa = video.play();
                        if (tentativa && tentativa.catch) tentativa.catch(() => {});
                    }
                } else {
                    video.pause();
                }
            };

            const sincronizar = () => videos.forEach(sincronizarVideo);

            videos.forEach((video) => {
                const slide = video.closest('.splide__slide');
                if (!slide) return;

                // Os eventos do Splide podem disparar antes da classe
                // is-active ser aplicada; observar a classe evita que o
                // vídeo fique pausado ao entrar em exibição.
                new MutationObserver(sincronizar).observe(slide, { attributes: true, attributeFilter: ['class'] });
                video.addEventListener('canplay', () => sincronizarVideo(video));
            });

            splide.on('mounted', sincronizar);
            splide.on('active', sincronizar);
            splide.on('move', sincronizar);
            splide.on('moved', sincronizar);
        };
    </script>

