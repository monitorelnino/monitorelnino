                    <script>
                        (function () {
                            var ul = document.getElementById('menu-desktop');
                            var extra = document.getElementById('extra-menu');
                            if (!ul || !extra || ul.closest('.layout-3-header') || ul.closest('.layout-4-header') || ul.closest('.l4-header-menu')) return;

                            var extraGrid = extra.querySelector('.layout-1-extra-menu-grid');
                            var extraEmpty = extra.querySelector('.layout-1-extra-menu-empty');
                            var filterInput = extra.querySelector('.layout-1-extra-menu-filter-input');
                            var moreBtn = null;
                            var items = [];
                            Array.prototype.forEach.call(ul.children, function (li) {
                                if (li.classList.contains('desktop-visible')) moreBtn = li;
                                if (li.classList.contains('menu-item-principal')) items.push(li);
                            });
                            var scheduled = false;
                            var hoverTimer = null;

                            function normalizeText(text) {
                                return String(text || '')
                                    .normalize('NFD')
                                    .replace(/[\u0300-\u036f]/g, '')
                                    .toLowerCase()
                                    .trim();
                            }

                            function applyExtraFilter() {
                                if (!extraGrid) return;
                                var termo = normalizeText(filterInput ? filterInput.value : '');
                                var visiveis = 0;
                                Array.prototype.forEach.call(extraGrid.children, function (item) {
                                    var texto = normalizeText(item.getAttribute('data-filter') || item.textContent);
                                    var ok = !termo || texto.indexOf(termo) !== -1;
                                    item.style.display = ok ? '' : 'none';
                                    if (ok) visiveis++;
                                });
                                if (extraEmpty) extraEmpty.style.display = visiveis === 0 ? '' : 'none';
                            }

                            function closeAllExtraGroups() {
                                extra.querySelectorAll('.layout-1-extra-menu-item-dropdown.is-open').forEach(function (other) {
                                    other.classList.remove('is-open');
                                    var otherTitle = other.querySelector('.layout-1-extra-menu-card-title');
                                    if (otherTitle) otherTitle.setAttribute('aria-expanded', 'false');
                                });
                            }

                            function bindExtraGroupToggles() {
                                extra.querySelectorAll('.layout-1-extra-menu-item-dropdown').forEach(function (item) {
                                    var title = item.querySelector('.layout-1-extra-menu-card-title');
                                    if (!title || title.dataset.l1Bound === '1') return;
                                    title.dataset.l1Bound = '1';
                                    title.setAttribute('role', 'button');
                                    title.setAttribute('tabindex', '0');
                                    title.setAttribute('aria-expanded', 'false');
                                    item.classList.remove('is-open');

                                    if (!title.querySelector('.layout-1-extra-menu-chevron')) {
                                        var label = document.createElement('span');
                                        label.textContent = title.textContent.trim();
                                        title.textContent = '';
                                        title.appendChild(label);
                                        var icon = document.createElement('i');
                                        icon.className = 'fas fa-chevron-down layout-1-extra-menu-chevron';
                                        icon.setAttribute('aria-hidden', 'true');
                                        title.appendChild(icon);
                                    }

                                    var toggleGroup = function () {
                                        var opening = !item.classList.contains('is-open');
                                        closeAllExtraGroups();
                                        if (opening) {
                                            item.classList.add('is-open');
                                            title.setAttribute('aria-expanded', 'true');
                                        } else {
                                            title.setAttribute('aria-expanded', 'false');
                                        }
                                    };

                                    title.addEventListener('click', function (e) {
                                        e.preventDefault();
                                        e.stopPropagation();
                                        toggleGroup();
                                    });
                                    title.addEventListener('keydown', function (e) {
                                        if (e.key === 'Enter' || e.key === ' ') {
                                            e.preventDefault();
                                            toggleGroup();
                                        }
                                    });
                                });
                            }

                            function createExtraMenuItem(li) {
                                var link = null;
                                var submenu = null;
                                Array.prototype.forEach.call(li.children, function (child) {
                                    if (child.tagName === 'A') link = child;
                                    if (child.getAttribute && child.getAttribute('opcoes') === 'principal') submenu = child;
                                });
                                var title = '';
                                if (link) {
                                    title = (link.getAttribute('data-menu-title') || link.textContent || '').replace(/\s+/g, ' ').trim();
                                }

                                if (submenu) {
                                    var submenuTitles = [];
                                    var sublist = document.createElement('ul');
                                    sublist.className = 'layout-1-extra-menu-sublist';
                                    Array.prototype.forEach.call(submenu.children, function (liSource) {
                                        var subLink = liSource.querySelector('a');
                                        if (!subLink) return;
                                        var subTitle = (subLink.getAttribute('data-menu-title') || subLink.textContent || '').replace(/\s+/g, ' ').trim();
                                        submenuTitles.push(subTitle);
                                        var liSub = document.createElement('li');
                                        var a = document.createElement('a');
                                        a.href = subLink.getAttribute('href') || '#';
                                        a.className = 'layout-1-extra-menu-submenu-link';
                                        a.textContent = subTitle;
                                        a.setAttribute('onclick', 'closeExtraMenu()');
                                        if (subLink.getAttribute('target')) a.setAttribute('target', subLink.getAttribute('target'));
                                        liSub.appendChild(a);
                                        sublist.appendChild(liSub);
                                    });

                                    var item = document.createElement('div');
                                    item.className = 'layout-1-extra-menu-item layout-1-extra-menu-item-dropdown layout-1-extra-menu-item-dynamic';
                                    item.setAttribute('data-filter', normalizeText([title].concat(submenuTitles).join(' ')));

                                    var card = document.createElement('div');
                                    card.className = 'layout-1-extra-menu-card';

                                    var cardTitle = document.createElement('div');
                                    cardTitle.className = 'layout-1-extra-menu-card-title';
                                    var span = document.createElement('span');
                                    span.textContent = title;
                                    cardTitle.appendChild(span);
                                    var chevron = document.createElement('i');
                                    chevron.className = 'fas fa-chevron-down layout-1-extra-menu-chevron';
                                    chevron.setAttribute('aria-hidden', 'true');
                                    cardTitle.appendChild(chevron);

                                    card.appendChild(cardTitle);
                                    card.appendChild(sublist);
                                    item.appendChild(card);
                                    return item;
                                }

                                var itemLink = document.createElement('div');
                                itemLink.className = 'layout-1-extra-menu-item layout-1-extra-menu-item-dynamic';
                                itemLink.setAttribute('data-filter', normalizeText(title));

                                var aCard = document.createElement('a');
                                aCard.className = 'layout-1-extra-menu-card layout-1-extra-menu-card-link' + (link && link.classList.contains('current-link') ? ' current-link' : '');
                                aCard.href = link ? (link.getAttribute('href') || '#') : '#';
                                aCard.setAttribute('onclick', 'closeExtraMenu()');
                                if (link && link.getAttribute('target')) aCard.setAttribute('target', link.getAttribute('target'));

                                var titleSpan = document.createElement('span');
                                titleSpan.className = 'layout-1-extra-menu-card-title';
                                titleSpan.textContent = title;
                                aCard.appendChild(titleSpan);
                                itemLink.appendChild(aCard);
                                return itemLink;
                            }

                            function itemVisible(li) {
                                return !li.classList.contains('menu-overflow-hidden') && li.style.display !== 'none';
                            }

                            function usedWidth() {
                                var gap = parseFloat(window.getComputedStyle(ul).columnGap || window.getComputedStyle(ul).gap) || 0;
                                var width = 0;
                                var count = 0;
                                Array.prototype.forEach.call(ul.children, function (li) {
                                    if (li.classList.contains('menu-overflow-hidden')) return;
                                    if (li.style.display === 'none') return;
                                    if (li.offsetWidth === 0) return;
                                    width += li.offsetWidth;
                                    count++;
                                });
                                if (count > 1) width += gap * (count - 1);
                                return width;
                            }

                            function availableWidth() {
                                var nav = ul.closest('[menu-principal]') || ul.parentElement;
                                if (!nav) return window.innerWidth;
                                var style = window.getComputedStyle(nav);
                                var padding = (parseFloat(style.paddingLeft) || 0) + (parseFloat(style.paddingRight) || 0);
                                return Math.max(0, nav.clientWidth - padding);
                            }

                            function overflows() {
                                return usedWidth() > availableWidth() + 1;
                            }

                            function isDesktopHover() {
                                return window.innerWidth > 750 && window.matchMedia('(hover: hover) and (pointer: fine)').matches;
                            }

                            function bindHoverBehaviour() {
                                if (!moreBtn) return;

                                function openHover() {
                                    clearTimeout(hoverTimer);
                                    if (!extra.classList.contains('is-open') && typeof toggleExtraMenu === 'function') {
                                        toggleExtraMenu();
                                    }
                                }

                                function scheduleClose() {
                                    clearTimeout(hoverTimer);
                                    hoverTimer = setTimeout(function () {
                                        if (typeof closeExtraMenu === 'function') closeExtraMenu();
                                    }, 220);
                                }

                                moreBtn.onmouseenter = function () { if (isDesktopHover()) openHover(); };
                                moreBtn.onmouseleave = function () { if (isDesktopHover()) scheduleClose(); };
                                extra.onmouseenter = function () { if (isDesktopHover()) clearTimeout(hoverTimer); };
                                extra.onmouseleave = function () { if (isDesktopHover()) scheduleClose(); };
                            }

                            function updateGwHeaderOverflowMenu() {
                                if (!extraGrid) return;
                                extraGrid.innerHTML = '';
                                items.forEach(function (li) {
                                    li.classList.remove('menu-overflow-hidden');
                                });
                                if (moreBtn) moreBtn.style.display = 'none';
                                if (typeof closeExtraMenu === 'function') closeExtraMenu();

                                if (window.innerWidth <= 750) {
                                    ul.classList.add('is-overflow-ready');
                                    return;
                                }

                                var guard = 0;
                                while (overflows() && guard < items.length) {
                                    if (moreBtn) moreBtn.style.display = '';
                                    var candidate = null;
                                    for (var i = items.length - 1; i >= 0; i--) {
                                        if (itemVisible(items[i])) {
                                            candidate = items[i];
                                            break;
                                        }
                                    }
                                    if (!candidate) break;
                                    candidate.classList.add('menu-overflow-hidden');
                                    guard++;
                                }

                                var hidden = items.filter(function (li) {
                                    return li.classList.contains('menu-overflow-hidden');
                                });

                                if (hidden.length) {
                                    if (moreBtn) moreBtn.style.display = '';
                                    hidden.forEach(function (li) {
                                        extraGrid.appendChild(createExtraMenuItem(li));
                                    });
                                    bindExtraGroupToggles();
                                    applyExtraFilter();
                                } else if (moreBtn) {
                                    moreBtn.style.display = 'none';
                                }

                                ul.classList.add('is-overflow-ready');
                            }

                            window.updateGwHeaderOverflowMenu = updateGwHeaderOverflowMenu;
                            window.__l1BindExtraGroupToggles = bindExtraGroupToggles;
                            window.__l1ApplyExtraFilter = applyExtraFilter;
                            window.__l1CloseAllExtraGroups = closeAllExtraGroups;

                            if (filterInput) {
                                filterInput.addEventListener('input', applyExtraFilter);
                            }

                            bindHoverBehaviour();

                            function scheduleUpdate() {
                                if (scheduled) return;
                                scheduled = true;
                                requestAnimationFrame(function () {
                                    scheduled = false;
                                    updateGwHeaderOverflowMenu();
                                });
                            }

                            updateGwHeaderOverflowMenu();
                            window.addEventListener('resize', scheduleUpdate);
                            window.addEventListener('load', scheduleUpdate);

                            if (window.ResizeObserver) {
                                var observerTarget = ul.closest('[menu-principal]') || ul;
                                new ResizeObserver(scheduleUpdate).observe(observerTarget);
                            }

                            document.addEventListener('keydown', function (e) {
                                if (e.key === 'Escape' && typeof closeExtraMenu === 'function') closeExtraMenu();
                            });
                        })();
                    </script>

