            <script>
                function toggleDropdown(event, menu) {
                    event.preventDefault();

                    // Fecha todos os outros submenus antes de abrir o novo
                    document.querySelectorAll('ul[opcoes]').forEach(ul => {
                        if (ul !== event.target.nextElementSibling) {
                            ul.style.display = 'none';
                        }
                    });

                    // Alterna a exibição do submenu clicado
                    let submenu = event.target.nextElementSibling;

                    if (submenu && submenu.getAttribute('opcoes') === menu) {
                        submenu.style.display = (submenu.style.display === 'none' || submenu.style.display === '') ? 'block' : 'none';
                    }
                }
            </script>

            <script src="https://unpkg.com/wavesurfer.js"></script>
            

            <script>
                // Carrega depois que o DOM estiver pronto
                (function() {
                    function initRadioUI() {
                        const audio = document.getElementById("myAudio");
                        const playPauseBtn = document.getElementById("playPauseBtn");
                        const visualizer = document.getElementById("visualizer2");

                        // Se não houver rádio nesta página, não faz nada
                        if (!audio || !playPauseBtn || !visualizer) return;

                        // Cria as barras do visualizador (uma única vez)
                        const totalBars = 20;
                        if (!visualizer.dataset.built) {
                            for (let i = 0; i < totalBars; i++) {
                                const bar = document.createElement("div");
                                bar.classList.add("bar2");
                                bar.style.animationDelay = `${(i * 0.05).toFixed(2)}s`;
                                visualizer.appendChild(bar);
                            }
                            visualizer.dataset.built = "1";
                        }

                        // Seleciona as barras criadas
                        const bars = visualizer.querySelectorAll(".bar2");

                        function toggleBarsAnimation(running) {
                            bars.forEach(bar => {
                                bar.style.animationPlayState = running ? "running" : "paused";
                            });
                        }

                        // Estado inicial
                        toggleBarsAnimation(false);

                        // Play/Pause
                        playPauseBtn.addEventListener("click", () => {
                            const redirectEnabled = playPauseBtn.dataset.redirect === "1";
                            const redirectUrl = playPauseBtn.dataset.radioUrl;

                            if (redirectEnabled) {
                                if (redirectUrl) {
                                    window.location.href = redirectUrl;
                                }
                                return;
                            }

                            if (audio.paused) {
                                audio.play().then(() => {
                                    playPauseBtn.innerHTML = '<i class="fas fa-pause"></i>';
                                    toggleBarsAnimation(true);
                                }).catch(() => {
                                    // Em caso de bloqueio do autoplay, mantém o botão em "play"
                                    playPauseBtn.innerHTML = '<i class="fas fa-play"></i>';
                                    toggleBarsAnimation(false);
                                });
                            } else {
                                audio.pause();
                                playPauseBtn.innerHTML = '<i class="fas fa-play"></i>';
                                toggleBarsAnimation(false);
                            }
                        });

                        // Ao terminar
                        audio.addEventListener("ended", () => {
                            playPauseBtn.innerHTML = '<i class="fas fa-play"></i>';
                            toggleBarsAnimation(false);
                        });
                    }

                    if (document.readyState === "loading") {
                        document.addEventListener("DOMContentLoaded", initRadioUI);
                    } else {
                        initRadioUI();
                    }
                })();
            </script>


            
