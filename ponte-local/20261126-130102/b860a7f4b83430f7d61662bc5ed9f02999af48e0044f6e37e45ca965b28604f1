<script defer>

    const removerAcentos = (str) => {
        return str.normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^\w\s]/gi, '');
    };

    const executarBusca = () => {
        const valorDaBusca = removerAcentos(busca.value.toLowerCase());

        listaItens.forEach(item => {
            const itemRotulo = removerAcentos(item.getAttribute('data-rotulo').toLowerCase());
            if (itemRotulo.includes(valorDaBusca)) {
                item.style.display = '';
            } else {
                item.style.display = 'none';
            }
        });
    };

    const busca = document.querySelector('[name="busca"]');
    const listaItens = document.querySelectorAll('.lista__grid-item');

    busca.addEventListener("keyup", (event) => {
        executarBusca();
    });

    busca.addEventListener("click", () => {
        executarBusca();
    });
</script>

    

