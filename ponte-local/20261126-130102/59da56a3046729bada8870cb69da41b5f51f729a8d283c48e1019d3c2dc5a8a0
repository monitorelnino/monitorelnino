<script>
    document.addEventListener("DOMContentLoaded", function () {
        var carousel = document.querySelector(".home-noticiasinsta-instagram-videos .videos-lista");
        if (!carousel) return;

        var slides = Array.from(carousel.querySelectorAll(".videos-lista-item"));
        var intervaloImagem = 8000;
        var atual = null;
        var versaoSlide = 0;
        var videoAtivo = false;
        var interagiu = false;

        function obterSlider() {
            return carousel.slider || null;
        }

        function configurarSlider() {
            var slider = obterSlider();
            if (!slider || slider._instagramTempoConfigurado) return slider;

            var playOriginal = slider.play;

            slider.play = function () {
                if (videoAtivo) return this.pause();

                this.options.interval = intervaloImagem;

                if (this.state.isPlayng) {
                    this.pause();
                }

                return playOriginal.call(this);
            };

            slider._instagramTempoConfigurado = true;
            return slider;
        }

        function atualizarControles(item) {
            var video = item.querySelector(".video-insta");
            var botaoPlay = item.querySelector(".btn-insta-play");
            var botaoSom = item.querySelector(".btn-insta-som");
            if (!video) return;

            video.controls = !video.muted && !video.paused;

            if (botaoPlay) {
                botaoPlay.style.display = video.paused ? "flex" : "none";
            }

            if (botaoSom) {
                botaoSom.style.display = !video.paused && video.muted ? "flex" : "none";
            }
        }

        function alterarIntervalo(tempo) {
            tempo = Math.max(1000, Math.ceil(tempo));

            if (carousel.getAttribute("data-interval") !== String(tempo)) {
                carousel.setAttribute("data-interval", tempo);
            }

            var slider = obterSlider();
            if (slider) slider.options.interval = tempo;
        }

        function atualizarIntervaloVideo(video, item) {
            if (atual !== item) return;

            if (isFinite(video.duration) && video.duration > 0) {
                alterarIntervalo(Math.ceil(video.duration * 1000));
            }
        }

        function carregarVideoAtivo(video, callback) {
            if (video.readyState >= 1) {
                callback();
                return;
            }

            video.addEventListener("loadedmetadata", callback, { once: true });

            var fonte = video.querySelector("source[data-src]");
            if (fonte) {
                fonte.src = fonte.getAttribute("data-src");
                fonte.removeAttribute("data-src");
                video.preload = "metadata";
                video.load();
            }
        }

        function pararVideoAnterior(item) {
            if (!item) return;

            var video = item.querySelector(".video-insta");
            if (!video) return;

            video.pause();
            video.muted = true;
            video.controls = false;
            atualizarControles(item);
        }

        function atualizarTempoCarousel() {
            var slider = configurarSlider();
            if (!slider) return;

            var item = slider.currentElement;
            if (!item || item === atual) return;

            var anterior = atual;
            atual = item;
            versaoSlide++;
            interagiu = false;

            pararVideoAnterior(anterior);

            var video = item.querySelector(".video-insta");

            if (!video) {
                videoAtivo = false;
                alterarIntervalo(intervaloImagem);
                slider.play();
            } else {
                videoAtivo = true;
                slider.pause();
                alterarIntervalo(intervaloImagem);

                var versao = versaoSlide;

                carregarVideoAtivo(video, function () {
                    if (atual !== item || versao !== versaoSlide) return;

                    atualizarIntervaloVideo(video, item);

                    if (video.currentTime > 0) {
                        video._reinicioAutomatico = true;

                        try {
                            video.currentTime = 0;
                        } catch (e) {
                            video._reinicioAutomatico = false;
                        }
                    }

                    video.muted = true;
                    video.controls = false;

                    var reproducao = video.play();

                    if (reproducao && reproducao.catch) {
                        reproducao.catch(function () {
                            if (atual !== item || versao !== versaoSlide) return;

                            videoAtivo = false;
                            alterarIntervalo(intervaloImagem);
                            slider.play();
                            atualizarControles(item);
                        });
                    }
                });
            }

            if (!carousel.hasAttribute("data-play")) {
                carousel.setAttribute("data-play", "");
            }
        }

        function ativarVideo(item) {
            if (atual !== item) return;

            var video = item.querySelector(".video-insta");
            if (!video) return;

            interagiu = true;
            carousel.removeAttribute("data-play");
            video.muted = false;
            video.controls = true;

            if (video.paused) {
                video.play().catch(function () {
                    atualizarControles(item);
                });
            }

            atualizarControles(item);
        }

        slides.forEach(function (item) {
            var video = item.querySelector(".video-insta");
            if (!video) return;

            var botaoPlay = item.querySelector(".btn-insta-play");
            var botaoSom = item.querySelector(".btn-insta-som");

            video.loop = false;
            video.muted = true;
            video.controls = false;
            video.autoplay = false;

            video.addEventListener("click", function (e) {
                e.preventDefault();
                e.stopPropagation();

                if (atual !== item) return;

                if (video.paused || video.muted) {
                    ativarVideo(item);
                } else {
                    interagiu = true;
                    carousel.removeAttribute("data-play");
                    video.pause();
                    video.muted = true;
                    video.controls = false;
                    atualizarControles(item);
                }
            });

            [botaoPlay, botaoSom].forEach(function (botao) {
                if (!botao) return;

                botao.addEventListener("click", function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    ativarVideo(item);
                });
            });

            video.addEventListener("durationchange", function () {
                atualizarIntervaloVideo(video, item);
            });

            video.addEventListener("loadedmetadata", function () {
                atualizarIntervaloVideo(video, item);
            });

            video.addEventListener("play", function () {
                atualizarControles(item);
            });

            video.addEventListener("pause", function () {
                atualizarControles(item);
            });

            video.addEventListener("volumechange", function () {
                atualizarControles(item);
            });

            video.addEventListener("ended", function () {
                atualizarControles(item);

                var slider = obterSlider();
                if (slider && slider.currentElement === item && !interagiu) {
                    slider.goNext();
                }
            });

            video.addEventListener("error", function () {
                if (atual !== item) return;

                var slider = obterSlider();
                videoAtivo = false;
                alterarIntervalo(intervaloImagem);

                if (slider) slider.play();
            });

            video.addEventListener("seeked", function () {
                if (video._reinicioAutomatico) {
                    video._reinicioAutomatico = false;
                    return;
                }

                if (atual !== item) return;

                interagiu = true;
                carousel.removeAttribute("data-play");
            });
        });

        carousel.addEventListener("render", atualizarTempoCarousel);
        atualizarTempoCarousel();
    });
</script>

    

