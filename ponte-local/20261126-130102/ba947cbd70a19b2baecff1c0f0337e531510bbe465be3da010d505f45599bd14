            const limite = numero;

            for (let p of texto) {
                const acimaLimite = p.innerText.length > limite;
                const pontoOuVazio = acimaLimite ? '...' : '';
                p.innerText = p.innerText.substring(0, limite) + pontoOuVazio.trim();
            }
        }
