    const headerMenu = document.querySelector(".site-header");
    const btnHamburgers = document.querySelectorAll('[data-btn="menu-topo"]');
    const menusConteudo = document.querySelectorAll('.menu-topo__conteudo');

    const fecharTodosOsMenus = () => {
        menusConteudo.forEach(menu => {
            menu.classList.remove("mostrar");
        });
        btnHamburgers.forEach(btn => {
            btn.classList.remove("ativo");
        });
    };

    btnHamburgers.forEach(btnHamburger => {
        const ativarMenu = (event) => {
            event.stopPropagation();
            const menuConteudo = btnHamburger.nextElementSibling;

            const isMenuAberto = menuConteudo.classList.contains('mostrar');

            fecharTodosOsMenus();

            if (!isMenuAberto) {
                menuConteudo.classList.add('mostrar');
                btnHamburger.classList.add("ativo");
                document.body.addEventListener('click', fecharMenu);
            }
        };

        const fecharMenu = (event) => {
            if (!btnHamburger.contains(event.target) && !event.target.closest('.menu-topo__conteudo')) {
                fecharTodosOsMenus();
                document.body.removeEventListener('click', fecharMenu);
            }
        };

        btnHamburger.addEventListener('click', ativarMenu);
    });
</script>

