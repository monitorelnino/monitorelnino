<script defer>
    const listaBandeira = document.querySelectorAll('[data-lista="bandeira"] li')

    document.addEventListener("DOMContentLoaded", function () {
        const itens = document.querySelectorAll('[data-noticia="item"]');
        let current = 0;

        itens[0].classList.add('ativo');

        const trocarItem = () => {
            const total = itens.length;
            const atual = itens[current];
            const proximoIndex = (current + 1) % total;
            const proximo = itens[proximoIndex];

            atual.classList.remove('ativo');
            atual.classList.add('saindo');

            proximo.classList.add('ativo');

            setTimeout(() => {
                atual.classList.remove('saindo');
            }, 500);

            current = proximoIndex;
        }

        setTimeout(() => {
            trocarItem();

            setInterval(trocarItem, 5000);
        }, 5000);
    });

    listaBandeira.forEach(item => {
        item.addEventListener('click', () => {
            const img = document.querySelector('[data-btn="bandeira"] img')
            let partes = img.src.split('/');
            partes[partes.length - 1] = item.children[0].children[0].dataset.img;
            img.src = partes.join('/')
        })
    })
</script>

