<script>
    document.querySelectorAll('.destaques-lista-item, .noticias-lista-item').forEach(item => {
        const link = item.querySelector('.destaques-lista-item__link, .noticias-lista-item__link');
        const box = item.querySelector('.box-categoria');
        if (!link || !box) return;

        let isDown = false;
        let startX = 0;
        let scrollLeft = 0;
        let dragged = false;

        // começar arraste
        box.addEventListener('mousedown', e => {
            isDown = true;
            dragged = false;
            startX = e.pageX - box.offsetLeft;
            scrollLeft = box.scrollLeft;
            box.classList.add('dragging');
        });

        // arrastando
        document.addEventListener('mousemove', e => {
            if (!isDown) return;
            const x = e.pageX - box.offsetLeft;
            const walk = x - startX;

            if (Math.abs(walk) > 3) { // passa de 3px = consideramos drag
                dragged = true;
            }

            box.scrollLeft = scrollLeft - walk;
        });

        // soltar mouse
        document.addEventListener('mouseup', () => {
            isDown = false;
            box.classList.remove('dragging');
            // NÃO zeramos dragged aqui, para o click conseguir ler
        });

        // se o clique final cair no <a>, decidimos se pode navegar ou não
        link.addEventListener('click', e => {
            if (dragged) {
                e.preventDefault();   // não abre o link
                e.stopPropagation();  // não propaga o clique
                dragged = false;      // reseta para o próximo
            }
        });
    });
</script>

    

