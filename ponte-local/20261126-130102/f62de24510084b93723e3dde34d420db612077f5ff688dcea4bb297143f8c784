.s-dark .smart-head-mobile .smart-head-mid,
.smart-head-mobile .s-dark.smart-head-mid { border-top-color: #f4f4f4; }
.smart-head-mobile .smart-head-mid { border-bottom-color: #cd051f; }
.off-canvas { background-color: #034eac; }
.s-dark .off-canvas, .off-canvas.s-dark { background-color: #034eac; }
.trending-ticker .heading { color: #ffffff; }
@media (min-width: 941px) and (max-width: 1200px) { .navigation-main .menu > li > a { font-size: calc(10px + (17px - 10px) * .7); } }


