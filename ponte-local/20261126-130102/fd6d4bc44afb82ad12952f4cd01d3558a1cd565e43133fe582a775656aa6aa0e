                    <div class="stories_bolinha" style="background-image: url(https://ecrie.com.br/sistema/conteudos/imagem/g_167_0_1_23042026223046.jpg); background-size: 64px 64px; border: solid; border-color: #518678;"></div>
            </div>
        </div>
    </div>

<script defer>
    const fechar = document.querySelector(".fechar");
    const thumbs = document.querySelectorAll(".stories_bolinha");
    const storiesContainer = document.querySelector(".stories");

    if (document.querySelector(".slider-container .slider").dataset.controls != null) {
        const stories = document.querySelectorAll(".stories .slider__item");
        const botoesSlider = document.getElementById("stories-slider-arrows");
        var abriu = false;
        var controls = null;
        var botoes = null;
        var storiesAtual = 0;
        var anteriorStories = 0;
        var proximoStories = 0;
        var total = thumbs.length;

        thumbs.forEach((e) => {
            e.addEventListener("click", () => {
                controls = document.querySelector(".slider-controls__container");
                botoes = controls.querySelectorAll(":is(.slider-controls__counters button)");
                let sliderCerto = 0;

                storiesContainer.style.display = "block";

                botoes.forEach((c) => {
                    if (c.classList.contains("is-active")) {
                        c.classList.remove("is-active");
                    };
                });

                stories.forEach(function (el, i) {
                    if (el.classList.contains("current")) {
                        el.classList.remove("current");
                    };
                    if (el.classList.contains("prev")) {
                        el.classList.remove("prev");
                    };
                    if (el.classList.contains("next")) {
                        el.classList.remove("next");
                    };
                    if (el.querySelector("img").src == e.getAttribute("style").split("(")[1].split(")")[0]) {
                        el.classList.add("current");
                        sliderCerto = i;
                        botoes.forEach((c) => {
                            if (c.textContent == (i + 1)) {
                                c.classList.add("is-active");
                            };
                        });
                    };
                });

                if (!abriu) {
                    controls.appendChild(botoesSlider);
                    botoesSlider.style.display = "block";
                    botoesSlider.removeAttribute("id");
                    botoes.forEach((c) => {
                        c.addEventListener("click", () => { alterarOrdem(c.textContent) }, false)
                    });
                    abriu = true;
                };

                adicionarClassesIrmaos(sliderCerto);
            }, false);
        });

        function alterarOrdem(n) {
            thumbs[n - 1].click();
        };

        function adicionarClassesIrmaos(n) {
            storiesAtual = n;
            try {
                stories[n].nextElementSibling.classList.add("next");
                proximoStories = n;
            } catch {
                stories[0].classList.add("next");
                proximoStories = 0;
            };
            if (!thumbs[n].previousElementSibling.classList.contains("stories_chamada")) {
                stories[n].previousElementSibling.classList.add("prev");
                anteriorStories = n;
            }
            else {
                stories[total - 1].classList.add("prev");
                anteriorStories = total;
            };
        };

        botoesSlider.querySelector(".prev").addEventListener("click", () => { sliderAnterior() });
        botoesSlider.querySelector(".next").addEventListener("click", () => { sliderSeguinte() });

        function sliderAnterior() {
            try {
                thumbs[anteriorStories - 1].click();
            } catch {
                thumbs[total].click();
            };
        };

        function sliderSeguinte() {
            try {
                thumbs[storiesAtual + 1].click();
            } catch {
                thumbs[0].click();
            };
        };
    }
    else {
        thumbs.forEach((e) => {
            e.addEventListener("click", () => {
                storiesContainer.style.display = "block";
            });
        });
    };

    fechar.addEventListener("click", () => {
        storiesContainer.style.display = "none";
    }, false);
</script>
