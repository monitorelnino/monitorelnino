        botao.addEventListener('click', function () {
            container.classList.add('accepted');

            var data = new Date();
            data.setTime(data.getTime() + (90 * 24 * 60 * 60 * 1000))
            var expiracao = "expires=" + data.toUTCString();

            document.cookie = "user-lgpd-accept=true; " + expiracao;
        });
    </script>

