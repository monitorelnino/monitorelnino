<html lang="pt-BR"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    
    <title>Defesa Civil Municipal | Prefeitura de Francisco Morato</title>
    <meta name="description" content="Portal oficial da Defesa Civil de Francisco Morato com informações de prevenção, contatos e atendimento emergencial.">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        :root{
            --azul:#0b3d6e;
            --azul-claro:#1e6bb8;
            --bg:#f1f4f8;
            --texto:#333;
        }

        body{
            margin:0;
            font-family: Arial, sans-serif;
            background:var(--bg);
            color:var(--texto);
            line-height:1.6;
            transition: background 0.3s, color 0.3s;
        }

        /* BARRA ACESSIBILIDADE FIXA (SEM LOGO) */
        #acessibilidade{
            background:var(--azul);
            padding:10px;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .acess-container{
            max-width: 1200px;
            margin: auto;
            display: flex;
            justify-content: center; /* Centraliza os botões agora que não há logo */
            gap: 15px;
            flex-wrap: wrap;
        }

        .btn-acess{
            background:#fff;
            color:var(--azul);
            border:2px solid #fff;
            padding:8px 15px;
            border-radius:4px;
            cursor:pointer;
            font-weight:bold;
            transition: 0.2s;
            font-size: 14px;
        }

        .btn-acess:hover, .btn-acess:focus{
            background: var(--azul);
            color: #fff;
            outline: 3px solid #ffcc00;
        }

        /* ALTO CONTRASTE */
        .alto-contraste, .alto-contraste main, .alto-contraste .container {
            background-color: #000 !important;
            color: #fff !important;
        }

        .alto-contraste h1, .alto-contraste h2, .alto-contraste strong {
            color: #ffff00 !important;
        }

        /* CONTEÚDO CENTRALIZADO */
        .container{
            max-width:1000px;
            margin:20px auto;
            background:#fff;
            padding:40px;
            text-align: center;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }

        .banner img{
            width:100%;
            max-height:300px;
            object-fit:cover;
        }

        .card{ margin-bottom: 40px; }

        ul {
            display: inline-block;
            text-align: left;
            list-style-position: inside;
        }

        /* MAPA E LOGO NO FINAL */
        iframe {
            width: 100%;
            height: 450px;
            border: 0;
            border-radius: 4px;
            margin-top: 20px;
        }

        .logo-rodape {
            max-width: 200px;
            height: auto;
            margin: 20px auto;
            display: block;
        }

        footer {
            text-align: center;
            padding: 30px;
            font-size: 14px;
            border-top: 1px solid #ddd;
        }
    </style>
<style>[vw] [vw-access-button]{display:none;flex-direction:row-reverse;width:40px;height:40px;cursor:pointer;overflow:hidden;position:absolute;border-radius:8px;transition:all 0.5s ease;right:0;left:auto}[vw] [vw-access-button] img{max-height:40px;transition:all 0.5s ease;border-radius:8px;opacity:1 !important;visibility:visible !important}[vw] [vw-access-button] .vp-access-button{width:40px;height:40px;z-index:1}[vw] [vw-access-button] .vp-pop-up{position:absolute;height:40px;min-width:150px;z-index:0;left:0;right:auto}[vw] [vw-access-button]:hover{width:200px}[vw] [vw-access-button].isLeft{flex-direction:row;left:0;right:auto}[vw] [vw-access-button].isLeft .vp-pop-up{left:auto;right:0}[vw] [vw-access-button].isTopOrBottom:hover{bottom:-20px;top:0;margin-right:-80px}[vw] [vw-access-button].active{display:flex}
