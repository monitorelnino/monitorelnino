<body>

<div id="acessibilidade" role="navigation" aria-label="Ferramentas de Acessibilidade">
  <div class="acess-container">
    <div class="botoes-acess">
        <button class="btn-acess" onclick="alterarFonte(1)" onmouseenter="falarTexto(&#39;Aumentar fonte&#39;)" aria-label="Aumentar texto">A+</button>
        <button class="btn-acess" onclick="alterarFonte(-1)" onmouseenter="falarTexto(&#39;Diminuir fonte&#39;)" aria-label="Diminuir texto">A-</button>
        <button class="btn-acess" onclick="alternarContraste()" onmouseenter="falarTexto(&#39;Alternar contraste&#39;)" aria-label="Alternar Alto Contraste">🌓 Contraste</button>
        <button class="btn-acess" id="btn-voz" onclick="toggleLeitura()" onmouseenter="falarNomeBotao()" aria-label="Ouvir texto da página">🔊 Ouvir Página</button>
    </div>
  </div>
</div>

<header class="banner">
    <img src="./banner-defesa-civil.png" alt="Banner da Defesa Civil de Francisco Morato">
</header>

<main id="conteudo" class="container">
    <h1>Defesa Civil de Francisco Morato</h1>

    <section class="card">
        <h2>Contatos de Emergência</h2>
        <p><strong>Email:</strong> defesacivil@franciscomorato.sp.gov.br</p>
        <p><strong>Telefone:</strong> 199 / (11) 4488-2011</p>
        <p><strong>GCM:</strong> 153 / (11) 4881-0637</p>
        <p><strong>Atendimento:</strong> 24 horas</p>
    </section>

    <section class="card">
        <h2>Principais Serviços</h2>
        <ul>
            <li>Monitoramento de áreas de risco</li>
            <li>Atendimento emergencial</li>
            <li>Educação preventiva</li>
        </ul>
    </section>

    <section class="card">
        <h2>Localização</h2>
        <p>Avenida Ulisses Guimarães, nº 888, Francisco Morato/SP</p>
        <iframe title="Mapa de localização da Defesa Civil" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3675.0547634851743!2d-46.76897!3d-23.21671!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94cf5b7b8b8b8b8b%3A0x8b8b8b8b8b8b8b8b!2sAv.%20Ul%C3%ADsses%20Guimar%C3%A3es%2C%20888%20-%20Francisco%20Morato%2C%20SP!5e0!3m2!1spt-BR!2sbr!4v1691234567890" allowfullscreen="" loading="lazy">
        </iframe>
    </section>

    <img src="./logo-prefeitura.png" alt="Logo Prefeitura de Francisco Morato" class="logo-rodape">
</main>

<footer>
    Prefeitura de Francisco Morato – 2026
</footer>

<script>
    let nivelFonte = 100;
    function alterarFonte(delta) {
        nivelFonte += (delta * 10);
        if (nivelFonte < 80) nivelFonte = 80;
        if (nivelFonte > 150) nivelFonte = 150;
        document.documentElement.style.fontSize = nivelFonte + "%";
    }

    function alternarContraste() {
        document.body.classList.toggle('alto-contraste');
    }

    let sintetizador = window.speechSynthesis;
    
    function falarTexto(texto) {
        if (!sintetizador.speaking) {
            const anuncio = new SpeechSynthesisUtterance(texto);
            anuncio.lang = 'pt-BR';
            anuncio.rate = 1.2;
            sintetizador.speak(anuncio);
        }
    }

    function falarNomeBotao() {
        const textoBotao = document.getElementById('btn-voz').innerText;
        falarTexto(textoBotao);
    }

    function toggleLeitura() {
        const btn = document.getElementById('btn-voz');
        if (sintetizador.speaking) {
            sintetizador.cancel();
            btn.innerHTML = "🔊 Ouvir Página";
            return;
        }
        const texto = document.getElementById('conteudo').innerText;
        const locucao = new SpeechSynthesisUtterance(texto);
        locucao.lang = 'pt-BR';
        locucao.onstart = () => btn.innerHTML = "⏹ Parar Leitura";
        locucao.onend = () => btn.innerHTML = "🔊 Ouvir Página";
        sintetizador.speak(locucao);
    }
</script>

