<script defer>
    document.addEventListener("DOMContentLoaded", () => {
        const btnHamburgers = document.querySelectorAll('[data-btn="menu-topo"]');

        const fecharTodosOsMenus = (devolverFoco = false) => {
            btnHamburgers.forEach(btn => {
                const menu = btn.nextElementSibling;

                if (!menu?.classList.contains("menu-topo__conteudo")) {
                    return;
                }

                menu.classList.remove("mostrar");
                menu.setAttribute("aria-hidden", "true");
                menu.inert = true;

                btn.classList.remove("ativo");
                btn.setAttribute("aria-expanded", "false");

                if (devolverFoco && btn.contains(document.activeElement)) {
                    btn.focus();
                }
            });
        };

        btnHamburgers.forEach(btn => {
            const menu = btn.nextElementSibling;

            if (!menu?.classList.contains("menu-topo__conteudo")) {
                return;
            }

            menu.inert = true;
            menu.setAttribute("aria-hidden", "true");
            btn.setAttribute("aria-expanded", "false");

            const alternarMenu = event => {
                event.stopPropagation();

                const estavaAberto = menu.classList.contains("mostrar");

                fecharTodosOsMenus();

                if (!estavaAberto) {
                    menu.classList.add("mostrar");
                    menu.setAttribute("aria-hidden", "false");
                    menu.inert = false;

                    btn.classList.add("ativo");
                    btn.setAttribute("aria-expanded", "true");
                }
            };

            btn.addEventListener("click", alternarMenu);

            menu.addEventListener("keydown", event => {
                if (event.key === "Escape") {
                    event.preventDefault();

                    menu.classList.remove("mostrar");
                    menu.setAttribute("aria-hidden", "true");
                    menu.inert = true;

                    btn.classList.remove("ativo");
                    btn.setAttribute("aria-expanded", "false");

                    btn.focus();
                }
            });
        });

        document.addEventListener("click", event => {
            const clicouDentro = [...btnHamburgers].some(btn => {
                const menu = btn.nextElementSibling;

                return btn.contains(event.target) ||
                    menu?.contains(event.target);
            });

            if (!clicouDentro) {
                fecharTodosOsMenus();
            }
        });
    });
</script>


