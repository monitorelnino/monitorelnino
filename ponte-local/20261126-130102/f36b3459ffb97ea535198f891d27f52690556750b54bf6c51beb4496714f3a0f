<script>
    const conteinerBolinha = document.createElement("conteiner")
    const conteiner = document.querySelector(".carroselVideos");
    const bolinha = document.createElement("div");
    const itens = document.querySelectorAll("#video-item");
    const prev = document.querySelector(".btnVideoprev");
    const next = document.querySelector(".btnVideonext");
    const intervalTime = 5000;
    let intervalId;
    var index = 0;

    function criarIntervalo() {
        intervalId = setInterval(() => {
            index = (index < itens.length - 1) ? index + 1 : 0;
            carrosel(index);
            resetBolinha(index);
        }, intervalTime);
    }
    function resetIntervalo() {
        clearInterval(intervalId);
        criarIntervalo();
    }
    function carrosel(index) {
        itens.forEach((item, i) => {
            if (i != index) {
                item.classList.remove("ativo");
            } else {
                item.classList.add("ativo");
            }
        });
    }
    function resetBolinha(index) {
        const bolinhass = document.querySelectorAll(".bolinha");
        bolinhass.forEach((item, i) => {
            if (i != index) {
                item.classList.remove("ativo");
            } else {
                item.classList.add("ativo");
            }
        });
    }

    if (itens.length < 2) {
        prev.style.display = "none"
        next.style.display = "none"
    }
    else if (itens.length > 1) {
        prev.addEventListener("click", (event) => {
            index = (index > 0) ? index - 1 : itens.length - 1;
            carrosel(index);
        });
        next.addEventListener("click", (event) => {
            index = (index < itens.length - 1) ? index + 1 : 0;
            carrosel(index);
        });

        itens.forEach((item, i) => {
            const bolinha = document.createElement("div");
            bolinha.classList.add("bolinha");
            bolinha.dataset.index = i;
            if (i === 0) bolinha.classList.add("ativo");
            conteinerBolinha.appendChild(bolinha);
            conteinerBolinha.classList.add("conteinerBolinha")
            conteiner.appendChild(conteinerBolinha)

            bolinha.addEventListener("click", (e) => {
                const bolinhas = document.querySelectorAll(".bolinha");
                const newIndex = parseInt(bolinha.dataset.index);
                index = newIndex;
                bolinhas.forEach((b) => b.classList.remove("ativo"));
                e.target.classList.add("ativo")
                carrosel(index);
                resetIntervalo();
            });
        });
    }

    criarIntervalo();
</script>


