    if (imagens && imgPrincipal) {
        imgPrincipal.addEventListener('click', () => {
            modalTurismo.classList.add('mostrar-modal')
            document.querySelector('#img-modal-turismo').src = imgPrincipal.src
            document.body.style.overflow = 'hidden'

            document.querySelector('.fechar-modal-turismo').addEventListener('click', () => {
                modalTurismo.classList.remove('mostrar-modal')
                document.body.style.overflow = 'initial'
            })
